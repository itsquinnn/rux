fn compute_file_checksum(filepath: *byte, buffer: *mut byte, max_size: uint) -> uint {
    let fd: int = @os.open(filepath, 0, 0);
    if fd < 0 { return 0; }

    let nread: int = @os.read(fd, buffer, max_size);
    @os.close(fd);
    if nread <= 0 { return 0; }

    var hash: uint = 14695981039346656037;
    var i: uint = 0;
    let count: uint = nread as uint;

    while i < count {
        let b: byte = buffer[i];
        hash = (hash ^ (b as uint)) * 1099511628211;
        i = i + 1;
    }

    return hash;
}

fn compare_two_binaries(path_a: *byte, path_b: *byte, buf_a: *mut byte, buf_b: *mut byte, max_size: uint) -> int {
    let fd_a: int = @os.open(path_a, 0, 0);
    if fd_a < 0 { return -1; }
    let read_a: int = @os.read(fd_a, buf_a, max_size);
    @os.close(fd_a);

    let fd_b: int = @os.open(path_b, 0, 0);
    if fd_b < 0 { return -2; }
    let read_b: int = @os.read(fd_b, buf_b, max_size);
    @os.close(fd_b);

    if read_a != read_b {
        return 0;
    }

    var i: uint = 0;
    let total: uint = read_a as uint;
    while i < total {
        if buf_a[i] != buf_b[i] {
            return 0;
        }
        i = i + 1;
    }

    return 1;
}
