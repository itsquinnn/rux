include "lib/core/types.rx";

struct SemVer {
    major: uint,
    minor: uint,
    patch: uint,
}

fn semver_set(out: *mut SemVer, maj: uint, min: uint, pat: uint) {
    out.major = maj;
    out.minor = min;
    out.patch = pat;
}

fn semver_parse_into(s: *const byte, out: *mut SemVer) {
    var parts: [uint; 3];
    parts[0] = 0; parts[1] = 0; parts[2] = 0;
    var p_idx: uint = 0;
    var i: uint = 0;
    while s[i] != 0 && p_idx < 3 {
        let c: byte = s[i];
        if c >= 48 && c <= 57 {
            parts[p_idx] = (parts[p_idx] * 10) + ((c - 48) as uint);
        } else if c == 46 {
            p_idx = p_idx + 1;
        } else {
            break;
        }
        i = i + 1;
    }
    out.major = parts[0];
    out.minor = parts[1];
    out.patch = parts[2];
}

fn semver_compare(a: *const SemVer, b: *const SemVer) -> int {
    if a.major != b.major {
        if a.major > b.major { return 1; }
        return -1;
    }
    if a.minor != b.minor {
        if a.minor > b.minor { return 1; }
        return -1;
    }
    if a.patch != b.patch {
        if a.patch > b.patch { return 1; }
        return -1;
    }
    return 0;
}

fn semver_satisfies_caret(candidate: *const SemVer, req: *const SemVer) -> bool {
    if req.major > 0 {
        if candidate.major != req.major { return false; }
        return semver_compare(candidate, req) >= 0;
    }
    if req.minor > 0 {
        if candidate.major != 0 || candidate.minor != req.minor { return false; }
        return candidate.patch >= req.patch;
    }
    return candidate.major == 0 && candidate.minor == 0 && candidate.patch == req.patch;
}

fn semver_satisfies_tilde(candidate: *const SemVer, req: *const SemVer) -> bool {
    if candidate.major != req.major || candidate.minor != req.minor {
        return false;
    }
    return candidate.patch >= req.patch;
}
