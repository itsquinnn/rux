include "lib/core/types.rx";
include "lib/fs/file.rx";

struct FmtOptions {
    check_only: bool,
    indent_spaces: uint,
}

fn fmt_default_options() -> FmtOptions {
    var opts: FmtOptions;
    opts.check_only = false;
    opts.indent_spaces = 4;
    return opts;
}

fn fmt_format_buffer(src: *const byte, src_len: uint, dst: *mut byte, dst_max: uint, indent_step: uint) -> uint {
    var si: uint = 0;
    var di: uint = 0;
    var brace_depth: int = 0;
    var consec_blank: uint = 0;

    while si < src_len {
        var line_start: uint = si;
        while line_start < src_len && (src[line_start] == 32 || src[line_start] == 9) {
            line_start = line_start + 1;
        }
        var line_end: uint = line_start;
        while line_end < src_len && src[line_end] != 10 {
            line_end = line_end + 1;
        }
        let next_si: uint = line_end + 1;
        while line_end > line_start && (src[line_end - 1] == 32 || src[line_end - 1] == 9 || src[line_end - 1] == 13) {
            line_end = line_end - 1;
        }

        if line_end == line_start {
            consec_blank = consec_blank + 1;
            if consec_blank <= 1 && di > 0 && di < dst_max {
                dst[di] = 10;
                di = di + 1;
            }
        } else {
            consec_blank = 0;
            if src[line_start] == 125 && brace_depth > 0 {
                brace_depth = brace_depth - 1;
            }

            let spaces: uint = (brace_depth as uint) * indent_step;
            var sp_i: uint = 0;
            while sp_i < spaces && di < dst_max {
                dst[di] = 32;
                di = di + 1;
                sp_i = sp_i + 1;
            }

            var k: uint = line_start;
            var in_str: bool = false;
            while k < line_end && di < dst_max {
                let ch: byte = src[k];
                dst[di] = ch;
                di = di + 1;
                if ch == 34 { in_str = !in_str; }
                if !in_str {
                    if ch == 123 { brace_depth = brace_depth + 1; }
                    else if ch == 125 && k > line_start {
                        if brace_depth > 0 { brace_depth = brace_depth - 1; }
                    }
                }
                k = k + 1;
            }
            if di < dst_max {
                dst[di] = 10;
                di = di + 1;
            }
        }
        si = next_si;
    }

    if di < dst_max {
        dst[di] = 0;
    }
    return di;
}

fn format_file(target_path: str, opts: FmtOptions) -> int {
    var f: File = file_open(target_path, OpenMode.READ_ONLY);
    if !f.is_open {
        return -1;
    }
    var in_buf: [byte; 65536];
    let n_read: int = file_read(&mut f, &mut in_buf[0], 65535);
    file_close(&mut f);
    if n_read <= 0 {
        return 0;
    }
    in_buf[n_read as uint] = 0 as byte;
    var out_buf: [byte; 65536];
    let out_len: uint = fmt_format_buffer(&in_buf[0], n_read as uint, &mut out_buf[0], 65535, opts.indent_spaces);
    if opts.check_only {
        return 0;
    }
    var out_f: File = file_open(target_path, OpenMode.WRITE_ONLY);
    if !out_f.is_open {
        return -1;
    }
    file_write(&mut out_f, &out_buf[0], out_len);
    file_close(&mut out_f);
    return 0;
}
