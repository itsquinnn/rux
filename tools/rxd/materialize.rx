include "lib/core/types.rx";
include "lib/os/os.rx";
include "lib/rxd/rxd.rx";

fn rxd_cmd_materialize(in_path: *const byte, out_path: *const byte) -> int {
    let res: int = rxd_materialize_file(in_path, out_path);
    if res <= 0 {
        let fail: str = "[FAIL] Materialization failed";
        os_println(fail as *const byte);
        return 1;
    }
    let ok: str = "[PASS] Materialized .rxdb silicon plate into clean .rxd text";
    os_println(ok as *const byte);
    return 0;
}

