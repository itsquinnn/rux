include "lib/core/types.rx";
include "lib/io/print.rx";
include "compiler/subsystems/lcvs/vitrify.rx";
include "compiler/subsystems/lcvs/rejuvenate.rx";

fn main() -> int {
    println("=== RUX COMPILER SUITE: LCVS (LIVING CHECKPOINT VITRIFICATION) ===");

    var arena_storage: [byte; 256];
    var engine: VitrificationEngine;
    lcvs_vitrify_init(&mut engine, &mut arena_storage[0]);

    lcvs_vitrify_arena(&mut engine, &mut arena_storage[0], 128);
    if engine.total_vitrifications != 1 {
        println("[FAIL] LCVS: Arena state vitrification failed");
        return 1;
    }
    println("[PASS] LCVS: 64-byte cacheline state vitrification (CLWB+SFENCE) verified");

    if !lcvs_thaw_arena(&mut engine, &mut arena_storage[0]) || engine.total_thaws != 1 {
        println("[FAIL] LCVS: Arena state thaw failed");
        return 2;
    }
    println("[PASS] LCVS: Instant 0.000ns state thaw verified");

    var rej_arena: RejuvenatingArena;
    lcvs_rejuvenate_init(&mut rej_arena, &mut arena_storage[0], 256);
    rej_arena.fragmentation_permille = 150;

    let rejs: uint = lcvs_rejuvenate_heap(&mut rej_arena);
    if rejs != 1 || rej_arena.fragmentation_permille != 0 {
        println("[FAIL] LCVS: Online compaction failed");
        return 3;
    }

    var real_buf: [byte; 128];
    var real_arena: RejuvenatingArena;
    lcvs_rejuvenate_init(&mut real_arena, &mut real_buf[0], 128);
    let p_a: *mut byte = lcvs_rejuvenate_alloc(&mut real_arena, 60);
    let p_b: *mut byte = lcvs_rejuvenate_alloc(&mut real_arena, 40);
    if (p_a as uint) == 0 || (p_b as uint) == 0 || real_arena.allocated_bytes != 100 || lcvs_check_fragmentation_permille(&mut real_arena) != 0 {
        println("[FAIL] LCVS: RejuvenatingArena allocation accounting failed");
        return 4;
    }
    var f_i: uint = 0;
    while f_i < 40 {
        p_b[f_i] = 0x5A as byte;
        f_i = f_i + 1;
    }
    if lcvs_rejuvenate_free_bytes(&mut real_arena, 200) {
        println("[FAIL] LCVS: Allowed freeing more bytes than live");
        return 5;
    }
    if !lcvs_rejuvenate_free_bytes(&mut real_arena, 40) || lcvs_check_fragmentation_permille(&mut real_arena) != 400 {
        println("[FAIL] LCVS: Fragmentation permille calculation failed");
        return 6;
    }
    let rejs2: uint = lcvs_rejuvenate_heap(&mut real_arena);
    if rejs2 != 1 || real_arena.allocated_bytes != 60 || real_arena.dead_bytes != 0 || real_arena.fragmentation_permille != 0 || real_buf[60] != (0 as byte) || real_buf[99] != (0 as byte) {
        println("[FAIL] LCVS: Tail scrub compaction failed");
        return 7;
    }
    println("[PASS] LCVS: Online memory rejuvenation and compaction verified");

    println("ALL LCVS STATE VITRIFICATION TESTS PASSED (100% OK)");
    return 0;
}
