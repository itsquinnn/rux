@cInclude("tests/sample_c_interop.h")

fn multi_step_coroutine(step_ptr: *mut uint, val_ptr: *mut uint) -> uint {
    var s: uint = 0;
    var v: uint = 0;
    unsafe {
        s = *step_ptr;
        v = *val_ptr;
    }
    if s < 3 {
        s = s + 1;
        v = v + 25;
        unsafe {
            *step_ptr = s;
            *val_ptr = v;
        }
        return POLL_PENDING;
    }
    return POLL_READY;
}

fn worker_goroutine_step(quantum: uint, acc_ptr: *mut uint) -> uint {
    unsafe {
        *acc_ptr = *acc_ptr + 10;
    }
    if quantum >= 2 {
        return 1;
    }
    return 0;
}

fn on_button_click(ev_code: int) -> int {
    return ev_code + 1000;
}

fn ts_gradual_compute(a: any, b: unknown) -> any {
    return (a as int) + (b as int);
}

fn main() -> int {
    println("=== RUX COMPLETE ECOSYSTEM & RUNTIME VERIFICATION ===");

    var ex: AsyncExecutor;
    executor_init(&mut ex);
    if ex.epoll_fd < 0 { return 1; }
    executor_spawn_coroutine(&mut ex, multi_step_coroutine);
    executor_spawn_coroutine(&mut ex, multi_step_coroutine);
    let coro_total: uint = executor_run_until_complete(&mut ex);
    if coro_total != 150 || ex.poll_cycles != 8 { return 2; }
    executor_shutdown(&mut ex);
    println("[PASS] 1. Rust Production Async Runtime (Multi-Yield Coroutines & Linux Epoll Reactor)");

    var tls: TlsClient = TlsClient::new();
    tls_derive_key_schedule(&mut tls);
    let msg: *const u8 = "SOVEREIGN_TLS13_PAYLOAD";
    var sealed_rec: [u8; 128];
    let sealed_len: u64 = tls_aead_seal_record(&mut tls, msg, 23, &mut sealed_rec[0]);
    var opened_buf: [u8; 128];
    let opened_len: int = tls_aead_open_record(&mut tls, 0, &sealed_rec[0], sealed_len, &mut opened_buf[0]);
    if opened_len != 23 || opened_buf[0] != 83 || opened_buf[22] != 68 { return 3; }
    sealed_rec[10] = sealed_rec[10] ^ 255;
    let tampered_res: int = tls_aead_open_record(&mut tls, 0, &sealed_rec[0], sealed_len, &mut opened_buf[0]);
    if tampered_res != -1 { return 4; }

    var bh: BinaryHeap;
    bheap_init(&mut bh, 16);
    bheap_push(&mut bh, 40);
    bheap_push(&mut bh, 95);
    bheap_push(&mut bh, 15);
    if option_unwrap(bheap_pop(&mut bh)) != 95 || option_unwrap(bheap_pop(&mut bh)) != 40 { return 5; }
    println("[PASS] 2. Rust Complete TLS 1.3 HKDF + AEAD Tag Verification & BinaryHeap");

    let lint_src: *const byte = "unsafe { let p = x as *mut u8; while true { let z = 1 / 0; {} } } // TODO";
    let rep: ClippyReport = clippy_analyze_source(lint_src, 73);
    if rep.unsafe_blocks != 1 || rep.raw_ptr_casts != 1 || rep.infinite_loops != 1 ||
       rep.div_by_zero != 1 || rep.empty_blocks != 1 || rep.todo_markers != 1 {
        return 6;
    }
    let unformatted: *const byte = "fn foo() {\nif true {\nlet x = 1;\n}\n}\n";
    var fmt_out: [byte; 256];
    let fmt_len: uint = fmt_format_buffer(unformatted, 36, &mut fmt_out[0], 256, 4);
    if fmt_len == 0 || fmt_out[11] != 32 || fmt_out[14] != 32 { return 7; }
    println("[PASS] 3. Rust Clippy (6 Lint Rules) & Rustfmt Indentation Formatter");

    var pkt: CInteropPacket;
    pkt.magic = C_HEADER_VERSION;
    pkt.payload_len = C_SCALE_MAC(16, 8);
    pkt.status_code = 200;
    var cpt: CPoint2D;
    cpt.x = 12;
    cpt.y = 30;
    if pkt.magic != 314 || pkt.payload_len != 128 || (cpt.x + cpt.y) != 42 { return 8; }

    var bg: BuildGraph;
    build_init(&mut bg, TARGET_LINUX_X64, OPT_RELEASE_FAST);
    let s0: uint = build_add_executable(&mut bg, "app", "src/main.rx", TARGET_LINUX_X64);
    let _s1: uint = build_add_static_library(&mut bg, "libcore.a", "lib/core.rx", TARGET_LINUX_ARM64);
    let _s2: uint = build_add_shared_library(&mut bg, "libnet.so", "lib/net.rx", TARGET_RISCV64);
    build_step_add_c_header(&mut bg, s0);
    if build_execute_all(&mut bg) != 3 { return 9; }
    println("[PASS] 4. Zig @cInclude C Header Translator (.h -> Rux) & BuildGraph Engine");

    var sched: MNScheduler;
    mn_sched_init(&mut sched, 4);
    var gi: uint = 0;
    while gi < 8 {
        go_spawn_on(&mut sched, 0, worker_goroutine_step, 5);
        gi = gi + 1;
    }
    let total_g_res: uint = mn_sched_run(&mut sched);
    let total_steals: uint = sched.procs[1].steal_count + sched.procs[2].steal_count + sched.procs[3].steal_count;
    if total_g_res != 280 || sched.completed_g != 8 || total_steals == 0 { return 10; }
    println("[PASS] 5. Go Preemptive M:N Work-Stealing Goroutine Scheduler (8 G across 4 P)");

    var ch1: Chan<uint>;
    var ch2: Chan<uint>;
    chan_init_u64(&mut ch1, 8);
    chan_init_u64(&mut ch2, 8);
    chan_try_send(&mut ch2, 777);

    var sel_val: uint = 0;
    select {
        case chan_try_recv(&mut ch1, &mut sel_val) => {
            sel_val = sel_val + 1;
        }
        case chan_try_recv(&mut ch2, &mut sel_val) => {
            sel_val = sel_val + 23;
        }
        default => {
            sel_val = 999;
        }
    }
    if sel_val != 800 { return 11; }
    println("[PASS] 6. Go Typed Chan<T> & Native `select { case ... default ... }` Multiplexer");

    var jb: JitCodeBuf;
    if !jit_init(&mut jb) { return 12; }
    jit_emit_prologue_arg0(&mut jb);
    jit_emit_op_imm32(&mut jb, JIT_OP_ADD_IMM, 15);
    jit_emit_op_imm32(&mut jb, JIT_OP_MUL_IMM, 3);
    jit_emit_op_imm32(&mut jb, JIT_OP_SUB_IMM, 5);
    let jit_fn: fn(int) -> int = jit_finalize_fn(&mut jb);
    let jit_out: int = jit_fn(10);
    jit_free(&mut jb);
    if jit_out != 70 { return 13; }
    println("[PASS] 7. JavaScript Native x86-64 Runtime JIT Compiler (mmap RWX -> 70)");

    var doc: DomDocument;
    document_init(&mut doc);
    let root_div: int = document_create_element(&mut doc, "div");
    let btn_el: int = document_create_element(&mut doc, "button");
    element_set_id(&mut doc, btn_el, "submit-btn");
    element_set_attribute(&mut doc, btn_el, "class", "btn-primary");
    element_set_text_content(&mut doc, btn_el, "Launch Sovereign");
    element_append_child(&mut doc, root_div, btn_el);
    element_add_event_listener(&mut doc, btn_el, on_button_click);

    let found_btn: int = document_get_element_by_id(&doc, "submit-btn");
    let ev_res: int = element_dispatch_event(&mut doc, found_btn, 42);
    if found_btn != btn_el || ev_res != 1042 { return 14; }

    var ls: LocalStorage;
    local_storage_init(&mut ls);
    local_storage_set_item(&mut ls, "theme", "dark");
    let theme_val: *const byte = local_storage_get_item(&ls, "theme");
    if theme_val[0] != 100 { return 15; }

    let dyn_a: any = 120;
    let dyn_b: unknown = 80;
    let dyn_c: any = ts_gradual_compute(dyn_a, dyn_b);
    let av1: AnyVal = any_number(33);
    let av2: AnyVal = any_number(67);
    let av_sum: AnyVal = any_add(av1, av2);
    if (dyn_c as int) != 200 || av_sum.num_val != 100 { return 16; }

    println("[PASS] 8. JS DOM/BOM/EventTarget/LocalStorage & TypeScript Gradual Typing (`any`)");
    println("=== ALL 8 ECOSYSTEM, RUNTIME, JIT & INTEROP GATES PASSED (EXIT 0) ===");
    return 0;
}
