fn omni_slen(s: *u8) -> u64 {
    var i: u64 = 0;
    while s[i] != 0 { i = i + 1; }
    return i;
}

fn omni_contains(hay: *u8, hlen: u64, needle: *u8) -> u32 {
    let nlen: u64 = omni_slen(needle);
    if nlen == 0 { return 1; }
    if hlen < nlen { return 0; }
    var i: u64 = 0;
    while (i + nlen) <= hlen {
        var ok: u32 = 1;
        var j: u64 = 0;
        while j < nlen {
            if hay[i + j] != needle[j] {
                ok = 0;
                j = nlen;
            } else {
                j = j + 1;
            }
        }
        if ok == 1 { return 1; }
        i = i + 1;
    }
    return 0;
}

fn omni_write_file(path: *u8, content: *u8) {
    let fd: i64 = syscall(2, path as u64, 577, 493);
    if fd >= 0 {
        syscall(1, fd as u64, content as u64, omni_slen(content));
        syscall(3, fd as u64);
    }
}

fn omni_run_cmd(a0: *u8, a1: *u8, a2: *u8, a3: *u8, a4: *u8, stdin_str: *u8, out_buf: *mut u8, out_cap: u64, out_len: *mut u64) -> i64 {
    var out_pack: u64 = 0;
    var in_pack: u64 = 0;
    syscall(22, (&mut out_pack) as u64);
    let out_r: u64 = out_pack & 4294967295;
    let out_w: u64 = (out_pack >> 32) & 4294967295;
    var in_r: u64 = 0;
    var in_w: u64 = 0;
    if stdin_str != (0 as *u8) {
        syscall(22, (&mut in_pack) as u64);
        in_r = in_pack & 4294967295;
        in_w = (in_pack >> 32) & 4294967295;
    }

    let pid: i64 = syscall(56, 17, 0, 0, 0, 0);
    if pid == 0 {
        syscall(3, out_r);
        syscall(33, out_w, 1);
        syscall(33, out_w, 2);
        syscall(3, out_w);

        if stdin_str != (0 as *u8) {
            syscall(3, in_w);
            syscall(33, in_r, 0);
            syscall(3, in_r);
        }

        var argv: [u64; 8];
        argv[0] = a0 as u64;
        var ac: u64 = 1;
        if a1 != (0 as *u8) { argv[ac] = a1 as u64; ac = ac + 1; }
        if a2 != (0 as *u8) { argv[ac] = a2 as u64; ac = ac + 1; }
        if a3 != (0 as *u8) { argv[ac] = a3 as u64; ac = ac + 1; }
        if a4 != (0 as *u8) { argv[ac] = a4 as u64; ac = ac + 1; }
        argv[ac] = 0;

        var envp: [u64; 2];
        envp[0] = "PATH=/usr/bin:/bin" as u64;
        envp[1] = 0;
        syscall(59, a0 as u64, (&argv[0]) as u64, (&envp[0]) as u64);
        syscall(60, 127);
    }

    syscall(3, out_w);
    if stdin_str != (0 as *u8) {
        syscall(3, in_r);
        let slen: u64 = omni_slen(stdin_str);
        if slen > 0 {
            syscall(1, in_w, stdin_str as u64, slen);
        }
        syscall(3, in_w);
    }

    var total: u64 = 0;
    var more: u32 = 1;
    while more == 1 && (total + 1) < out_cap {
        let nr: i64 = syscall(0, out_r, (out_buf + total) as u64, (out_cap - 1) - total);
        if nr > 0 {
            total = total + (nr as u64);
        } else {
            more = 0;
        }
    }
    out_buf[total] = 0;
    *out_len = total;
    syscall(3, out_r);

    var wstatus: u64 = 0;
    syscall(61, pid as u64, (&mut wstatus) as u64, 0, 0);
    let ws: u64 = wstatus & 4294967295;
    if (ws & 127) != 0 {
        return (128 + (ws & 127)) as i64;
    }
    return ((ws >> 8) & 255) as i64;
}

fn omni_assert(ok: u32, label: *u8, buf: *u8) {
    if ok == 1 {
        print("[PASS] ");
        println(label);
    } else {
        print("[FAIL] ");
        println(label);
        print("Output: ");
        println(buf);
        syscall(60, 1);
    }
}

