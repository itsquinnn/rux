include "lib/core/types.rx";
include "lib/core/panic.rx";
include "compiler/subsystems/uses/plate_mem.rx";
include "compiler/subsystems/uses/ip_hee.rx";
include "compiler/subsystems/uses/acrq.rx";

fn test_bump_allocation() {
    var storage: [byte; 1024];
    let base_ptr: *mut byte = &mut storage[0];
    let offset: uint = 64;
    let slot: *mut byte = (base_ptr as uint + offset) as *mut byte;

    slot[0] = 0x42 as byte;
    assert(slot[0] == 0x42, "Direct slot write verification failed");
}

fn test_uses_alloc() {
    var plate_buffer: [byte; 2048];
    var pool: UsesBumpPool = UsesBumpPool {
        base: &mut plate_buffer[0],
        head: 0,
        capacity: 2048,
        allocations_count: 0,
    };

    let p1: *mut byte = uses_alloc(&mut pool, 128);
    assert((p1 as uint) > 0, "uses_alloc p1 failed");
    assert(pool.allocations_count == 1, "uses_alloc count mismatch");

    let p2: *mut byte = uses_alloc(&mut pool, 256);
    assert((p2 as uint) > 0, "uses_alloc p2 failed");
    assert(pool.allocations_count == 2, "uses_alloc count mismatch");
    assert((p2 as uint) >= (p1 as uint) + 128, "uses_alloc alignment mismatch");
}

fn test_uses_acrq_ring() {
    var sq_storage: [AcrqSubmissionEntry64; 16];
    var cq_storage: [AcrqCompletionEntry32; 16];
    var dma_scratch: [byte; 512];

    var drv: AcrqActiveDriver = AcrqActiveDriver {
        sq_entries: &mut sq_storage[0],
        cq_entries: &mut cq_storage[0],
        sq_head: 0,
        sq_tail: 0,
        cq_head: 0,
        cq_tail: 0,
        ring_size: 16,
        ring_mask: 15,
        dma_buf: &mut dma_scratch[0],
        dma_buf_size: 512,
        submissions_processed: 0,
        completions_generated: 0,
        bytes_transferred: 0,
        cap_faults: 0,
    };

    var src_buf: [byte; 32];
    src_buf[0] = 0xAA as byte;
    src_buf[1] = 0xBB as byte;
    var dst_buf: [byte; 32];

    var sqe: AcrqSubmissionEntry64 = AcrqSubmissionEntry64 {
        opcode: 1,
        flags: 0,
        capability_tag: 1,
        capability_proof: 1,
        source_addr: (&src_buf[0]) as uint,
        dest_addr: (&dst_buf[0]) as uint,
        length: 32,
        user_tag: 777,
    };

    let submit_res: int = acrq_driver_submit(&mut drv, &sqe);
    assert(submit_res == 0, "acrq_driver_submit failed");

    let processed: uint = acrq_driver_process_entries(&mut drv);
    assert(processed == 1, "acrq_driver_process_entries mismatch");
    assert(dst_buf[0] == 0xAA as byte, "ACRQ DMA byte 0 transfer mismatch");
    assert(dst_buf[1] == 0xBB as byte, "ACRQ DMA byte 1 transfer mismatch");

    var cqe: AcrqCompletionEntry32;
    let poll_ok: bool = acrq_driver_poll_completion(&mut drv, &mut cqe);
    assert(poll_ok, "acrq_driver_poll_completion failed");
    assert(cqe.user_tag == 777, "ACRQ user_tag correlation mismatch");
    assert(cqe.status == 0, "ACRQ status code error");
    assert(cqe.transferred_bytes == 32, "ACRQ transferred bytes mismatch");
}

fn main() -> int {
    test_bump_allocation();
    test_uses_alloc();
    test_uses_acrq_ring();
    return 0;
}
