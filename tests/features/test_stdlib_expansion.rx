include "lib/core/types.rx";
include "lib/core/result.rx";
include "lib/io/traits.rx";
include "lib/net/tls.rx";

fn test_io_traits() {
    var storage: [u8; 128];
    var mem: MemBuffer = MemBuffer::new(&mut storage[0], 128);

    let msg: *u8 = "Hello Rux Sovereign Standard Library";
    let len: u64 = 36;
    let wr: Result = MemBuffer::write(&mut mem, msg, len);
    if res_is_err<u64, int>(&wr) == 1 || wr.val != 36 {
        println("[FAIL] MemBuffer::write failed!");
        sys_exit(1);
    }
    println("[PASS] Write trait implementation confirmed");

    var read_buf: [u8; 64];
    let rr: Result = MemBuffer::read(&mut mem, &mut read_buf[0], 36);
    if res_is_err<u64, int>(&rr) == 1 || rr.val != 36 {
        println("[FAIL] MemBuffer::read failed!");
        sys_exit(1);
    }
    if read_buf[0] != 72 || read_buf[1] != 101 {
        println("[FAIL] Read bytes do not match expected payload!");
        sys_exit(1);
    }
    println("[PASS] Read trait implementation confirmed");

    var bw: BufWriter = BufWriter::new();
    BufWriter::write_byte(&mut bw, 65);
    BufWriter::write_byte(&mut bw, 66);
    if bw.buf_len != 2 || bw.buffer[0] != 65 || bw.buffer[1] != 66 {
        println("[FAIL] BufWriter buffer state incorrect!");
        sys_exit(1);
    }

    var br: BufReader = BufReader::new();
    BufReader::fill_from_buffer(&mut br, &bw.buffer[0], bw.buf_len);
    let b0: int = BufReader::read_byte(&mut br);
    let b1: int = BufReader::read_byte(&mut br);
    let b_eof: int = BufReader::read_byte(&mut br);
    if b0 != 65 || b1 != 66 || b_eof != -1 {
        println("[FAIL] BufReader byte reading failed!");
        sys_exit(1);
    }
    println("[PASS] BufReader and BufWriter buffered I/O confirmed");
}

fn test_tls_substrate() {
    var client: TlsClient = TlsClient::new();
    var ch_buf: [u8; 512];
    let ch_len: u64 = tls_build_client_hello(&mut client, "rux-lang.org", &mut ch_buf[0]);

    if ch_buf[0] != TLS_CONTENT_HANDSHAKE {
        println("[FAIL] Invalid TLS record content type!");
        sys_exit(1);
    }
    if ch_buf[1] != 3 || ch_buf[2] != 1 {
        println("[FAIL] Invalid TLS record legacy version!");
        sys_exit(1);
    }
    if ch_buf[5] != TLS_HANDSHAKE_CLIENT_HELLO {
        println("[FAIL] Handshake message is not ClientHello!");
        sys_exit(1);
    }

    var sh_packet: [u8; 64];
    sh_packet[0] = TLS_CONTENT_HANDSHAKE;
    sh_packet[1] = 3; sh_packet[2] = 3;
    sh_packet[5] = TLS_HANDSHAKE_SERVER_HELLO;
    var i: u64 = 0;
    while i < 32 {
        sh_packet[11 + i] = ((i * 5 + 77) & 255) as u8;
        i = i + 1;
    }

    let parsed: bool = tls_parse_server_hello(&mut client, &sh_packet[0], 64);
    if parsed != true {
        println("[FAIL] Failed to parse valid TLS 1.3 ServerHello!");
        sys_exit(1);
    }
    if client.state != 2 {
        println("[FAIL] TLS client state did not transition to Handshake Established!");
        sys_exit(1);
    }
    println("[PASS] TLS 1.3 ClientHello generation & ServerHello parsing confirmed");
}

fn main() -> int {
    println("=== RUNNING STDLIB EXPANSION (IO TRAITS & TLS 1.3) SUITE ===");
    test_io_traits();
    test_tls_substrate();
    println("=== ALL STDLIB EXPANSION TESTS PASSED (SILICON CONFIRMED) ===");
    return 0;
}
