include "compiler/subsystems/ccns/cap.rx";

fn ccns_invoke_sandboxed(
    token: *mut AegisCapToken,
    offset: uint,
    len: uint,
    is_write: bool,
    data_buf: *mut byte
) -> int {
    let perm: uint = if is_write { 2 } else { 1 };
    if !ccns_cap_validate(token, offset, len, perm) {
        return -1;
    }

    let src_or_dst: *mut byte = (token.base_address + offset) as *mut byte;
    var i: uint = 0;
    while i < len {
        if is_write {
            src_or_dst[i] = data_buf[i];
        } else {
            data_buf[i] = src_or_dst[i];
        }
        i = i + 1;
    }

    return 0;
}
