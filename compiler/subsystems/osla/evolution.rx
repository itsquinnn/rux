struct HebbianCircuit {
    transit_count: uint,
    reinforcement_level: uint,
}

struct PunctuatedDispatch {
    kernel_id: uint,
    stability_generation: uint,
    is_crystallized: bool,
}

fn osla_hebbian_record_transit(circuit: *mut HebbianCircuit) -> uint {
    if (circuit as uint) == 0 {
        return 0;
    }
    if circuit.transit_count < 0xFFFFFFFFFFFFFFFF {
        circuit.transit_count = circuit.transit_count + 1;
    }
    if circuit.reinforcement_level < 1000 {
        var delta: uint = (1000 - circuit.reinforcement_level) / 16;
        if delta == 0 {
            delta = 1;
        }
        circuit.reinforcement_level = circuit.reinforcement_level + delta;
        if circuit.reinforcement_level > 1000 {
            circuit.reinforcement_level = 1000;
        }
    }
    return circuit.reinforcement_level;
}

fn osla_punctuated_dispatch_resolve(pd: *mut PunctuatedDispatch) -> uint {
    if (pd as uint) == 0 || pd.kernel_id == 0 {
        return 0;
    }
    if !pd.is_crystallized && pd.stability_generation > 100 {
        pd.is_crystallized = true;
    }
    return pd.kernel_id;
}
