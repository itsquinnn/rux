struct RpiBumpPool {
    base: *mut byte,
    head: uint,
    capacity: uint,
    allocations_count: uint,
}

fn rpi_bump_alloc(pool: *mut RpiBumpPool, bytes: uint) -> *mut byte {
    let aligned: uint = ((bytes + 7) / 8) * 8;
    if (pool.head + aligned) > pool.capacity {
        return 0 as *mut byte;
    }

    let ptr: *mut byte = (pool.base as uint + pool.head) as *mut byte;
    pool.head = pool.head + aligned;
    pool.allocations_count = pool.allocations_count + 1;
    return ptr;
}
