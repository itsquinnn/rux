fn expand_source_includes(in_path: *u8, src: *u8, src_len: u64, dst: *mut u8, dst_max: u64) -> u64 {
    let state: *mut u64 = uses_alloc(4096) as *mut u64;
    state[0] = 0;
    state[1] = 0;

    var root_norm: [u8; 256];
    var empty_dir: [u8; 2];
    empty_dir[0] = 0;
    let rlen: u64 = normalize_rel_path(&empty_dir[0], in_path, &mut root_norm[0]);
    if rlen > 0 {
        var r_off: [u64; 1];
        let rh: u64 = canonical_path_hash(&root_norm[0], rlen, &mut r_off[0]);
        state[2] = rh;
        state[1] = 1;
    }

    var base_dir: [u8; 256];
    extract_parent_dir(in_path, &mut base_dir[0]);
    expand_include_rec(src, src_len, &base_dir[0], dst, dst_max, state);

    let res: u64 = state[0];
    uses_free(state as *mut u8, 4096);
    return preprocess_directives(dst, res, dst_max);
}
