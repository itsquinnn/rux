include "compiler/subsystems/eia/header.rx";
include "compiler/subsystems/eia/contracts.rx";
include "compiler/subsystems/eia/relocations.rx";
include "compiler/subsystems/eia/type_graph.rx";
include "compiler/subsystems/eia/patcher.rx";

struct ACRQ_SubmissionEntry {
    opcode: u8,
    flags: u8,
    ring_id: u16,
    capability_tag: u32,
    capability_proof: u64,
    source_addr: u64,
    dest_addr: u64,
    length: u32,
    user_data: u32,
    continuation_ip: u64,
}

struct ACRQ_CompletionEntry {
    user_data: u32,
    status: u32,
    transferred_bytes: u64,
    timestamp_ns: u64,
    reserved: u64,
}

struct ACRQ_Ring {
    sq_entries: *mut ACRQ_SubmissionEntry,
    cq_entries: *mut ACRQ_CompletionEntry,
    sq_head: u32,
    sq_tail: u32,
    cq_head: u32,
    cq_tail: u32,
    ring_size: u32,
    ring_mask: u32,
}
