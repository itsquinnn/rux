fn hash_identifier(start: *u8, len: u32) -> u64 {
    var h: u64 = 14695981039346656037;
    var i: u32 = 0;
    while i < len {
        let b: u8 = start[i as u64];
        h = h ^ (b as u64);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}

fn str_eq(s1: *u8, s2: *u8) -> u32 {
    var i: u64 = 0;
    while s1[i] != 0 && s2[i] != 0 {
        if s1[i] != s2[i] { return 0; }
        i = i + 1;
    }
    if s1[i] == s2[i] { return 1; }
    return 0;
}

fn str_starts_with(s: *u8, prefix: *u8, plen: u64) -> u32 {
    var i: u64 = 0;
    while i < plen {
        if s[i] == 0 || s[i] != prefix[i] { return 0; }
        i = i + 1;
    }
    return 1;
}

fn str_len(s: *u8) -> u64 {
    var len: u64 = 0;
    while s[len] != 0 { len = len + 1; }
    return len;
}

fn str_ends_with(s: *u8, suffix: *u8) -> u32 {
    let slen: u64 = str_len(s);
    let sufflen: u64 = str_len(suffix);
    if slen < sufflen { return 0; }
    let offset: u64 = slen - sufflen;
    var i: u64 = 0;
    while i < sufflen {
        let idx: u64 = offset + i;
        if s[idx] != suffix[i] { return 0; }
        i = i + 1;
    }
    return 1;
}

fn is_digit(c: u8) -> u32 {
    if c >= 48 && c <= 57 { return 1; }
    return 0;
}

fn is_alpha(c: u8) -> u32 {
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 { return 1; }
    return 0;
}

fn is_alnum(c: u8) -> u32 {
    if is_alpha(c) == 1 || is_digit(c) == 1 { return 1; }
    return 0;
}

