fn parse_type_alias(p: *mut Parser) {
    parser_expect(p, 80);
    let alias_kind: u32 = p.cur_tok.kind as u32;
    let alias_hash: u64 = p.cur_tok.hash;
    lex_next_token(p.lex, &mut p.cur_tok);
    parser_expect(p, 40);
    var ptr_depth: u64 = 0;
    while p.cur_tok.kind == 32 || p.cur_tok.kind == 50 || p.cur_tok.kind == 13 || p.cur_tok.kind == 12 || p.cur_tok.kind == 124 {
        if p.cur_tok.kind == 32 || p.cur_tok.kind == 50 { ptr_depth = ptr_depth + 1; }
        lex_next_token(p.lex, &mut p.cur_tok);
    }
    var target_kind: u64 = p.cur_tok.kind;
    var target_hash: u64 = p.cur_tok.hash;
    lex_next_token(p.lex, &mut p.cur_tok);
    if target_kind == 1 {
        let ex: *mut ConstEntry = parser_find_alias(p, target_hash);
        if ex != (0 as *mut ConstEntry) {
            if ptr_depth == 0 {
                target_hash = ex.val;
                target_kind = ex.extra;
            }
        }
    }
    if target_kind == 138 && ptr_depth == 0 {
        ptr_depth = 1;
        target_hash = 631772817358541784;
        target_kind = 23;
    }
    if ptr_depth > 0 {
        var pk: u64 = 1002;
        if target_kind == 1 && parser_find_known_struct(p, target_hash) != (0 as *mut ConstEntry) {
            pk = 1001;
        }
        if ptr_depth > 1 { pk = 1011; }
        target_kind = pk;
    }
    if alias_kind == 1 && alias_hash != target_hash {
        parser_add_alias(p, alias_hash, target_hash, target_kind);
    }
    consume_optional_semi(p);
}

fn parse_enum(p: *mut Parser) {
    parser_expect(p, 81);
    let enum_hash: u64 = p.cur_tok.hash;
    parser_expect_ident(p);
    if p.cur_tok.kind == 70 {
        parser_expect(p, 70);
        lex_next_token(p.lex, &mut p.cur_tok);
    }
    parser_add_const(p, enum_hash, 0, 777);
    parser_add_alias(p, enum_hash, 5563585020063213298, 20);

    parser_expect(p, 62);
    var next_val: u64 = 0;
    while p.cur_tok.kind != 63 && p.cur_tok.kind != 0 {
        let v_hash: u64 = p.cur_tok.hash;
        parser_expect_ident(p);
        if p.cur_tok.kind == 40 {
            parser_expect(p, 40);
            let v_expr: *mut AstNode = parse_expr(p);
            next_val = eval_const_ast(p, v_expr);
        }
        let scoped_h: u64 = combine_ns_hash(enum_hash, v_hash);
        parser_add_const(p, scoped_h, next_val, 1);
        next_val = next_val + 1;
        if p.cur_tok.kind == 72 || p.cur_tok.kind == 71 {
            lex_next_token(p.lex, &mut p.cur_tok);
        }
    }
    parser_expect(p, 63);
    consume_optional_semi(p);
}

fn parse_top_const(p: *mut Parser) {
    lex_next_token(p.lex, &mut p.cur_tok);
    if p.cur_tok.kind == 13 { lex_next_token(p.lex, &mut p.cur_tok); }
    let cname_hash: u64 = p.cur_tok.hash;
    var is_signed_c: u64 = 0;
    parser_expect_ident(p);
    if p.cur_tok.kind == 70 {
        parser_expect(p, 70);
        while p.cur_tok.kind == 32 || p.cur_tok.kind == 50 || p.cur_tok.kind == 13 || p.cur_tok.kind == 12 || p.cur_tok.kind == 124 {
            lex_next_token(p.lex, &mut p.cur_tok);
        }
        if is_signed_type_hash(p.cur_tok.kind as u32, p.cur_tok.hash) == 1 {
            is_signed_c = 3;
        }
        lex_next_token(p.lex, &mut p.cur_tok);
    }
    if p.cur_tok.kind == 40 || p.cur_tok.kind == 77 {
        lex_next_token(p.lex, &mut p.cur_tok);
        let cexpr: *mut AstNode = parse_expr(p);
        var is_str_c: u32 = 0;
        if cexpr != (0 as *mut AstNode) {
            if is_const_evaluatable(p, cexpr) == 0 {
                diag_syntax_unexpected_tok(p, "const initializer must be a compile-time constant expression");
            }
            if cexpr.kind == 118 {
                is_str_c = 1;
            }
        }
        if is_str_c == 1 {
            let cextra: u64 = (cexpr.val << 32) | 2;
            parser_add_const(p, cname_hash, cexpr.hash, cextra);
        } else {
            let cval: u64 = eval_const_ast(p, cexpr);
            if cexpr != (0 as *mut AstNode) {
                if cexpr.is_mut == 1 {
                    is_signed_c = 3;
                }
            }
            parser_add_const(p, cname_hash, cval, is_signed_c);
        }
    } else {
        diag_syntax_unexpected_tok(p, "const declaration must have an initializer");
    }
    consume_optional_semi(p);
}

fn parse_struct(p: *mut Parser) -> *mut AstNode {
    let snode: *mut AstNode = alloc_node(p, 100);
    if p.cur_tok.kind == 109 {
        snode.val = 1;
        parser_expect(p, 109);
    } else if p.cur_tok.kind == 110 {
        snode.val = 2;
        parser_expect(p, 110);
        if p.cur_tok.kind == 10 { parser_expect(p, 10); }
    } else {
        parser_expect(p, 10);
    }
    snode.hash = p.cur_tok.hash;
    let s_name_hash: u64 = snode.hash;
    parser_expect_ident(p);

    if p.cur_tok.kind == 43 {
        parser_expect(p, 43);
        var gs: GenericStruct;
        gs.name_hash = s_name_hash;
        gs.param_count = 0;
        gs.param0_hash = 0;
        gs.param1_hash = 0;
        gs.param2_hash = 0;
        gs.param3_hash = 0;
        gs.field_count = 0;

        while p.cur_tok.kind != 44 && p.cur_tok.kind != 0 {
            if gs.param_count == 0 { gs.param0_hash = p.cur_tok.hash; }
            else if gs.param_count == 1 { gs.param1_hash = p.cur_tok.hash; }
            else if gs.param_count == 2 { gs.param2_hash = p.cur_tok.hash; }
            else if gs.param_count == 3 { gs.param3_hash = p.cur_tok.hash; }
            gs.param_count = gs.param_count + 1;
            parser_expect_ident(p);
            if p.cur_tok.kind == 72 { parser_expect(p, 72); }
        }
        parser_expect(p, 44);
        parser_expect(p, 62);

        while p.cur_tok.kind != 63 && p.cur_tok.kind != 0 {
            let f_name_h: u64 = p.cur_tok.hash;
            parser_expect_ident(p);
            parser_expect(p, 70);

            var f_ptr: u64 = 0;
            while p.cur_tok.kind == 32 || p.cur_tok.kind == 50 || p.cur_tok.kind == 13 || p.cur_tok.kind == 12 || p.cur_tok.kind == 124 {
                if p.cur_tok.kind == 32 || p.cur_tok.kind == 50 { f_ptr = 1; }
                lex_next_token(p.lex, &mut p.cur_tok);
            }

            let f_type_h: u64 = p.cur_tok.hash;
            var t_kind: u64 = 0;
            if f_type_h == gs.param0_hash { t_kind = 1; }
            else if gs.param_count > 1 && f_type_h == gs.param1_hash { t_kind = 2; }
            else if gs.param_count > 2 && f_type_h == gs.param2_hash { t_kind = 3; }
            else if gs.param_count > 3 && f_type_h == gs.param3_hash { t_kind = 4; }

            lex_next_token(p.lex, &mut p.cur_tok);

            if gs.field_count < 16 {
                let gf: *mut GenericField = ((&mut gs as *mut u8) + 56 + (gs.field_count * 40)) as *mut GenericField;
                gf.name_hash = f_name_h;
                gf.type_kind = t_kind;
                gf.concrete_hash = f_type_h;
                gf.is_ptr = f_ptr;
                gf.arr_len = 0;
                gs.field_count = gs.field_count + 1;
            }

            if p.cur_tok.kind == 72 || p.cur_tok.kind == 71 {
                lex_next_token(p.lex, &mut p.cur_tok);
            }
        }
        parser_expect(p, 63);
        consume_optional_semi(p);
        register_generic_struct(p, &mut gs);
        return 0 as *mut AstNode;
    }

    if p.cur_tok.kind == 71 || p.cur_tok.kind == 0 || p.cur_tok.kind == 10 || p.cur_tok.kind == 11 || p.cur_tok.kind == 12 {
        consume_optional_semi(p);
        snode.val = 8;
        parser_register_struct(p, s_name_hash, 8);
        p.struct_count = p.struct_count + 1;
        return snode;
    }
    if p.cur_tok.kind == 60 {
        parser_expect(p, 60);
        var tup_sz: u64 = 0;
        var field_idx: u64 = 0;
        var last_tf: *mut AstNode = 0 as *mut AstNode;
        while p.cur_tok.kind != 61 && p.cur_tok.kind != 0 {
            let tf: *mut AstNode = alloc_node(p, 101);
            tf.hash = s_name_hash + 1000 + field_idx;
            tf.id = tup_sz;
            var tf_ptr: u32 = 0;
            while p.cur_tok.kind == 32 || p.cur_tok.kind == 50 || p.cur_tok.kind == 13 || p.cur_tok.kind == 12 || p.cur_tok.kind == 124 {
                if p.cur_tok.kind == 32 || p.cur_tok.kind == 50 { tf_ptr = 1; }
                lex_next_token(p.lex, &mut p.cur_tok);
            }
            let tk: u32 = p.cur_tok.kind as u32;
            let th: u64 = p.cur_tok.hash;
            lex_next_token(p.lex, &mut p.cur_tok);
            var fsz: u64 = 8;
            if tf_ptr == 0 {
                fsz = type_prim_size_from_tok(tk, th);
            }
            tf.val = fsz;
            if last_tf == (0 as *mut AstNode) { snode.child1 = tf; }
            else { last_tf.next = tf; }
            last_tf = tf;
            tup_sz = tup_sz + fsz;
            field_idx = field_idx + 1;
            if p.cur_tok.kind == 72 { parser_expect(p, 72); }
        }
        parser_expect(p, 61);
        consume_optional_semi(p);
        if tup_sz == 0 { tup_sz = 8; }
        snode.val = tup_sz;
        parser_register_struct(p, s_name_hash, tup_sz);
        p.struct_count = p.struct_count + 1;
        return snode;
    }

    parser_expect(p, 62);

    var cur_off: u64 = 0;
    var max_align: u64 = 1;
    var last_f: *mut AstNode = 0 as *mut AstNode;
    while p.cur_tok.kind != 63 && p.cur_tok.kind != 0 {
        let fnode: *mut AstNode = alloc_node(p, 101);
        fnode.hash = p.cur_tok.hash;
        parser_expect_ident(p);
        parser_expect(p, 70);

        var f_size: u64 = 8;
        var f_align: u64 = 8;

        if p.cur_tok.kind == 64 {
            parser_expect(p, 64);
            var e_ptr: u32 = 0;
            while p.cur_tok.kind == 32 || p.cur_tok.kind == 50 || p.cur_tok.kind == 13 || p.cur_tok.kind == 12 || p.cur_tok.kind == 124 {
                if p.cur_tok.kind == 32 || p.cur_tok.kind == 50 { e_ptr = 1; }
                lex_next_token(p.lex, &mut p.cur_tok);
            }
            var ek: u32 = p.cur_tok.kind as u32;
            var eh: u64 = p.cur_tok.hash;
            if p.cur_tok.kind != 71 && p.cur_tok.kind != 0 {
                lex_next_token(p.lex, &mut p.cur_tok);
            }
            while p.cur_tok.kind != 71 && p.cur_tok.kind != 0 {
                lex_next_token(p.lex, &mut p.cur_tok);
            }
            parser_expect(p, 71);
            var acnt: u64 = 0;
            if p.cur_tok.kind == 2 {
                acnt = p.cur_tok.int_val;
                lex_next_token(p.lex, &mut p.cur_tok);
            } else {
                let ace2: *mut ConstEntry = parser_find_const(p, p.cur_tok.hash);
                if ace2 != (0 as *mut ConstEntry) { acnt = ace2.val; }
                lex_next_token(p.lex, &mut p.cur_tok);
            }
            parser_expect(p, 65);

            var esz: u64 = 8;
            if e_ptr == 0 {
                if ek == 1 {
                    let eal2: *mut ConstEntry = parser_find_alias(p, eh);
                    if eal2 != (0 as *mut ConstEntry) {
                        if eal2.extra < 1000 {
                            eh = eal2.val;
                            ek = eal2.extra as u32;
                        }
                    }
                }
                if ek == 1 {
                    let eks2: *mut ConstEntry = parser_find_known_struct(p, eh);
                    if eks2 != (0 as *mut ConstEntry) {
                        esz = eks2.val;
                        fnode.child1 = eh as *mut AstNode;
                    } else {
                        esz = 8;
                    }
                } else {
                    esz = type_prim_size_from_tok(ek, eh);
                }
            }
            var ealgn: u64 = 8;
            if esz == 1 { ealgn = 1; }
            else if esz == 2 { ealgn = 2; }
            else if esz == 4 { ealgn = 4; }
            var sgn_bias: u64 = 0;
            if e_ptr == 0 && is_signed_type_hash(ek, eh) == 1 {
                sgn_bias = 50;
            }
            fnode.is_mut = 100 + sgn_bias + ealgn;
            fnode.val = acnt * esz;
            fnode.id = esz;
            f_size = acnt * esz;
            f_align = ealgn;
        } else if p.cur_tok.kind == 11 {
            lex_next_token(p.lex, &mut p.cur_tok);
            if p.cur_tok.kind == 60 {
                parser_expect(p, 60);
                var fpd: u32 = 1;
                while fpd > 0 && p.cur_tok.kind != 0 {
                    if p.cur_tok.kind == 60 { fpd = fpd + 1; }
                    else if p.cur_tok.kind == 61 { fpd = fpd - 1; }
                    lex_next_token(p.lex, &mut p.cur_tok);
                }
            }
            if p.cur_tok.kind == 74 {
                parser_expect(p, 74);
                while p.cur_tok.kind == 32 || p.cur_tok.kind == 50 || p.cur_tok.kind == 13 || p.cur_tok.kind == 12 || p.cur_tok.kind == 124 {
                    lex_next_token(p.lex, &mut p.cur_tok);
                }
                lex_next_token(p.lex, &mut p.cur_tok);
            }
            fnode.id = 0;
            fnode.val = 20;
            fnode.is_mut = 1;
            f_size = 8;
            f_align = 8;
        } else {
            var is_ptr: u32 = 0;
            var stars: u32 = 0;
            while p.cur_tok.kind == 50 || p.cur_tok.kind == 32 || p.cur_tok.kind == 13 || p.cur_tok.kind == 12 || p.cur_tok.kind == 124 || p.cur_tok.kind == 99 || p.cur_tok.kind == 53 || p.cur_tok.kind == 104 {
                if p.cur_tok.kind == 50 || p.cur_tok.kind == 32 {
                    stars = stars + 1;
                    if stars == 1 { is_ptr = 1; } else { is_ptr = 11; }
                }
                lex_next_token(p.lex, &mut p.cur_tok);
            }
            var fk: u64 = p.cur_tok.kind;
            var fh: u64 = p.cur_tok.hash;
            lex_next_token(p.lex, &mut p.cur_tok);

            if p.cur_tok.kind == 43 {
                parser_expect(p, 43);
                let g_arg0: u64 = parse_type_arg_hash(p);
                var g_arg1: u64 = 0;
                if p.cur_tok.kind == 72 {
                    parser_expect(p, 72);
                    g_arg1 = parse_type_arg_hash(p);
                }
                parser_expect(p, 44);
                if p.cg != (0 as *mut u8) {
                    fh = instantiate_generic_struct(p, p.cg as *mut CodeGen, fh, g_arg0, g_arg1);
                    fk = 1;
                }
            } else if is_generic_struct(p, fh) == 1 && p.cg != (0 as *mut u8) {
                let gs_fh: *mut GenericStruct = find_generic_struct(p, fh);
                if gs_fh != (0 as *mut GenericStruct) {
                    if gs_fh.param_count == 1 {
                        fh = instantiate_generic_struct(p, p.cg as *mut CodeGen, fh, 5563585020063213298, 0);
                    } else if gs_fh.param_count == 2 {
                        fh = instantiate_generic_struct(p, p.cg as *mut CodeGen, fh, 5563585020063213298, 3089943341986682694);
                    }
                    fk = 1;
                }
            }

            if fk == 1 {
                let fal: *mut ConstEntry = parser_find_alias(p, fh);
                if fal != (0 as *mut ConstEntry) {
                    if fal.extra >= 1000 && is_ptr == 0 {
                        is_ptr = (fal.extra - 1000) as u32;
                        fh = fal.val;
                        fk = 20;
                    } else if fal.extra < 1000 {
                        fh = fal.val;
                        fk = fal.extra;
                    }
                }
            }
            if fk == 138 && is_ptr == 0 {
                is_ptr = 2;
                fh = 631772817358541784;
                fk = 23;
            }
            if is_ptr > 0 && is_ptr < 11 {
                if fk == 1 {
                    is_ptr = 1;
                } else {
                    is_ptr = 2;
                }
            }
            fnode.id = fh;
            fnode.val = fk;
            fnode.is_mut = is_ptr as u64;

            if is_ptr > 0 {
                f_size = 8;
                f_align = 8;
            } else if fk == 1 {
                let fks: *mut ConstEntry = parser_find_known_struct(p, fh);
                if fks != (0 as *mut ConstEntry) { f_size = fks.val; } else { f_size = 24; }
                f_align = 8;
            } else {
                f_size = type_prim_size_from_tok(fk as u32, fh);
                f_align = f_size;
            }
            if p.cur_tok.kind == 70 {
                parser_expect(p, 70);
                lex_next_token(p.lex, &mut p.cur_tok);
            }
        }

        if snode.val == 2 { f_align = 1; }
        if f_align > max_align { max_align = f_align; }
        if snode.val == 1 {
            if f_size > cur_off { cur_off = f_size; }
        } else {
            let rem: u64 = cur_off % f_align;
            if rem != 0 { cur_off = cur_off + (f_align - rem); }
            cur_off = cur_off + f_size;
        }

        if p.cur_tok.kind == 72 || p.cur_tok.kind == 71 {
            lex_next_token(p.lex, &mut p.cur_tok);
        }
        if last_f == (0 as *mut AstNode) {
            snode.child1 = fnode;
        } else {
            last_f.next = fnode;
        }
        last_f = fnode;
    }

    if snode.val != 2 {
        let rem_end: u64 = cur_off % max_align;
        if rem_end != 0 { cur_off = cur_off + (max_align - rem_end); }
    }
    if cur_off == 0 { cur_off = 8; }

    parser_expect(p, 63);
    consume_optional_semi(p);
    parser_register_struct(p, snode.hash, cur_off);
    p.struct_count = p.struct_count + 1;
    return snode;
}

fn parse_fn(p: *mut Parser, calling_conv: u32) -> *mut AstNode {
    var fn_flags: u64 = 0;
    while p.cur_tok.kind == 90 || p.cur_tok.kind == 106 || p.cur_tok.kind == 102 || p.cur_tok.kind == 92 || p.cur_tok.kind == 142 || p.cur_tok.kind == 124 || p.cur_tok.kind == 56 || p.cur_tok.kind == 55 {
        if p.cur_tok.kind == 102 { fn_flags = fn_flags | 1; }
        else if p.cur_tok.kind == 92 { fn_flags = fn_flags | 2; }
        else if p.cur_tok.kind == 124 { fn_flags = fn_flags | 4; }
        else if p.cur_tok.kind == 142 { fn_flags = fn_flags | 8; }
        else if p.cur_tok.kind == 56 {
            lex_next_token(p.lex, &mut p.cur_tok);
            if p.cur_tok.kind != 0 && p.cur_tok.kind != 11 { lex_next_token(p.lex, &mut p.cur_tok); }
            continue;
        } else if p.cur_tok.kind == 55 {
            lex_next_token(p.lex, &mut p.cur_tok);
            if p.cur_tok.kind == 64 {
                while p.cur_tok.kind != 65 && p.cur_tok.kind != 0 { lex_next_token(p.lex, &mut p.cur_tok); }
                if p.cur_tok.kind == 65 { lex_next_token(p.lex, &mut p.cur_tok); }
            }
            continue;
        }
        lex_next_token(p.lex, &mut p.cur_tok);
    }
    let fnode: *mut AstNode = alloc_node(p, 102);
    fnode.id = calling_conv as u64;
    parser_expect(p, 11);
    let fn_nm_start: *u8 = p.cur_tok.start;
    var fn_nm_end: *u8 = p.cur_tok.start + p.cur_tok.len;
    fnode.hash = p.cur_tok.hash;
    parser_expect_ident(p);
    while p.cur_tok.kind == 78 {
        parser_expect(p, 78);
        fnode.hash = combine_ns_hash(fnode.hash, p.cur_tok.hash);
        fn_nm_end = p.cur_tok.start + p.cur_tok.len;
        parser_expect_ident(p);
    }
    let fn_nm_meta: *mut AstNode = alloc_node(p, 199);
    fn_nm_meta.hash = fn_nm_start as u64;
    fn_nm_meta.val = (fn_nm_end as u64) - (fn_nm_start as u64);
    fnode.child3 = fn_nm_meta;

    var is_gen_fn: u32 = 0;
    var gf_p0: u64 = 0;
    var gf_p1: u64 = 0;
    var gf_b0: u64 = 0;
    var gf_b1: u64 = 0;
    var gf_param_cnt: u64 = 0;
    if p.cur_tok.kind == 43 {
        parser_expect(p, 43);
        gf_p0 = p.cur_tok.hash;
        gf_param_cnt = 1;
        parser_expect_ident(p);
        if p.cur_tok.kind == 70 { parser_expect(p, 70); gf_b0 = p.cur_tok.hash; parser_expect_ident(p); }
        if p.cur_tok.kind == 72 {
            parser_expect(p, 72);
            gf_p1 = p.cur_tok.hash;
            gf_param_cnt = 2;
            parser_expect_ident(p);
            if p.cur_tok.kind == 70 { parser_expect(p, 70); gf_b1 = p.cur_tok.hash; parser_expect_ident(p); }
        }
        parser_expect(p, 44);
        is_gen_fn = 1;
    }

    parser_expect(p, 60);

    var last_param: *mut AstNode = 0 as *mut AstNode;
    var p_cnt_fn: u32 = 0;
    while p.cur_tok.kind != 61 && p.cur_tok.kind != 0 {
        if p.cur_tok.kind == 113 {
            parser_expect(p, 113);
            while p_cnt_fn < 6 {
                let vnode: *mut AstNode = alloc_node(p, 101);
                vnode.hash = 999999000 + (p_cnt_fn as u64);
                vnode.val = 5563585020063213298;
                vnode.is_mut = 0;
                if last_param == (0 as *mut AstNode) { fnode.child2 = vnode; } else { last_param.next = vnode; }
                last_param = vnode;
                p_cnt_fn = p_cnt_fn + 1;
            }
            break;
        }
        let pnode: *mut AstNode = alloc_node(p, 101);
        if p.cur_tok.kind == 13 { lex_next_token(p.lex, &mut p.cur_tok); }
        pnode.hash = p.cur_tok.hash;
        parser_expect_ident(p);
        parser_expect(p, 70);

        if p.cur_tok.kind == 11 {
            lex_next_token(p.lex, &mut p.cur_tok);
            if p.cur_tok.kind == 60 {
                parser_expect(p, 60);
                var ppd: u32 = 1;
                while ppd > 0 && p.cur_tok.kind != 0 {
                    if p.cur_tok.kind == 60 { ppd = ppd + 1; }
                    else if p.cur_tok.kind == 61 { ppd = ppd - 1; }
                    lex_next_token(p.lex, &mut p.cur_tok);
                }
            }
