fn compile_stmt(cg: *mut CodeGen, stmt: *mut AstNode) {
    if stmt == (0 as *mut AstNode) || stmt.kind == 0 { return; }

    if stmt.kind == 105 {
        let var_hash: u64 = stmt.hash;
        var var_size: u64 = 8;
        var is_ptr: u64 = 0;
        if stmt.id == 1 { is_ptr = 1; }
        if stmt.id == 2 { is_ptr = 2; }
        var is_val: u64 = 0;
        if stmt.id == 3 { is_val = 1; }
        if stmt.id == 0 && stmt.is_mut == 1 { is_val = 2; }
        if stmt.id == 10 || stmt.id == 11 {
            is_val = 1;
            is_ptr = stmt.id;
            var_size = stmt.val;
        }
        var s_hash: u64 = 0;
        if stmt.id == 12 {
            is_val = 1;
            is_ptr = 100 + stmt.is_mut;
            var_size = stmt.val;
            s_hash = stmt.child3 as u64;
        }

        if stmt.id == 0 && stmt.child1 != (0 as *mut AstNode) {
            if stmt.child1.kind == 113 {
                let frs: *mut ConstEntry = cg_find_fn_ret_struct(cg, stmt.child1.hash);
                if frs != (0 as *mut ConstEntry) {
                    is_val = 1;
                    s_hash = frs.val;
                    var_size = frs.extra;
                } else if cg_is_fn_signed_ret(cg, stmt.child1.hash) == 1 {
                    is_val = 2;
                }
            } else if cg_is_string_expr(cg, stmt.child1) == 1 {
                is_ptr = 2;
                s_hash = 23;
                is_val = 0;
            }
        }

        if is_val == 1 && stmt.id == 3 {
            s_hash = stmt.val;
            let si: *mut StructInfo = cg_find_struct(cg, s_hash);
            if si != (0 as *mut StructInfo) {
                var_size = si.total_size;
            } else {
                var_size = 24;
            }
        } else if is_ptr == 1 || is_ptr == 2 {
            if s_hash == 0 { s_hash = stmt.val; }
            var_size = 8;
        }

        let aligned_size: u64 = ((var_size + 7) / 8) * 8;
        cg.current_stack_offset = cg.current_stack_offset + aligned_size;

        let lv: *mut LocalVar = ((cg.locals as *mut u8) + ((cg.local_count as u64) * 48)) as *mut LocalVar;
        lv.name_hash = var_hash;
        lv.rbp_offset = cg.current_stack_offset;
        lv.size = var_size;
        lv.is_struct_ptr = is_ptr;
        lv.is_struct_val = is_val;
        lv.struct_hash = s_hash;
        if cg.local_muts != (0 as *mut u8) && cg.local_count < 65536 {
            let is_decl_mut: u64 = stmt.child2 as u64;
            var init_flag: u8 = 0;
            if is_decl_mut == 1 { init_flag = 1; }
            else if is_decl_mut == 2 { init_flag = 2; }
            else if stmt.child1 == (0 as *mut AstNode) { init_flag = 3; }
            cg.local_muts[cg.local_count] = init_flag;
        }
        cg.local_count = cg.local_count + 1;

        if stmt.child1 != (0 as *mut AstNode) {
            if stmt.child1.kind == 121 && (is_ptr == 10 || is_ptr == 11 || is_ptr >= 100) {
                var el_sz: u32 = 8;
                if is_ptr == 10 { el_sz = 1; }
                else if is_ptr >= 100 { el_sz = (is_ptr - 100) as u32; }
                if stmt.child1.id == 1 {
                    compile_expr(cg, stmt.child1.child1);
                    let cnt_val: u64 = stmt.child1.child2.val;
                    var r_idx: u32 = 0;
                    while (r_idx as u64) < cnt_val {
                        let rel_off: u32 = (lv.rbp_offset as u32) - (r_idx * el_sz);
                        if el_sz == 1 {
                            cg_emit8(cg, 136); cg_emit8(cg, 133); cg_emit32(cg, 0 - rel_off);
                        } else if el_sz == 2 {
                            cg_emit8(cg, 102); cg_emit8(cg, 137); cg_emit8(cg, 133); cg_emit32(cg, 0 - rel_off);
                        } else if el_sz == 4 {
                            cg_emit8(cg, 137); cg_emit8(cg, 133); cg_emit32(cg, 0 - rel_off);
                        } else {
                            cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 133); cg_emit32(cg, 0 - rel_off);
                        }
                        r_idx = r_idx + 1;
                    }
                    return;
                }
                var cur_el: *mut AstNode = stmt.child1.child1;
                var el_idx: u32 = 0;
                while cur_el != (0 as *mut AstNode) {
                    compile_expr(cg, cur_el);
                    let el_off: u32 = (lv.rbp_offset as u32) - (el_idx * el_sz);
                    if el_sz == 1 {
                        cg_emit8(cg, 136); cg_emit8(cg, 133); cg_emit32(cg, 0 - el_off);
                    } else if el_sz == 2 {
                        cg_emit8(cg, 102); cg_emit8(cg, 137); cg_emit8(cg, 133); cg_emit32(cg, 0 - el_off);
                    } else if el_sz == 4 {
                        cg_emit8(cg, 137); cg_emit8(cg, 133); cg_emit32(cg, 0 - el_off);
                    } else {
                        cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 133); cg_emit32(cg, 0 - el_off);
                    }
                    el_idx = el_idx + 1;
                    cur_el = cur_el.next;
                }
                return;
            }
            compile_expr(cg, stmt.child1);
            if is_val == 1 && is_ptr == 0 {
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 198);
                cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 189);
                cg_emit32(cg, 0 - (lv.rbp_offset as u32));
                cg_emit8(cg, 185); cg_emit32(cg, var_size as u32);
                cg_emit8(cg, 252); cg_emit8(cg, 243); cg_emit8(cg, 164);
            } else {
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 133);
                cg_emit32(cg, 0 - (lv.rbp_offset as u32));
                if cg.has_lambdas == 1 {
                    let uoff: u32 = cg_get_or_add_upvalue(cg, var_hash);
                    cg_emit_store_upvalue(cg, uoff);
                }
            }
        }
        return;
    }

    if stmt.kind == 106 {
        let lhs: *mut AstNode = stmt.child1;
        let rhs: *mut AstNode = stmt.child2;

        if lhs.kind == 112 && lhs.val == 32 {
            compile_expr(cg, lhs.child1);
            cg_emit8(cg, 80);
            compile_expr(cg, rhs);
            cg_emit8(cg, 95);

            if cg_is_struct_elem_array(cg, lhs.child1) == 1 {
                let dsh: u64 = cg_infer_expr_struct_hash(cg, lhs.child1);
                let dsi: *mut StructInfo = cg_find_struct(cg, dsh);
                var dsz: u32 = 24;
                if dsi != (0 as *mut StructInfo) { dsz = dsi.total_size as u32; }
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 198);
                cg_emit8(cg, 185); cg_emit32(cg, dsz);
                cg_emit8(cg, 252); cg_emit8(cg, 243); cg_emit8(cg, 164);
                return;
            }
            let pstride: u64 = cg_get_expr_elem_stride(cg, lhs.child1);
            if pstride == 1 {
                cg_emit8(cg, 136); cg_emit8(cg, 7);
            } else if pstride == 2 {
                cg_emit8(cg, 102); cg_emit8(cg, 137); cg_emit8(cg, 7);
            } else if pstride == 4 {
                cg_emit8(cg, 137); cg_emit8(cg, 7);
            } else {
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 7);
            }
            return;
        }

        if lhs.kind == 115 {
            if lhs.child1.kind == 117 && lhs.child2.kind == 116 {
                let lv_chk2: *mut LocalVar = cg_find_local(cg, lhs.child1.hash);
                if lv_chk2 != (0 as *mut LocalVar) && lv_chk2.is_struct_val == 1 && (lv_chk2.is_struct_ptr == 10 || lv_chk2.is_struct_ptr == 11 || lv_chk2.is_struct_ptr >= 100) {
                    let s_stride: u64 = cg_get_expr_elem_stride(cg, lhs.child1);
                    if s_stride > 0 && lv_chk2.size > 0 && (lhs.child2.val * s_stride) >= lv_chk2.size {
                        diag_report_packed_error(cg, lhs.child1.val, "RangeError", ": Array index out of bounds");
                    }
                }
            }
            compile_expr(cg, lhs.child1);
            cg_emit8(cg, 80);
            compile_expr(cg, lhs.child2);
            cg_emit8(cg, 91);

            let stride2: u64 = cg_get_expr_elem_stride(cg, lhs.child1);
            rt_guard_emit_bounds_check(cg, lhs.child1, stride2);
            cg_emit_scale_index(cg, stride2);
            cg_emit8(cg, 83);
            compile_expr(cg, rhs);
            cg_emit8(cg, 91);

            if cg_is_struct_elem_array(cg, lhs.child1) == 1 {
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 223);
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 198);
                cg_emit8(cg, 185); cg_emit32(cg, stride2 as u32);
                cg_emit8(cg, 252); cg_emit8(cg, 243); cg_emit8(cg, 164);
                return;
            }
            if stride2 == 1 {
                cg_emit8(cg, 136); cg_emit8(cg, 3);
            } else if stride2 == 2 {
                cg_emit8(cg, 102); cg_emit8(cg, 137); cg_emit8(cg, 3);
            } else if stride2 == 4 {
                cg_emit8(cg, 137); cg_emit8(cg, 3);
            } else {
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 3);
            }
            return;
        }

        if lhs.kind == 114 {
            let base: *mut AstNode = lhs.child1;
            if base != (0 as *mut AstNode) && base.kind == 117 && cg.local_muts != (0 as *mut u8) {
                let base_idx: u64 = cg_find_local_index(cg, base.hash);
                if base_idx != 18446744073709551615 {
                    let lv_b: *mut LocalVar = ((cg.locals as *mut u8) + (base_idx * 48)) as *mut LocalVar;
                    if lv_b.is_struct_val == 1 && lv_b.is_struct_ptr == 0 {
                        let bmflag: u8 = cg.local_muts[base_idx];
                        if bmflag == 0 || bmflag == 2 {
                            diag_report_packed_error(cg, base.val, "TypeError", ": Cannot assign to field of immutable variable (declared with 'let')");
                            return;
                        }
                    }
                }
            }
            var s_hash: u64 = cg_infer_expr_struct_hash(cg, base);
            if s_hash == 0 {
                var ti_f2: u32 = 0;
                while ti_f2 < (cg.tg_count as u32) && s_hash == 0 {
                    let tge_f2: *mut EiaTypeGraphEntry = ((cg.type_graph as *mut u8) + ((ti_f2 as u64) * 24)) as *mut EiaTypeGraphEntry;
                    if tge_f2.field_hash == lhs.hash {
                        s_hash = tge_f2.type_sig_hash;
                    }
                    ti_f2 = ti_f2 + 1;
                }
            }
            if s_hash == 0 && cg.struct_count > 0 {
                let first_s: *mut StructInfo = cg.structs;
                s_hash = first_s.type_sig_hash;
            }

            compile_expr(cg, base);
            cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 198);

            let disp: u32 = cg_lookup_field_offset(cg, s_hash, lhs.hash);
            cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 190);
            let hole_offset: u32 = cg.text_size;
            cg_emit32(cg, disp);
            cg_add_reloc(cg, hole_offset, s_hash, lhs.hash);

            cg_emit8(cg, 87);
            compile_expr(cg, rhs);
            cg_emit8(cg, 95);

            let fm_a: *mut FieldMeta = cg_find_field_meta(cg, s_hash, lhs.hash);
            var is_sub_a: u32 = 0;
            if fm_a != (0 as *mut FieldMeta) {
                if (fm_a.flags & 512) != 0 {
                    is_sub_a = 1;
                }
            }
            if is_sub_a == 1 {
                let copy_sz: u32 = (fm_a.flags >> 32) as u32;
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 198);
                cg_emit8(cg, 185); cg_emit32(cg, copy_sz);
                cg_emit8(cg, 252); cg_emit8(cg, 243); cg_emit8(cg, 164);
                return;
            }
            var f_sz_a: u64 = 8;
            if fm_a != (0 as *mut FieldMeta) { f_sz_a = fm_a.flags & 255; }
            if f_sz_a == 1 {
                cg_emit8(cg, 136); cg_emit8(cg, 7);
            } else if f_sz_a == 2 {
                cg_emit8(cg, 102); cg_emit8(cg, 137); cg_emit8(cg, 7);
            } else if f_sz_a == 4 {
                cg_emit8(cg, 137); cg_emit8(cg, 7);
            } else {
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 7);
            }
            return;
        }

        if lhs.kind == 117 {
            let lv_idx: u64 = cg_find_local_index(cg, lhs.hash);
            if lv_idx != 18446744073709551615 && cg.local_muts != (0 as *mut u8) {
                let mflag: u8 = cg.local_muts[lv_idx];
                if mflag == 2 {
                    diag_report_packed_error(cg, lhs.val, "TypeError", ": Assignment to constant variable (declared with 'const')");
                    return;
                } else if mflag == 3 {
                    cg.local_muts[lv_idx] = 1;
                }
            }
            let lv: *mut LocalVar = cg_find_local(cg, lhs.hash);
            if opt_try_emit_inplace_assign(cg, lv, lhs.hash, rhs) == 1 {
                return;
            }
            compile_expr(cg, rhs);
            if lv != (0 as *mut LocalVar) {
                if lv.is_struct_val == 1 && lv.is_struct_ptr == 0 {
                    cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 198);
                    cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 189);
                    cg_emit32(cg, 0 - (lv.rbp_offset as u32));
                    cg_emit8(cg, 185); cg_emit32(cg, lv.size as u32);
                    cg_emit8(cg, 252); cg_emit8(cg, 243); cg_emit8(cg, 164);
                } else {
                    cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 133);
                    cg_emit32(cg, 0 - (lv.rbp_offset as u32));
                    if cg.has_lambdas == 1 {
                        let uoff: u32 = cg_get_or_add_upvalue(cg, lhs.hash);
                        cg_emit_store_upvalue(cg, uoff);
                    }
                }
            } else {
                let uoff2: u32 = cg_find_upvalue(cg, lhs.hash);
                if uoff2 != 0 {
                    cg_emit_store_upvalue(cg, uoff2);
                } else if (lhs.val >> 48) == 1 {
                    diag_report_packed_error(cg, lhs.val, "ReferenceError", " is not defined");
                }
            }
            return;
        }
    }

    if stmt.kind == 128 {
        if cg.defer_nodes != (0 as *mut u64) && cg.defer_count < 64 {
            cg.defer_nodes[cg.defer_count] = stmt as u64;
            cg.defer_count = cg.defer_count + 1;
        }
        return;
    }

    if stmt.kind == 132 {
        cg.unsafe_depth = cg.unsafe_depth + 1;
        var us_s: *mut AstNode = stmt.child1;
        while us_s != (0 as *mut AstNode) {
            compile_stmt(cg, us_s);
            us_s = us_s.next;
        }
        if cg.unsafe_depth > 0 {
            cg.unsafe_depth = cg.unsafe_depth - 1;
        }
        return;
    }

    if stmt.kind == 126 {
        var is_lbl_break: u32 = 0;
        var target_lbl: u64 = stmt.hash;
        if target_lbl == 0 && stmt.child1 != (0 as *mut AstNode) && stmt.child1.kind == 117 {
            var c_cand: u64 = cg.loop_depth;
            while c_cand > 0 {
                c_cand = c_cand - 1;
                if cg.loop_break_holes[(c_cand * 64) + 63] == stmt.child1.hash {
                    target_lbl = stmt.child1.hash;
                    is_lbl_break = 1;
                    c_cand = 0;
                }
            }
        }
        if is_lbl_break == 0 && stmt.child1 != (0 as *mut AstNode) {
            compile_expr(cg, stmt.child1);
        }
        if cg.loop_depth > 0 && cg.loop_break_holes != (0 as *mut u64) {
            var d: u64 = cg.loop_depth - 1;
            if target_lbl != 0 {
                var cand_d: u64 = cg.loop_depth;
                while cand_d > 0 {
                    cand_d = cand_d - 1;
                    if cg.loop_break_holes[(cand_d * 64) + 63] == target_lbl {
                        d = cand_d;
                        cand_d = 0;
                    }
                }
            }
            let bcnt: u64 = cg.loop_break_counts[d];
            if bcnt < 64 {
                cg_emit8(cg, 233);
                cg.loop_break_holes[(d * 64) + bcnt] = cg.text_size as u64;
                cg_emit32(cg, 0);
                cg.loop_break_counts[d] = bcnt + 1;
            }
        }
        return;
    }

    if stmt.kind == 127 {
        if cg.loop_depth > 0 && cg.loop_cont_offs != (0 as *mut u64) {
            var cd: u64 = cg.loop_depth - 1;
            if stmt.hash != 0 {
                var cand_cd: u64 = cg.loop_depth;
                while cand_cd > 0 {
                    cand_cd = cand_cd - 1;
                    if cg.loop_break_holes[(cand_cd * 64) + 63] == stmt.hash {
                        cd = cand_cd;
                        cand_cd = 0;
                    }
                }
            }
            let cont_target: u32 = cg.loop_cont_offs[cd] as u32;
            cg_emit8(cg, 233);
            let cdisp: i32 = (cont_target as i32) - ((cg.text_size + 4) as i32);
            cg_emit32(cg, cdisp as u32);
        }
        return;
    }

    if stmt.kind == 107 {
        let jz_else_hole: u32 = opt_emit_cond_branch_false(cg, stmt.child1);

        var bs: *mut AstNode = stmt.child2;
        while bs != (0 as *mut AstNode) {
            compile_stmt(cg, bs);
            bs = bs.next;
        }

        if stmt.child3 != (0 as *mut AstNode) {
            cg_emit8(cg, 233);
            let jmp_end_hole: u32 = cg.text_size;
            cg_emit32(cg, 0);

            let else_offset: u32 = cg.text_size;
            cg_patch32(cg, jz_else_hole, else_offset - (jz_else_hole + 4));

            var ebs: *mut AstNode = stmt.child3;
            while ebs != (0 as *mut AstNode) {
                compile_stmt(cg, ebs);
                ebs = ebs.next;
            }

            let end_offset: u32 = cg.text_size;
            cg_patch32(cg, jmp_end_hole, end_offset - (jmp_end_hole + 4));
        } else {
            let end_offset: u32 = cg.text_size;
            cg_patch32(cg, jz_else_hole, end_offset - (jz_else_hole + 4));
        }
        return;
    }

    if stmt.kind == 108 {
        if stmt.id == 0 {
            opt_emit_licm_preheader(cg, stmt.child1, stmt.child2);
            if opt_try_compile_hot_while(cg, stmt) == 1 {
                return;
            }
            if opt_try_compile_dual_accum_while(cg, stmt) == 1 {
                return;
            }
            if opt_try_compile_cond_accum_while(cg, stmt) == 1 {
                return;
            }
        }
        let loop_offset: u32 = cg.text_size;
        let cur_d: u64 = cg.loop_depth;
        if cg.loop_cont_offs != (0 as *mut u64) && cur_d < 32 {
            cg.loop_cont_offs[cur_d] = loop_offset as u64;
            cg.loop_break_counts[cur_d] = 0;
            cg.loop_break_holes[(cur_d * 64) + 63] = stmt.id;
            cg.loop_depth = cur_d + 1;
        }

        let jz_end_hole: u32 = opt_emit_cond_branch_false(cg, stmt.child1);

        var bs: *mut AstNode = stmt.child2;
        while bs != (0 as *mut AstNode) {
            compile_stmt(cg, bs);
            bs = bs.next;
        }

        cg_emit8(cg, 233);
        let jmp_disp: i32 = (loop_offset as i32) - ((cg.text_size + 4) as i32);
        cg_emit32(cg, jmp_disp as u32);

        let end_offset: u32 = cg.text_size;
        cg_patch32(cg, jz_end_hole, end_offset - (jz_end_hole + 4));

        if cg.loop_cont_offs != (0 as *mut u64) && cur_d < 32 {
            let b_total: u64 = cg.loop_break_counts[cur_d];
            var bi: u64 = 0;
            while bi < b_total {
                let bhole: u32 = cg.loop_break_holes[(cur_d * 64) + bi] as u32;
                cg_patch32(cg, bhole, end_offset - (bhole + 4));
                bi = bi + 1;
            }
            cg.loop_depth = cur_d;
        }
        return;
    }

    if stmt.kind == 125 {
        cg.current_stack_offset = cg.current_stack_offset + 8;
        let i_off: u32 = cg.current_stack_offset as u32;
        let lv_i: *mut LocalVar = ((cg.locals as *mut u8) + ((cg.local_count as u64) * 48)) as *mut LocalVar;
        lv_i.name_hash = stmt.hash;
        lv_i.rbp_offset = i_off as u64;
        lv_i.size = 8;
        lv_i.is_struct_ptr = 0;
        lv_i.is_struct_val = 2;
        lv_i.struct_hash = 0;
        cg.local_count = cg.local_count + 1;

        cg.current_stack_offset = cg.current_stack_offset + 8;
        let end_off: u32 = cg.current_stack_offset as u32;

        compile_expr(cg, stmt.child1);
        cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 133);
        cg_emit32(cg, 0 - i_off);

        if stmt.id == 0 && stmt.val == 0 && cg.has_lambdas == 0 && stmt.child3 != (0 as *mut AstNode) && stmt.child3.next == (0 as *mut AstNode) {
            if opt_try_compile_cond_accum_body(cg, stmt.hash, i_off, 1, stmt.child2, stmt.child3) == 1 {
                return;
            }
        }

        compile_expr(cg, stmt.child2);
        if stmt.id == 0 && stmt.val == 0 && cg.has_lambdas == 0 && stmt.child3 != (0 as *mut AstNode) && stmt.child3.next == (0 as *mut AstNode) {
            let f_sum_h: u64 = opt_match_sum_accum_stmt(stmt.child3, stmt.hash);
            if f_sum_h != 0 {
                let lv_fsum: *mut LocalVar = cg_find_local(cg, f_sum_h);
                if lv_fsum != (0 as *mut LocalVar) && lv_fsum.is_struct_val != 1 {
                    opt_emit_scev64_accum_loop(cg, i_off, lv_fsum.rbp_offset as u32, 1);
                    return;
                }
            }
        }
        cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 133);
        cg_emit32(cg, 0 - end_off);

        cg_emit8(cg, 233);
        let init_jmp_hole: u32 = cg.text_size;
        cg_emit32(cg, 0);

        let step_off: u32 = cg.text_size;
        cg_emit8(cg, 72); cg_emit8(cg, 255); cg_emit8(cg, 133);
        cg_emit32(cg, 0 - i_off);

        let cond_off: u32 = cg.text_size;
        cg_patch32(cg, init_jmp_hole, cond_off - (init_jmp_hole + 4));

        cg_emit8(cg, 72); cg_emit8(cg, 139); cg_emit8(cg, 133);
        cg_emit32(cg, 0 - i_off);
        cg_emit8(cg, 72); cg_emit8(cg, 59); cg_emit8(cg, 133);
        cg_emit32(cg, 0 - end_off);
        if stmt.val == 1 {
            cg_emit8(cg, 15); cg_emit8(cg, 143);
        } else {
            cg_emit8(cg, 15); cg_emit8(cg, 141);
        }
        let for_end_hole: u32 = cg.text_size;
        cg_emit32(cg, 0);

        let f_depth: u64 = cg.loop_depth;
        if cg.loop_cont_offs != (0 as *mut u64) && f_depth < 32 {
            cg.loop_cont_offs[f_depth] = step_off as u64;
            cg.loop_break_counts[f_depth] = 0;
            cg.loop_break_holes[(f_depth * 64) + 63] = stmt.id;
            cg.loop_depth = f_depth + 1;
        }

        var fbs: *mut AstNode = stmt.child3;
        while fbs != (0 as *mut AstNode) {
            compile_stmt(cg, fbs);
            fbs = fbs.next;
        }

        cg_emit8(cg, 233);
        let step_disp: i32 = (step_off as i32) - ((cg.text_size + 4) as i32);
        cg_emit32(cg, step_disp as u32);

        let for_end_off: u32 = cg.text_size;
        cg_patch32(cg, for_end_hole, for_end_off - (for_end_hole + 4));

        if cg.loop_cont_offs != (0 as *mut u64) && f_depth < 32 {
            let fb_total: u64 = cg.loop_break_counts[f_depth];
            var fbi: u64 = 0;
            while fbi < fb_total {
                let fbhole: u32 = cg.loop_break_holes[(f_depth * 64) + fbi] as u32;
                cg_patch32(cg, fbhole, for_end_off - (fbhole + 4));
                fbi = fbi + 1;
            }
            cg.loop_depth = f_depth;
        }
        return;
    }

    if stmt.kind == 129 {
        compile_stmt_match(cg, stmt);
        return;
    }

    if stmt.kind == 109 {
        if stmt.child1 != (0 as *mut AstNode) {
            if opt_try_emit_tail_call(cg, stmt.child1) == 1 {
                return;
            }
            compile_expr(cg, stmt.child1);
            if cg.cur_fn_ret_size > 0 {
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 198);
                cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 61);
                let stage_hole: u32 = cg.text_size;
                cg_emit32(cg, 0);
                cg_add_rodata_fixup(cg, stage_hole, cg.ret_stage_off as u32);
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 248);
                cg_emit8(cg, 185); cg_emit32(cg, cg.cur_fn_ret_size as u32);
                cg_emit8(cg, 252); cg_emit8(cg, 243); cg_emit8(cg, 164);
            }
        } else {
            cg_emit8(cg, 49); cg_emit8(cg, 192);
        }
        cg_emit_defers(cg);
        cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 236);
        cg_emit8(cg, 93);
        cg_emit8(cg, 195);
        return;
    }

    if stmt.kind == 110 {
        compile_expr(cg, stmt.child1);
        return;
    }
}

fn register_fn_contract(cg: *mut CodeGen, fnode: *mut AstNode, fn_text_offset: u32) {
    let fn_vaddr: u64 = 4259840 + (fn_text_offset as u64);
    let fn_code_size: u64 = (cg.text_size - fn_text_offset) as u64;

    var param_types_buf: [u64; 64];
    var param_ptrs_buf: [u64; 64];
    let p_types: *mut u64 = &mut param_types_buf[0];
    let p_ptrs: *mut u64 = &mut param_ptrs_buf[0];
    var pc: *mut AstNode = fnode.child2;
    var p_count: u32 = 0;
    while pc != (0 as *mut AstNode) && p_count < 64 {
        p_types[p_count as u64] = pc.val;
        p_ptrs[p_count as u64] = pc.is_mut as u64;
        p_count = p_count + 1;
        pc = pc.next;
    }
    let fn_cconv: u32 = fnode.id as u32;
    let sig_hash: u64 = compute_canonical_sig_hash(p_count, fn_cconv, fnode.val, p_types as *u64, p_ptrs as *u64);

    let sc: *mut SymbolContract = ((cg.contracts as *mut u8) + ((cg.contract_count as u64) * 48)) as *mut SymbolContract;
    sc.symbol_hash = fnode.hash;
    sc.type_sig_hash = sig_hash;
    sc.vaddr = fn_vaddr;
    sc.code_size = fn_code_size;
    sc.flags = 1;
    sc.param_conv = (p_count & 65535) | ((fn_cconv & 65535) << 16);
    sc.contract_digest = blake3_hash64(sc as *u8, 40);
    cg.contract_count = cg.contract_count + 1;
}

fn compile_fn(cg: *mut CodeGen, fnode: *mut AstNode) {
    let fn_text_offset: u32 = cg.text_size;

    cg.cur_fn_ret_size = 0;
    if fnode.is_mut == 0 {
        let ret_si: *mut StructInfo = cg_find_struct(cg, fnode.val);
        if ret_si != (0 as *mut StructInfo) {
            cg.cur_fn_ret_size = ret_si.total_size;
            cg_register_fn_ret_struct(cg, fnode.hash, fnode.val, ret_si.total_size);
        } else if is_signed_type_hash(0, fnode.val) == 1 {
            cg_register_fn_signed_ret(cg, fnode.hash);
        }
    }

    if cg.target_arch == 1 || cg.target_arch == 8 || cg.target_arch == 10 {
        compile_fn_arm64(cg, fnode);
        register_fn_contract(cg, fnode, fn_text_offset);
        return;
    }
    if cg.target_arch == 2 || cg.target_arch == 9 {
        compile_fn_riscv(cg, fnode);
        register_fn_contract(cg, fnode, fn_text_offset);
        return;
    }
    if cg.target_arch == 11 {
        compile_fn_wasm(cg, fnode);
        register_fn_contract(cg, fnode, fn_text_offset);
        return;
    }

    let fe: *mut FnEntry = ((cg.fn_entries as *mut u8) + ((cg.fn_entry_count as u64) * 16)) as *mut FnEntry;
    fe.fn_hash = fnode.hash;
    fe.text_offset = fn_text_offset as u64;
    cg.fn_entry_count = cg.fn_entry_count + 1;

    cg_emit8(cg, 85);
    cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 229);
    cg_emit8(cg, 72); cg_emit8(cg, 129); cg_emit8(cg, 236);
    let stack_sub_hole: u32 = cg.text_size;
    cg_emit32(cg, 4096);

    cg.local_count = 0;
    cg.current_stack_offset = 0;
    cg.loop_depth = 0;
    cg.defer_count = 0;

    var p_idx: u32 = 0;
    var p_cur: *mut AstNode = fnode.child2;
    while p_cur != (0 as *mut AstNode) && p_idx < 64 {
        cg.current_stack_offset = cg.current_stack_offset + 8;
        let lv: *mut LocalVar = ((cg.locals as *mut u8) + ((cg.local_count as u64) * 48)) as *mut LocalVar;
        lv.name_hash = p_cur.hash;
        lv.rbp_offset = cg.current_stack_offset;
        lv.size = 8;
        lv.is_struct_ptr = p_cur.is_mut;
        lv.is_struct_val = 0;
        let psi: *mut StructInfo = cg_find_struct(cg, p_cur.val);
        if psi != (0 as *mut StructInfo) {
            if p_cur.is_mut != 11 {
                lv.is_struct_ptr = 1;
            }
        } else if p_cur.is_mut == 0 {
            if is_signed_type_hash(0, p_cur.val) == 1 {
                lv.is_struct_val = 2;
            }
        }
        lv.struct_hash = p_cur.val;
        if cg.local_muts != (0 as *mut u8) && cg.local_count < 65536 {
            cg.local_muts[cg.local_count] = 1;
        }
        cg.local_count = cg.local_count + 1;

        if p_idx < 6 {
            if p_idx == 0 { cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 189); }
            else if p_idx == 1 { cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 181); }
            else if p_idx == 2 { cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 149); }
            else if p_idx == 3 { cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 141); }
            else if p_idx == 4 { cg_emit8(cg, 76); cg_emit8(cg, 137); cg_emit8(cg, 133); }
            else if p_idx == 5 { cg_emit8(cg, 76); cg_emit8(cg, 137); cg_emit8(cg, 141); }
            cg_emit32(cg, 0 - (lv.rbp_offset as u32));
        } else {
            let stk_p_disp: u32 = 16 + ((p_idx - 6) * 8);
            cg_emit8(cg, 72); cg_emit8(cg, 139); cg_emit8(cg, 133);
            cg_emit32(cg, stk_p_disp);
            cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 133);
            cg_emit32(cg, 0 - (lv.rbp_offset as u32));
        }

        if cg.has_lambdas == 1 {
            cg_emit8(cg, 72); cg_emit8(cg, 139); cg_emit8(cg, 133);
            cg_emit32(cg, 0 - (lv.rbp_offset as u32));
            let puoff: u32 = cg_get_or_add_upvalue(cg, p_cur.hash);
            cg_emit_store_upvalue(cg, puoff);
        }

        p_idx = p_idx + 1;
        p_cur = p_cur.next;
    }

    cg.cur_fn_hash = fnode.hash;
    cg.cur_fn_body_off = cg.text_size as u64;
    cg.cur_fn_param_cnt = p_idx as u64;

    cg_check_mutability_prepass(cg, fnode);
    opt_run_ir_pipeline(cg, fnode);

    var stmt: *mut AstNode = fnode.child1;
    while stmt != (0 as *mut AstNode) {
        compile_stmt(cg, stmt);
        stmt = stmt.next;
    }

    cg_emit_defers(cg);

    cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 236);
    cg_emit8(cg, 93);
    cg_emit8(cg, 195);

    var needed_stack: u64 = cg.current_stack_offset + 128;
    if needed_stack < 4096 { needed_stack = 4096; }
    let aligned_frame: u64 = ((needed_stack + 15) / 16) * 16;
    cg_patch32(cg, stack_sub_hole, aligned_frame as u32);

    register_fn_contract(cg, fnode, fn_text_offset);
    rt_guard_record_fn(cg, fnode, fn_text_offset, cg.text_size as u32);

    if fnode.hash == 2258945139493307336 && cg.call_main_hole != 0 {
        let disp: i32 = (fn_text_offset as i32) - ((cg.call_main_hole + 4) as i32);
        cg_patch32(cg, cg.call_main_hole, disp as u32);
        cg.call_main_hole = 0;
    }
}
