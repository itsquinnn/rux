struct FieldInfo {
    name_hash: u64,
    byte_offset: u32,
    field_size: u32,
    type_kind: u32,
}

struct StructInfo {
    name_hash: u64,
    type_sig_hash: u64,
    total_size: u64,
    field_count: u64,
}

struct LocalVar {
    name_hash: u64,
    rbp_offset: u64,
    size: u64,
    is_struct_ptr: u64,
    is_struct_val: u64,
    struct_hash: u64,
}

struct CallFixup {
    hole_offset: u64,
    callee_hash: u64,
}

struct FnEntry {
    fn_hash: u64,
    text_offset: u64,
}

struct CodeGen {
    text_buf: *mut u8,
    text_size: u64,

    rodata_buf: *mut u8,
    rodata_size: u64,

    relocs: *mut EiaRelocHole,
    reloc_count: u64,

    type_graph: *mut EiaTypeGraphEntry,
    tg_count: u64,

    contracts: *mut SymbolContract,
    contract_count: u64,

    call_main_hole: u64,

    call_fixups: *mut CallFixup,
    call_fixup_count: u64,

    fn_entries: *mut FnEntry,
    fn_entry_count: u64,

    structs: *mut StructInfo,
    struct_count: u64,

    locals: *mut LocalVar,
    local_count: u64,
    local_muts: *mut u8,
    current_stack_offset: u64,
    force_bridge: u64,
    permute_seed: u64,
    target_arch: u64,

    rodata_fixups: *mut RodataFixup,
    rodata_fixup_count: u64,
    field_metas: *mut FieldMeta,
    field_meta_count: u64,
    fn_ret_structs: *mut ConstEntry,
    fn_ret_struct_count: u64,
    fn_signed_rets: *mut ConstEntry,
    fn_signed_ret_count: u64,
    cur_fn_ret_size: u64,
    ret_stage_off: u64,
    loop_depth: u64,
    loop_cont_offs: *mut u64,
    loop_break_holes: *mut u64,
    loop_break_counts: *mut u64,
    defer_nodes: *mut u64,
    defer_count: u64,
    pe_exit_iat_hole: u64,
    pe_exit_iat_hole2: u64,
    pe_getstd_iat_hole: u64,
    pe_getstd_iat_hole2: u64,
    pe_writefile_iat_hole: u64,
    pe_valloc_iat_hole: u64,
    pe_createfile_iat_hole: u64,
    pe_readfile_iat_hole: u64,
    pe_closehandle_iat_hole: u64,
    pe_vfree_iat_hole: u64,
    pe_getcmdline_iat_hole: u64,
    pe_sleep_iat_hole: u64,
    pe_write_helper_off: u64,
    pe_valloc_helper_off: u64,
    pe_createfile_helper_off: u64,
    pe_readfile_helper_off: u64,
    pe_closehandle_helper_off: u64,
    pe_vfree_helper_off: u64,
    pe_sleep_helper_off: u64,
    is_freestanding: u64,
    strict_safety: u64,
    unsafe_depth: u64,
    parser: *mut u8,
    upvalues: *mut ConstEntry,
    upvalue_count: u64,
    has_lambdas: u64,
    cur_fn_hash: u64,
    cur_fn_body_off: u64,
    cur_fn_param_cnt: u64,
    dbg_fns: *mut u8,
    dbg_fn_count: u64,
    dbg_file_ro_off: u64,
    rt_install_hole: u64,
    rt_bounds_holes: *mut u32,
    rt_bounds_hole_count: u64,
    sym_checks: *mut ConstEntry,
    sym_check_count: u64,
    skip_ir_opt: u64,
}

fn cg_init_pe(cg: *mut CodeGen) {
    cg.pe_exit_iat_hole = 0;
    cg.pe_exit_iat_hole2 = 0;
    cg.pe_getstd_iat_hole = 0;
    cg.pe_getstd_iat_hole2 = 0;
    cg.pe_writefile_iat_hole = 0;
    cg.pe_valloc_iat_hole = 0;
    cg.pe_createfile_iat_hole = 0;
    cg.pe_readfile_iat_hole = 0;
    cg.pe_closehandle_iat_hole = 0;
    cg.pe_vfree_iat_hole = 0;
    cg.pe_getcmdline_iat_hole = 0;
    cg.pe_sleep_iat_hole = 0;
    cg.pe_write_helper_off = 0;
    cg.pe_valloc_helper_off = 0;
    cg.pe_createfile_helper_off = 0;
    cg.pe_readfile_helper_off = 0;
    cg.pe_closehandle_helper_off = 0;
    cg.pe_vfree_helper_off = 0;
    cg.pe_sleep_helper_off = 0;
}

fn cg_emit8(cg: *mut CodeGen, b: u8) {
    cg.text_buf[cg.text_size as u64] = b;
    cg.text_size = cg.text_size + 1;
}

fn cg_emit32(cg: *mut CodeGen, val: u32) {
    cg_emit8(cg, (val & 255) as u8);
    cg_emit8(cg, ((val >> 8) & 255) as u8);
    cg_emit8(cg, ((val >> 16) & 255) as u8);
    cg_emit8(cg, ((val >> 24) & 255) as u8);
}

fn cg_emit64(cg: *mut CodeGen, val: u64) {
    cg_emit32(cg, (val & 4294967295) as u32);
    cg_emit32(cg, ((val >> 32) & 4294967295) as u32);
}

fn cg_patch32(cg: *mut CodeGen, offset: u32, val: u32) {
    cg.text_buf[offset as u64] = (val & 255) as u8;
    cg.text_buf[(offset + 1) as u64] = ((val >> 8) & 255) as u8;
    cg.text_buf[(offset + 2) as u64] = ((val >> 16) & 255) as u8;
    cg.text_buf[(offset + 3) as u64] = ((val >> 24) & 255) as u8;
}

fn cg_add_rodata_fixup(cg: *mut CodeGen, hole_offset: u32, rodata_off: u32) {
    if cg.rodata_fixups == (0 as *mut RodataFixup) { return; }
    if cg.rodata_fixup_count < 65536 {
        let rf: *mut RodataFixup = ((cg.rodata_fixups as *mut u8) + (cg.rodata_fixup_count * 16)) as *mut RodataFixup;
        rf.hole_offset = hole_offset as u64;
        rf.rodata_off = rodata_off as u64;
        cg.rodata_fixup_count = cg.rodata_fixup_count + 1;
    }
}

fn cg_add_field_meta(cg: *mut CodeGen, struct_hash: u64, field_hash: u64, type_hash: u64, flags: u64) {
    if cg.field_metas == (0 as *mut FieldMeta) { return; }
    if cg.field_meta_count < 16384 {
        let fm: *mut FieldMeta = ((cg.field_metas as *mut u8) + (cg.field_meta_count * 32)) as *mut FieldMeta;
        fm.struct_hash = struct_hash;
        fm.field_hash = field_hash;
        fm.type_hash = type_hash;
        fm.flags = flags;
        cg.field_meta_count = cg.field_meta_count + 1;
    }
}

fn cg_find_field_meta(cg: *mut CodeGen, struct_hash: u64, field_hash: u64) -> *mut FieldMeta {
    if cg.field_metas == (0 as *mut FieldMeta) { return 0 as *mut FieldMeta; }
    var sig_hash: u64 = struct_hash;
    if struct_hash != 0 {
        let si: *mut StructInfo = cg_find_struct(cg, struct_hash);
        if si != (0 as *mut StructInfo) {
            sig_hash = si.type_sig_hash;
        }
    }
    var i: u64 = 0;
    while i < cg.field_meta_count {
        let fm: *mut FieldMeta = ((cg.field_metas as *mut u8) + (i * 32)) as *mut FieldMeta;
        if fm.field_hash == field_hash {
            if struct_hash == 0 || fm.struct_hash == struct_hash || fm.struct_hash == sig_hash {
                return fm;
            }
        }
        i = i + 1;
    }
    return 0 as *mut FieldMeta;
}

fn cg_register_fn_ret_struct(cg: *mut CodeGen, fn_hash: u64, struct_hash: u64, struct_size: u64) {
    if cg.fn_ret_structs == (0 as *mut ConstEntry) { return; }
    if cg.fn_ret_struct_count < 2048 {
        let ce: *mut ConstEntry = ((cg.fn_ret_structs as *mut u8) + (cg.fn_ret_struct_count * 24)) as *mut ConstEntry;
        ce.name_hash = fn_hash;
        ce.val = struct_hash;
        ce.extra = struct_size;
        cg.fn_ret_struct_count = cg.fn_ret_struct_count + 1;
    }
}

fn cg_find_fn_ret_struct(cg: *mut CodeGen, fn_hash: u64) -> *mut ConstEntry {
    if cg.fn_ret_structs == (0 as *mut ConstEntry) { return 0 as *mut ConstEntry; }
    var i: u64 = 0;
    while i < cg.fn_ret_struct_count {
        let ce: *mut ConstEntry = ((cg.fn_ret_structs as *mut u8) + (i * 24)) as *mut ConstEntry;
        if ce.name_hash == fn_hash {
            return ce;
        }
        i = i + 1;
    }
    return 0 as *mut ConstEntry;
}

fn cg_register_fn_signed_ret(cg: *mut CodeGen, fn_hash: u64) {
    if cg.fn_signed_rets == (0 as *mut ConstEntry) { return; }
    if cg.fn_signed_ret_count < 4096 {
        let ce: *mut ConstEntry = ((cg.fn_signed_rets as *mut u8) + (cg.fn_signed_ret_count * 24)) as *mut ConstEntry;
        ce.name_hash = fn_hash;
        ce.val = 1;
        ce.extra = 0;
        cg.fn_signed_ret_count = cg.fn_signed_ret_count + 1;
    }
}

fn cg_is_fn_signed_ret(cg: *mut CodeGen, fn_hash: u64) -> u32 {
    if cg.fn_signed_rets == (0 as *mut ConstEntry) { return 0; }
    var i: u64 = 0;
    while i < cg.fn_signed_ret_count {
        let ce: *mut ConstEntry = ((cg.fn_signed_rets as *mut u8) + (i * 24)) as *mut ConstEntry;
        if ce.name_hash == fn_hash {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn cg_add_reloc(cg: *mut CodeGen, insn_offset: u32, type_hash: u64, field_hash: u64) {
    let hole: *mut EiaRelocHole = ((cg.relocs as *mut u8) + ((cg.reloc_count as u64) * 24)) as *mut EiaRelocHole;
    hole.insn_offset = insn_offset;
    hole.patch_kind = 1;
    hole.type_sig_hash = type_hash;
    hole.field_or_sym_hash = field_hash;
    cg.reloc_count = cg.reloc_count + 1;
}

fn cg_add_reloc_ex(cg: *mut CodeGen, insn_offset: u32, patch_kind: u32, type_hash: u64, field_or_sym_hash: u64) {
    let hole: *mut EiaRelocHole = ((cg.relocs as *mut u8) + ((cg.reloc_count as u64) * 24)) as *mut EiaRelocHole;
    hole.insn_offset = insn_offset;
    hole.patch_kind = patch_kind;
    hole.type_sig_hash = type_hash;
    hole.field_or_sym_hash = field_or_sym_hash;
    cg.reloc_count = cg.reloc_count + 1;
}

fn cg_add_type_graph_entry(cg: *mut CodeGen, type_hash: u64, field_hash: u64, byte_offset: u32, field_size: u32) {
    let entry: *mut EiaTypeGraphEntry = ((cg.type_graph as *mut u8) + ((cg.tg_count as u64) * 24)) as *mut EiaTypeGraphEntry;
    entry.type_sig_hash = type_hash;
    entry.field_hash = field_hash;
    entry.byte_offset = byte_offset;
    entry.field_size = field_size;
    cg.tg_count = cg.tg_count + 1;
}

fn cg_find_struct(cg: *mut CodeGen, name_hash: u64) -> *mut StructInfo {
    var i: u32 = 0;
    while i < cg.struct_count {
        let si: *mut StructInfo = ((cg.structs as *mut u8) + ((i as u64) * 32)) as *mut StructInfo;
        if si.name_hash == name_hash || si.type_sig_hash == name_hash {
            return si;
        }
        i = i + 1;
    }
    return 0 as *mut StructInfo;
}

fn cg_lookup_field_offset(cg: *mut CodeGen, type_hash: u64, field_hash: u64) -> u32 {
    var sig_hash: u64 = type_hash;
    let si: *mut StructInfo = cg_find_struct(cg, type_hash);
    if si != (0 as *mut StructInfo) {
        sig_hash = si.type_sig_hash;
    }
    var ti: u32 = 0;
    while ti < (cg.tg_count as u32) {
        let tge: *mut EiaTypeGraphEntry = ((cg.type_graph as *mut u8) + ((ti as u64) * 24)) as *mut EiaTypeGraphEntry;
        if (type_hash == 0 || tge.type_sig_hash == sig_hash || tge.type_sig_hash == type_hash) && tge.field_hash == field_hash {
            return tge.byte_offset;
        }
        ti = ti + 1;
    }
    if field_hash == hash_identifier("val", 3) {
        let val_alt_h: u64 = hash_identifier("value", 5);
        var ti2: u32 = 0;
        while ti2 < (cg.tg_count as u32) {
            let tge2: *mut EiaTypeGraphEntry = ((cg.type_graph as *mut u8) + ((ti2 as u64) * 24)) as *mut EiaTypeGraphEntry;
            if (si == (0 as *mut StructInfo) || tge2.type_sig_hash == sig_hash) && tge2.field_hash == val_alt_h {
                return tge2.byte_offset;
            }
            ti2 = ti2 + 1;
        }
    }
    return 0;
}

fn cg_find_local(cg: *mut CodeGen, name_hash: u64) -> *mut LocalVar {
    var i: u32 = cg.local_count as u32;
    while i > 0 {
        i = i - 1;
        let lv: *mut LocalVar = ((cg.locals as *mut u8) + ((i as u64) * 48)) as *mut LocalVar;
        if lv.name_hash == name_hash {
            return lv;
        }
    }
    return 0 as *mut LocalVar;
}

fn cg_find_local_index(cg: *mut CodeGen, name_hash: u64) -> u64 {
    var i: u32 = cg.local_count as u32;
    while i > 0 {
        i = i - 1;
        let lv: *mut LocalVar = ((cg.locals as *mut u8) + ((i as u64) * 48)) as *mut LocalVar;
        if lv.name_hash == name_hash {
            return i as u64;
        }
    }
    return 18446744073709551615;
}

