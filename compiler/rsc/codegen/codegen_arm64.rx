fn arm64_emit_load_sized(cg: *mut CodeGen, sz: u64) {
    arm64_emit_load_sized_ex(cg, sz, 0);
}

fn arm64_emit_memcpy_x0_to_x1(cg: *mut CodeGen, copy_sz: u64) {
