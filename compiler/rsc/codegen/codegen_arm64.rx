    if x86_nr == 35 { return 101; }
    if x86_nr == 39 { return 172; }
    if x86_nr == 41 { return 198; }
    if x86_nr == 42 { return 203; }
    if x86_nr == 43 { return 202; }
    if x86_nr == 49 { return 200; }
    if x86_nr == 50 { return 201; }
    if x86_nr == 56 { return 220; }
    if x86_nr == 59 { return 221; }
    if x86_nr == 60 { return 93; }
    if x86_nr == 61 { return 260; }
    if x86_nr == 63 { return 160; }
    if x86_nr == 77 { return 46; }
    if x86_nr == 82 { return 276; }
    if x86_nr == 83 { return 34; }
    if x86_nr == 87 { return 35; }
    if x86_nr == 217 { return 61; }
    if x86_nr == 228 { return 113; }
    if x86_nr == 291 { return 20; }
    if x86_nr == 318 { return 278; }
    if x86_nr == 319 { return 279; }
    return x86_nr;
}

fn macos_bsd_syscall_nr(x86_nr: u64) -> u64 {
    if x86_nr == 0 { return 3; }
    if x86_nr == 1 { return 4; }
    if x86_nr == 2 { return 5; }
    if x86_nr == 3 { return 6; }
    if x86_nr == 5 { return 189; }
    if x86_nr == 8 { return 199; }
