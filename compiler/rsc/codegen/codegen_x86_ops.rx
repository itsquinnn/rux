                cg_emit8(cg, 49); cg_emit8(cg, 210);
                cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 246);
                cg_emit8(cg, 116); cg_emit8(cg, 11);
                cg_emit8(cg, 128); cg_emit8(cg, 60); cg_emit8(cg, 22); cg_emit8(cg, 0);
                cg_emit8(cg, 116); cg_emit8(cg, 5);
                cg_emit8(cg, 72); cg_emit8(cg, 255); cg_emit8(cg, 194);
                cg_emit8(cg, 235); cg_emit8(cg, 245);
            }
            cg_emit_os_write(cg, fd_num);
        } else {
            compile_expr(cg, pa);
            let is_sgn_p: u32 = cg_is_signed_expr(cg, pa);
            cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 236); cg_emit8(cg, 32);
            cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 124); cg_emit8(cg, 36); cg_emit8(cg, 31);
            cg_emit8(cg, 49); cg_emit8(cg, 201);
            if is_sgn_p == 1 {
                cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 192);
                cg_emit8(cg, 121); cg_emit8(cg, 8);
                cg_emit8(cg, 72); cg_emit8(cg, 247); cg_emit8(cg, 216);
                cg_emit8(cg, 185); cg_emit32(cg, 1);
            }
            cg_emit8(cg, 187); cg_emit32(cg, 10);
            let dig_loop: u32 = cg.text_size;
            cg_emit8(cg, 49); cg_emit8(cg, 210);
            cg_emit8(cg, 72); cg_emit8(cg, 247); cg_emit8(cg, 243);
            cg_emit8(cg, 128); cg_emit8(cg, 194); cg_emit8(cg, 48);
            cg_emit8(cg, 136); cg_emit8(cg, 23);
            cg_emit8(cg, 72); cg_emit8(cg, 255); cg_emit8(cg, 207);
            cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 192);
            cg_emit8(cg, 117);
            let back_d: i32 = (dig_loop as i32) - ((cg.text_size + 1) as i32);
            cg_emit8(cg, (back_d & 255) as u8);
            if is_sgn_p == 1 {
                cg_emit8(cg, 133); cg_emit8(cg, 201);
                cg_emit8(cg, 116); cg_emit8(cg, 6);
                cg_emit8(cg, 198); cg_emit8(cg, 7); cg_emit8(cg, 45);
                cg_emit8(cg, 72); cg_emit8(cg, 255); cg_emit8(cg, 207);
            }
            cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 119); cg_emit8(cg, 1);
            cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 84); cg_emit8(cg, 36); cg_emit8(cg, 32);
            cg_emit8(cg, 72); cg_emit8(cg, 41); cg_emit8(cg, 242);
