        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 2);
        cg_emit8(cg, 117); cg_emit8(cg, 7);
        cg_emit8(cg, 232);
        let cf_disp: i32 = (cg.pe_createfile_helper_off as i32) - ((cg.text_size + 4) as i32);
        cg_emit32(cg, cf_disp as u32);
        cg_emit8(cg, 235); cg_emit8(cg, 94);

        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 3);
        cg_emit8(cg, 117); cg_emit8(cg, 7);
        cg_emit8(cg, 232);
        let cl_disp: i32 = (cg.pe_closehandle_helper_off as i32) - ((cg.text_size + 4) as i32);
        cg_emit32(cg, cl_disp as u32);
        cg_emit8(cg, 235); cg_emit8(cg, 81);

        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 9);
        cg_emit8(cg, 117); cg_emit8(cg, 7);
        cg_emit8(cg, 232);
        let va_disp: i32 = (cg.pe_valloc_helper_off as i32) - ((cg.text_size + 4) as i32);
        cg_emit32(cg, va_disp as u32);
        cg_emit8(cg, 235); cg_emit8(cg, 68);

        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 11);
        cg_emit8(cg, 117); cg_emit8(cg, 7);
        cg_emit8(cg, 232);
        let vf_disp: i32 = (cg.pe_vfree_helper_off as i32) - ((cg.text_size + 4) as i32);
        cg_emit32(cg, vf_disp as u32);
        cg_emit8(cg, 235); cg_emit8(cg, 55);

        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 35);
        cg_emit8(cg, 117); cg_emit8(cg, 7);
        cg_emit8(cg, 232);
        let sl_disp: i32 = (cg.pe_sleep_helper_off as i32) - ((cg.text_size + 4) as i32);
        cg_emit32(cg, sl_disp as u32);
        cg_emit8(cg, 235); cg_emit8(cg, 42);

        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 39);
        cg_emit8(cg, 117); cg_emit8(cg, 7);
        cg_emit8(cg, 184); cg_emit32(cg, 1000);
        cg_emit8(cg, 235); cg_emit8(cg, 29);

        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 87);
        cg_emit8(cg, 117); cg_emit8(cg, 7);
        cg_emit8(cg, 232);
        let dl_disp: i32 = ((cg.pe_sleep_helper_off + 35) as i32) - ((cg.text_size + 4) as i32);
        cg_emit32(cg, dl_disp as u32);
        cg_emit8(cg, 235); cg_emit8(cg, 16);

        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 60);
        cg_emit8(cg, 117); cg_emit8(cg, 8);
        cg_emit8(cg, 137); cg_emit8(cg, 249);
        cg_emit8(cg, 233);
        let d_exit: i32 = ((cg.pe_exit_iat_hole as i32) - 10) - ((cg.text_size + 4) as i32);
        cg_emit32(cg, d_exit as u32);
        cg_emit8(cg, 144);

        cg_emit8(cg, 49); cg_emit8(cg, 192);
        return;
    }

    if cg.target_arch == 7 {
        var mac_is_fork: u32 = 0;
        if node.child1 != (0 as *mut AstNode) && node.child1.kind == 116 && node.child1.val == 56 {
            mac_is_fork = 1;
        }
        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 0);
        cg_emit8(cg, 117); cg_emit8(cg, 5);
        cg_emit8(cg, 184); cg_emit32(cg, 33554435);
        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 1);
        cg_emit8(cg, 117); cg_emit8(cg, 5);
        cg_emit8(cg, 184); cg_emit32(cg, 33554436);
        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 2);
        cg_emit8(cg, 117); cg_emit8(cg, 19);
        cg_emit8(cg, 184); cg_emit32(cg, 33554437);
        cg_emit8(cg, 72); cg_emit8(cg, 129); cg_emit8(cg, 254); cg_emit32(cg, 577);
        cg_emit8(cg, 117); cg_emit8(cg, 5);
        cg_emit8(cg, 190); cg_emit32(cg, 1537);
        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 3);
        cg_emit8(cg, 117); cg_emit8(cg, 5);
        cg_emit8(cg, 184); cg_emit32(cg, 33554438);
        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 9);
        cg_emit8(cg, 117); cg_emit8(cg, 11);
        cg_emit8(cg, 184); cg_emit32(cg, 33554629);
        cg_emit8(cg, 65); cg_emit8(cg, 186); cg_emit32(cg, 4098);
        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 11);
        cg_emit8(cg, 117); cg_emit8(cg, 5);
        cg_emit8(cg, 184); cg_emit32(cg, 33554505);
        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 16);
        cg_emit8(cg, 117); cg_emit8(cg, 5);
        cg_emit8(cg, 184); cg_emit32(cg, 33554486);
        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 39);
        cg_emit8(cg, 117); cg_emit8(cg, 5);
        cg_emit8(cg, 184); cg_emit32(cg, 33554452);
        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 56);
        cg_emit8(cg, 117); cg_emit8(cg, 5);
        cg_emit8(cg, 184); cg_emit32(cg, 33554434);
        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 59);
        cg_emit8(cg, 117); cg_emit8(cg, 5);
        cg_emit8(cg, 184); cg_emit32(cg, 33554491);
        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 60);
        cg_emit8(cg, 117); cg_emit8(cg, 5);
        cg_emit8(cg, 184); cg_emit32(cg, 33554433);
        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 61);
        cg_emit8(cg, 117); cg_emit8(cg, 5);
        cg_emit8(cg, 184); cg_emit32(cg, 33554439);
        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 87);
        cg_emit8(cg, 117); cg_emit8(cg, 5);
        cg_emit8(cg, 184); cg_emit32(cg, 33554442);
        cg_emit8(cg, 15); cg_emit8(cg, 5);
        cg_emit8(cg, 115); cg_emit8(cg, 3);
        cg_emit8(cg, 72); cg_emit8(cg, 247); cg_emit8(cg, 216);
        if mac_is_fork == 1 {
            cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 210);
