        while t_cur != (0 as *mut AstNode) {
            compile_expr(cg, t_cur);
            cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 61);
            let thole: u32 = cg.text_size;
            cg_emit32(cg, 0);
            cg_add_rodata_fixup(cg, thole, tup_ro + (ti * 8));
            cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 7);
            ti = ti + 1;
            t_cur = t_cur.next;
        }
        cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 5);
        let tres_hole: u32 = cg.text_size;
        cg_emit32(cg, 0);
        cg_add_rodata_fixup(cg, tres_hole, tup_ro);
        return;
    }
    if node.val == 50 || node.val == 51 {
        cg.rodata_size = ((cg.rodata_size + 7) / 8) * 8;
        let vec_ro: u32 = cg.rodata_size as u32;
        var vz: u32 = 0;
        while vz < 536 {
            cg.rodata_buf[cg.rodata_size as u64] = 0;
            cg.rodata_size = cg.rodata_size + 1;
            vz = vz + 1;
        }
        var v_idx: u32 = 0;
        var v_cur: *mut AstNode = node.child1;
        while v_cur != (0 as *mut AstNode) && v_idx < 64 {
            compile_expr(cg, v_cur);
            if node.val == 51 && cg_is_string_expr(cg, v_cur) == 1 {
                cg_emit_str_hash(cg);
            }
            cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 61);
            let vhole: u32 = cg.text_size;
            cg_emit32(cg, 0);
            cg_add_rodata_fixup(cg, vhole, vec_ro + 16 + (v_idx * 8));
            cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 7);
            v_idx = v_idx + 1;
            v_cur = v_cur.next;
        }
        cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 5);
        let vres_hole: u32 = cg.text_size;
        cg_emit32(cg, 0);
        cg_add_rodata_fixup(cg, vres_hole, vec_ro);
        cg_emit8(cg, 72); cg_emit8(cg, 199); cg_emit8(cg, 0); cg_emit32(cg, v_idx);
        cg_emit8(cg, 72); cg_emit8(cg, 199); cg_emit8(cg, 64); cg_emit8(cg, 8); cg_emit32(cg, 64);
        return;
    }
    if node.val == 52 {
        cg.rodata_size = ((cg.rodata_size + 7) / 8) * 8;
        let map_ro: u32 = cg.rodata_size as u32;
        var mz: u32 = 0;
        while mz < 536 {
            cg.rodata_buf[cg.rodata_size as u64] = 0;
            cg.rodata_size = cg.rodata_size + 1;
            mz = mz + 1;
        }
        var m_idx: u32 = 0;
        var m_cur: *mut AstNode = node.child1;
        while m_cur != (0 as *mut AstNode) && m_idx < 32 {
            var k_node: *mut AstNode = m_cur;
            var v_node: *mut AstNode = m_cur.child1;
            if m_cur.kind == 101 {
                k_node = m_cur.child1;
                v_node = m_cur.child2;
            }
            compile_expr(cg, k_node);
            if cg_is_string_expr(cg, k_node) == 1 {
                cg_emit_str_hash(cg);
            }
            cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 61);
            let khole: u32 = cg.text_size;
            cg_emit32(cg, 0);
            cg_add_rodata_fixup(cg, khole, map_ro + 16 + (m_idx * 16));
            cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 7);
            if v_node != (0 as *mut AstNode) {
                compile_expr(cg, v_node);
                cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 61);
                let mvhole: u32 = cg.text_size;
                cg_emit32(cg, 0);
                cg_add_rodata_fixup(cg, mvhole, map_ro + 24 + (m_idx * 16));
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 7);
            }
            m_idx = m_idx + 1;
            m_cur = m_cur.next;
        }
        cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 5);
        let mres_hole: u32 = cg.text_size;
        cg_emit32(cg, 0);
        cg_add_rodata_fixup(cg, mres_hole, map_ro);
        cg_emit8(cg, 72); cg_emit8(cg, 199); cg_emit8(cg, 0); cg_emit32(cg, m_idx);
        cg_emit8(cg, 72); cg_emit8(cg, 199); cg_emit8(cg, 64); cg_emit8(cg, 8); cg_emit32(cg, 32);
        return;
    }
    cg_emit8(cg, 72); cg_emit8(cg, 49); cg_emit8(cg, 192);
}

fn compile_expr_binary(cg: *mut CodeGen, node: *mut AstNode) {
    let op: u32 = node.val as u32;
    if op == 30 {
        if cg_is_str_concat_expr(cg, node.child1) == 1 || cg_is_str_concat_expr(cg, node.child2) == 1 {
            cg_emit_str_concat(cg, node.child1, node.child2);
            return;
        }
    }
    if op == 91 || op == 111 {
        compile_expr(cg, node.child1);
        cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 192);
        cg_emit8(cg, 15); cg_emit8(cg, 133);
        let or_hole: u32 = cg.text_size;
        cg_emit32(cg, 0);
        compile_expr(cg, node.child2);
        let or_done: u32 = cg.text_size;
        cg_patch32(cg, or_hole, or_done - (or_hole + 4));
        return;
    }
    if op == 108 {
        compile_expr(cg, node.child1);
        cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 248); cg_emit8(cg, 0);
        cg_emit8(cg, 15); cg_emit8(cg, 143);
        let catch_hole: u32 = cg.text_size;
        cg_emit32(cg, 0);
        compile_expr(cg, node.child2);
        let catch_done: u32 = cg.text_size;
        cg_patch32(cg, catch_hole, catch_done - (catch_hole + 4));
        return;
    }

    if op == 49 {
        compile_expr(cg, node.child1);
        cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 192);
        cg_emit8(cg, 15); cg_emit8(cg, 132);
        let and_hole: u32 = cg.text_size;
        cg_emit32(cg, 0);
        compile_expr(cg, node.child2);
        cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 192);
        cg_emit8(cg, 15); cg_emit8(cg, 149); cg_emit8(cg, 192);
        cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192);
        cg_emit8(cg, 235); cg_emit8(cg, 3);
        let and_false: u32 = cg.text_size;
        cg_patch32(cg, and_hole, and_false - (and_hole + 4));
        cg_emit8(cg, 72); cg_emit8(cg, 49); cg_emit8(cg, 192);
        return;
    }

    if op == 57 {
        compile_expr(cg, node.child1);
        cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 192);
        cg_emit8(cg, 15); cg_emit8(cg, 133);
        let or_hole2: u32 = cg.text_size;
        cg_emit32(cg, 0);
        compile_expr(cg, node.child2);
        cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 192);
        cg_emit8(cg, 15); cg_emit8(cg, 149); cg_emit8(cg, 192);
        cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192);
        cg_emit8(cg, 235); cg_emit8(cg, 7);
        let or_true2: u32 = cg.text_size;
        cg_patch32(cg, or_hole2, or_true2 - (or_hole2 + 4));
        cg_emit8(cg, 72); cg_emit8(cg, 199); cg_emit8(cg, 192); cg_emit32(cg, 1);
        return;
    }

    let is_sgn: u32 = cg_is_signed_expr(cg, node);
    cg_eval_binary_operands_fast(cg, node.child1, node.child2);

    if op == 30 {
        cg_emit8(cg, 72); cg_emit8(cg, 1); cg_emit8(cg, 216);
    } else if op == 31 {
        cg_emit8(cg, 72); cg_emit8(cg, 41); cg_emit8(cg, 216);
    } else if op == 32 {
        cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 175); cg_emit8(cg, 195);
    } else if op == 33 {
        if is_sgn == 1 {
            cg_emit8(cg, 72); cg_emit8(cg, 153);
            cg_emit8(cg, 72); cg_emit8(cg, 247); cg_emit8(cg, 251);
        } else {
            cg_emit8(cg, 72); cg_emit8(cg, 49); cg_emit8(cg, 210);
            cg_emit8(cg, 72); cg_emit8(cg, 247); cg_emit8(cg, 243);
        }
    } else if op == 34 {
        if is_sgn == 1 {
            cg_emit8(cg, 72); cg_emit8(cg, 153);
            cg_emit8(cg, 72); cg_emit8(cg, 247); cg_emit8(cg, 251);
        } else {
            cg_emit8(cg, 72); cg_emit8(cg, 49); cg_emit8(cg, 210);
            cg_emit8(cg, 72); cg_emit8(cg, 247); cg_emit8(cg, 243);
        }
        cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 208);
    } else if op == 49 {
        cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 192);
        cg_emit8(cg, 15); cg_emit8(cg, 149); cg_emit8(cg, 192);
        cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 219);
        cg_emit8(cg, 15); cg_emit8(cg, 149); cg_emit8(cg, 195);
        cg_emit8(cg, 32); cg_emit8(cg, 216);
        cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192);
    } else if op == 57 {
        cg_emit8(cg, 72); cg_emit8(cg, 9); cg_emit8(cg, 216);
        cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 192);
        cg_emit8(cg, 15); cg_emit8(cg, 149); cg_emit8(cg, 192);
        cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192);
    } else if op == 50 {
        cg_emit8(cg, 72); cg_emit8(cg, 33); cg_emit8(cg, 216);
    } else if op == 51 {
        cg_emit8(cg, 72); cg_emit8(cg, 9); cg_emit8(cg, 216);
    } else if op == 52 {
        cg_emit8(cg, 72); cg_emit8(cg, 49); cg_emit8(cg, 216);
    } else if op == 47 {
        cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 217);
        cg_emit8(cg, 72); cg_emit8(cg, 211); cg_emit8(cg, 224);
    } else if op == 48 {
        cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 217);
        if cg_is_signed_expr(cg, node.child1) == 1 {
            cg_emit8(cg, 72); cg_emit8(cg, 211); cg_emit8(cg, 248);
        } else {
            cg_emit8(cg, 72); cg_emit8(cg, 211); cg_emit8(cg, 232);
        }
    } else if op == 41 {
        cg_emit8(cg, 72); cg_emit8(cg, 57); cg_emit8(cg, 216);
        cg_emit8(cg, 15); cg_emit8(cg, 148); cg_emit8(cg, 192);
        cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192);
    } else if op == 42 {
        cg_emit8(cg, 72); cg_emit8(cg, 57); cg_emit8(cg, 216);
        cg_emit8(cg, 15); cg_emit8(cg, 149); cg_emit8(cg, 192);
        cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192);
    } else if op == 43 {
        cg_emit8(cg, 72); cg_emit8(cg, 57); cg_emit8(cg, 216);
        if is_sgn == 1 {
            cg_emit8(cg, 15); cg_emit8(cg, 156); cg_emit8(cg, 192);
        } else {
            cg_emit8(cg, 15); cg_emit8(cg, 146); cg_emit8(cg, 192);
        }
        cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192);
    } else if op == 44 {
        cg_emit8(cg, 72); cg_emit8(cg, 57); cg_emit8(cg, 216);
        if is_sgn == 1 {
            cg_emit8(cg, 15); cg_emit8(cg, 159); cg_emit8(cg, 192);
        } else {
            cg_emit8(cg, 15); cg_emit8(cg, 151); cg_emit8(cg, 192);
        }
        cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192);
    } else if op == 45 {
        cg_emit8(cg, 72); cg_emit8(cg, 57); cg_emit8(cg, 216);
        if is_sgn == 1 {
            cg_emit8(cg, 15); cg_emit8(cg, 158); cg_emit8(cg, 192);
        } else {
            cg_emit8(cg, 15); cg_emit8(cg, 150); cg_emit8(cg, 192);
        }
        cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192);
    } else if op == 46 {
        cg_emit8(cg, 72); cg_emit8(cg, 57); cg_emit8(cg, 216);
        if is_sgn == 1 {
            cg_emit8(cg, 15); cg_emit8(cg, 157); cg_emit8(cg, 192);
        } else {
            cg_emit8(cg, 15); cg_emit8(cg, 147); cg_emit8(cg, 192);
        }
        cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192);
    }
}
