fn compile_expr_print(cg: *mut CodeGen, node: *mut AstNode) {
    var fd_num: u32 = 1;
    if node.val == 2 { fd_num = 2; }

    var pa: *mut AstNode = node.child1;
    while pa != (0 as *mut AstNode) {
        var as_str: u32 = 0;
