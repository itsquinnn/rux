fn compile_fn_riscv(cg: *mut CodeGen, fnode: *mut AstNode) {
    let fn_text_offset: u32 = cg.text_size;

    let fe: *mut FnEntry = ((cg.fn_entries as *mut u8) + ((cg.fn_entry_count as u64) * 16)) as *mut FnEntry;
    fe.fn_hash = fnode.hash;
    fe.text_offset = fn_text_offset as u64;
    cg.fn_entry_count = cg.fn_entry_count + 1;

    cg_emit32(cg, 4278255891);
    cg_emit32(cg, 1127459);
    cg_emit32(cg, 8466467);
    cg_emit32(cg, 16843795);
    let rv_frame_hole: u32 = cg.text_size;
    cg_emit32(cg, 695);
    cg_emit32(cg, 164499);
    cg_emit32(cg, 1079050547);

    cg.local_count = 0;
    cg.current_stack_offset = 16;
    cg.loop_depth = 0;

    var p_idx: u32 = 0;
    var p_cur: *mut AstNode = fnode.child2;
    while p_cur != (0 as *mut AstNode) && p_idx < 64 {
        cg.current_stack_offset = cg.current_stack_offset + 8;
        let lv: *mut LocalVar = ((cg.locals as *mut u8) + ((cg.local_count as u64) * 48)) as *mut LocalVar;
        lv.name_hash = p_cur.hash;
        lv.rbp_offset = cg.current_stack_offset;
        lv.size = 8;
        lv.is_struct_ptr = p_cur.is_mut;
        lv.is_struct_val = 0;
        let psi: *mut StructInfo = cg_find_struct(cg, p_cur.val);
        if psi != (0 as *mut StructInfo) && p_cur.is_mut != 11 {
            lv.is_struct_ptr = 1;
        } else if p_cur.is_mut == 0 && is_signed_type_hash(0, p_cur.val) == 1 {
            lv.is_struct_val = 2;
        }
        lv.struct_hash = p_cur.val;
        cg.local_count = cg.local_count + 1;

        if p_idx < 8 {
            riscv_emit_mov_imm(cg, 5, lv.rbp_offset as u64);
            cg_emit32(cg, 1079247539);
            cg_emit32(cg, 176163 | ((10 + p_idx) << 20));
        } else {
            let rv_sp_off: u64 = ((p_idx - 8) as u64) * 8;
            riscv_emit_mov_imm(cg, 5, rv_sp_off);
            cg_emit32(cg, 5505715);
            cg_emit32(cg, 176899);
            riscv_emit_mov_imm(cg, 5, lv.rbp_offset as u64);
            cg_emit32(cg, 1079247539);
            cg_emit32(cg, 6467619);
        }
        p_idx = p_idx + 1;
        p_cur = p_cur.next;
    }

    var stmt: *mut AstNode = fnode.child1;
    while stmt != (0 as *mut AstNode) {
        compile_stmt_riscv(cg, stmt);
        stmt = stmt.next;
    }

    var rv_fsz: u32 = (((cg.current_stack_offset as u32) + 63) / 16) * 16;
    if rv_fsz < 64 { rv_fsz = 64; }
    let rv_fhi: u32 = (rv_fsz + 2048) >> 12;
    let rv_flo: u32 = rv_fsz - (rv_fhi << 12);
    cg_patch32(cg, rv_frame_hole, 695 | ((rv_fhi & 1048575) << 12));
    cg_patch32(cg, rv_frame_hole + 4, 164499 | ((rv_flo & 4095) << 20));

    cg_emit32(cg, 4278452499);
    cg_emit32(cg, 78851);
    cg_emit32(cg, 8466563);
    cg_emit32(cg, 16843027);
    cg_emit32(cg, 32871);

    if fnode.hash == 2258945139493307336 && cg.call_main_hole != 0 {
        riscv_patch_call(cg, cg.call_main_hole as u32, fn_text_offset);
        cg.call_main_hole = 0;
    }
}
