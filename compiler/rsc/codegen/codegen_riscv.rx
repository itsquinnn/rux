fn riscv_emit_mov_imm(cg: *mut CodeGen, reg: u32, val: u64) {
    let sval: i64 = val as i64;
    if sval >= -2048 && sval <= 2047 {
        let imm: u32 = (val as u32) & 4095;
        cg_emit32(cg, 19 | (imm << 20) | (reg << 7));
        return;
    }
    let v32: u32 = val as u32;
    let hi: u32 = (v32 + 2048) >> 12;
    let lo: u32 = v32 - (hi << 12);
    cg_emit32(cg, 55 | ((hi & 1048575) << 12) | (reg << 7));
    cg_emit32(cg, 19 | ((lo & 4095) << 20) | (reg << 15) | (reg << 7));
}

fn riscv_push(cg: *mut CodeGen, reg: u32) {
    cg_emit32(cg, 4278255891);
    cg_emit32(cg, 77859 | (reg << 20));
}

fn riscv_pop(cg: *mut CodeGen, reg: u32) {
    cg_emit32(cg, 77827 | (reg << 7));
    cg_emit32(cg, 16843027);
}

fn riscv_patch_branch(cg: *mut CodeGen, hole: u32, target: u32, base_op: u32) {
    let d: i32 = (target as i32) - (hole as i32);
    let imm12: u32 = ((d as u32) >> 12) & 1;
    let imm10_5: u32 = ((d as u32) >> 5) & 63;
    let imm4_1: u32 = ((d as u32) >> 1) & 15;
    let imm11: u32 = ((d as u32) >> 11) & 1;
    let insn: u32 = base_op | (imm11 << 7) | (imm4_1 << 8) | (imm10_5 << 25) | (imm12 << 31);
    cg_patch32(cg, hole, insn);
}

fn riscv_encode_jal(disp: i32, rd: u32) -> u32 {
    let j_imm20: u32 = ((disp as u32) >> 20) & 1;
    let j_imm10_1: u32 = ((disp as u32) >> 1) & 1023;
    let j_imm11: u32 = ((disp as u32) >> 11) & 1;
    let j_imm19_12: u32 = ((disp as u32) >> 12) & 255;
    return 111 | (rd << 7) | (j_imm19_12 << 12) | (j_imm11 << 20) | (j_imm10_1 << 21) | (j_imm20 << 31);
}

fn riscv_emit_load_sized(cg: *mut CodeGen, sz: u64) {
    if sz == 1 {
        cg_emit32(cg, 181507);
    } else if sz == 2 {
        cg_emit32(cg, 185603);
    } else if sz == 4 {
        cg_emit32(cg, 189699);
    } else {
        cg_emit32(cg, 374019);
    }
}

fn riscv_emit_store_sized(cg: *mut CodeGen, sz: u64) {
    if sz == 1 {
        cg_emit32(cg, 10649635);
    } else if sz == 2 {
        cg_emit32(cg, 10653731);
    } else if sz == 4 {
        cg_emit32(cg, 10657827);
    } else {
        cg_emit32(cg, 10842275);
    }
}

fn compile_expr_riscv(cg: *mut CodeGen, node: *mut AstNode) {
    if node == (0 as *mut AstNode) {
        return;
    }
    if node.kind == 116 || node.kind == 136 {
        riscv_emit_mov_imm(cg, 10, node.val);
        return;
    }
    if node.kind == 118 {
        let s_ptr: *u8 = node.hash as *u8;
        let s_len: u32 = node.val as u32;

        let rodata_off: u32 = cg.rodata_size;
        var si: u32 = 1;
        let s_end: u32 = s_len - 1;
        while si < s_end {
            let sc: u8 = s_ptr[si as u64];
            if sc == 92 && (si + 1) < s_end {
                si = si + 1;
                let esc: u8 = s_ptr[si as u64];
                if esc == 110 {
                    cg.rodata_buf[cg.rodata_size as u64] = 10;
                } else if esc == 116 {
                    cg.rodata_buf[cg.rodata_size as u64] = 9;
                } else if esc == 114 {
                    cg.rodata_buf[cg.rodata_size as u64] = 13;
                } else {
                    cg.rodata_buf[cg.rodata_size as u64] = esc;
                }
            } else {
                cg.rodata_buf[cg.rodata_size as u64] = sc;
            }
            cg.rodata_size = cg.rodata_size + 1;
            si = si + 1;
        }
        cg.rodata_buf[cg.rodata_size as u64] = 0;
        cg.rodata_size = cg.rodata_size + 1;

        let vaddr: u64 = 4718592 + (rodata_off as u64);
        riscv_emit_mov_imm(cg, 10, vaddr);
        return;
    }
    if node.kind == 117 {
        let lv: *mut LocalVar = cg_find_local(cg, node.hash);
        if lv != (0 as *mut LocalVar) {
            riscv_emit_mov_imm(cg, 5, lv.rbp_offset as u64);
            cg_emit32(cg, 1079248307);
            if lv.is_struct_val == 1 && lv.is_struct_ptr == 0 {
                cg_emit32(cg, 165139);
            } else {
                cg_emit32(cg, 374019);
            }
        }
        return;
    }
    if node.kind == 131 {
        compile_expr_riscv(cg, node.child1);
        return;
    }
    if node.kind == 112 {
        let operand: *mut AstNode = node.child1;
        if node.val == 53 {
            compile_expr_riscv(cg, operand);
            cg_emit32(cg, 1389843);
            return;
        }
        if node.val == 54 {
            compile_expr_riscv(cg, operand);
            cg_emit32(cg, 4294264083);
            return;
        }
        if node.val == 31 {
            compile_expr_riscv(cg, operand);
            cg_emit32(cg, 1084228915);
            return;
        }
        if node.val == 32 {
            compile_expr_riscv(cg, operand);
            let p_stride: u64 = cg_get_expr_elem_stride(cg, operand);
            cg_emit32(cg, 328339);
            riscv_emit_load_sized(cg, p_stride);
            return;
        }
        if operand != (0 as *mut AstNode) && operand.kind == 117 {
            let lv_r: *mut LocalVar = cg_find_local(cg, operand.hash);
            if lv_r != (0 as *mut LocalVar) {
                riscv_emit_mov_imm(cg, 5, lv_r.rbp_offset as u64);
                cg_emit32(cg, 1079248307);
                cg_emit32(cg, 165139);
                return;
            }
        }
        compile_expr_riscv(cg, operand);
        return;
    }
    if node.kind == 122 {
        let si_lit: *mut StructInfo = cg_find_struct(cg, node.hash);
        var lit_sz: u64 = 24;
        if si_lit != (0 as *mut StructInfo) { lit_sz = si_lit.total_size; }
        let lit_aligned: u64 = ((lit_sz + 7) / 8) * 8;
        cg.current_stack_offset = cg.current_stack_offset + lit_aligned;
        let lit_rbp: u64 = cg.current_stack_offset;

        var fi: *mut AstNode = node.child1;
        while fi != (0 as *mut AstNode) {
            compile_expr_riscv(cg, fi.child1);
            let f_disp: u32 = cg_lookup_field_offset(cg, node.hash, fi.hash);
            let base_off: u64 = lit_rbp - (f_disp as u64);
            riscv_emit_mov_imm(cg, 5, base_off);
            cg_emit32(cg, 1079248307);
            let fm_lit: *mut FieldMeta = cg_find_field_meta(cg, node.hash, fi.hash);
            var fsz_l: u64 = 8;
            if fm_lit != (0 as *mut FieldMeta) { fsz_l = fm_lit.flags & 255; }
            riscv_emit_store_sized(cg, fsz_l);
            fi = fi.next;
        }
        riscv_emit_mov_imm(cg, 5, lit_rbp);
        cg_emit32(cg, 1079248307);
        cg_emit32(cg, 165139);
        return;
    }
    if node.kind == 114 {
        let s_hash: u64 = arm64_resolve_struct_hash(cg, node.child1, node.hash);
        let disp: u32 = cg_lookup_field_offset(cg, s_hash, node.hash);
        compile_expr_riscv(cg, node.child1);
        let hole_offset: u32 = cg.text_size;
        let hi: u32 = (disp + 2048) >> 12;
        let lo: u32 = disp - (hi << 12);
        cg_emit32(cg, 695 | ((hi & 1048575) << 12));
        cg_emit32(cg, 164499 | ((lo & 4095) << 20));
        cg_emit32(cg, 5571251);
        let fm: *mut FieldMeta = cg_find_field_meta(cg, s_hash, node.hash);
        var f_sz: u64 = 8;
        if fm != (0 as *mut FieldMeta) { f_sz = fm.flags & 255; }
        riscv_emit_load_sized(cg, f_sz);
        cg_add_reloc(cg, hole_offset, s_hash, node.hash);
        return;
    }
    if node.kind == 115 {
        compile_expr_riscv(cg, node.child1);
        riscv_push(cg, 10);
        compile_expr_riscv(cg, node.child2);
        let stride: u64 = cg_get_expr_elem_stride(cg, node.child1);
        riscv_emit_mov_imm(cg, 11, stride);
        cg_emit32(cg, 45418803);
        cg_emit32(cg, 328339);
        riscv_pop(cg, 10);
        cg_emit32(cg, 5571251);
        riscv_emit_load_sized(cg, stride);
        return;
    }
    if node.kind == 124 {
        compile_expr_riscv(cg, node.child1);
        let beqz_h: u32 = cg.text_size;
        cg_emit32(cg, 99 | (10 << 15));
        compile_expr_riscv(cg, node.child2);
        let jal_end_h: u32 = cg.text_size;
        cg_emit32(cg, 111);
        let else_off: u32 = cg.text_size;
        riscv_patch_branch(cg, beqz_h, else_off, 99 | (10 << 15));
        if node.child3 != (0 as *mut AstNode) {
            compile_expr_riscv(cg, node.child3);
        } else {
            riscv_emit_mov_imm(cg, 10, 0);
        }
        let end_off: u32 = cg.text_size;
        cg_patch32(cg, jal_end_h, riscv_encode_jal((end_off as i32) - (jal_end_h as i32), 0));
        return;
    }
    if node.kind == 129 {
        compile_expr_riscv(cg, node.child1);
        riscv_push(cg, 10);
        var end_holes: [u32; 64];
        var end_cnt: u32 = 0;
        var arm: *mut AstNode = node.child2;
        while arm != (0 as *mut AstNode) {
            if arm.val == 1 {
                compile_expr_riscv(cg, arm.child2);
                if end_cnt < 64 {
                    end_holes[end_cnt as u64] = cg.text_size;
                    cg_emit32(cg, 111);
                    end_cnt = end_cnt + 1;
                }
            } else {
                var pat_holes: [u32; 16];
                var pat_cnt: u32 = 0;
                var pat: *mut AstNode = arm.child1;
                while pat != (0 as *mut AstNode) {
                    compile_expr_riscv(cg, pat);
                    cg_emit32(cg, 77827 | (11 << 7));
                    if pat_cnt < 16 {
                        pat_holes[pat_cnt as u64] = cg.text_size;
                        pat_cnt = pat_cnt + 1;
                    }
                    cg_emit32(cg, 99 | (10 << 15) | (11 << 20));
                    pat = pat.next;
                }
                let next_arm_h: u32 = cg.text_size;
                cg_emit32(cg, 111);
                let hit_off: u32 = cg.text_size;
                var pi: u32 = 0;
                while pi < pat_cnt {
                    riscv_patch_branch(cg, pat_holes[pi as u64], hit_off, 99 | (10 << 15) | (11 << 20));
                    pi = pi + 1;
                }
                compile_expr_riscv(cg, arm.child2);
                if end_cnt < 64 {
                    end_holes[end_cnt as u64] = cg.text_size;
                    cg_emit32(cg, 111);
                    end_cnt = end_cnt + 1;
                }
                let next_off: u32 = cg.text_size;
                cg_patch32(cg, next_arm_h, riscv_encode_jal((next_off as i32) - (next_arm_h as i32), 0));
            }
            arm = arm.next;
        }
        let m_end: u32 = cg.text_size;
        var ei: u32 = 0;
        while ei < end_cnt {
            let eh: u32 = end_holes[ei as u64];
            cg_patch32(cg, eh, riscv_encode_jal((m_end as i32) - (eh as i32), 0));
            ei = ei + 1;
        }
        riscv_pop(cg, 5);
        return;
    }
    if node.kind == 106 {
        let op: u32 = node.val as u32;
        compile_expr_riscv(cg, node.child1);
        riscv_push(cg, 10);
        compile_expr_riscv(cg, node.child2);
        cg_emit32(cg, 42003);
        riscv_pop(cg, 10);

        if op == 30 { cg_emit32(cg, 12911923); }
        else if op == 31 { cg_emit32(cg, 1086686515); }
        else if op == 32 { cg_emit32(cg, 46466355); }
        else if op == 33 { cg_emit32(cg, 46482739); }
        else if op == 34 { cg_emit32(cg, 46490931); }
        else if op == 50 { cg_emit32(cg, 12940595); }
        else if op == 51 { cg_emit32(cg, 12936499); }
        else if op == 52 { cg_emit32(cg, 12928307); }
        else if op == 47 { cg_emit32(cg, 12916019); }
        else if op == 48 { cg_emit32(cg, 12932403); }
        else if op == 41 {
            cg_emit32(cg, 1086686515);
            cg_emit32(cg, 1389843);
        }
        else if op == 42 {
            cg_emit32(cg, 1086686515);
            cg_emit32(cg, 10500403);
        }
        else if op == 43 { cg_emit32(cg, 12920115); }
        else if op == 44 { cg_emit32(cg, 10888499); }
        else if op == 45 {
            cg_emit32(cg, 10888499);
            cg_emit32(cg, 1062163);
        }
        else if op == 46 {
            cg_emit32(cg, 12920115);
            cg_emit32(cg, 1062163);
        }
        return;
    }
    if node.kind == 113 {
        var cur_a: *mut AstNode = node.child2;
        var a_cnt: u32 = 0;
        while cur_a != (0 as *mut AstNode) && a_cnt < 6 {
            compile_expr_riscv(cg, cur_a);
            riscv_push(cg, 10);
            a_cnt = a_cnt + 1;
            cur_a = cur_a.next;
        }
        var pop_i: u32 = a_cnt;
        while pop_i > 0 {
            pop_i = pop_i - 1;
            riscv_pop(cg, 10 + pop_i);
        }
        let fix: *mut CallFixup = ((cg.call_fixups as *mut u8) + ((cg.call_fixup_count as u64) * 16)) as *mut CallFixup;
        fix.hole_offset = cg.text_size as u64;
        fix.callee_hash = node.hash;
        cg.call_fixup_count = cg.call_fixup_count + 1;
        cg_emit32(cg, 239);
        return;
    }
    if node.kind == 120 {
        compile_expr_riscv(cg, node.child1);
        cg_emit32(cg, 42003);
        riscv_emit_mov_imm(cg, 10, 1);
        var slen: u32 = 8;
        if node.child1.kind == 118 {
            let raw_len: u32 = node.child1.val as u32;
            if raw_len >= 2 { slen = raw_len - 2; }
        }
        riscv_emit_mov_imm(cg, 12, slen as u64);
        riscv_emit_mov_imm(cg, 17, 64);
        cg_emit32(cg, 115);
        return;
    }
    if node.kind == 121 {
        if node.val == 2 {
            cg_emit32(cg, 267386895);
            cg_emit32(cg, 4111);
            return;
        }
        if node.val == 10 { cg_emit32(cg, 46499083); return; }
        if node.val == 11 { cg_emit32(cg, 80057611); return; }
        if node.val == 12 { cg_emit32(cg, 113616139); return; }
        if node.val == 13 { cg_emit32(cg, 147173387); return; }
        return;
    }
    if node.kind == 133 {
        compile_expr_riscv(cg, node.child1);
        let bgez_h: u32 = cg.text_size;
        cg_emit32(cg, 20579 | (10 << 15));
        cg_emit32(cg, 4278452499);
        cg_emit32(cg, 78851);
        cg_emit32(cg, 8466563);
        cg_emit32(cg, 16843027);
        cg_emit32(cg, 32871);
        let ok_off: u32 = cg.text_size;
        riscv_patch_branch(cg, bgez_h, ok_off, 20579 | (10 << 15));
        return;
    }
    if node.kind == 135 {
        var ab: *mut AstNode = node.child1;
        while ab != (0 as *mut AstNode) {
            cg_emit8(cg, (ab.val & 255) as u8);
            ab = ab.next;
        }
        while (cg.text_size % 4) != 0 {
            cg_emit8(cg, 0);
        }
        return;
    }
}

fn compile_stmt_riscv(cg: *mut CodeGen, stmt: *mut AstNode) {
    if stmt == (0 as *mut AstNode) {
        return;
    }
    if stmt.kind == 105 {
        var var_sz: u64 = 8;
        let si_v: *mut StructInfo = cg_find_struct(cg, stmt.val);
        if si_v != (0 as *mut StructInfo) && stmt.id == 0 {
            var_sz = ((si_v.total_size + 7) / 8) * 8;
        }
        cg.current_stack_offset = cg.current_stack_offset + var_sz;
        let lv: *mut LocalVar = ((cg.locals as *mut u8) + ((cg.local_count as u64) * 48)) as *mut LocalVar;
        lv.name_hash = stmt.hash;
        lv.rbp_offset = cg.current_stack_offset;
        lv.size = var_sz;
        lv.is_struct_ptr = stmt.id;
        if si_v != (0 as *mut StructInfo) && stmt.id == 0 {
            lv.is_struct_val = 1;
        } else {
            lv.is_struct_val = 0;
        }
        lv.struct_hash = stmt.val;
        cg.local_count = cg.local_count + 1;

        if stmt.child1 != (0 as *mut AstNode) {
            compile_expr_riscv(cg, stmt.child1);
            riscv_emit_mov_imm(cg, 5, lv.rbp_offset as u64);
            cg_emit32(cg, 1079248307);
            cg_emit32(cg, 10842275);
        }
        return;
    }
    if stmt.kind == 106 {
        let target: *mut AstNode = stmt.child1;
        if target.kind == 117 {
            let lv: *mut LocalVar = cg_find_local(cg, target.hash);
            if lv != (0 as *mut LocalVar) {
                compile_expr_riscv(cg, stmt.child2);
                riscv_emit_mov_imm(cg, 5, lv.rbp_offset as u64);
                cg_emit32(cg, 1079248307);
                cg_emit32(cg, 10842275);
            }
            return;
        }
        if target.kind == 114 {
            let s_hash: u64 = arm64_resolve_struct_hash(cg, target.child1, target.hash);
            let disp: u32 = cg_lookup_field_offset(cg, s_hash, target.hash);
            compile_expr_riscv(cg, target.child1);
            riscv_push(cg, 10);
            compile_expr_riscv(cg, stmt.child2);
            riscv_pop(cg, 6);
            let hole_off: u32 = cg.text_size;
            let hi: u32 = (disp + 2048) >> 12;
            let lo: u32 = disp - (hi << 12);
            cg_emit32(cg, 695 | ((hi & 1048575) << 12));
            cg_emit32(cg, 164499 | ((lo & 4095) << 20));
            cg_emit32(cg, 6455987);
            let fm: *mut FieldMeta = cg_find_field_meta(cg, s_hash, target.hash);
            var f_sz: u64 = 8;
            if fm != (0 as *mut FieldMeta) { f_sz = fm.flags & 255; }
            riscv_emit_store_sized(cg, f_sz);
            cg_add_reloc(cg, hole_off, s_hash, target.hash);
            return;
        }
        if target.kind == 115 {
            compile_expr_riscv(cg, target.child1);
            riscv_push(cg, 10);
            compile_expr_riscv(cg, target.child2);
            let stride: u64 = cg_get_expr_elem_stride(cg, target.child1);
            riscv_emit_mov_imm(cg, 11, stride);
            cg_emit32(cg, 45418803);
            cg_emit32(cg, 328339);
            riscv_pop(cg, 6);
            cg_emit32(cg, 6455987);
            riscv_push(cg, 5);
            compile_expr_riscv(cg, stmt.child2);
            riscv_pop(cg, 5);
            riscv_emit_store_sized(cg, stride);
            return;
        }
        if target.kind == 112 && target.val == 32 {
            compile_expr_riscv(cg, target.child1);
            riscv_push(cg, 10);
            compile_expr_riscv(cg, stmt.child2);
            riscv_pop(cg, 5);
            let p_stride: u64 = cg_get_expr_elem_stride(cg, target.child1);
            riscv_emit_store_sized(cg, p_stride);
            return;
        }
        return;
    }
    if stmt.kind == 126 {
        if cg.loop_depth > 0 && cg.loop_break_holes != (0 as *mut u64) {
            let d: u64 = cg.loop_depth - 1;
            let bcnt: u64 = cg.loop_break_counts[d];
            if bcnt < 64 {
                cg.loop_break_holes[(d * 64) + bcnt] = cg.text_size as u64;
                cg_emit32(cg, 111);
                cg.loop_break_counts[d] = bcnt + 1;
            }
        }
        return;
    }
    if stmt.kind == 127 {
        if cg.loop_depth > 0 && cg.loop_cont_offs != (0 as *mut u64) {
            let cd: u64 = cg.loop_depth - 1;
            let cont_target: u32 = cg.loop_cont_offs[cd] as u32;
            cg_emit32(cg, riscv_encode_jal((cont_target as i32) - (cg.text_size as i32), 0));
        }
        return;
    }
    if stmt.kind == 107 {
        compile_expr_riscv(cg, stmt.child1);
        let beqz_hole: u32 = cg.text_size;
        cg_emit32(cg, 99 | (10 << 15));
        var cur_then: *mut AstNode = stmt.child2;
        while cur_then != (0 as *mut AstNode) {
            compile_stmt_riscv(cg, cur_then);
            cur_then = cur_then.next;
        }
        if stmt.child3 != (0 as *mut AstNode) {
            let jal_end_hole: u32 = cg.text_size;
            cg_emit32(cg, 111);
            let else_target: u32 = cg.text_size;
            riscv_patch_branch(cg, beqz_hole, else_target, 99 | (10 << 15));

            var cur_else: *mut AstNode = stmt.child3;
            while cur_else != (0 as *mut AstNode) {
                compile_stmt_riscv(cg, cur_else);
                cur_else = cur_else.next;
            }

            let end_target: u32 = cg.text_size;
            cg_patch32(cg, jal_end_hole, riscv_encode_jal((end_target as i32) - (jal_end_hole as i32), 0));
        } else {
            let else_target: u32 = cg.text_size;
            riscv_patch_branch(cg, beqz_hole, else_target, 99 | (10 << 15));
        }
        return;
    }
    if stmt.kind == 108 {
        let loop_offset: u32 = cg.text_size;
        let cur_d: u64 = cg.loop_depth;
        if cg.loop_cont_offs != (0 as *mut u64) && cur_d < 32 {
            cg.loop_cont_offs[cur_d] = loop_offset as u64;
            cg.loop_break_counts[cur_d] = 0;
            cg.loop_depth = cur_d + 1;
        }
        compile_expr_riscv(cg, stmt.child1);
        let b_exit_hole: u32 = cg.text_size;
        cg_emit32(cg, 99 | (10 << 15));
        var cur_body: *mut AstNode = stmt.child2;
        while cur_body != (0 as *mut AstNode) {
            compile_stmt_riscv(cg, cur_body);
            cur_body = cur_body.next;
        }
        cg_emit32(cg, riscv_encode_jal((loop_offset as i32) - (cg.text_size as i32), 0));
        let end_target: u32 = cg.text_size;
        riscv_patch_branch(cg, b_exit_hole, end_target, 99 | (10 << 15));

        if cg.loop_cont_offs != (0 as *mut u64) && cur_d < 32 {
            let b_total: u64 = cg.loop_break_counts[cur_d];
            var bi: u64 = 0;
            while bi < b_total {
                let bhole: u32 = cg.loop_break_holes[(cur_d * 64) + bi] as u32;
                cg_patch32(cg, bhole, riscv_encode_jal((end_target as i32) - (bhole as i32), 0));
                bi = bi + 1;
            }
            cg.loop_depth = cur_d;
        }
        return;
    }
    if stmt.kind == 129 {
        compile_expr_riscv(cg, stmt);
        return;
    }
    if stmt.kind == 109 {
        if stmt.child1 != (0 as *mut AstNode) {
            compile_expr_riscv(cg, stmt.child1);
        } else {
            riscv_emit_mov_imm(cg, 10, 0);
        }
        cg_emit32(cg, 4278452499);
        cg_emit32(cg, 78851);
        cg_emit32(cg, 8466563);
        cg_emit32(cg, 16843027);
        cg_emit32(cg, 32871);
        return;
    }
    if stmt.kind == 110 {
        compile_expr_riscv(cg, stmt.child1);
        return;
    }
    if stmt.kind == 132 {
        var us_s: *mut AstNode = stmt.child1;
        while us_s != (0 as *mut AstNode) {
            compile_stmt_riscv(cg, us_s);
            us_s = us_s.next;
        }
        return;
    }
}

fn compile_fn_riscv(cg: *mut CodeGen, fnode: *mut AstNode) {
    let fn_text_offset: u32 = cg.text_size;

    let fe: *mut FnEntry = ((cg.fn_entries as *mut u8) + ((cg.fn_entry_count as u64) * 16)) as *mut FnEntry;
    fe.fn_hash = fnode.hash;
    fe.text_offset = fn_text_offset as u64;
    cg.fn_entry_count = cg.fn_entry_count + 1;

    cg_emit32(cg, 4278255891);
    cg_emit32(cg, 1127459);
    cg_emit32(cg, 8466467);
    cg_emit32(cg, 16843795);

    cg.local_count = 0;
    cg.current_stack_offset = 0;

    var p_idx: u32 = 0;
    var p_cur: *mut AstNode = fnode.child2;
    while p_cur != (0 as *mut AstNode) && p_idx < 6 {
        cg.current_stack_offset = cg.current_stack_offset + 8;
        let lv: *mut LocalVar = ((cg.locals as *mut u8) + ((cg.local_count as u64) * 48)) as *mut LocalVar;
        lv.name_hash = p_cur.hash;
        lv.rbp_offset = cg.current_stack_offset;
        lv.size = 8;
        lv.is_struct_ptr = p_cur.id;
        lv.is_struct_val = 0;
        lv.struct_hash = p_cur.val;
        cg.local_count = cg.local_count + 1;

        riscv_emit_mov_imm(cg, 5, lv.rbp_offset as u64);
        cg_emit32(cg, 1079248307);
        cg_emit32(cg, 77859 | ((10 + p_idx) << 20));
        p_idx = p_idx + 1;
        p_cur = p_cur.next;
    }

    var stmt: *mut AstNode = fnode.child1;
    while stmt != (0 as *mut AstNode) {
        compile_stmt_riscv(cg, stmt);
        stmt = stmt.next;
    }

    cg_emit32(cg, 4278452499);
    cg_emit32(cg, 78851);
    cg_emit32(cg, 8466563);
    cg_emit32(cg, 16843027);
    cg_emit32(cg, 32871);

    if fnode.hash == 2258945139493307336 && cg.call_main_hole != 0 {
        let disp: i32 = (fn_text_offset as i32) - (cg.call_main_hole as i32);
        cg_patch32(cg, cg.call_main_hole as u32, riscv_encode_jal(disp, 1));
        cg.call_main_hole = 0;
    }
}
