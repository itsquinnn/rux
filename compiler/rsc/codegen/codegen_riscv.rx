fn riscv_emit_mov_imm(cg: *mut CodeGen, reg: u32, val: u64) {
    let sval: i64 = val as i64;
    if sval >= -2048 && sval <= 2047 {
        let imm: u32 = (val as u32) & 4095;
        cg_emit32(cg, 19 | (imm << 20) | (reg << 7));
        return;
    }
    if sval >= -2147483648 && sval <= 2147483647 {
        let v32: u32 = val as u32;
        let hi: u32 = (v32 + 2048) >> 12;
        let lo: u32 = v32 - (hi << 12);
        cg_emit32(cg, 55 | ((hi & 1048575) << 12) | (reg << 7));
        cg_emit32(cg, 19 | ((lo & 4095) << 20) | (reg << 15) | (reg << 7));
        return;
    }
    let hi32: u32 = ((val >> 32) & 4294967295) as u32;
    let h_hi: u32 = (hi32 + 2048) >> 12;
    let h_lo: u32 = hi32 - (h_hi << 12);
    cg_emit32(cg, 55 | ((h_hi & 1048575) << 12) | (reg << 7));
    cg_emit32(cg, 19 | ((h_lo & 4095) << 20) | (reg << 15) | (reg << 7));
    let c1: u32 = ((val >> 21) & 2047) as u32;
    let c2: u32 = ((val >> 10) & 2047) as u32;
    let c3: u32 = (val & 1023) as u32;
    cg_emit32(cg, 4115 | (11 << 20) | (reg << 15) | (reg << 7));
    if c1 != 0 { cg_emit32(cg, 24595 | (c1 << 20) | (reg << 15) | (reg << 7)); }
    cg_emit32(cg, 4115 | (11 << 20) | (reg << 15) | (reg << 7));
    if c2 != 0 { cg_emit32(cg, 24595 | (c2 << 20) | (reg << 15) | (reg << 7)); }
    cg_emit32(cg, 4115 | (10 << 20) | (reg << 15) | (reg << 7));
    if c3 != 0 { cg_emit32(cg, 24595 | (c3 << 20) | (reg << 15) | (reg << 7)); }
}

fn riscv_patch_call(cg: *mut CodeGen, hole: u32, target: u32) {
    let rdisp: i32 = (target as i32) - (hole as i32);
    let rhi: u32 = ((rdisp + 2048) >> 12) as u32;
    let rlo: u32 = (rdisp - ((rhi as i32) << 12)) as u32;
    cg_patch32(cg, hole, 791 | ((rhi & 1048575) << 12));
    cg_patch32(cg, hole + 4, 196839 | ((rlo & 4095) << 20));
}

fn riscv_push(cg: *mut CodeGen, reg: u32) {
    cg_emit32(cg, 4278255891);
    cg_emit32(cg, 77859 | (reg << 20));
}

fn riscv_pop(cg: *mut CodeGen, reg: u32) {
    cg_emit32(cg, 77827 | (reg << 7));
    cg_emit32(cg, 16843027);
}

fn riscv_patch_branch(cg: *mut CodeGen, hole: u32, target: u32, base_op: u32) {
    let d: i32 = (target as i32) - (hole as i32);
    let imm12: u32 = ((d as u32) >> 12) & 1;
    let imm10_5: u32 = ((d as u32) >> 5) & 63;
    let imm4_1: u32 = ((d as u32) >> 1) & 15;
    let imm11: u32 = ((d as u32) >> 11) & 1;
    let insn: u32 = base_op | (imm11 << 7) | (imm4_1 << 8) | (imm10_5 << 25) | (imm12 << 31);
    cg_patch32(cg, hole, insn);
}

fn riscv_encode_jal(disp: i32, rd: u32) -> u32 {
    let j_imm20: u32 = ((disp as u32) >> 20) & 1;
    let j_imm10_1: u32 = ((disp as u32) >> 1) & 1023;
    let j_imm11: u32 = ((disp as u32) >> 11) & 1;
    let j_imm19_12: u32 = ((disp as u32) >> 12) & 255;
    return 111 | (rd << 7) | (j_imm19_12 << 12) | (j_imm11 << 20) | (j_imm10_1 << 21) | (j_imm20 << 31);
}

fn riscv_emit_load_sized_ex(cg: *mut CodeGen, sz: u64, is_sgn: u32) {
    if sz == 1 {
        if is_sgn == 1 { cg_emit32(cg, 165123); } else { cg_emit32(cg, 181507); }
    } else if sz == 2 {
        if is_sgn == 1 { cg_emit32(cg, 169219); } else { cg_emit32(cg, 185603); }
    } else if sz == 4 {
        if is_sgn == 1 { cg_emit32(cg, 173315); } else { cg_emit32(cg, 189699); }
    } else {
        cg_emit32(cg, 177411);
    }
}

fn riscv_emit_load_sized(cg: *mut CodeGen, sz: u64) {
    riscv_emit_load_sized_ex(cg, sz, 0);
}

fn riscv_emit_memcpy_a0_to_t0(cg: *mut CodeGen, copy_sz: u64) {
    if copy_sz == 0 { return; }
    riscv_emit_mov_imm(cg, 7, copy_sz);
