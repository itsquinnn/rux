    let wi_back: i32 = (wi_loop as i32) - (((cg.text_size as u32) + 4) as i32);
    cg_emit32(cg, wi_back as u32);
    cg_emit8(cg, 133); cg_emit8(cg, 201);
    cg_emit8(cg, 116); cg_emit8(cg, 6);
    cg_emit8(cg, 198); cg_emit8(cg, 7); cg_emit8(cg, 45);
    cg_emit8(cg, 72); cg_emit8(cg, 255); cg_emit8(cg, 207);
    cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 119); cg_emit8(cg, 1);
    cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 84); cg_emit8(cg, 36); cg_emit8(cg, 32);
    cg_emit8(cg, 72); cg_emit8(cg, 41); cg_emit8(cg, 242);
    cg_emit8(cg, 191); cg_emit32(cg, 2);
    cg_emit8(cg, 184); cg_emit32(cg, 1);
    cg_emit8(cg, 15); cg_emit8(cg, 5);
    cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 196); cg_emit8(cg, 32);
    cg_emit8(cg, 195);

    let resolve_fn_off: u32 = cg.text_size as u32;
