    rt_emit_print_ro(cg, ro_msg_lparen, write_cstr_off);
    rt_emit_print_ro(cg, cg.dbg_file_ro_off as u32, write_cstr_off);
    rt_emit_print_ro(cg, ro_msg_plus0x, write_cstr_off);
    cg_emit8(cg, 88);
    rt_emit_call_rel(cg, write_hex_off);
    rt_emit_print_ro(cg, ro_msg_rparen_nl, write_cstr_off);
    cg_emit8(cg, 195);
    let pf_unk_off: u32 = cg.text_size as u32;
