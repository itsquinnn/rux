    cg_emit8(cg, 121); cg_emit8(cg, 8);
    cg_emit8(cg, 72); cg_emit8(cg, 247); cg_emit8(cg, 216);
    cg_emit8(cg, 185); cg_emit32(cg, 1);
    cg_emit8(cg, 65); cg_emit8(cg, 184); cg_emit32(cg, 10);
