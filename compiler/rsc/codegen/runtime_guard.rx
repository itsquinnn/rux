struct DbgFnSym {
    start_off: u32,
    end_off: u32,
    name_ro_off: u32,
    reserved: u32,
}

fn rt_emit_ro_bytes(cg: *mut CodeGen, ptr: *u8, len: u64) -> u32 {
    let off: u32 = cg.rodata_size as u32;
    var i: u64 = 0;
    while i < len {
        cg.rodata_buf[cg.rodata_size] = ptr[i];
        cg.rodata_size = cg.rodata_size + 1;
        i = i + 1;
    }
    cg.rodata_buf[cg.rodata_size] = 0;
    cg.rodata_size = cg.rodata_size + 1;
    return off;
}

fn rt_emit_ro_cstr(cg: *mut CodeGen, s: *u8) -> u32 {
    if s == (0 as *u8) {
        let off0: u32 = cg.rodata_size as u32;
        cg.rodata_buf[cg.rodata_size] = 0;
        cg.rodata_size = cg.rodata_size + 1;
        return off0;
    }
    var len: u64 = 0;
    while s[len] != 0 {
        len = len + 1;
    }
    return rt_emit_ro_bytes(cg, s, len);
}

fn rt_emit_ro_u32(cg: *mut CodeGen, v: u32) {
    cg.rodata_buf[cg.rodata_size] = (v & 255) as u8;
    cg.rodata_buf[cg.rodata_size + 1] = ((v >> 8) & 255) as u8;
    cg.rodata_buf[cg.rodata_size + 2] = ((v >> 16) & 255) as u8;
    cg.rodata_buf[cg.rodata_size + 3] = ((v >> 24) & 255) as u8;
    cg.rodata_size = cg.rodata_size + 4;
}

fn rt_emit_ro_u64(cg: *mut CodeGen, v: u64) {
    rt_emit_ro_u32(cg, (v & 4294967295) as u32);
    rt_emit_ro_u32(cg, ((v >> 32) & 4294967295) as u32);
}

fn rt_guard_init(cg: *mut CodeGen, arena: *mut Arena, in_path: *u8) {
    cg.dbg_fns = arena_alloc(arena, 524288);
    cg.dbg_fn_count = 0;
    cg.dbg_file_ro_off = rt_emit_ro_cstr(cg, in_path) as u64;
    cg.rt_install_hole = 0;
    cg.rt_bounds_holes = arena_alloc(arena, 131072) as *mut u32;
    cg.rt_bounds_hole_count = 0;
}

fn rt_guard_record_fn(cg: *mut CodeGen, fnode: *mut AstNode, fn_start: u32, fn_end: u32) {
    if cg.dbg_fns == (0 as *mut u8) || cg.dbg_fn_count >= 32768 {
        return;
    }
    var name_ro: u32 = 0;
    if fnode != (0 as *mut AstNode) && fnode.child3 != (0 as *mut AstNode) {
        let nm: *mut AstNode = fnode.child3;
        if nm.kind == 199 && nm.hash != 0 && nm.val > 0 && nm.val < 256 {
            name_ro = rt_emit_ro_bytes(cg, nm.hash as *u8, nm.val);
        }
    }
    if name_ro == 0 {
        name_ro = rt_emit_ro_cstr(cg, "<anonymous>");
    }
    let sym: *mut DbgFnSym = (cg.dbg_fns + (cg.dbg_fn_count * 16)) as *mut DbgFnSym;
    sym.start_off = fn_start;
    sym.end_off = fn_end;
    sym.name_ro_off = name_ro;
    sym.reserved = 0;
    cg.dbg_fn_count = cg.dbg_fn_count + 1;
}

fn rt_guard_emit_bounds_check(cg: *mut CodeGen, base_expr: *mut AstNode, stride: u64) {
    if cg.target_arch != 0 || cg.is_freestanding != 0 {
        return;
    }
    if base_expr == (0 as *mut AstNode) || base_expr.kind != 117 || stride == 0 {
        return;
    }
    let lv: *mut LocalVar = cg_find_local(cg, base_expr.hash);
    if lv == (0 as *mut LocalVar) {
        return;
    }
    if lv.is_struct_val == 1 && (lv.is_struct_ptr == 10 || lv.is_struct_ptr == 11 || lv.is_struct_ptr >= 100) && lv.size >= stride {
        let elem_cnt: u64 = lv.size / stride;
        if elem_cnt > 0 && elem_cnt < 2147483647 && cg.rt_bounds_holes != (0 as *mut u32) && cg.rt_bounds_hole_count < 32768 {
            cg_emit8(cg, 72); cg_emit8(cg, 61); cg_emit32(cg, elem_cnt as u32);
            cg_emit8(cg, 114); cg_emit8(cg, 10);
            cg_emit8(cg, 186); cg_emit32(cg, elem_cnt as u32);
            cg_emit8(cg, 232);
            cg.rt_bounds_holes[cg.rt_bounds_hole_count] = cg.text_size as u32;
            cg.rt_bounds_hole_count = cg.rt_bounds_hole_count + 1;
            cg_emit32(cg, 0);
        }
    }
}

fn rt_emit_call_rel(cg: *mut CodeGen, target_off: u32) {
    cg_emit8(cg, 232);
    let d: i32 = (target_off as i32) - (((cg.text_size as u32) + 4) as i32);
    cg_emit32(cg, d as u32);
}

fn rt_emit_jmp_rel(cg: *mut CodeGen, target_off: u32) {
    cg_emit8(cg, 233);
    let d: i32 = (target_off as i32) - (((cg.text_size as u32) + 4) as i32);
    cg_emit32(cg, d as u32);
}

fn rt_emit_print_ro(cg: *mut CodeGen, ro_off: u32, write_cstr_off: u32) {
    cg_emit8(cg, 73); cg_emit8(cg, 141); cg_emit8(cg, 181);
    cg_emit32(cg, ro_off);
    rt_emit_call_rel(cg, write_cstr_off);
}

fn rt_emit_load_bases(cg: *mut CodeGen) {
    cg_emit8(cg, 76); cg_emit8(cg, 141); cg_emit8(cg, 37);
    let t_disp: i32 = 0 - (((cg.text_size as u32) + 4) as i32);
    cg_emit32(cg, t_disp as u32);
    cg_emit8(cg, 76); cg_emit8(cg, 141); cg_emit8(cg, 45);
    let r_hole: u32 = cg.text_size as u32;
    cg_emit32(cg, 0);
    cg_add_rodata_fixup(cg, r_hole, 0);
}

fn rt_emit_sigaction_reg(cg: *mut CodeGen, sig: u32) {
    cg_emit8(cg, 191); cg_emit32(cg, sig);
    cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 117); cg_emit8(cg, 192);
    cg_emit8(cg, 49); cg_emit8(cg, 210);
    cg_emit8(cg, 65); cg_emit8(cg, 186); cg_emit32(cg, 8);
    cg_emit8(cg, 184); cg_emit32(cg, 13);
    cg_emit8(cg, 15); cg_emit8(cg, 5);
}

fn rt_guard_emit_all(cg: *mut CodeGen) {
    if cg.target_arch != 0 || cg.is_freestanding != 0 {
        return;
    }

    let ro_msg_null: u32 = rt_emit_ro_cstr(cg, "\nUncaught TypeError: Cannot read or write memory of null pointer (address 0x");
    let ro_msg_segv: u32 = rt_emit_ro_cstr(cg, "\nUncaught ReferenceError: Invalid memory access at address 0x");
    let ro_msg_stack: u32 = rt_emit_ro_cstr(cg, "\nUncaught RangeError: Maximum call stack size exceeded\n");
    let ro_msg_fpe: u32 = rt_emit_ro_cstr(cg, "\nUncaught RangeError: Division or modulo by zero\n");
    let ro_msg_ill: u32 = rt_emit_ro_cstr(cg, "\nUncaught RuntimeError: Illegal or privileged CPU instruction at 0x");
    let ro_msg_bus: u32 = rt_emit_ro_cstr(cg, "\nUncaught MemoryError: Bus error at address 0x");
    let ro_msg_abrt: u32 = rt_emit_ro_cstr(cg, "\nUncaught RuntimeError: Process aborted (SIGABRT)\n");
    let ro_msg_oob1: u32 = rt_emit_ro_cstr(cg, "\nUncaught RangeError: Array index out of bounds (index ");
    let ro_msg_oob2: u32 = rt_emit_ro_cstr(cg, ", length ");
    let ro_msg_rparen_nl: u32 = rt_emit_ro_cstr(cg, ")\n");
    let ro_msg_nl: u32 = rt_emit_ro_cstr(cg, "\n");
    let ro_msg_at: u32 = rt_emit_ro_cstr(cg, "    at ");
    let ro_msg_lparen: u32 = rt_emit_ro_cstr(cg, " (");
    let ro_msg_plus0x: u32 = rt_emit_ro_cstr(cg, "+0x");
    let ro_msg_unknown: u32 = rt_emit_ro_cstr(cg, "<unknown> (0x");

    cg.rodata_size = ((cg.rodata_size + 7) / 8) * 8;
    let dbg_dir_ro_off: u32 = cg.rodata_size as u32;
    rt_emit_ro_u64(cg, cg.dbg_fn_count);
    rt_emit_ro_u64(cg, cg.dbg_file_ro_off);
    var si: u64 = 0;
    while si < cg.dbg_fn_count {
        let sym: *mut DbgFnSym = (cg.dbg_fns + (si * 16)) as *mut DbgFnSym;
        rt_emit_ro_u32(cg, sym.start_off);
        rt_emit_ro_u32(cg, sym.end_off);
        rt_emit_ro_u32(cg, sym.name_ro_off);
        rt_emit_ro_u32(cg, 0);
        si = si + 1;
    }

    let restorer_off: u32 = cg.text_size as u32;
    cg_emit8(cg, 72); cg_emit8(cg, 199); cg_emit8(cg, 192); cg_emit32(cg, 15);
    cg_emit8(cg, 15); cg_emit8(cg, 5);

    let write_cstr_off: u32 = cg.text_size as u32;
    cg_emit8(cg, 49); cg_emit8(cg, 210);
    cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 246);
    cg_emit8(cg, 15); cg_emit8(cg, 132);
    let wc_done_hole: u32 = cg.text_size as u32;
    cg_emit32(cg, 0);
    let wc_loop: u32 = cg.text_size as u32;
    cg_emit8(cg, 128); cg_emit8(cg, 60); cg_emit8(cg, 22); cg_emit8(cg, 0);
    cg_emit8(cg, 15); cg_emit8(cg, 132);
    let wc_write_hole: u32 = cg.text_size as u32;
    cg_emit32(cg, 0);
    cg_emit8(cg, 72); cg_emit8(cg, 255); cg_emit8(cg, 194);
    rt_emit_jmp_rel(cg, wc_loop);
    let wc_write_off: u32 = cg.text_size as u32;
    cg_patch32(cg, wc_write_hole, wc_write_off - (wc_write_hole + 4));
    cg_emit8(cg, 191); cg_emit32(cg, 2);
    cg_emit8(cg, 184); cg_emit32(cg, 1);
    cg_emit8(cg, 15); cg_emit8(cg, 5);
    let wc_done_off: u32 = cg.text_size as u32;
