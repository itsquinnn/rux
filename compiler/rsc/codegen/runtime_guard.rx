    cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 84); cg_emit8(cg, 36); cg_emit8(cg, 32);
    cg_emit8(cg, 72); cg_emit8(cg, 41); cg_emit8(cg, 242);
