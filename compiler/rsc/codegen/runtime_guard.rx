fn rt_emit_builtin_fallbacks(cg: *mut CodeGen) {
    if cg == (0 as *mut CodeGen) { return; }
    if cg.target_arch != 0 { return; }
    let sys_exit_h: u64 = hash_identifier("sys_exit", 8);
    if diag_is_symbol_defined(cg, sys_exit_h) == 1 { return; }
    var needed: u32 = 0;
    var i: u64 = 0;
    while i < cg.sym_check_count {
        let ce: *mut ConstEntry = ((cg.sym_checks as *mut u8) + (i * 24)) as *mut ConstEntry;
        if ce.name_hash == sys_exit_h {
            needed = 1;
            i = cg.sym_check_count;
        } else {
            i = i + 1;
        }
    }
    if needed == 1 {
        let fn_off: u32 = cg.text_size;
        cg_emit8(cg, 184); cg_emit32(cg, 60);
        cg_emit8(cg, 15); cg_emit8(cg, 5);
        cg_emit8(cg, 195);
        let fe: *mut FnEntry = ((cg.fn_entries as *mut u8) + ((cg.fn_entry_count as u64) * 16)) as *mut FnEntry;
        fe.fn_hash = sys_exit_h;
        fe.text_offset = fn_off as u64;
        cg.fn_entry_count = cg.fn_entry_count + 1;
    }
    let eval_h: u64 = hash_identifier("eval", 4);
    var eval_defined: u32 = 0;
    var efi: u64 = 0;
    while efi < cg.fn_entry_count {
        let efe: *mut FnEntry = ((cg.fn_entries as *mut u8) + (efi * 16)) as *mut FnEntry;
        if efe.fn_hash == eval_h { eval_defined = 1; }
        efi = efi + 1;
    }
    if eval_defined == 0 {
        var eval_needed: u32 = 0;
        var ei: u64 = 0;
        while ei < cg.sym_check_count {
            let ece: *mut ConstEntry = ((cg.sym_checks as *mut u8) + (ei * 24)) as *mut ConstEntry;
            if ece.name_hash == eval_h {
                eval_needed = 1;
                ei = cg.sym_check_count;
            } else {
                ei = ei + 1;
            }
        }
        if eval_needed == 1 {
            let eval_off: u32 = cg.text_size;
            cg_emit8(cg, 49); cg_emit8(cg, 192);
            cg_emit8(cg, 195);
            let efe2: *mut FnEntry = ((cg.fn_entries as *mut u8) + ((cg.fn_entry_count as u64) * 16)) as *mut FnEntry;
            efe2.fn_hash = eval_h;
            efe2.text_offset = eval_off as u64;
            cg.fn_entry_count = cg.fn_entry_count + 1;
        }
    }
}

