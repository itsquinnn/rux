    cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 199); cg_emit8(cg, 16);
    let rf_loop: u32 = cg.text_size as u32;
    cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 201);
    cg_emit8(cg, 15); cg_emit8(cg, 132);
    let rf_nf_hole2: u32 = cg.text_size as u32;
    cg_emit32(cg, 0);
    cg_emit8(cg, 139); cg_emit8(cg, 23);
    cg_emit8(cg, 72); cg_emit8(cg, 57); cg_emit8(cg, 208);
