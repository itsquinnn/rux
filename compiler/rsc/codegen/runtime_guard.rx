    cg_emit8(cg, 76); cg_emit8(cg, 137); cg_emit8(cg, 238);
    cg_emit8(cg, 72); cg_emit8(cg, 1); cg_emit8(cg, 214);
    cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 194);
    cg_emit8(cg, 184); cg_emit32(cg, 1);
