fn continuum_ast_node_uses_eval(n: *mut AstNode, eval_h: u64) -> u32 {
    if n == (0 as *mut AstNode) { return 0; }
    if n.kind == 113 && n.hash == eval_h { return 1; }
    if continuum_ast_node_uses_eval(n.child1, eval_h) == 1 { return 1; }
    if n.kind != 105 && continuum_ast_node_uses_eval(n.child2, eval_h) == 1 { return 1; }
    if n.kind != 102 && n.kind != 105 && continuum_ast_node_uses_eval(n.child3, eval_h) == 1 { return 1; }
    if continuum_ast_node_uses_eval(n.next, eval_h) == 1 { return 1; }
    return 0;
}

fn continuum_ast_uses_eval(p: *mut Parser) -> u32 {
    let eval_h: u64 = hash_identifier("eval", 4);
    var i: u64 = 0;
    while i < p.fn_ast_count {
        let slot: *u64 = (p.fn_asts + (i * 16)) as *u64;
        let fnode: *mut AstNode = slot[1] as *mut AstNode;
        if fnode != (0 as *mut AstNode) {
            if continuum_ast_node_uses_eval(fnode.child1, eval_h) == 1 {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn continuum_find_fn_text_off(cg: *mut CodeGen, fn_hash: u64) -> i64 {
    var i: u64 = 0;
    while i < cg.fn_entry_count {
        let fe: *mut FnEntry = ((cg.fn_entries as *mut u8) + (i * 16)) as *mut FnEntry;
        if fe.fn_hash == fn_hash {
            return fe.text_offset as i64;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn continuum_jit_exec(cg: *mut CodeGen, entry_hash: u64, in_path: *u8, in_path_idx: u64, argc: u64, argv: *mut *mut u8, isolate_fork: u32) -> i64 {
    let entry_off: i64 = continuum_find_fn_text_off(cg, entry_hash);
    if entry_off < 0 { return 0; }

    let ro_base_off: u64 = (((cg.text_size as u64) + 63) / 64) * 64;
    let total_raw: u64 = ro_base_off + (cg.rodata_size as u64) + 4096;
    let map_cap: u64 = ((total_raw + 4095) / 4096) * 4096;
    let jit_mem: *mut u8 = acrq_port_submit(5, 0, 7, 0, map_cap, 34) as *mut u8;
    if (jit_mem as i64) <= 0 {
        diag_write_cstr("Uncaught MemoryError: JIT mmap allocation failed\n");
        return 1;
    }

    var ti: u64 = 0;
    while ti < (cg.text_size as u64) {
        jit_mem[ti] = cg.text_buf[ti];
        ti = ti + 1;
    }
    var ri: u64 = 0;
    while ri < (cg.rodata_size as u64) {
        jit_mem[ro_base_off + ri] = cg.rodata_buf[ri];
        ri = ri + 1;
    }

    var rfi: u64 = 0;
    while rfi < cg.rodata_fixup_count {
        let rf: *mut RodataFixup = ((cg.rodata_fixups as *mut u8) + (rfi * 16)) as *mut RodataFixup;
        let disp: i32 = ((ro_base_off + rf.rodata_off) as i32) - ((rf.hole_offset as i32) + 4);
        let hp: *mut u32 = (jit_mem + rf.hole_offset) as *mut u32;
        hp[0] = disp as u32;
        rfi = rfi + 1;
    }

    @silicon.mfence();

    var c_argv: [u64; 32];
    c_argv[0] = in_path as u64;
    var ca_n: u64 = 1;
    if in_path_idx > 0 {
        var fw_i: u64 = in_path_idx + 1;
        while fw_i < argc && ca_n < 31 {
            c_argv[ca_n] = argv[fw_i] as u64;
            ca_n = ca_n + 1;
            fw_i = fw_i + 1;
        }
    }
    c_argv[ca_n] = 0;

    if isolate_fork == 1 {
        let pid: i64 = syscall(56, 17, 0, 0, 0, 0);
        if pid == 0 {
            if cg.rt_install_hole > 0 {
                let rdisp: i32 = ((jit_mem + cg.rt_install_hole) as *i32)[0];
                if rdisp != 0 {
                    let rt_fn: *mut u8 = jit_mem + (((cg.rt_install_hole as i64) + 4 + (rdisp as i64)) as u64);
                    rt_fn();
                }
            }
            let jfn_c: *mut u8 = jit_mem + (entry_off as u64);
            let jret_c: i64 = jfn_c(ca_n, (&mut c_argv[0]) as *mut *mut u8);
            sys_exit(jret_c as int);
        }
        if pid > 0 {
            var wstatus: u64 = 0;
            syscall(61, pid as u64, (&mut wstatus) as u64, 0, 0);
            acrq_port_submit(6, 0, 0, jit_mem as u64, map_cap, 0);
            let ws: u64 = wstatus & 4294967295;
            if (ws & 127) != 0 { return (128 + (ws & 127)) as i64; }
            return ((ws >> 8) & 255) as i64;
        }
    }

    if cg.rt_install_hole > 0 {
        let rdisp2: i32 = ((jit_mem + cg.rt_install_hole) as *i32)[0];
        if rdisp2 != 0 {
            let rt_fn2: *mut u8 = jit_mem + (((cg.rt_install_hole as i64) + 4 + (rdisp2 as i64)) as u64);
            rt_fn2();
        }
    }

    let jfn: *mut u8 = jit_mem + (entry_off as u64);
    let ret: i64 = jfn(ca_n, (&mut c_argv[0]) as *mut *mut u8);
    acrq_port_submit(6, 0, 0, jit_mem as u64, map_cap, 0);
    return ret;
}

fn repl_read_line(dst: *mut u8, max_len: u64, eof_out: *mut u32) -> u64 {
    var len: u64 = 0;
    var ch: [u8; 4];
    while len + 2 < max_len {
        let nr: i64 = acrq_port_submit(2, 0, 0, 0, (&mut ch[0]) as u64, 1);
        if nr <= 0 {
            if len == 0 { *eof_out = 1; }
            dst[len] = 0;
            return len;
        }
        if ch[0] == 10 {
            dst[len] = 0;
            return len;
        }
        if ch[0] != 13 {
            dst[len] = ch[0];
            len = len + 1;
        }
    }
    dst[len] = 0;
    return len;
}

fn repl_brace_delta(s: *u8, len: u64) -> i64 {
    var delta: i64 = 0;
    var in_str: u32 = 0;
    var i: u64 = 0;
    while i < len {
        let c: u8 = s[i];
        if in_str == 1 {
            if c == 92 { i = i + 1; }
            else if c == 34 { in_str = 0; }
        } else {
            if c == 34 { in_str = 1; }
            else if c == 123 { delta = delta + 1; }
            else if c == 125 { delta = delta - 1; }
        }
        i = i + 1;
    }
    return delta;
}

fn continuum_repl_loop(parse_arena: *mut Arena, cg_arena: *mut Arena) -> i64 {
    var tios: [u8; 64];
    let is_tty: i64 = syscall(16, 0, 21505, (&mut tios[0]) as u64, 0, 0);
    if is_tty == 0 {
        uses_println("Rux Omni-Modal Interactive REPL v1.0.0 (:help for commands, :quit to exit)");
    }

    var lex: Lexer;
    lex.src = "";
    lex.len = 0;
    lex.pos = 0;
    lex.line = 1;
    lex.col = 1;

    var parser: Parser;
    parser.lex = &mut lex;
    parser.arena = parse_arena;
    parser.node_count = 0;
    parser.struct_count = 0;
    parser.fn_count = 0;
    parser.consts = arena_alloc(parse_arena, 98304) as *mut ConstEntry;
    parser.const_count = 0;
    parser.aliases = arena_alloc(parse_arena, 49152) as *mut ConstEntry;
    parser.alias_count = 0;
    parser.known_structs = arena_alloc(parse_arena, 49152) as *mut ConstEntry;
    parser.known_struct_count = 0;
    parser.anon_fns = 0 as *mut AstNode;
    parser.anon_fn_last = 0 as *mut AstNode;
    parser.anon_fn_count = 0;
    parser.generic_structs = arena_alloc(parse_arena, 65536);
    parser.generic_struct_count = 0;
    parser.generic_fns = arena_alloc(parse_arena, 65536);
    parser.generic_fn_count = 0;
    parser.instantiations = arena_alloc(parse_arena, 65536) as *mut ConstEntry;
    parser.instantiation_count = 0;
    parser.traits = arena_alloc(parse_arena, 65536);
    parser.trait_count = 0;
    parser.trait_impls = arena_alloc(parse_arena, 65536);
    parser.trait_impl_count = 0;
    parser.fn_asts = arena_alloc(parse_arena, 65536);
    parser.fn_ast_count = 0;
    parser.src_path = "<repl>";
    parser.no_exit_on_err = 1;
    parser.had_error = 0;

    var cg: CodeGen;
    cg.structs = arena_alloc(cg_arena, 262144) as *mut StructInfo;
    cg.struct_count = 0;
    cg.type_graph = arena_alloc(cg_arena, 262144) as *mut EiaTypeGraphEntry;
    cg.tg_count = 0;
    cg.field_metas = arena_alloc(cg_arena, 262144) as *mut FieldMeta;
    cg.field_meta_count = 0;
    cg.parser = (&mut parser) as *mut u8;
    parser.cg = (&mut cg) as *mut u8;

    traits_init(&mut parser);
    parser_add_const(&mut parser, hash_identifier("true", 4), 1, 1);
    parser_add_const(&mut parser, hash_identifier("false", 5), 0, 1);
    parser_add_const(&mut parser, hash_identifier("null", 4), 0, 1);
    parser_add_const(&mut parser, hash_identifier("nil", 3), 0, 1);

    var st: InterpState;
    interp_init(&mut st, &mut parser, &mut cg, 1);

    let line_buf: *mut u8 = uses_alloc(65536);
    let turn_buf: *mut u8 = uses_alloc(131072);
    var eof: u32 = 0;
    var repl_tier: u32 = 4;

    while eof == 0 {
        if is_tty == 0 { uses_print("rux> "); }
        var tlen: u64 = repl_read_line(turn_buf, 65536, &mut eof);
        if eof == 1 && tlen == 0 { break; }

        var bdepth: i64 = repl_brace_delta(turn_buf, tlen);
        while bdepth > 0 && eof == 0 {
            if is_tty == 0 { uses_print("...  "); }
            let nlen: u64 = repl_read_line(line_buf, 16384, &mut eof);
            turn_buf[tlen] = 10;
            tlen = tlen + 1;
            var ci: u64 = 0;
            while ci < nlen && (tlen + 2) < 131072 {
                turn_buf[tlen] = line_buf[ci];
                tlen = tlen + 1;
                ci = ci + 1;
            }
            turn_buf[tlen] = 0;
            bdepth = bdepth + repl_brace_delta(line_buf, nlen);
        }

        var trim_i: u64 = 0;
        while trim_i < tlen && (turn_buf[trim_i] == 32 || turn_buf[trim_i] == 9) {
            trim_i = trim_i + 1;
        }
        let cmd: *u8 = turn_buf + trim_i;
        if cmd[0] == 0 { continue; }
        if str_eq(cmd, ":quit") == 1 || str_eq(cmd, ":q") == 1 || str_eq(cmd, "exit") == 1 {
            break;
        }
        if str_eq(cmd, ":help") == 1 {
            uses_println("Commands: :help | :mode [interp|vm|jit] | :reset | :quit");
            continue;
        }
        if str_starts_with(cmd, ":mode", 5) == 1 {
            if str_eq(cmd, ":mode interp") == 1 { repl_tier = 4; uses_println("[repl] mode=interp"); }
            else if str_eq(cmd, ":mode vm") == 1 { repl_tier = 5; uses_println("[repl] mode=vm"); }
            else if str_eq(cmd, ":mode jit") == 1 { repl_tier = 3; uses_println("[repl] mode=jit"); }
            else {
                if repl_tier == 4 { uses_println("[repl] mode=interp"); }
                else if repl_tier == 5 { uses_println("[repl] mode=vm"); }
                else { uses_println("[repl] mode=jit"); }
            }
            continue;
        }
        if str_eq(cmd, ":reset") == 1 {
            st.var_top = 0;
            st.frame_base = 0;
            parser.fn_ast_count = 0;
            parser.const_count = 4;
            uses_println("[repl] session state cleared");
            continue;
        }

        let src_copy: *mut u8 = arena_alloc(parse_arena, tlen + 8);
        var cpi: u64 = 0;
        while cpi <= tlen { src_copy[cpi] = turn_buf[cpi]; cpi = cpi + 1; }

        lex.src = src_copy;
        lex.len = tlen;
        lex.pos = 0;
        lex.line = 1;
        lex.col = 1;
        parser.had_error = 0;
        st.had_runtime_err = 0;
        st.flow = 0;
        st.last_was_expr = 0;
        lex_next_token(parser.lex, &mut parser.cur_tok);

        while parser.cur_tok.kind != 0 && parser.had_error == 0 && st.had_runtime_err == 0 {
            if parser.cur_tok.kind == 11 || parser.cur_tok.kind == 102 {
                let _rf: *mut AstNode = parse_fn(&mut parser, 0);
            } else if parser.cur_tok.kind == 12 && parser.cur_tok.hash == 7334518323283222324 {
                parse_top_const(&mut parser);
            } else if parser.cur_tok.kind == 10 {
                let rsn: *mut AstNode = parse_struct(&mut parser);
                if rsn != (0 as *mut AstNode) {
                    register_parsed_struct_cg(&mut parser, &mut cg, rsn);
                }
            } else if parser.cur_tok.kind == 81 {
                parse_enum(&mut parser);
            } else if parser.cur_tok.kind == 80 {
                parse_type_alias(&mut parser);
            } else if parser.cur_tok.kind == 71 {
                lex_next_token(parser.lex, &mut parser.cur_tok);
            } else {
                let rstmt: *mut AstNode = parse_stmt(&mut parser);
                if parser.had_error == 0 && rstmt != (0 as *mut AstNode) {
                    interp_exec_stmt(&mut st, rstmt);
                    if st.had_runtime_err == 0 && st.last_was_expr == 1 && parser.cur_tok.kind == 0 {
                        if st.last_kind == 1 && st.last_val != 0 {
                            uses_println(st.last_val as *u8);
                        } else {
                            interp_write_i64(1, st.last_val);
                            uses_println("");
                        }
                    }
                    if st.flow == 1 { st.flow = 0; }
                }
            }
        }
    }
    return 0;
}

fn continuum_synthesize_main(p: *mut Parser, body_head: *mut AstNode, body_tail: *mut AstNode) -> *mut AstNode {
    let fnode: *mut AstNode = alloc_node(p, 102);
    fnode.hash = 2258945139493307336;
    fnode.val = 3089943341986682694;
    fnode.is_mut = 0;
    fnode.id = 0;

    let nm: *mut AstNode = alloc_node(p, 199);
    nm.hash = ("<main>" as *u8) as u64;
    nm.val = 6;
    fnode.child3 = nm;

    let p_argc: *mut AstNode = alloc_node(p, 101);
    p_argc.hash = hash_identifier("argc", 4);
    p_argc.val = 5563585020063213298;
    p_argc.is_mut = 0;

    let p_argv: *mut AstNode = alloc_node(p, 101);
    p_argv.hash = hash_identifier("argv", 4);
    p_argv.val = 23;
    p_argv.is_mut = 11;

    p_argc.next = p_argv;
    fnode.child2 = p_argc;

    let zlit: *mut AstNode = alloc_node(p, 116);
    zlit.val = 0;
    let rnode: *mut AstNode = alloc_node(p, 109);
    rnode.child1 = zlit;

    if body_head == (0 as *mut AstNode) {
        fnode.child1 = rnode;
    } else {
        fnode.child1 = body_head;
        if body_tail != (0 as *mut AstNode) && body_tail.kind != 109 {
            body_tail.next = rnode;
        }
    }

    register_comptime_fn(p, fnode);
    p.fn_count = p.fn_count + 1;
    return fnode;
}

fn continuum_finalize_and_run(
    p: *mut Parser,
    cg: *mut CodeGen,
    top_head: *mut AstNode,
    top_tail: *mut AstNode,
    explicit_main: *mut AstNode,
    main_had_lambdas: u32,
    req_mode: u32,
    trace_mode: u32,
    is_run_mode: u32,
    has_inline_code: u32,
    format_kind: u32,
    is_upbp: u32,
    in_path: *u8,
    out_path: *u8,
    in_path_idx: u64,
    argc: u64,
    argv: *mut *mut u8
) -> i64 {
    var entry_hash: u64 = 2258945139493307336;

    if explicit_main != (0 as *mut AstNode) {
        if top_head != (0 as *mut AstNode) && top_tail != (0 as *mut AstNode) {
            top_tail.next = explicit_main.child1;
            explicit_main.child1 = top_head;
        }
        cg.has_lambdas = main_had_lambdas as u64;
        compile_fn(cg, explicit_main);
        cg.has_lambdas = 0;
    } else if top_head != (0 as *mut AstNode) {
        let synth: *mut AstNode = continuum_synthesize_main(p, top_head, top_tail);
        cg.has_lambdas = main_had_lambdas as u64;
        compile_fn(cg, synth);
        cg.has_lambdas = 0;
    } else {
        let start_h: u64 = hash_identifier("_start", 6);
        let kmain_h: u64 = hash_identifier("kernel_main", 11);
        let start_off: i64 = continuum_find_fn_text_off(cg, start_h);
        let kmain_off: i64 = continuum_find_fn_text_off(cg, kmain_h);
        if start_off >= 0 {
            entry_hash = start_h;
            if cg.call_main_hole != 0 {
                let d0: i32 = (start_off as i32) - ((cg.call_main_hole as i32) + 4);
                cg_patch32(cg, cg.call_main_hole as u32, d0 as u32);
                cg.call_main_hole = 0;
            }
        } else if kmain_off >= 0 {
            entry_hash = kmain_h;
            if cg.call_main_hole != 0 {
                let d1: i32 = (kmain_off as i32) - ((cg.call_main_hole as i32) + 4);
                cg_patch32(cg, cg.call_main_hole as u32, d1 as u32);
                cg.call_main_hole = 0;
            }
        } else {
            let empty_main: *mut AstNode = continuum_synthesize_main(p, 0 as *mut AstNode, 0 as *mut AstNode);
            compile_fn(cg, empty_main);
        }
    }

    rt_emit_builtin_fallbacks(cg);
    diag_verify_all_symbols(cg);

    var actual_mode: u32 = req_mode;
    if actual_mode == 0 {
        if cg.is_freestanding == 1 || cg.target_arch == 3 || cg.target_arch == 4 || cg.target_arch == 8 || cg.target_arch == 9 {
            actual_mode = 8;
        } else if continuum_ast_uses_eval(p) == 1 {
            actual_mode = 4;
        } else if has_inline_code == 1 && cg.target_arch == 0 && format_kind == 0 {
            actual_mode = 3;
        } else if is_run_mode == 0 && (str_eq(out_path, "./.rux_exec") == 0 && str_starts_with(out_path, "./.rux_", 7) == 0 && str_eq(out_path, "main") == 0) {
            actual_mode = 1;
        } else {
            actual_mode = 2;
        }
    }

    if trace_mode == 1 {
        if actual_mode == 1 { diag_write_cstr("[continuum] tier=aot-native\n"); }
        else if actual_mode == 2 { diag_write_cstr("[continuum] tier=hosted-native\n"); }
        else if actual_mode == 3 { diag_write_cstr("[continuum] tier=jit-in-memory\n"); }
        else if actual_mode == 4 { diag_write_cstr("[continuum] tier=ast-interpreter\n"); }
        else if actual_mode == 5 { diag_write_cstr("[continuum] tier=rxbc-bytecode-vm\n"); }
        else if actual_mode == 7 { diag_write_cstr("[continuum] tier=transpile-c99\n"); }
        else if actual_mode == 8 { diag_write_cstr("[continuum] tier=freestanding-baremetal\n"); }
    }

    if actual_mode == 4 {
        return continuum_interp_run(p, cg, entry_hash, in_path, in_path_idx, argc, argv);
    }
    if actual_mode == 5 {
        return continuum_vm_run(p, cg, entry_hash, in_path, in_path_idx, argc, argv);
    }
    if actual_mode == 7 {
        var c_out: *u8 = out_path;
        if str_eq(c_out, "main") == 1 || str_eq(c_out, "./.rux_exec") == 1 {
            c_out = "out.c";
        }
        return continuum_transpile_c(p, entry_hash, c_out);
    }

    var cfi: u32 = 0;
    while cfi < (cg.call_fixup_count as u32) {
        let cfix: *mut CallFixup = ((cg.call_fixups as *mut u8) + ((cfi as u64) * 16)) as *mut CallFixup;
        var fei: u32 = 0;
        while fei < (cg.fn_entry_count as u32) {
            let fe: *mut FnEntry = ((cg.fn_entries as *mut u8) + ((fei as u64) * 16)) as *mut FnEntry;
            if fe.fn_hash == cfix.callee_hash {
                if cg.target_arch == 1 || cg.target_arch == 8 || cg.target_arch == 10 {
                    let adisp: i32 = ((fe.text_offset as i32) - (cfix.hole_offset as i32)) / 4;
                    let bl_op: u32 = 2483027968 | ((adisp as u32) & 67108863);
                    cg_patch32(cg, cfix.hole_offset as u32, bl_op);
                } else if cg.target_arch == 2 || cg.target_arch == 9 {
                    let rdisp: i32 = (fe.text_offset as i32) - (cfix.hole_offset as i32);
                    let rimm20: u32 = ((rdisp as u32) >> 20) & 1;
                    let rimm10_1: u32 = ((rdisp as u32) >> 1) & 1023;
                    let rimm11: u32 = ((rdisp as u32) >> 11) & 1;
                    let rimm19_12: u32 = ((rdisp as u32) >> 12) & 255;
                    let jal_op: u32 = 239 | (rimm19_12 << 12) | (rimm11 << 20) | (rimm10_1 << 21) | (rimm20 << 31);
                    cg_patch32(cg, cfix.hole_offset as u32, jal_op);
                } else if cg.target_arch == 11 {
                    wasm_patch_uleb5(cg, cfix.hole_offset as u32, fei);
                } else {
                    let disp: i32 = (fe.text_offset as i32) - (((cfix.hole_offset as u32) + 4) as i32);
                    cg_patch32(cg, cfix.hole_offset as u32, disp as u32);
                }
                fei = cg.fn_entry_count as u32;
            }
            fei = fei + 1;
        }
        cfi = cfi + 1;
    }

    rt_guard_emit_all(cg);

    if actual_mode == 3 {
        return continuum_jit_exec(cg, entry_hash, in_path, in_path_idx, argc, argv, 0);
    }

    var exe_path: *u8 = out_path;
    let will_exec: u32 = (actual_mode == 2 || (is_run_mode == 1 && actual_mode != 1 && actual_mode != 8)) as u32;
    if will_exec == 1 && str_starts_with(out_path, "./.rux_", 7) == 1 {
        let up: *mut u8 = uses_alloc(96);
        let ol: u64 = str_len(out_path);
        var ui: u64 = 0;
        while ui < ol && ui < 64 { up[ui] = out_path[ui]; ui = ui + 1; }
        up[ui] = 95;
        ui = ui + 1;
        var pv: u64 = syscall(39, 0) as u64;
        var digs: [u8; 24];
        var dn: u64 = 0;
        if pv == 0 { digs[0] = 48; dn = 1; }
        while pv > 0 { digs[dn] = (48 + (pv % 10)) as u8; dn = dn + 1; pv = pv / 10; }
        while dn > 0 { dn = dn - 1; up[ui] = digs[dn]; ui = ui + 1; }
        up[ui] = 0;
        exe_path = up;
    }

    var write_res: i64 = 0;
    if format_kind == 1 { write_res = write_pe32_binary(cg, exe_path, 0); }
    if format_kind == 2 { write_res = write_macho_binary(cg, exe_path); }
    if format_kind == 3 { write_res = write_pe32_binary(cg, exe_path, 1); }
    if format_kind == 4 { write_res = write_wasm_binary(cg, exe_path); }
    if format_kind == 0 { write_res = write_elf64_binary(cg, exe_path, is_upbp); }
    if write_res < 0 {
        uses_println("ERROR: Failed to write output binary");
        return 3;
    }

    if will_exec == 1 {
        if format_kind == 0 && cg.target_arch == 0 {
            let pid: i64 = syscall(56, 17, 0, 0, 0, 0);
            if pid == 0 {
                var c_argv: [u64; 32];
                c_argv[0] = exe_path as u64;
                var ca_n: u64 = 1;
                if in_path_idx > 0 {
                    var fw_i: u64 = in_path_idx + 1;
                    while fw_i < argc && ca_n < 31 {
                        c_argv[ca_n] = argv[fw_i] as u64;
                        ca_n = ca_n + 1;
                        fw_i = fw_i + 1;
                    }
                }
                c_argv[ca_n] = 0;
                var c_envp: [u64; 1];
                c_envp[0] = 0;
                syscall(59, exe_path as u64, (&c_argv[0]) as u64, (&c_envp[0]) as u64);
                sys_exit(127);
            }
            if pid > 0 {
                var wstatus: u64 = 0;
                syscall(61, pid as u64, (&mut wstatus) as u64, 0, 0);
                uses_unlink(exe_path);
                let ws: u64 = wstatus & 4294967295;
                if (ws & 127) != 0 {
                    return (128 + (ws & 127)) as i64;
                }
                return ((ws >> 8) & 255) as i64;
            }
        }
        let code: i64 = iphee_exec_binary(exe_path, 16777216);
        uses_unlink(exe_path);
        return code;
    }

    return 0;
}
