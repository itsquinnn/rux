fn rxbc_vm_err(cls: *u8, msg: *u8) {
    diag_write_cstr("Uncaught ");
    diag_write_cstr(cls);
    diag_write_cstr(": ");
    diag_write_cstr(msg);
    diag_write_cstr("\n");
    sys_exit(1);
}

fn continuum_vm_run(p: *mut Parser, cg: *mut CodeGen, entry_hash: u64, in_path: *u8, in_path_idx: u64, argc: u64, argv: *mut *mut u8) -> i64 {
    var bc: RxbcCompiler;
    bc.p = p;
    bc.cg = cg;
    bc.code = uses_alloc(4194304);
    bc.code_len = 0;
    bc.heap_cap = 4194304;
    bc.heap = uses_alloc(bc.heap_cap);
    bc.heap_off = 64;
    bc.fn_hashes = uses_alloc(32768);
    bc.fn_pcs = uses_alloc(32768);
    bc.fn_pcnts = uses_alloc(32768);
    bc.fn_lcnts = uses_alloc(32768);
    bc.fn_ret_str = uses_alloc(32768);
    bc.fn_cnt = 0;
    bc.loc_hashes = uses_alloc(16384);
    bc.loc_kinds = uses_alloc(16384);
    bc.loc_caps = uses_alloc(16384);
    bc.loc_cnt = 0;
    bc.loop_depth = 0;
    bc.cont_pcs = uses_alloc(512);
    bc.brk_holes = uses_alloc(16384);
    bc.brk_cnts = uses_alloc(512);

    var fi: u64 = 0;
    while fi < p.fn_ast_count && bc.fn_cnt < 4096 {
        let slot: *u64 = (p.fn_asts + (fi * 16)) as *u64;
        let fnode: *mut AstNode = slot[1] as *mut AstNode;
        if fnode != (0 as *mut AstNode) {
            let idx: u64 = bc.fn_cnt;
            ((bc.fn_hashes + (idx * 8)) as *mut u64)[0] = fnode.hash;
            var pcnt: u64 = 0;
            var pc: *mut AstNode = fnode.child2;
            while pc != (0 as *mut AstNode) { pcnt = pcnt + 1; pc = pc.next; }
            ((bc.fn_pcnts + (idx * 8)) as *mut u64)[0] = pcnt;
            var rstr: u64 = 0;
            if fnode.is_mut == 1 && (fnode.val == 23 || fnode.val == 631772817358541784) { rstr = 1; }
            ((bc.fn_ret_str + (idx * 8)) as *mut u64)[0] = rstr;
            bc.fn_cnt = idx + 1;
        }
        fi = fi + 1;
    }

    fi = 0;
    var out_idx: u64 = 0;
    while fi < p.fn_ast_count && out_idx < bc.fn_cnt {
        let slot2: *u64 = (p.fn_asts + (fi * 16)) as *u64;
        let fnode2: *mut AstNode = slot2[1] as *mut AstNode;
        if fnode2 != (0 as *mut AstNode) {
            ((bc.fn_pcs + (out_idx * 8)) as *mut u64)[0] = bc.code_len;
            bc.loc_cnt = 0;
            bc.loop_depth = 0;
            var p_cur: *mut AstNode = fnode2.child2;
            while p_cur != (0 as *mut AstNode) {
                var pk: u64 = 0;
                if p_cur.is_mut == 11 { pk = 11; }
                else if p_cur.is_mut > 0 && (p_cur.val == 23 || p_cur.val == 631772817358541784) { pk = 1; }
                else if p_cur.is_mut > 0 { pk = 8; }
                rxbc_add_loc(&mut bc, p_cur.hash, pk, 0);
                p_cur = p_cur.next;
            }
            rxbc_compile_stmt_list(&mut bc, fnode2.child1);
            rxbc_emit(&mut bc, 1, 0);
            rxbc_emit(&mut bc, 31, 0);
            ((bc.fn_lcnts + (out_idx * 8)) as *mut u64)[0] = bc.loc_cnt + 4;
            out_idx = out_idx + 1;
        }
        fi = fi + 1;
    }

    let entry_idx: i64 = rxbc_find_fn_idx(&mut bc, entry_hash);
    if entry_idx < 0 { return 0; }

    let stack_mem: *mut i64 = uses_alloc(1048576) as *mut i64;
    let locals_mem: *mut i64 = uses_alloc(2097152) as *mut i64;
    let ret_pcs: *mut u64 = uses_alloc(32768) as *mut u64;
    let ret_fps: *mut u64 = uses_alloc(32768) as *mut u64;

    let argv_buf: *mut u64 = rxbc_heap_alloc(&mut bc, 264) as *mut u64;
    argv_buf[0] = in_path as u64;
    var ca_n: u64 = 1;
    if in_path_idx > 0 {
        var fw_i: u64 = in_path_idx + 1;
        while fw_i < argc && ca_n < 31 {
            argv_buf[ca_n] = argv[fw_i] as u64;
            ca_n = ca_n + 1;
            fw_i = fw_i + 1;
        }
    }
    argv_buf[ca_n] = 0;

    let e_idx: u64 = entry_idx as u64;
    let e_pcnt: u64 = ((bc.fn_pcnts + (e_idx * 8)) as *u64)[0];
    let e_lcnt: u64 = ((bc.fn_lcnts + (e_idx * 8)) as *u64)[0];
    if e_pcnt >= 1 { locals_mem[0] = ca_n as i64; }
    if e_pcnt >= 2 { locals_mem[1] = argv_buf as i64; }

    var sp: u64 = 0;
    var fp: u64 = 0;
    var fp_end: u64 = e_lcnt;
    var call_depth: u64 = 0;
    var pc: u64 = ((bc.fn_pcs + (e_idx * 8)) as *u64)[0];

    while pc < bc.code_len {
        let ins: *i64 = (bc.code + (pc * 16)) as *i64;
        let op: u64 = ins[0] as u64;
        let arg: i64 = ins[1];
        pc = pc + 1;

        if op == 1 {
            stack_mem[sp] = arg;
            sp = sp + 1;
        } else if op == 2 {
            stack_mem[sp] = locals_mem[fp + (arg as u64)];
            sp = sp + 1;
        } else if op == 3 {
            sp = sp - 1;
            locals_mem[fp + (arg as u64)] = stack_mem[sp];
        } else if op == 4 {
            if sp > 0 { sp = sp - 1; }
        } else if op == 5 {
            sp = sp - 1;
            stack_mem[sp - 1] = stack_mem[sp - 1] + stack_mem[sp];
        } else if op == 6 {
            sp = sp - 1;
            stack_mem[sp - 1] = stack_mem[sp - 1] - stack_mem[sp];
        } else if op == 7 {
            sp = sp - 1;
            stack_mem[sp - 1] = stack_mem[sp - 1] * stack_mem[sp];
        } else if op == 8 {
            sp = sp - 1;
            let r: i64 = stack_mem[sp];
            if r == 0 { rxbc_vm_err("RangeError", "Division or modulo by zero"); }
            stack_mem[sp - 1] = stack_mem[sp - 1] / r;
        } else if op == 9 {
            sp = sp - 1;
            let r2: i64 = stack_mem[sp];
            if r2 == 0 { rxbc_vm_err("RangeError", "Division or modulo by zero"); }
            stack_mem[sp - 1] = stack_mem[sp - 1] % r2;
        } else if op == 10 {
            sp = sp - 1;
            stack_mem[sp - 1] = ((stack_mem[sp - 1] as u64) << ((stack_mem[sp] as u64) & 63)) as i64;
        } else if op == 11 {
            sp = sp - 1;
            stack_mem[sp - 1] = stack_mem[sp - 1] >> (stack_mem[sp] & 63);
        } else if op == 12 {
            sp = sp - 1;
            stack_mem[sp - 1] = stack_mem[sp - 1] & stack_mem[sp];
        } else if op == 13 {
            sp = sp - 1;
            stack_mem[sp - 1] = stack_mem[sp - 1] | stack_mem[sp];
        } else if op == 14 {
            sp = sp - 1;
            stack_mem[sp - 1] = stack_mem[sp - 1] ^ stack_mem[sp];
        } else if op == 15 {
            sp = sp - 1;
            if stack_mem[sp - 1] == stack_mem[sp] { stack_mem[sp - 1] = 1; } else { stack_mem[sp - 1] = 0; }
        } else if op == 16 {
            sp = sp - 1;
            if stack_mem[sp - 1] != stack_mem[sp] { stack_mem[sp - 1] = 1; } else { stack_mem[sp - 1] = 0; }
        } else if op == 17 {
            sp = sp - 1;
            if stack_mem[sp - 1] < stack_mem[sp] { stack_mem[sp - 1] = 1; } else { stack_mem[sp - 1] = 0; }
        } else if op == 18 {
            sp = sp - 1;
            if stack_mem[sp - 1] > stack_mem[sp] { stack_mem[sp - 1] = 1; } else { stack_mem[sp - 1] = 0; }
        } else if op == 19 {
            sp = sp - 1;
            if stack_mem[sp - 1] <= stack_mem[sp] { stack_mem[sp - 1] = 1; } else { stack_mem[sp - 1] = 0; }
        } else if op == 20 {
            sp = sp - 1;
            if stack_mem[sp - 1] >= stack_mem[sp] { stack_mem[sp - 1] = 1; } else { stack_mem[sp - 1] = 0; }
        } else if op == 21 {
            if stack_mem[sp - 1] == 0 { stack_mem[sp - 1] = 1; } else { stack_mem[sp - 1] = 0; }
        } else if op == 22 {
            stack_mem[sp - 1] = stack_mem[sp - 1] ^ (0 - 1);
        } else if op == 23 {
            pc = arg as u64;
        } else if op == 24 {
            sp = sp - 1;
            if stack_mem[sp] == 0 { pc = arg as u64; }
        } else if op == 25 {
            sp = sp - 1;
            if stack_mem[sp] != 0 { pc = arg as u64; }
        } else if op == 27 {
            let asz: u64 = (arg as u64) & 4294967295;
            let aslot: u64 = (arg as u64) >> 32;
            let abuf: *mut u8 = rxbc_heap_alloc(&mut bc, asz);
            locals_mem[fp + aslot] = abuf as i64;
        } else if op == 28 {
            sp = sp - 1;
            let idx: i64 = stack_mem[sp];
            let base: i64 = stack_mem[sp - 1];
            let stride: i64 = arg & 255;
            let cap: u64 = (arg as u64) >> 8;
            if cap > 0 && (idx < 0 || ((idx as u64) * (stride as u64)) >= cap) {
                rxbc_vm_err("RangeError", "Array index out of bounds");
            }
            if base == 0 || (base as u64) < 65536 {
                rxbc_vm_err("TypeError", "Cannot read memory of null or invalid pointer");
            }
            let addr: u64 = (base + (idx * stride)) as u64;
            if stride == 1 { stack_mem[sp - 1] = ((addr as *u8)[0]) as i64; }
            else if stride == 2 { stack_mem[sp - 1] = ((addr as *u16)[0]) as i64; }
            else if stride == 4 { stack_mem[sp - 1] = ((addr as *u32)[0]) as i64; }
            else { stack_mem[sp - 1] = (addr as *i64)[0]; }
        } else if op == 29 {
            sp = sp - 3;
            let base2: i64 = stack_mem[sp];
            let idx2: i64 = stack_mem[sp + 1];
            let val2: i64 = stack_mem[sp + 2];
            let stride2: i64 = arg & 255;
            let cap2: u64 = (arg as u64) >> 8;
            if cap2 > 0 && (idx2 < 0 || ((idx2 as u64) * (stride2 as u64)) >= cap2) {
                rxbc_vm_err("RangeError", "Array index out of bounds");
            }
            if base2 == 0 || (base2 as u64) < 65536 {
                rxbc_vm_err("TypeError", "Cannot write memory of null or invalid pointer");
            }
            let waddr: u64 = (base2 + (idx2 * stride2)) as u64;
            if stride2 == 1 { (waddr as *mut u8)[0] = (val2 & 255) as u8; }
            else if stride2 == 2 { (waddr as *mut u16)[0] = (val2 & 65535) as u16; }
            else if stride2 == 4 { (waddr as *mut u32)[0] = (val2 & 4294967295) as u32; }
            else { (waddr as *mut i64)[0] = val2; }
        } else if op == 30 || op == 40 {
            var callee_idx: u64 = 0;
            var call_argc: u64 = 0;
            if op == 30 {
                callee_idx = (arg as u64) & 4294967295;
                call_argc = (arg as u64) >> 32;
            } else {
                sp = sp - 1;
                callee_idx = stack_mem[sp] as u64;
                call_argc = arg as u64;
            }
            if call_depth >= 2048 || (fp_end + 256) >= 262140 {
                rxbc_vm_err("RangeError", "Maximum call stack size exceeded");
            }
            ret_pcs[call_depth] = pc;
            ret_fps[call_depth] = fp;
            call_depth = call_depth + 1;

            let new_fp: u64 = fp_end;
            let callee_lcnt: u64 = ((bc.fn_lcnts + (callee_idx * 8)) as *u64)[0];
            fp_end = new_fp + callee_lcnt;
            var ai: u64 = call_argc;
            while ai > 0 {
                ai = ai - 1;
                sp = sp - 1;
                locals_mem[new_fp + ai] = stack_mem[sp];
            }
            fp = new_fp;
            pc = ((bc.fn_pcs + (callee_idx * 8)) as *u64)[0];
        } else if op == 31 {
            sp = sp - 1;
            let ret_v: i64 = stack_mem[sp];
            if call_depth == 0 {
                return ret_v;
            }
            fp_end = fp;
            call_depth = call_depth - 1;
            fp = ret_fps[call_depth];
            pc = ret_pcs[call_depth];
            stack_mem[sp] = ret_v;
            sp = sp + 1;
        } else if op == 32 {
            sp = sp - 1;
            let sptr: i64 = stack_mem[sp];
            if sptr != 0 {
                let ps: *u8 = sptr as *u8;
                let plen: u64 = str_len(ps);
                if plen > 0 { acrq_port_submit(1, arg as u32, 0, ps as u64, 0, plen); }
            }
        } else if op == 33 {
            sp = sp - 1;
            interp_write_i64(arg as u32, stack_mem[sp]);
        } else if op == 34 {
            let nl: *u8 = "\n";
            acrq_port_submit(1, arg as u32, 0, nl as u64, 0, 1);
        } else if op == 35 {
            let nargs: u64 = arg as u64;
            var sargs: [u64; 6];
            var si: u64 = 0;
            while si < 6 { sargs[si] = 0; si = si + 1; }
            var k: u64 = nargs;
            while k > 0 {
                k = k - 1;
                sp = sp - 1;
                sargs[k] = stack_mem[sp] as u64;
            }
            sp = sp - 1;
            let nr: u64 = stack_mem[sp] as u64;
            stack_mem[sp] = syscall(nr, sargs[0], sargs[1], sargs[2], sargs[3], sargs[4], sargs[5]);
            sp = sp + 1;
        } else if op == 36 {
            sp = sp - 1;
            sys_exit(stack_mem[sp] as int);
        } else if op == 37 {
            let csz: u64 = (arg as u64) & 255;
            let csgn: u64 = ((arg as u64) >> 8) & 1;
            let cv: u64 = stack_mem[sp - 1] as u64;
            if csz == 1 {
                let b8: u64 = cv & 255;
                if csgn == 1 && (b8 & 128) != 0 { stack_mem[sp - 1] = (b8 | (0 - 256 as u64)) as i64; }
                else { stack_mem[sp - 1] = b8 as i64; }
            } else if csz == 2 {
                let b16: u64 = cv & 65535;
                if csgn == 1 && (b16 & 32768) != 0 { stack_mem[sp - 1] = (b16 | (0 - 65536 as u64)) as i64; }
                else { stack_mem[sp - 1] = b16 as i64; }
            } else if csz == 4 {
                let b32: u64 = cv & 4294967295;
                if csgn == 1 && (b32 & 2147483648) != 0 { stack_mem[sp - 1] = (b32 | (0 - 4294967296 as u64)) as i64; }
                else { stack_mem[sp - 1] = b32 as i64; }
            }
        } else if op == 39 {
            stack_mem[sp] = ((locals_mem as *u8) + ((fp + (arg as u64)) * 8)) as i64;
            sp = sp + 1;
        }
    }
    return 0;
}
