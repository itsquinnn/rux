struct CTranspiler {
    p: *mut Parser,
    buf: *mut u8,
    pos: u64,
    cap: u64,
    decl_hashes: *mut u8,
    decl_kinds: *mut u8,
    decl_cnt: u64,
    fn_hashes: *mut u8,
    fn_ret_str: *mut u8,
    fn_cnt: u64,
}

fn c_put8(ct: *mut CTranspiler, b: u8) {
    if ct.pos + 4 < ct.cap {
        ct.buf[ct.pos] = b;
        ct.pos = ct.pos + 1;
    }
}

fn c_puts(ct: *mut CTranspiler, s: *u8) {
    if s == (0 as *u8) { return; }
    var i: u64 = 0;
    while s[i] != 0 {
        c_put8(ct, s[i]);
        i = i + 1;
    }
}

fn c_put_u64(ct: *mut CTranspiler, v: u64) {
    if v == 0 { c_put8(ct, 48); return; }
    var tmp: [u8; 28];
    var n: u64 = 0;
    var cur: u64 = v;
    while cur > 0 && n < 24 {
        tmp[n] = (48 + (cur % 10)) as u8;
        cur = cur / 10;
        n = n + 1;
    }
    var i: u64 = 0;
    while i < n {
        c_put8(ct, tmp[n - 1 - i]);
        i = i + 1;
    }
}

fn c_put_i64(ct: *mut CTranspiler, v: i64) {
    if v < 0 {
        c_puts(ct, "(-");
        c_put_u64(ct, (0 - v) as u64);
        c_puts(ct, "LL)");
        return;
    }
    c_put_u64(ct, v as u64);
    c_puts(ct, "LL");
}

fn c_put_hex(ct: *mut CTranspiler, h: u64) {
    let hex: *u8 = "0123456789abcdef";
    var shift: i64 = 60;
    while shift >= 0 {
        let nib: u64 = (h >> (shift as u64)) & 15;
        c_put8(ct, hex[nib]);
        shift = shift - 4;
    }
}

fn c_put_var(ct: *mut CTranspiler, h: u64) {
    c_puts(ct, "rx_v_");
    c_put_hex(ct, h);
}

fn c_put_fn(ct: *mut CTranspiler, h: u64) {
    c_puts(ct, "rx_fn_");
    c_put_hex(ct, h);
}

fn c_find_decl_kind(ct: *mut CTranspiler, h: u64) -> i64 {
    var i: u64 = ct.decl_cnt;
    while i > 0 {
        i = i - 1;
        if ((ct.decl_hashes + (i * 8)) as *u64)[0] == h {
            return ((ct.decl_kinds + (i * 8)) as *u64)[0] as i64;
        }
    }
    return 0 - 1;
}

fn c_add_decl(ct: *mut CTranspiler, h: u64, k: u64) -> u32 {
    let ex: i64 = c_find_decl_kind(ct, h);
    if ex >= 0 { return 1; }
    if ct.decl_cnt < 2048 {
        ((ct.decl_hashes + (ct.decl_cnt * 8)) as *mut u64)[0] = h;
        ((ct.decl_kinds + (ct.decl_cnt * 8)) as *mut u64)[0] = k;
        ct.decl_cnt = ct.decl_cnt + 1;
    }
    return 0;
}

fn c_expr_is_str(ct: *mut CTranspiler, n: *mut AstNode) -> u32 {
    if n == (0 as *mut AstNode) { return 0; }
    if n.kind == 118 { return 1; }
    if n.kind == 117 {
        let dk: i64 = c_find_decl_kind(ct, n.hash);
        if dk == 1 { return 1; }
        let ce: *mut ConstEntry = parser_find_const(ct.p, n.hash);
        if ce != (0 as *mut ConstEntry) && (ce.extra & 4294967295) == 2 { return 1; }
        return 0;
    }
    if n.kind == 131 {
        if n.is_mut > 0 && n.is_mut != 11 && (n.val == 23 || n.hash == 631772817358541784) { return 1; }
        return 0;
    }
    if n.kind == 115 && n.child1 != (0 as *mut AstNode) && n.child1.kind == 117 {
        if c_find_decl_kind(ct, n.child1.hash) == 11 { return 1; }
    }
    if n.kind == 113 {
        var i: u64 = 0;
        while i < ct.fn_cnt {
            if ((ct.fn_hashes + (i * 8)) as *u64)[0] == n.hash {
                return ((ct.fn_ret_str + (i * 8)) as *u64)[0] as u32;
            }
            i = i + 1;
        }
    }
    return 0;
}

fn c_emit_expr(ct: *mut CTranspiler, n: *mut AstNode) {
    if n == (0 as *mut AstNode) { c_puts(ct, "0LL"); return; }
    if n.kind == 116 { c_put_i64(ct, n.val as i64); return; }
    if n.kind == 118 {
        c_puts(ct, "((int64_t)(uintptr_t)");
        let sp: *u8 = n.hash as *u8;
        let slen: u64 = n.val;
        var si: u64 = 0;
        while si < slen { c_put8(ct, sp[si]); si = si + 1; }
        c_puts(ct, ")");
        return;
    }
    if n.kind == 117 {
        if c_find_decl_kind(ct, n.hash) >= 0 {
            c_put_var(ct, n.hash);
            return;
        }
        let ce: *mut ConstEntry = parser_find_const(ct.p, n.hash);
        if ce != (0 as *mut ConstEntry) {
            if (ce.extra & 4294967295) == 2 {
                c_puts(ct, "((int64_t)(uintptr_t)");
                let csp: *u8 = ce.val as *u8;
                let cslen: u64 = ce.extra >> 32;
                var csi: u64 = 0;
                while csi < cslen { c_put8(ct, csp[csi]); csi = csi + 1; }
                c_puts(ct, ")");
            } else {
                c_put_i64(ct, ce.val as i64);
            }
            return;
        }
        c_puts(ct, "((int64_t)(uintptr_t)&");
        c_put_fn(ct, n.hash);
        c_puts(ct, ")");
        return;
    }
    if n.kind == 131 {
        if n.is_mut > 0 {
            c_emit_expr(ct, n.child1);
            return;
        }
        let csz: u64 = type_prim_size_from_tok(n.val as u32, n.hash);
        let csgn: u32 = is_signed_type_hash(n.val as u32, n.hash);
        c_puts(ct, "((int64_t)(");
        if csz == 1 { if csgn == 1 { c_puts(ct, "int8_t"); } else { c_puts(ct, "uint8_t"); } }
        else if csz == 2 { if csgn == 1 { c_puts(ct, "int16_t"); } else { c_puts(ct, "uint16_t"); } }
        else if csz == 4 { if csgn == 1 { c_puts(ct, "int32_t"); } else { c_puts(ct, "uint32_t"); } }
        else { c_puts(ct, "int64_t"); }
        c_puts(ct, ")(");
        c_emit_expr(ct, n.child1);
        c_puts(ct, "))");
        return;
    }
    if n.kind == 112 {
        if n.val == 53 { c_puts(ct, "(!("); c_emit_expr(ct, n.child1); c_puts(ct, "))"); return; }
        if n.val == 54 { c_puts(ct, "(~("); c_emit_expr(ct, n.child1); c_puts(ct, "))"); return; }
        if n.val == 50 {
            if n.child1 != (0 as *mut AstNode) && n.child1.kind == 117 {
                c_puts(ct, "((int64_t)(uintptr_t)&");
                c_put_var(ct, n.child1.hash);
                c_puts(ct, ")");
                return;
            }
            c_emit_expr(ct, n.child1);
            return;
        }
        if n.val == 32 {
            c_puts(ct, "(*(int64_t *)(uintptr_t)(");
            c_emit_expr(ct, n.child1);
            c_puts(ct, "))");
            return;
        }
        c_emit_expr(ct, n.child1);
        return;
    }
    if n.kind == 115 {
        var stride: u64 = 8;
        if c_expr_is_str(ct, n.child1) == 1 { stride = 1; }
        if n.child1 != (0 as *mut AstNode) && n.child1.kind == 117 {
            let dk: i64 = c_find_decl_kind(ct, n.child1.hash);
            if dk == 1 { stride = 1; }
            else if dk == 4 { stride = 4; }
        }
        if stride == 1 {
            c_puts(ct, "((int64_t)((uint8_t *)(uintptr_t)(");
        } else if stride == 4 {
            c_puts(ct, "((int64_t)((uint32_t *)(uintptr_t)(");
        } else {
            c_puts(ct, "(((int64_t *)(uintptr_t)(");
        }
        c_emit_expr(ct, n.child1);
        c_puts(ct, "))[");
        c_emit_expr(ct, n.child2);
        c_puts(ct, "])");
        return;
    }
    if n.kind == 124 {
        c_puts(ct, "((");
        c_emit_expr(ct, n.child1);
        c_puts(ct, ") ? (");
        c_emit_expr(ct, n.child2);
        c_puts(ct, ") : (");
        c_emit_expr(ct, n.child3);
        c_puts(ct, "))");
        return;
    }
    if n.kind == 106 {
        let op: u64 = n.val;
        if op == 30 || op == 31 || op == 32 {
            c_puts(ct, "((int64_t)((uint64_t)(");
            c_emit_expr(ct, n.child1);
            if op == 30 { c_puts(ct, ") + (uint64_t)("); }
            else if op == 31 { c_puts(ct, ") - (uint64_t)("); }
            else { c_puts(ct, ") * (uint64_t)("); }
            c_emit_expr(ct, n.child2);
            c_puts(ct, ")))");
            return;
        }
        c_puts(ct, "(");
        c_emit_expr(ct, n.child1);
        if op == 33 { c_puts(ct, " / "); }
        else if op == 34 { c_puts(ct, " % "); }
        else if op == 47 { c_puts(ct, " << "); }
        else if op == 48 { c_puts(ct, " >> "); }
        else if op == 50 { c_puts(ct, " & "); }
        else if op == 51 { c_puts(ct, " | "); }
        else if op == 52 { c_puts(ct, " ^ "); }
        else if op == 41 { c_puts(ct, " == "); }
        else if op == 42 { c_puts(ct, " != "); }
        else if op == 43 { c_puts(ct, " < "); }
        else if op == 44 { c_puts(ct, " > "); }
        else if op == 45 { c_puts(ct, " <= "); }
        else if op == 46 { c_puts(ct, " >= "); }
        else if op == 49 { c_puts(ct, " && "); }
        else if op == 57 { c_puts(ct, " || "); }
        else { c_puts(ct, " + "); }
        c_emit_expr(ct, n.child2);
        c_puts(ct, ")");
        return;
    }
    if n.kind == 120 {
        c_puts(ct, "({ ");
        var tgt_stream: *u8 = "stdout";
        if n.val == 2 { tgt_stream = "stderr"; }
        var pa: *mut AstNode = n.child1;
        while pa != (0 as *mut AstNode) {
            if c_expr_is_str(ct, pa) == 1 && n.val != 3 {
                c_puts(ct, "fprintf(");
                c_puts(ct, tgt_stream);
                c_puts(ct, ", \"%s\", (const char *)(uintptr_t)(");
                c_emit_expr(ct, pa);
                c_puts(ct, ")); ");
            } else {
                c_puts(ct, "fprintf(");
                c_puts(ct, tgt_stream);
                c_puts(ct, ", \"%lld\", (long long)(");
                c_emit_expr(ct, pa);
                c_puts(ct, ")); ");
            }
            pa = pa.next;
        }
        if n.val == 1 || n.val == 2 {
            c_puts(ct, "fputc(10, ");
            c_puts(ct, tgt_stream);
            c_puts(ct, "); ");
        }
        c_puts(ct, "0LL; })");
        return;
    }
    if n.kind == 119 {
        c_puts(ct, "((int64_t)syscall((long)(");
        c_emit_expr(ct, n.child1);
        c_puts(ct, ")");
        var sa: *mut AstNode = n.child2;
        while sa != (0 as *mut AstNode) {
            c_puts(ct, ", (long)(");
            c_emit_expr(ct, sa);
            c_puts(ct, ")");
            sa = sa.next;
        }
        c_puts(ct, "))");
        return;
    }
    if n.kind == 113 {
        if n.hash == hash_identifier("sys_exit", 8) {
            c_puts(ct, "(exit((int)(");
            c_emit_expr(ct, n.child2);
            c_puts(ct, ")), 0LL)");
            return;
        }
        c_put_fn(ct, n.hash);
        c_puts(ct, "(");
        var ca: *mut AstNode = n.child2;
        var first: u32 = 1;
        while ca != (0 as *mut AstNode) {
            if first == 0 { c_puts(ct, ", "); }
            c_emit_expr(ct, ca);
            first = 0;
            ca = ca.next;
        }
        c_puts(ct, ")");
        return;
    }
    c_puts(ct, "0LL");
}

fn c_emit_stmt_list(ct: *mut CTranspiler, stmts: *mut AstNode) {
    var cur: *mut AstNode = stmts;
    while cur != (0 as *mut AstNode) {
        c_emit_stmt(ct, cur);
        cur = cur.next;
    }
}

fn c_emit_stmt(ct: *mut CTranspiler, s: *mut AstNode) {
    if s == (0 as *mut AstNode) || s.kind == 0 { return; }
    if s.kind == 105 {
        if s.id == 10 || s.id == 11 || s.id == 12 {
            var astr: u64 = 8;
            if s.id == 10 { astr = 1; }
            else if s.id == 12 { astr = s.is_mut; }
            let existed: u32 = c_add_decl(ct, s.hash, astr);
            let arr_id: u64 = ct.pos;
            c_puts(ct, "    uint8_t rx_arr_");
            c_put_u64(ct, arr_id);
            c_puts(ct, "[");
            if s.val > 0 { c_put_u64(ct, s.val); } else { c_puts(ct, "8"); }
            c_puts(ct, "] = {0};\n    ");
            if existed == 0 { c_puts(ct, "int64_t "); }
            c_put_var(ct, s.hash);
            c_puts(ct, " = (int64_t)(uintptr_t)rx_arr_");
            c_put_u64(ct, arr_id);
            c_puts(ct, ";\n");
            return;
        }
        var vk: u64 = 0;
        if s.id == 11 { vk = 11; }
        else if s.id == 2 && (s.val == 23 || s.val == 631772817358541784) { vk = 1; }
        else if s.child1 != (0 as *mut AstNode) && c_expr_is_str(ct, s.child1) == 1 { vk = 1; }
        let existed2: u32 = c_add_decl(ct, s.hash, vk);
        c_puts(ct, "    ");
        if existed2 == 0 { c_puts(ct, "int64_t "); }
        c_put_var(ct, s.hash);
        c_puts(ct, " = ");
        if s.child1 != (0 as *mut AstNode) { c_emit_expr(ct, s.child1); } else { c_puts(ct, "0LL"); }
        c_puts(ct, ";\n");
        return;
    }
    if s.kind == 106 {
        let lhs: *mut AstNode = s.child1;
        if lhs == (0 as *mut AstNode) { return; }
        if lhs.kind == 117 {
            c_puts(ct, "    ");
            c_put_var(ct, lhs.hash);
            c_puts(ct, " = ");
            c_emit_expr(ct, s.child2);
            c_puts(ct, ";\n");
            return;
        }
        if lhs.kind == 115 {
            var stride: u64 = 8;
            if lhs.child1 != (0 as *mut AstNode) && lhs.child1.kind == 117 {
                let dk: i64 = c_find_decl_kind(ct, lhs.child1.hash);
                if dk == 1 { stride = 1; } else if dk == 4 { stride = 4; }
            }
            c_puts(ct, "    ((");
            if stride == 1 { c_puts(ct, "uint8_t *"); }
            else if stride == 4 { c_puts(ct, "uint32_t *"); }
            else { c_puts(ct, "int64_t *"); }
            c_puts(ct, ")(uintptr_t)(");
            c_emit_expr(ct, lhs.child1);
            c_puts(ct, "))[");
            c_emit_expr(ct, lhs.child2);
            c_puts(ct, "] = ");
            c_emit_expr(ct, s.child2);
            c_puts(ct, ";\n");
            return;
        }
        if lhs.kind == 112 && lhs.val == 32 {
            c_puts(ct, "    *(int64_t *)(uintptr_t)(");
            c_emit_expr(ct, lhs.child1);
            c_puts(ct, ") = ");
            c_emit_expr(ct, s.child2);
            c_puts(ct, ";\n");
            return;
        }
        return;
    }
    if s.kind == 107 {
        c_puts(ct, "    if (");
        c_emit_expr(ct, s.child1);
        c_puts(ct, ") {\n");
        c_emit_stmt_list(ct, s.child2);
        c_puts(ct, "    }");
        if s.child3 != (0 as *mut AstNode) {
            c_puts(ct, " else {\n");
            if s.child3.kind == 107 { c_emit_stmt(ct, s.child3); }
            else { c_emit_stmt_list(ct, s.child3); }
            c_puts(ct, "    }");
        }
        c_puts(ct, "\n");
        return;
    }
    if s.kind == 108 {
        c_puts(ct, "    while (");
        c_emit_expr(ct, s.child1);
        c_puts(ct, ") {\n");
        c_emit_stmt_list(ct, s.child2);
        c_puts(ct, "    }\n");
        return;
    }
    if s.kind == 125 {
        let ex_f: u32 = c_add_decl(ct, s.hash, 0);
        c_puts(ct, "    ");
        if ex_f == 0 { c_puts(ct, "int64_t "); }
        c_put_var(ct, s.hash);
        c_puts(ct, " = ");
        c_emit_expr(ct, s.child1);
        c_puts(ct, ";\n    while (");
        c_put_var(ct, s.hash);
        c_puts(ct, " < (");
        c_emit_expr(ct, s.child2);
        c_puts(ct, ")) {\n");
        c_emit_stmt_list(ct, s.child3);
        c_puts(ct, "        ");
        c_put_var(ct, s.hash);
        c_puts(ct, " = ");
        c_put_var(ct, s.hash);
        c_puts(ct, " + 1LL;\n    }\n");
        return;
    }
    if s.kind == 109 {
        c_puts(ct, "    return ");
        if s.child1 != (0 as *mut AstNode) { c_emit_expr(ct, s.child1); } else { c_puts(ct, "0LL"); }
        c_puts(ct, ";\n");
        return;
    }
    if s.kind == 126 { c_puts(ct, "    break;\n"); return; }
    if s.kind == 127 { c_puts(ct, "    continue;\n"); return; }
    if s.kind == 132 { c_emit_stmt_list(ct, s.child1); return; }
    if s.kind == 110 {
        c_puts(ct, "    (void)(");
        c_emit_expr(ct, s.child1);
        c_puts(ct, ");\n");
        return;
    }
}

fn continuum_transpile_c(p: *mut Parser, entry_hash: u64, out_path: *u8) -> i64 {
    var ct: CTranspiler;
    ct.p = p;
    ct.cap = 2097152;
    ct.buf = uses_alloc(ct.cap);
    ct.pos = 0;
    ct.decl_hashes = uses_alloc(16384);
    ct.decl_kinds = uses_alloc(16384);
    ct.decl_cnt = 0;
    ct.fn_hashes = uses_alloc(32768);
    ct.fn_ret_str = uses_alloc(32768);
    ct.fn_cnt = 0;

    c_puts(&mut ct, "#define _GNU_SOURCE\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <unistd.h>\n#include <sys/syscall.h>\n\n");

    var fi: u64 = 0;
    while fi < p.fn_ast_count && ct.fn_cnt < 4096 {
        let slot: *u64 = (p.fn_asts + (fi * 16)) as *u64;
        let fnode: *mut AstNode = slot[1] as *mut AstNode;
        if fnode != (0 as *mut AstNode) {
            ((ct.fn_hashes + (ct.fn_cnt * 8)) as *mut u64)[0] = fnode.hash;
            var rstr: u64 = 0;
            if fnode.is_mut == 1 && (fnode.val == 23 || fnode.val == 631772817358541784) { rstr = 1; }
            ((ct.fn_ret_str + (ct.fn_cnt * 8)) as *mut u64)[0] = rstr;
            ct.fn_cnt = ct.fn_cnt + 1;

            c_puts(&mut ct, "int64_t ");
            c_put_fn(&mut ct, fnode.hash);
            c_puts(&mut ct, "(");
            var pc: *mut AstNode = fnode.child2;
            var first: u32 = 1;
            while pc != (0 as *mut AstNode) {
                if first == 0 { c_puts(&mut ct, ", "); }
                c_puts(&mut ct, "int64_t ");
                c_put_var(&mut ct, pc.hash);
                first = 0;
                pc = pc.next;
            }
            c_puts(&mut ct, ");\n");
        }
        fi = fi + 1;
    }
    c_puts(&mut ct, "\n");

    var entry_pcnt: u64 = 0;
    fi = 0;
    while fi < p.fn_ast_count {
        let slot2: *u64 = (p.fn_asts + (fi * 16)) as *u64;
        let fnode2: *mut AstNode = slot2[1] as *mut AstNode;
        if fnode2 != (0 as *mut AstNode) {
            ct.decl_cnt = 0;
            c_puts(&mut ct, "int64_t ");
            c_put_fn(&mut ct, fnode2.hash);
            c_puts(&mut ct, "(");
            var pc2: *mut AstNode = fnode2.child2;
            var pcnt: u64 = 0;
            while pc2 != (0 as *mut AstNode) {
                if pcnt > 0 { c_puts(&mut ct, ", "); }
                c_puts(&mut ct, "int64_t ");
                c_put_var(&mut ct, pc2.hash);
                var pk: u64 = 0;
                if pc2.is_mut == 11 { pk = 11; }
                else if pc2.is_mut > 0 && (pc2.val == 23 || pc2.val == 631772817358541784) { pk = 1; }
                c_add_decl(&mut ct, pc2.hash, pk);
                pcnt = pcnt + 1;
                pc2 = pc2.next;
            }
            if fnode2.hash == entry_hash { entry_pcnt = pcnt; }
            c_puts(&mut ct, ") {\n");
            c_emit_stmt_list(&mut ct, fnode2.child1);
            c_puts(&mut ct, "    return 0LL;\n}\n\n");
        }
        fi = fi + 1;
    }

    c_puts(&mut ct, "int main(int rx_argc, char **rx_argv) {\n    return (int)");
    c_put_fn(&mut ct, entry_hash);
    c_puts(&mut ct, "(");
    if entry_pcnt >= 1 { c_puts(&mut ct, "(int64_t)rx_argc"); }
    if entry_pcnt >= 2 { c_puts(&mut ct, ", (int64_t)(uintptr_t)rx_argv"); }
    c_puts(&mut ct, ");\n}\n");

    let wres: i64 = acrq_file_write_bytes(out_path, ct.buf, ct.pos, 420);
    if wres < 0 {
        diag_write_cstr("Uncaught Error: Failed to write transpiled C output\n");
        return 1;
    }
    return 0;
}

