struct RxbcCompiler {
    p: *mut Parser,
    cg: *mut CodeGen,
    code: *mut u8,
    code_len: u64,
    heap: *mut u8,
    heap_off: u64,
    heap_cap: u64,
    fn_hashes: *mut u8,
    fn_pcs: *mut u8,
    fn_pcnts: *mut u8,
    fn_lcnts: *mut u8,
    fn_ret_str: *mut u8,
    fn_cnt: u64,
    loc_hashes: *mut u8,
    loc_kinds: *mut u8,
    loc_caps: *mut u8,
    loc_cnt: u64,
    loop_depth: u64,
    cont_pcs: *mut u8,
    brk_holes: *mut u8,
    brk_cnts: *mut u8,
}

fn rxbc_emit(bc: *mut RxbcCompiler, op: u64, arg: i64) -> u64 {
    let idx: u64 = bc.code_len;
    if idx >= 262140 { return idx; }
    let slot: *mut i64 = (bc.code + (idx * 16)) as *mut i64;
    slot[0] = op as i64;
    slot[1] = arg;
    bc.code_len = idx + 1;
    return idx;
}

fn rxbc_patch_arg(bc: *mut RxbcCompiler, pc: u64, arg: i64) {
    let slot: *mut i64 = (bc.code + (pc * 16)) as *mut i64;
    slot[1] = arg;
}

fn rxbc_heap_alloc(bc: *mut RxbcCompiler, bytes: u64) -> *mut u8 {
    var sz: u64 = bytes;
    if sz == 0 { sz = 8; }
    let aligned: u64 = ((sz + 7) / 8) * 8;
    if (bc.heap_off + aligned + 16) >= bc.heap_cap {
        let ex: *mut u8 = uses_alloc(aligned + 4096);
        var zi0: u64 = 0;
        while zi0 < aligned { ex[zi0] = 0; zi0 = zi0 + 1; }
        return ex;
    }
    let ptr: *mut u8 = bc.heap + bc.heap_off;
    bc.heap_off = bc.heap_off + aligned;
    var zi: u64 = 0;
    while zi < aligned { ptr[zi] = 0; zi = zi + 1; }
    return ptr;
}

fn rxbc_intern_str(bc: *mut RxbcCompiler, raw_ptr: *u8, raw_len: u64) -> i64 {
    let dst: *mut u8 = rxbc_heap_alloc(bc, raw_len + 8);
    var out_i: u64 = 0;
    if raw_len >= 2 {
        var si: u64 = 1;
        let s_end: u64 = raw_len - 1;
        while si < s_end {
            let sc: u8 = raw_ptr[si];
            var out_c: u8 = sc;
            if sc == 92 && (si + 1) < s_end {
                si = si + 1;
                let esc: u8 = raw_ptr[si];
                out_c = esc;
                if esc == 110 { out_c = 10; }
                if esc == 116 { out_c = 9; }
                if esc == 114 { out_c = 13; }
                if esc == 48 { out_c = 0; }
            }
            dst[out_i] = out_c;
            out_i = out_i + 1;
            si = si + 1;
        }
    }
    dst[out_i] = 0;
    return dst as i64;
}

fn rxbc_find_fn_idx(bc: *mut RxbcCompiler, h: u64) -> i64 {
    var i: u64 = bc.fn_cnt;
    while i > 0 {
        i = i - 1;
        let ph: *u64 = (bc.fn_hashes + (i * 8)) as *u64;
        if ph[0] == h { return i as i64; }
    }
    return 0 - 1;
}

fn rxbc_find_loc(bc: *mut RxbcCompiler, h: u64) -> i64 {
    var i: u64 = bc.loc_cnt;
    while i > 0 {
        i = i - 1;
        let ph: *u64 = (bc.loc_hashes + (i * 8)) as *u64;
        if ph[0] == h { return i as i64; }
    }
    return 0 - 1;
}

fn rxbc_loc_kind(bc: *mut RxbcCompiler, idx: u64) -> u64 {
    return ((bc.loc_kinds + (idx * 8)) as *u64)[0];
}

fn rxbc_loc_cap(bc: *mut RxbcCompiler, idx: u64) -> u64 {
    return ((bc.loc_caps + (idx * 8)) as *u64)[0];
}

fn rxbc_add_loc(bc: *mut RxbcCompiler, h: u64, k: u64, cap: u64) -> u64 {
    let ex: i64 = rxbc_find_loc(bc, h);
    if ex >= 0 {
        let uex: u64 = ex as u64;
        ((bc.loc_kinds + (uex * 8)) as *mut u64)[0] = k;
        ((bc.loc_caps + (uex * 8)) as *mut u64)[0] = cap;
        return uex;
    }
    let idx: u64 = bc.loc_cnt;
    if idx < 2048 {
        ((bc.loc_hashes + (idx * 8)) as *mut u64)[0] = h;
        ((bc.loc_kinds + (idx * 8)) as *mut u64)[0] = k;
        ((bc.loc_caps + (idx * 8)) as *mut u64)[0] = cap;
        bc.loc_cnt = idx + 1;
    }
    return idx;
}

fn rxbc_expr_kind(bc: *mut RxbcCompiler, n: *mut AstNode) -> u64 {
    if n == (0 as *mut AstNode) { return 0; }
    if n.kind == 118 { return 1; }
    if n.kind == 117 {
        let sl: i64 = rxbc_find_loc(bc, n.hash);
        if sl >= 0 { return rxbc_loc_kind(bc, sl as u64); }
        let ce: *mut ConstEntry = parser_find_const(bc.p, n.hash);
        if ce != (0 as *mut ConstEntry) && (ce.extra & 4294967295) == 2 { return 1; }
        return 0;
    }
    if n.kind == 131 {
        if n.is_mut == 11 { return 11; }
        if n.is_mut > 0 && (n.val == 23 || n.hash == 631772817358541784) { return 1; }
        if n.is_mut > 0 { return type_prim_size_from_tok(n.val as u32, n.hash); }
        return 0;
    }
    if n.kind == 115 {
        if rxbc_expr_kind(bc, n.child1) == 11 { return 1; }
        return 0;
    }
    if n.kind == 113 {
        let fidx: i64 = rxbc_find_fn_idx(bc, n.hash);
        if fidx >= 0 {
            if ((bc.fn_ret_str + ((fidx as u64) * 8)) as *u64)[0] == 1 { return 1; }
        }
        return 0;
    }
    if n.kind == 106 && n.val == 30 {
        if rxbc_expr_kind(bc, n.child1) == 1 { return 1; }
    }
    return 0;
}

fn rxbc_stride_for_kind(k: u64) -> u64 {
    if k == 1 { return 1; }
    if k == 2 { return 2; }
    if k == 4 { return 4; }
    return 8;
}

fn rxbc_compile_expr(bc: *mut RxbcCompiler, n: *mut AstNode) {
    if n == (0 as *mut AstNode) {
        rxbc_emit(bc, 1, 0);
        return;
    }
    if n.kind == 116 {
        rxbc_emit(bc, 1, n.val as i64);
        return;
    }
    if n.kind == 118 {
        let sptr: i64 = rxbc_intern_str(bc, n.hash as *u8, n.val);
        rxbc_emit(bc, 1, sptr);
        return;
    }
    if n.kind == 123 {
        let lidx: i64 = rxbc_find_fn_idx(bc, n.hash);
        rxbc_emit(bc, 1, lidx);
        return;
    }
    if n.kind == 117 {
        let sl: i64 = rxbc_find_loc(bc, n.hash);
        if sl >= 0 {
            rxbc_emit(bc, 2, sl);
            return;
        }
        let ce: *mut ConstEntry = parser_find_const(bc.p, n.hash);
        if ce != (0 as *mut ConstEntry) {
            if (ce.extra & 4294967295) == 2 {
                let cs: i64 = rxbc_intern_str(bc, ce.val as *u8, ce.extra >> 32);
                rxbc_emit(bc, 1, cs);
            } else {
                rxbc_emit(bc, 1, ce.val as i64);
            }
            return;
        }
        let fidx0: i64 = rxbc_find_fn_idx(bc, n.hash);
        rxbc_emit(bc, 1, fidx0);
        return;
    }
    if n.kind == 131 {
        rxbc_compile_expr(bc, n.child1);
        if n.is_mut == 0 {
            let csz: u64 = type_prim_size_from_tok(n.val as u32, n.hash);
            let csgn: u64 = is_signed_type_hash(n.val as u32, n.hash) as u64;
            if csz < 8 {
                rxbc_emit(bc, 37, (csz | (csgn << 8)) as i64);
            }
        }
        return;
    }
    if n.kind == 112 {
        if n.val == 53 {
            rxbc_compile_expr(bc, n.child1);
            rxbc_emit(bc, 21, 0);
            return;
        }
        if n.val == 54 {
            rxbc_compile_expr(bc, n.child1);
            rxbc_emit(bc, 22, 0);
            return;
        }
        if n.val == 50 {
            if n.child1 != (0 as *mut AstNode) {
                if n.child1.kind == 117 {
                    let asl: i64 = rxbc_find_loc(bc, n.child1.hash);
                    if asl >= 0 {
                        if rxbc_loc_cap(bc, asl as u64) > 0 {
                            rxbc_emit(bc, 2, asl);
                        } else {
                            rxbc_emit(bc, 39, asl);
                        }
                        return;
                    }
                } else if n.child1.kind == 115 {
                    let abk: u64 = rxbc_expr_kind(bc, n.child1.child1);
                    let astr: i64 = rxbc_stride_for_kind(abk) as i64;
                    rxbc_compile_expr(bc, n.child1.child1);
                    rxbc_compile_expr(bc, n.child1.child2);
                    if astr > 1 {
                        rxbc_emit(bc, 1, astr);
                        rxbc_emit(bc, 7, 0);
                    }
                    rxbc_emit(bc, 5, 0);
                    return;
                }
            }
            rxbc_compile_expr(bc, n.child1);
            return;
        }
        if n.val == 32 {
            let pk: u64 = rxbc_expr_kind(bc, n.child1);
            let pstr: u64 = rxbc_stride_for_kind(pk);
            rxbc_compile_expr(bc, n.child1);
            rxbc_emit(bc, 1, 0);
            rxbc_emit(bc, 28, pstr as i64);
            return;
        }
        rxbc_compile_expr(bc, n.child1);
        return;
    }
    if n.kind == 115 {
        let bk: u64 = rxbc_expr_kind(bc, n.child1);
        let stride: u64 = rxbc_stride_for_kind(bk);
        var cap: u64 = 0;
        if n.child1 != (0 as *mut AstNode) && n.child1.kind == 117 {
            let bsl: i64 = rxbc_find_loc(bc, n.child1.hash);
            if bsl >= 0 { cap = rxbc_loc_cap(bc, bsl as u64); }
        }
        rxbc_compile_expr(bc, n.child1);
        rxbc_compile_expr(bc, n.child2);
        rxbc_emit(bc, 28, (stride | (cap << 8)) as i64);
        return;
    }
    if n.kind == 124 {
        rxbc_compile_expr(bc, n.child1);
        let jz_hole: u64 = rxbc_emit(bc, 24, 0);
        rxbc_compile_expr(bc, n.child2);
        let jmp_hole: u64 = rxbc_emit(bc, 23, 0);
        rxbc_patch_arg(bc, jz_hole, bc.code_len as i64);
        rxbc_compile_expr(bc, n.child3);
        rxbc_patch_arg(bc, jmp_hole, bc.code_len as i64);
        return;
    }
    if n.kind == 133 {
        rxbc_compile_expr(bc, n.child1);
        return;
    }
    if n.kind == 106 {
        let op: u64 = n.val;
        if op == 49 {
            rxbc_compile_expr(bc, n.child1);
            let jz_a: u64 = rxbc_emit(bc, 24, 0);
            rxbc_compile_expr(bc, n.child2);
            let jz_b: u64 = rxbc_emit(bc, 24, 0);
            rxbc_emit(bc, 1, 1);
            let j_done: u64 = rxbc_emit(bc, 23, 0);
            rxbc_patch_arg(bc, jz_a, bc.code_len as i64);
            rxbc_patch_arg(bc, jz_b, bc.code_len as i64);
            rxbc_emit(bc, 1, 0);
            rxbc_patch_arg(bc, j_done, bc.code_len as i64);
            return;
        }
        if op == 57 {
            rxbc_compile_expr(bc, n.child1);
            let jnz_a: u64 = rxbc_emit(bc, 25, 0);
            rxbc_compile_expr(bc, n.child2);
            let jnz_b: u64 = rxbc_emit(bc, 25, 0);
            rxbc_emit(bc, 1, 0);
            let j_done2: u64 = rxbc_emit(bc, 23, 0);
            rxbc_patch_arg(bc, jnz_a, bc.code_len as i64);
            rxbc_patch_arg(bc, jnz_b, bc.code_len as i64);
            rxbc_emit(bc, 1, 1);
            rxbc_patch_arg(bc, j_done2, bc.code_len as i64);
            return;
        }
        rxbc_compile_expr(bc, n.child1);
        rxbc_compile_expr(bc, n.child2);
        if op == 30 { rxbc_emit(bc, 5, 0); return; }
        if op == 31 { rxbc_emit(bc, 6, 0); return; }
        if op == 32 { rxbc_emit(bc, 7, 0); return; }
        if op == 33 { rxbc_emit(bc, 8, 0); return; }
        if op == 34 { rxbc_emit(bc, 9, 0); return; }
        if op == 47 { rxbc_emit(bc, 10, 0); return; }
        if op == 48 { rxbc_emit(bc, 11, 0); return; }
        if op == 50 { rxbc_emit(bc, 12, 0); return; }
        if op == 51 { rxbc_emit(bc, 13, 0); return; }
        if op == 52 { rxbc_emit(bc, 14, 0); return; }
        if op == 41 { rxbc_emit(bc, 15, 0); return; }
        if op == 42 { rxbc_emit(bc, 16, 0); return; }
        if op == 43 { rxbc_emit(bc, 17, 0); return; }
        if op == 44 { rxbc_emit(bc, 18, 0); return; }
        if op == 45 { rxbc_emit(bc, 19, 0); return; }
        if op == 46 { rxbc_emit(bc, 20, 0); return; }
        rxbc_emit(bc, 4, 0);
        return;
    }
    if n.kind == 120 {
        var fd: i64 = 1;
        if n.val == 2 { fd = 2; }
        var pa: *mut AstNode = n.child1;
        while pa != (0 as *mut AstNode) {
            let pak: u64 = rxbc_expr_kind(bc, pa);
            rxbc_compile_expr(bc, pa);
            if pak == 1 && n.val != 3 {
                rxbc_emit(bc, 32, fd);
            } else {
                rxbc_emit(bc, 33, fd);
            }
            pa = pa.next;
        }
        if n.val == 1 || n.val == 2 {
            rxbc_emit(bc, 34, fd);
        }
        rxbc_emit(bc, 1, 0);
        return;
    }
    if n.kind == 119 {
        rxbc_compile_expr(bc, n.child1);
        var sac: i64 = 0;
        var sa: *mut AstNode = n.child2;
        while sa != (0 as *mut AstNode) && sac < 6 {
            rxbc_compile_expr(bc, sa);
            sac = sac + 1;
            sa = sa.next;
        }
        rxbc_emit(bc, 35, sac);
        return;
    }
    if n.kind == 113 {
        if n.hash == hash_identifier("sys_exit", 8) {
            rxbc_compile_expr(bc, n.child2);
            rxbc_emit(bc, 36, 0);
            rxbc_emit(bc, 1, 0);
            return;
        }
        var acnt: u64 = 0;
        var ca: *mut AstNode = n.child2;
        while ca != (0 as *mut AstNode) && acnt < 64 {
            rxbc_compile_expr(bc, ca);
            acnt = acnt + 1;
            ca = ca.next;
        }
        let fidx: i64 = rxbc_find_fn_idx(bc, n.hash);
        if fidx >= 0 {
            let call_pack: i64 = ((fidx as u64) | (acnt << 32)) as i64;
            rxbc_emit(bc, 30, call_pack);
            return;
        }
        if n.child1 != (0 as *mut AstNode) && n.child1.kind == 117 {
            let fn_loc: i64 = rxbc_find_loc(bc, n.child1.hash);
            if fn_loc >= 0 {
                rxbc_emit(bc, 2, fn_loc);
                rxbc_emit(bc, 40, acnt as i64);
                return;
            }
        }
        rxbc_emit(bc, 1, 0);
        return;
    }
    rxbc_emit(bc, 1, 0);
}

fn rxbc_compile_stmt_list(bc: *mut RxbcCompiler, stmts: *mut AstNode) {
    var cur: *mut AstNode = stmts;
    while cur != (0 as *mut AstNode) {
        rxbc_compile_stmt(bc, cur);
        cur = cur.next;
    }
}

fn rxbc_compile_stmt(bc: *mut RxbcCompiler, s: *mut AstNode) {
    if s == (0 as *mut AstNode) || s.kind == 0 { return; }

    if s.kind == 105 {
        if s.id == 10 || s.id == 11 || s.id == 12 {
            var astr: u64 = 8;
            if s.id == 10 { astr = 1; }
            else if s.id == 12 { astr = s.is_mut; }
            let aslot: u64 = rxbc_add_loc(bc, s.hash, astr, s.val);
            let apack: i64 = ((s.val & 4294967295) | (aslot << 32)) as i64;
            rxbc_emit(bc, 27, apack);
            return;
        }
        var vk: u64 = 0;
        if s.id == 11 { vk = 11; }
        else if s.id == 2 && (s.val == 23 || s.val == 631772817358541784) { vk = 1; }
        else if s.id == 1 || s.id == 2 { vk = 8; }
        else if s.child1 != (0 as *mut AstNode) { vk = rxbc_expr_kind(bc, s.child1); }
        let slot: u64 = rxbc_add_loc(bc, s.hash, vk, 0);
        if s.child1 != (0 as *mut AstNode) {
            rxbc_compile_expr(bc, s.child1);
        } else {
            rxbc_emit(bc, 1, 0);
        }
        rxbc_emit(bc, 3, slot as i64);
        return;
    }

    if s.kind == 106 {
        let lhs: *mut AstNode = s.child1;
        if lhs == (0 as *mut AstNode) { return; }
        if lhs.kind == 117 {
            let sl: i64 = rxbc_find_loc(bc, lhs.hash);
            if sl >= 0 {
                rxbc_compile_expr(bc, s.child2);
                rxbc_emit(bc, 3, sl);
            }
            return;
        }
        if lhs.kind == 115 {
            let bk: u64 = rxbc_expr_kind(bc, lhs.child1);
            let stride: u64 = rxbc_stride_for_kind(bk);
            var cap: u64 = 0;
            if lhs.child1 != (0 as *mut AstNode) && lhs.child1.kind == 117 {
                let bsl: i64 = rxbc_find_loc(bc, lhs.child1.hash);
                if bsl >= 0 { cap = rxbc_loc_cap(bc, bsl as u64); }
            }
            rxbc_compile_expr(bc, lhs.child1);
            rxbc_compile_expr(bc, lhs.child2);
            rxbc_compile_expr(bc, s.child2);
            rxbc_emit(bc, 29, (stride | (cap << 8)) as i64);
            return;
        }
        if lhs.kind == 112 && lhs.val == 32 {
            let pk: u64 = rxbc_expr_kind(bc, lhs.child1);
            let pstr: u64 = rxbc_stride_for_kind(pk);
            rxbc_compile_expr(bc, lhs.child1);
            rxbc_emit(bc, 1, 0);
            rxbc_compile_expr(bc, s.child2);
            rxbc_emit(bc, 29, pstr as i64);
            return;
        }
        return;
    }

    if s.kind == 107 {
        rxbc_compile_expr(bc, s.child1);
        let jz_else: u64 = rxbc_emit(bc, 24, 0);
        rxbc_compile_stmt_list(bc, s.child2);
        if s.child3 != (0 as *mut AstNode) {
            let j_end: u64 = rxbc_emit(bc, 23, 0);
            rxbc_patch_arg(bc, jz_else, bc.code_len as i64);
            if s.child3.kind == 107 {
                rxbc_compile_stmt(bc, s.child3);
            } else {
                rxbc_compile_stmt_list(bc, s.child3);
            }
            rxbc_patch_arg(bc, j_end, bc.code_len as i64);
        } else {
            rxbc_patch_arg(bc, jz_else, bc.code_len as i64);
        }
        return;
    }

    if s.kind == 108 {
        let d: u64 = bc.loop_depth;
        let loop_top: u64 = bc.code_len;
        if d < 32 {
            ((bc.cont_pcs + (d * 8)) as *mut u64)[0] = loop_top;
            ((bc.brk_cnts + (d * 8)) as *mut u64)[0] = 0;
        }
        bc.loop_depth = d + 1;
        rxbc_compile_expr(bc, s.child1);
        let jz_exit: u64 = rxbc_emit(bc, 24, 0);
        rxbc_compile_stmt_list(bc, s.child2);
        rxbc_emit(bc, 23, loop_top as i64);
        let exit_pc: i64 = bc.code_len as i64;
        rxbc_patch_arg(bc, jz_exit, exit_pc);
        bc.loop_depth = d;
        if d < 32 {
            let bcnt: u64 = ((bc.brk_cnts + (d * 8)) as *u64)[0];
            var bi: u64 = 0;
            while bi < bcnt {
                let bpc: u64 = ((bc.brk_holes + (((d * 64) + bi) * 8)) as *u64)[0];
                rxbc_patch_arg(bc, bpc, exit_pc);
                bi = bi + 1;
            }
        }
        return;
    }

    if s.kind == 125 {
        let fslot: u64 = rxbc_add_loc(bc, s.hash, 0, 0);
        rxbc_compile_expr(bc, s.child1);
        rxbc_emit(bc, 3, fslot as i64);
        let end_slot: u64 = rxbc_add_loc(bc, 888888000000 + s.id, 0, 0);
        rxbc_compile_expr(bc, s.child2);
        rxbc_emit(bc, 3, end_slot as i64);

        let d: u64 = bc.loop_depth;
        let cond_pc: u64 = bc.code_len;
        if d < 32 { ((bc.brk_cnts + (d * 8)) as *mut u64)[0] = 0; }
        rxbc_emit(bc, 2, fslot as i64);
        rxbc_emit(bc, 2, end_slot as i64);
        rxbc_emit(bc, 17, 0);
        let jz_exit: u64 = rxbc_emit(bc, 24, 0);

        var cont_holes: [u64; 64];
        if d < 32 { ((bc.cont_pcs + (d * 8)) as *mut u64)[0] = 0; }
        bc.loop_depth = d + 1;
        let body_start: u64 = bc.code_len;
        rxbc_compile_stmt_list(bc, s.child3);
        let step_pc: u64 = bc.code_len;
        rxbc_emit(bc, 2, fslot as i64);
        rxbc_emit(bc, 1, 1);
        rxbc_emit(bc, 5, 0);
        rxbc_emit(bc, 3, fslot as i64);
        rxbc_emit(bc, 23, cond_pc as i64);
        let exit_pc: i64 = bc.code_len as i64;
        rxbc_patch_arg(bc, jz_exit, exit_pc);
        bc.loop_depth = d;

        var pscan: u64 = body_start;
        while pscan < step_pc {
            let op_p: *i64 = (bc.code + (pscan * 16)) as *i64;
            if op_p[0] == 23 && op_p[1] == -999999 {
                rxbc_patch_arg(bc, pscan, step_pc as i64);
            }
            pscan = pscan + 1;
        }
        if d < 32 {
            let bcnt: u64 = ((bc.brk_cnts + (d * 8)) as *u64)[0];
            var bi: u64 = 0;
            while bi < bcnt {
                let bpc: u64 = ((bc.brk_holes + (((d * 64) + bi) * 8)) as *u64)[0];
                rxbc_patch_arg(bc, bpc, exit_pc);
                bi = bi + 1;
            }
        }
        return;
    }

    if s.kind == 129 {
        let mslot: u64 = rxbc_add_loc(bc, 777777000000 + s.id, 0, 0);
        rxbc_compile_expr(bc, s.child1);
        rxbc_emit(bc, 3, mslot as i64);
        var end_holes: [u64; 64];
        var end_cnt: u64 = 0;
        var marm: *mut AstNode = s.child2;
        while marm != (0 as *mut AstNode) {
            if marm.val == 1 {
                rxbc_compile_stmt_list(bc, marm.child2);
                if end_cnt < 64 {
                    end_holes[end_cnt] = rxbc_emit(bc, 23, 0);
                    end_cnt = end_cnt + 1;
                }
            } else {
                var hit_holes: [u64; 16];
                var hit_cnt: u64 = 0;
                var pat: *mut AstNode = marm.child1;
                while pat != (0 as *mut AstNode) {
                    rxbc_emit(bc, 2, mslot as i64);
                    rxbc_compile_expr(bc, pat);
                    rxbc_emit(bc, 15, 0);
                    if hit_cnt < 16 {
                        hit_holes[hit_cnt] = rxbc_emit(bc, 25, 0);
                        hit_cnt = hit_cnt + 1;
                    }
                    pat = pat.next;
                }
                let next_arm_h: u64 = rxbc_emit(bc, 23, 0);
                let hit_pc: i64 = bc.code_len as i64;
                var hi: u64 = 0;
                while hi < hit_cnt {
                    rxbc_patch_arg(bc, hit_holes[hi], hit_pc);
                    hi = hi + 1;
                }
                rxbc_compile_stmt_list(bc, marm.child2);
                if end_cnt < 64 {
                    end_holes[end_cnt] = rxbc_emit(bc, 23, 0);
                    end_cnt = end_cnt + 1;
                }
                rxbc_patch_arg(bc, next_arm_h, bc.code_len as i64);
            }
            marm = marm.next;
        }
        let mend_pc: i64 = bc.code_len as i64;
        var ei: u64 = 0;
        while ei < end_cnt {
            rxbc_patch_arg(bc, end_holes[ei], mend_pc);
            ei = ei + 1;
        }
        return;
    }

    if s.kind == 109 {
        if s.child1 != (0 as *mut AstNode) {
            rxbc_compile_expr(bc, s.child1);
        } else {
            rxbc_emit(bc, 1, 0);
        }
        rxbc_emit(bc, 31, 0);
        return;
    }

    if s.kind == 126 {
        if bc.loop_depth > 0 {
            let d: u64 = bc.loop_depth - 1;
            let bpc: u64 = rxbc_emit(bc, 23, 0);
            if d < 32 {
                let cnt: u64 = ((bc.brk_cnts + (d * 8)) as *u64)[0];
                if cnt < 64 {
                    ((bc.brk_holes + (((d * 64) + cnt) * 8)) as *mut u64)[0] = bpc;
                    ((bc.brk_cnts + (d * 8)) as *mut u64)[0] = cnt + 1;
                }
            }
        }
        return;
    }

    if s.kind == 127 {
        if bc.loop_depth > 0 {
            let d: u64 = bc.loop_depth - 1;
            let cpc: u64 = ((bc.cont_pcs + (d * 8)) as *u64)[0];
            if cpc == 0 {
                rxbc_emit(bc, 23, -999999);
            } else {
                rxbc_emit(bc, 23, cpc as i64);
            }
        }
        return;
    }

    if s.kind == 132 {
        rxbc_compile_stmt_list(bc, s.child1);
        return;
    }

    if s.kind == 110 {
        rxbc_compile_expr(bc, s.child1);
        rxbc_emit(bc, 4, 0);
        return;
    }
}

