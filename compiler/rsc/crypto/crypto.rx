include "lib/crypto/blake3_core.rx";

fn set_u32(buf: *mut u8, idx: u64, val: u32) {
    blake3_set_u32(buf, idx, val);
}

fn compute_canonical_sig_hash_ex(param_cnt: u32, calling_conv: u32, ret_type_hash: u64, ret_is_ptr: u64, param_types: *u64, param_ptrs: *u64) -> u64 {
    let total_len: u64 = 32 + ((param_cnt as u64) * 16);
    var stack_buf: [u8; 1056];
    var p: *mut u8 = &mut stack_buf[0];
    var used_heap: u64 = 0;
    if total_len > 1056 {
        p = uses_alloc(total_len);
        if (p as i64) <= 0 {
            uses_println("[RSC FATAL] OOM in compute_canonical_sig_hash");
            sys_exit(1);
        }
        used_heap = ((total_len + 15) / 16) * 16;
    }
    var i: u64 = 0;
    while i < total_len {
        p[i] = 0;
        i = i + 1;
    }

    // Domain tag "EIA_SIG2" distinguishes the dedicated ret_is_ptr layout from legacy hashes.
    p[0] = 69; p[1] = 73; p[2] = 65; p[3] = 95;
    p[4] = 83; p[5] = 73; p[6] = 71; p[7] = 50;

    p[8] = (param_cnt & 255) as u8;
    p[9] = ((param_cnt >> 8) & 255) as u8;
    p[10] = ((param_cnt >> 16) & 255) as u8;
    p[11] = ((param_cnt >> 24) & 255) as u8;

    p[12] = (calling_conv & 255) as u8;
    p[13] = ((calling_conv >> 8) & 255) as u8;
    p[14] = ((calling_conv >> 16) & 255) as u8;
    p[15] = ((calling_conv >> 24) & 255) as u8;

    var rh: u64 = ret_type_hash;
    var b: u64 = 0;
    while b < 8 {
        p[16 + b] = (rh & 255) as u8;
        rh = rh >> 8;
        b = b + 1;
    }

    var rptr: u64 = ret_is_ptr;
    b = 0;
    while b < 8 {
        p[24 + b] = (rptr & 255) as u8;
        rptr = rptr >> 8;
        b = b + 1;
    }

    var pi: u32 = 0;
    while pi < param_cnt {
        let base: u64 = 32 + ((pi as u64) * 16);
        var th: u64 = param_types[pi as u64];
        var ptr_kind: u64 = param_ptrs[pi as u64];
        b = 0;
        while b < 8 {
            p[base + b] = (th & 255) as u8;
            th = th >> 8;
            b = b + 1;
        }
        b = 0;
        while b < 8 {
            p[base + 8 + b] = (ptr_kind & 255) as u8;
            ptr_kind = ptr_kind >> 8;
            b = b + 1;
        }
        pi = pi + 1;
    }

    let sig_digest: u64 = blake3_hash64(p, total_len);
    if used_heap > 0 {
        uses_free(p, used_heap);
    }
    return sig_digest;
}

fn compute_canonical_sig_hash(param_cnt: u32, calling_conv: u32, ret_type_hash: u64, param_types: *u64, param_ptrs: *u64) -> u64 {
    return compute_canonical_sig_hash_ex(param_cnt, calling_conv, ret_type_hash, 0, param_types, param_ptrs);
}
