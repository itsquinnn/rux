                    out_path = "main.exe";
                }
            } else if host_a == 1 {
                format_kind = 0;
                target_arch = 1;
            } else if host_a == 2 {
                format_kind = 0;
                target_arch = 2;
            } else if host_a == 7 {
                format_kind = 2;
                target_arch = 7;
            } else if host_a == 10 {
                format_kind = 2;
                target_arch = 10;
