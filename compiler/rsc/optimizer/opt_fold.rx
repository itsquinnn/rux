fn opt_copy_node(dst: *mut AstNode, src: *mut AstNode) {
    if dst == (0 as *mut AstNode) || src == (0 as *mut AstNode) { return; }
    dst.kind = src.kind;
    dst.val = src.val;
    dst.hash = src.hash;
    dst.id = src.id;
    dst.is_mut = src.is_mut;
    dst.child1 = src.child1;
    dst.child2 = src.child2;
    dst.child3 = src.child3;
}

fn opt_log2_pow2(v: u64) -> i32 {
    if v < 2 { return -1; }
    if (v & (v - 1)) != 0 { return -1; }
    var k: i32 = 0;
    var tmp: u64 = v;
    while tmp > 1 {
        tmp = tmp >> 1;
        k = k + 1;
    }
    return k;
}

fn opt_is_pure_expr(n: *mut AstNode) -> u32 {
    if n == (0 as *mut AstNode) { return 1; }
    if n.kind == 116 || n.kind == 117 { return 1; }
    if n.kind == 131 { return opt_is_pure_expr(n.child1); }
    if n.kind == 106 {
        let op: u32 = n.val as u32;
        if op == 33 || op == 34 { return 0; }
        if opt_is_pure_expr(n.child1) == 1 && opt_is_pure_expr(n.child2) == 1 {
            return 1;
        }
    }
    return 0;
}

fn opt_expr_reads_var(n: *mut AstNode, var_hash: u64) -> u32 {
    if n == (0 as *mut AstNode) { return 0; }
    if n.kind == 117 && n.hash == var_hash { return 1; }
    if opt_expr_reads_var(n.child1, var_hash) == 1 { return 1; }
    if opt_expr_reads_var(n.child2, var_hash) == 1 { return 1; }
    if opt_expr_reads_var(n.child3, var_hash) == 1 { return 1; }
    if n.kind == 113 {
        var a: *mut AstNode = n.child2;
        while a != (0 as *mut AstNode) {
            if opt_expr_reads_var(a, var_hash) == 1 { return 1; }
            a = a.next;
        }
    }
    return 0;
}

fn opt_simplify_expr(node: *mut AstNode) {
    if node == (0 as *mut AstNode) { return; }
    opt_simplify_expr(node.child1);
    opt_simplify_expr(node.child2);
    opt_simplify_expr(node.child3);

    if node.kind == 113 {
        var a: *mut AstNode = node.child2;
        while a != (0 as *mut AstNode) {
            opt_simplify_expr(a);
            a = a.next;
        }
        return;
    }

    if node.kind != 106 { return; }
    let lhs: *mut AstNode = node.child1;
    let rhs: *mut AstNode = node.child2;
    if lhs == (0 as *mut AstNode) || rhs == (0 as *mut AstNode) { return; }
    let op: u32 = node.val as u32;

    if lhs.kind == 116 && rhs.kind == 116 {
        let a: u64 = lhs.val;
        let b: u64 = rhs.val;
        var folded: u32 = 0;
        var res: u64 = 0;
        if op == 30 { res = a + b; folded = 1; }
        else if op == 31 { res = a - b; folded = 1; }
        else if op == 32 { res = a * b; folded = 1; }
        else if op == 47 && b < 64 { res = a << b; folded = 1; }
        else if op == 48 && b < 64 { res = a >> b; folded = 1; }
        else if op == 50 { res = a & b; folded = 1; }
        else if op == 51 { res = a | b; folded = 1; }
        else if op == 52 { res = a ^ b; folded = 1; }
        if folded == 1 {
            node.kind = 116;
            node.val = res;
            node.child1 = 0 as *mut AstNode;
            node.child2 = 0 as *mut AstNode;
            return;
        }
    }

    if op == 30 {
        if rhs.kind == 116 && rhs.val == 0 { opt_copy_node(node, lhs); return; }
        if lhs.kind == 116 && lhs.val == 0 { opt_copy_node(node, rhs); return; }
    } else if op == 31 {
        if rhs.kind == 116 && rhs.val == 0 { opt_copy_node(node, lhs); return; }
        if lhs.kind == 117 && rhs.kind == 117 && lhs.hash == rhs.hash {
            node.kind = 116; node.val = 0; node.child1 = 0 as *mut AstNode; node.child2 = 0 as *mut AstNode; return;
        }
    } else if op == 32 {
        if rhs.kind == 116 {
            if rhs.val == 0 && opt_is_pure_expr(lhs) == 1 {
                node.kind = 116; node.val = 0; node.child1 = 0 as *mut AstNode; node.child2 = 0 as *mut AstNode; return;
            }
            if rhs.val == 1 { opt_copy_node(node, lhs); return; }
            let sh_k: i32 = opt_log2_pow2(rhs.val);
            if sh_k > 0 && sh_k <= 62 {
                node.val = 47;
                rhs.val = sh_k as u64;
                return;
            }
        }
        if lhs.kind == 116 {
            if lhs.val == 0 && opt_is_pure_expr(rhs) == 1 {
                node.kind = 116; node.val = 0; node.child1 = 0 as *mut AstNode; node.child2 = 0 as *mut AstNode; return;
            }
            if lhs.val == 1 { opt_copy_node(node, rhs); return; }
        }
    } else if op == 33 {
        if rhs.kind == 116 && rhs.val == 1 { opt_copy_node(node, lhs); return; }
    } else if op == 34 {
        if rhs.kind == 116 {
            if rhs.val == 1 && opt_is_pure_expr(lhs) == 1 {
                node.kind = 116; node.val = 0; node.child1 = 0 as *mut AstNode; node.child2 = 0 as *mut AstNode; return;
            }
            let sh_m: i32 = opt_log2_pow2(rhs.val);
            if sh_m > 0 && sh_m <= 62 {
                node.val = 50;
                rhs.val = rhs.val - 1;
                return;
            }
        }
    } else if op == 50 {
        if rhs.kind == 116 && rhs.val == 0 && opt_is_pure_expr(lhs) == 1 {
            node.kind = 116; node.val = 0; node.child1 = 0 as *mut AstNode; node.child2 = 0 as *mut AstNode; return;
        }
    } else if op == 51 || op == 47 || op == 48 {
        if rhs.kind == 116 && rhs.val == 0 { opt_copy_node(node, lhs); return; }
    } else if op == 52 {
        if rhs.kind == 116 && rhs.val == 0 { opt_copy_node(node, lhs); return; }
        if lhs.kind == 117 && rhs.kind == 117 && lhs.hash == rhs.hash {
            node.kind = 116; node.val = 0; node.child1 = 0 as *mut AstNode; node.child2 = 0 as *mut AstNode; return;
        }
    }
}

