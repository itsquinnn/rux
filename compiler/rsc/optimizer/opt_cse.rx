fn opt_is_cse_bin_expr(n: *mut AstNode) -> u32 {
    if n == (0 as *mut AstNode) || n.kind != 106 { return 0; }
    let op: u32 = n.val as u32;
    if op != 30 && op != 31 && op != 32 && op != 47 && op != 48 && op != 50 && op != 51 && op != 52 {
        return 0;
    }
    let l: *mut AstNode = n.child1;
    let r: *mut AstNode = n.child2;
    if l == (0 as *mut AstNode) || r == (0 as *mut AstNode) { return 0; }
    if (l.kind == 116 || l.kind == 117) && (r.kind == 116 || r.kind == 117) {
        return 1;
    }
    return 0;
}

fn opt_cse_match(a: *mut AstNode, b: *mut AstNode) -> u32 {
    if opt_is_cse_bin_expr(a) == 0 || opt_is_cse_bin_expr(b) == 0 { return 0; }
    if a.val != b.val { return 0; }
    let al: *mut AstNode = a.child1;
    let ar: *mut AstNode = a.child2;
    let bl: *mut AstNode = b.child1;
    let br: *mut AstNode = b.child2;
    if al.kind != bl.kind || ar.kind != br.kind { return 0; }
    if al.kind == 116 && al.val != bl.val { return 0; }
    if al.kind == 117 && al.hash != bl.hash { return 0; }
    if ar.kind == 116 && ar.val != br.val { return 0; }
    if ar.kind == 117 && ar.hash != br.hash { return 0; }
    return 1;
}

fn opt_cse_rewrite_subexpr(expr: *mut AstNode, avail_expr: *mut AstNode, holder_hash: u64) {
    if expr == (0 as *mut AstNode) { return; }
    if opt_cse_match(expr, avail_expr) == 1 {
        expr.kind = 117;
        expr.hash = holder_hash;
        expr.val = 0;
        expr.child1 = 0 as *mut AstNode;
        expr.child2 = 0 as *mut AstNode;
        return;
    }
    opt_cse_rewrite_subexpr(expr.child1, avail_expr, holder_hash);
    opt_cse_rewrite_subexpr(expr.child2, avail_expr, holder_hash);
}

fn opt_cse_stmt_list(stmts: *mut AstNode) {
    var avail_vars: [u64; 8];
    var avail_nodes: [u64; 8];
    var avail_cnt: u32 = 0;

    var cur: *mut AstNode = stmts;
    while cur != (0 as *mut AstNode) {
        if cur.kind == 105 || cur.kind == 109 || cur.kind == 110 {
            var ai: u32 = 0;
            while ai < avail_cnt {
                if avail_vars[ai as u64] != 0 {
                    opt_cse_rewrite_subexpr(cur.child1, avail_nodes[ai as u64] as *mut AstNode, avail_vars[ai as u64]);
                }
                ai = ai + 1;
            }
            if cur.kind == 105 && cur.id == 0 && opt_is_cse_bin_expr(cur.child1) == 1 {
                if opt_expr_reads_var(cur.child1, cur.hash) == 0 && avail_cnt < 8 {
                    avail_vars[avail_cnt as u64] = cur.hash;
                    avail_nodes[avail_cnt as u64] = cur.child1 as u64;
                    avail_cnt = avail_cnt + 1;
                }
            }
        } else if cur.kind == 106 {
            var ai2: u32 = 0;
            while ai2 < avail_cnt {
                if avail_vars[ai2 as u64] != 0 {
                    opt_cse_rewrite_subexpr(cur.child2, avail_nodes[ai2 as u64] as *mut AstNode, avail_vars[ai2 as u64]);
                }
                ai2 = ai2 + 1;
            }
            if cur.child1 != (0 as *mut AstNode) && cur.child1.kind == 117 {
                let mvar: u64 = cur.child1.hash;
                var inv_i: u32 = 0;
                while inv_i < avail_cnt {
                    if avail_vars[inv_i as u64] != 0 {
                        let en: *mut AstNode = avail_nodes[inv_i as u64] as *mut AstNode;
                        if avail_vars[inv_i as u64] == mvar || opt_expr_reads_var(en, mvar) == 1 {
                            avail_vars[inv_i as u64] = 0;
                        }
                    }
                    inv_i = inv_i + 1;
                }
                if opt_is_cse_bin_expr(cur.child2) == 1 && opt_expr_reads_var(cur.child2, mvar) == 0 && avail_cnt < 8 {
                    avail_vars[avail_cnt as u64] = mvar;
                    avail_nodes[avail_cnt as u64] = cur.child2 as u64;
                    avail_cnt = avail_cnt + 1;
                }
            } else {
                avail_cnt = 0;
            }
        } else if cur.kind != 0 {
            avail_cnt = 0;
        }
        cur = cur.next;
    }
}

