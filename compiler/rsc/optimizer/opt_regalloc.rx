struct RegVar {
    name_hash: u64,
    weight: u64,
    first_pos: u32,
    last_pos: u32,
    decl_count: u32,
    disqualified: u32,
    color: u32,
    is_agg: u32,
}

struct RegAllocState {
    vars: *mut RegVar,
    count: u32,
    cap: u32,
    pos: u32,
    loop_depth: u32,
    has_asm: u32,
    cg: *mut CodeGen,
}

fn ra_zero_bytes(ptr: *mut u8, n: u64) {
    var i: u64 = 0;
    while i < n {
        ptr[i] = 0;
        i = i + 1;
    }
}

fn ra_copy_bytes(dst: *mut u8, src: *mut u8, n: u64) {
    var i: u64 = 0;
    while i < n {
        dst[i] = src[i];
        i = i + 1;
    }
}

fn ra_var_at(st: *mut RegAllocState, idx: u32) -> *mut RegVar {
    return ((st.vars as *mut u8) + ((idx as u64) * 40)) as *mut RegVar;
}

fn ra_find_idx(st: *mut RegAllocState, name_hash: u64) -> i32 {
    if name_hash == 0 { return -1; }
    var i: u32 = 0;
    while i < st.count {
        let v: *mut RegVar = ra_var_at(st, i);
        if v.name_hash == name_hash { return i as i32; }
        i = i + 1;
    }
    return -1;
}

fn ra_find_or_add(st: *mut RegAllocState, name_hash: u64) -> i32 {
    if name_hash == 0 { return -1; }
    let existing: i32 = ra_find_idx(st, name_hash);
    if existing >= 0 { return existing; }
    if st.count >= st.cap {
        let old_bytes: u64 = (st.cap as u64) * 40;
        let new_cap: u32 = st.cap * 2;
        let new_bytes: u64 = (new_cap as u64) * 40;
        let new_buf: *mut u8 = uses_alloc(new_bytes);
        ra_zero_bytes(new_buf, new_bytes);
        ra_copy_bytes(new_buf, st.vars as *mut u8, old_bytes);
        uses_free(st.vars as *mut u8, old_bytes);
        st.vars = new_buf as *mut RegVar;
        st.cap = new_cap;
    }
    let idx: u32 = st.count;
    let v: *mut RegVar = ra_var_at(st, idx);
    v.name_hash = name_hash;
    v.weight = 0;
    v.first_pos = st.pos;
    v.last_pos = st.pos;
    v.decl_count = 0;
    v.disqualified = 0;
    v.color = 0;
    v.is_agg = 0;
    st.count = st.count + 1;
    return idx as i32;
}

fn ra_loop_weight(depth: u32) -> u64 {
    var d: u32 = depth;
    if d > 8 { d = 8; }
    return (1 as u64) << (d as u64);
}

fn ra_touch(st: *mut RegAllocState, name_hash: u64, is_defer: u32) {
    let idx: i32 = ra_find_idx(st, name_hash);
    if idx < 0 { return; }
    let v: *mut RegVar = ra_var_at(st, idx as u32);
    if st.pos < v.first_pos { v.first_pos = st.pos; }
    if is_defer == 1 {
        v.last_pos = 2147483647;
    } else if st.pos > v.last_pos {
        v.last_pos = st.pos;
    }
    v.weight = v.weight + ra_loop_weight(st.loop_depth);
}

fn ra_disqualify(st: *mut RegAllocState, name_hash: u64) {
    let idx: i32 = ra_find_or_add(st, name_hash);
    if idx < 0 { return; }
    let v: *mut RegVar = ra_var_at(st, idx as u32);
    v.disqualified = 1;
}

fn ra_disqualify_pattern(st: *mut RegAllocState, pat: *mut AstNode) {
    if pat == (0 as *mut AstNode) { return; }
    if pat.kind == 117 {
        ra_disqualify(st, pat.hash);
    } else if pat.kind == 121 || pat.kind == 122 {
        var el: *mut AstNode = pat.child1;
        while el != (0 as *mut AstNode) {
            ra_disqualify_pattern(st, el);
            el = el.next;
        }
    }
}

fn ra_walk_expr(st: *mut RegAllocState, expr: *mut AstNode, is_defer: u32) {
    if expr == (0 as *mut AstNode) { return; }
    if expr.kind == 135 {
        st.has_asm = 1;
        return;
    }
    if expr.kind == 112 && expr.val == 50 {
        if expr.child1 != (0 as *mut AstNode) && expr.child1.kind == 117 {
            ra_disqualify(st, expr.child1.hash);
        }
    } else if expr.kind == 117 {
        ra_touch(st, expr.hash, is_defer);
    }
    ra_walk_expr(st, expr.child1, is_defer);
    ra_walk_expr(st, expr.child2, is_defer);
    ra_walk_expr(st, expr.child3, is_defer);
    ra_walk_expr(st, expr.next, is_defer);
}

fn ra_extend_loop_vars(st: *mut RegAllocState, l_start: u32, l_end: u32) {
    var i: u32 = 0;
    while i < st.count {
        let v: *mut RegVar = ra_var_at(st, i);
        if v.first_pos <= l_start && v.last_pos > l_start && v.last_pos < l_end {
            v.last_pos = l_end;
        }
        i = i + 1;
    }
}

fn ra_walk_stmt_list(st: *mut RegAllocState, head: *mut AstNode, is_defer: u32) {
    var cur: *mut AstNode = head;
    while cur != (0 as *mut AstNode) {
        st.pos = st.pos + 1;
        if cur.kind == 105 {
            ra_walk_expr(st, cur.child1, is_defer);
            let idx: i32 = ra_find_or_add(st, cur.hash);
            if idx >= 0 {
                let v: *mut RegVar = ra_var_at(st, idx as u32);
                v.decl_count = v.decl_count + 1;
                if v.decl_count > 1 { v.disqualified = 1; }
                v.first_pos = st.pos;
                if st.pos > v.last_pos { v.last_pos = st.pos; }
                v.weight = v.weight + ra_loop_weight(st.loop_depth);
                var agg: u32 = 0;
                if cur.id == 3 || cur.id == 10 || cur.id == 11 || cur.id == 12 {
                    agg = 1;
                } else if cur.child1 != (0 as *mut AstNode) {
                    if cur.child1.kind == 121 || cur.child1.kind == 122 {
                        agg = 1;
                    } else if cur.child1.kind == 113 {
                        let frs: *mut ConstEntry = cg_find_fn_ret_struct(st.cg, cur.child1.hash);
                        if frs != (0 as *mut ConstEntry) {
                            if !(frs.extra == 0 && frs.val == 9398593617327382768) {
                                agg = 1;
                            }
                        }
                    } else if cur.child1.kind == 117 {
                        let sidx: i32 = ra_find_idx(st, cur.child1.hash);
                        if sidx >= 0 {
                            let sv: *mut RegVar = ra_var_at(st, sidx as u32);
                            if sv.is_agg == 1 { agg = 1; }
                        }
                    }
                }
                if agg == 1 {
                    v.is_agg = 1;
                    v.disqualified = 1;
                }
            }
        } else if cur.kind == 106 {
            ra_walk_expr(st, cur.child2, is_defer);
            ra_walk_expr(st, cur.child1, is_defer);
        } else if cur.kind == 107 {
            ra_walk_expr(st, cur.child1, is_defer);
            ra_walk_stmt_list(st, cur.child2, is_defer);
            ra_walk_stmt_list(st, cur.child3, is_defer);
        } else if cur.kind == 108 {
            let l_start: u32 = st.pos;
            st.pos = st.pos + 1;
            st.loop_depth = st.loop_depth + 1;
            ra_walk_expr(st, cur.child1, is_defer);
            ra_walk_stmt_list(st, cur.child2, is_defer);
            st.loop_depth = st.loop_depth - 1;
            let l_end: u32 = st.pos;
            ra_extend_loop_vars(st, l_start, l_end);
        } else if cur.kind == 125 {
            ra_walk_expr(st, cur.child1, is_defer);
            let f_start: u32 = st.pos;
            st.pos = st.pos + 1;
            let fidx: i32 = ra_find_or_add(st, cur.hash);
            if fidx >= 0 {
                let fv: *mut RegVar = ra_var_at(st, fidx as u32);
                fv.decl_count = fv.decl_count + 1;
                if fv.decl_count > 1 { fv.disqualified = 1; }
                fv.first_pos = st.pos;
                fv.last_pos = st.pos;
                fv.weight = fv.weight + ra_loop_weight(st.loop_depth + 1);
            }
            ra_walk_expr(st, cur.child2, is_defer);
            st.loop_depth = st.loop_depth + 1;
            ra_walk_stmt_list(st, cur.child3, is_defer);
            st.loop_depth = st.loop_depth - 1;
            let f_end: u32 = st.pos;
            ra_extend_loop_vars(st, f_start, f_end);
            if fidx >= 0 {
                let fv2: *mut RegVar = ra_var_at(st, fidx as u32);
                if fv2.last_pos < f_end { fv2.last_pos = f_end; }
            }
        } else if cur.kind == 129 {
            ra_walk_expr(st, cur.child1, is_defer);
            var marm: *mut AstNode = cur.child2;
            while marm != (0 as *mut AstNode) {
                ra_disqualify_pattern(st, marm.child1);
                ra_walk_expr(st, marm.child3, is_defer);
                ra_walk_stmt_list(st, marm.child2, is_defer);
                marm = marm.next;
            }
        } else if cur.kind == 128 {
            ra_walk_stmt_list(st, cur.child1, 1);
        } else if cur.kind == 132 {
            ra_walk_stmt_list(st, cur.child1, is_defer);
        } else if cur.kind == 135 {
            st.has_asm = 1;
        } else if cur.kind == 109 || cur.kind == 110 {
            ra_walk_expr(st, cur.child1, is_defer);
        } else {
            ra_walk_expr(st, cur.child1, is_defer);
            ra_walk_expr(st, cur.child2, is_defer);
        }
        cur = cur.next;
    }
}

fn ra_bit_get(adj: *mut u64, words: u64, i: u32, j: u32) -> u32 {
    let w: u64 = (j as u64) / 64;
    let b: u64 = (j as u64) % 64;
    if (adj[((i as u64) * words) + w] & ((1 as u64) << b)) != 0 { return 1; }
    return 0;
}

fn ra_bit_set(adj: *mut u64, words: u64, i: u32, j: u32) {
    let wi: u64 = ((i as u64) * words) + ((j as u64) / 64);
    let wj: u64 = ((j as u64) * words) + ((i as u64) / 64);
    adj[wi] = adj[wi] | ((1 as u64) << ((j as u64) % 64));
    adj[wj] = adj[wj] | ((1 as u64) << ((i as u64) % 64));
}

fn ra_store_cg_reg(cg: *mut CodeGen, name_hash: u64, hw_reg: u8) {
    if cg.reg_var_count >= cg.reg_var_cap {
        var new_cap: u64 = 128;
        if cg.reg_var_cap > 0 { new_cap = cg.reg_var_cap * 2; }
        let new_h: *mut u64 = uses_alloc(new_cap * 8) as *mut u64;
        let new_a: *mut u8 = uses_alloc(new_cap);
        ra_zero_bytes(new_h as *mut u8, new_cap * 8);
        ra_zero_bytes(new_a, new_cap);
        if cg.reg_hashes != (0 as *mut u64) && cg.reg_var_cap > 0 {
            ra_copy_bytes(new_h as *mut u8, cg.reg_hashes as *mut u8, cg.reg_var_count * 8);
            uses_free(cg.reg_hashes as *mut u8, cg.reg_var_cap * 8);
        }
        if cg.reg_allocs != (0 as *mut u8) && cg.reg_var_cap > 0 {
            ra_copy_bytes(new_a, cg.reg_allocs, cg.reg_var_count);
            uses_free(cg.reg_allocs, cg.reg_var_cap);
        }
        cg.reg_hashes = new_h;
        cg.reg_allocs = new_a;
        cg.reg_var_cap = new_cap;
    }
    cg.reg_hashes[cg.reg_var_count] = name_hash;
    cg.reg_allocs[cg.reg_var_count] = hw_reg;
    cg.reg_var_count = cg.reg_var_count + 1;
}

fn opt_regalloc_prepare_fn(cg: *mut CodeGen, fnode: *mut AstNode) {
    cg.reg_var_count = 0;
    cg.fn_callee_mask = 0;
    if cg == (0 as *mut CodeGen) || fnode == (0 as *mut AstNode) { return; }
    if cg.has_lambdas != 0 || cg.skip_ir_opt != 0 || cg.target_arch != 0 { return; }

    var st: RegAllocState;
    st.cap = 64;
    st.vars = uses_alloc((st.cap as u64) * 40) as *mut RegVar;
    ra_zero_bytes(st.vars as *mut u8, (st.cap as u64) * 40);
    st.count = 0;
    st.pos = 0;
    st.loop_depth = 0;
    st.has_asm = 0;
    st.cg = cg;

    var p_cnt: u32 = 0;
    var p_cur: *mut AstNode = fnode.child2;
    while p_cur != (0 as *mut AstNode) && p_cnt < 64 {
        let pidx: i32 = ra_find_or_add(&mut st, p_cur.hash);
        if pidx >= 0 {
            let pv: *mut RegVar = ra_var_at(&mut st, pidx as u32);
            pv.decl_count = pv.decl_count + 1;
            if pv.decl_count > 1 || p_cur.is_mut == 99 { pv.disqualified = 1; }
            pv.first_pos = 0;
            pv.last_pos = 0;
            pv.weight = pv.weight + 1;
        }
        p_cnt = p_cnt + 1;
        p_cur = p_cur.next;
    }

    ra_walk_stmt_list(&mut st, fnode.child1, 0);

    if st.has_asm != 0 || st.count == 0 {
        uses_free(st.vars as *mut u8, (st.cap as u64) * 40);
        return;
    }

    let max_end: u32 = st.pos + 1;
    var k: u32 = 0;
    while k < st.count {
        let vk: *mut RegVar = ra_var_at(&mut st, k);
        if vk.last_pos == 2147483647 { vk.last_pos = max_end; }
        k = k + 1;
    }

    let elig_bytes: u64 = (st.count as u64) * 4;
    let elig: *mut u32 = uses_alloc(elig_bytes) as *mut u32;
    var m: u32 = 0;
    k = 0;
    while k < st.count {
        let vk2: *mut RegVar = ra_var_at(&mut st, k);
        if vk2.disqualified == 0 && vk2.is_agg == 0 && vk2.weight > 0 {
            elig[m as u64] = k;
            m = m + 1;
        }
        k = k + 1;
    }

    if m == 0 {
        uses_free(elig as *mut u8, elig_bytes);
        uses_free(st.vars as *mut u8, (st.cap as u64) * 40);
        return;
    }

    let words: u64 = ((m as u64) + 63) / 64;
    let adj_bytes: u64 = (m as u64) * words * 8;
    let u32_bytes: u64 = (m as u64) * 4;
    let adj: *mut u64 = uses_alloc(adj_bytes) as *mut u64;
    let cur_deg: *mut u32 = uses_alloc(u32_bytes) as *mut u32;
    let removed: *mut u8 = uses_alloc(m as u64);
    let stack: *mut u32 = uses_alloc(u32_bytes) as *mut u32;
    let colors: *mut u8 = uses_alloc(m as u64);
    ra_zero_bytes(adj as *mut u8, adj_bytes);
    ra_zero_bytes(cur_deg as *mut u8, u32_bytes);
    ra_zero_bytes(removed, m as u64);
    ra_zero_bytes(colors, m as u64);

    var a: u32 = 0;
    while a < m {
        let va: *mut RegVar = ra_var_at(&mut st, elig[a as u64]);
        var b: u32 = a + 1;
        while b < m {
            let vb: *mut RegVar = ra_var_at(&mut st, elig[b as u64]);
            if va.first_pos <= vb.last_pos && vb.first_pos <= va.last_pos {
                ra_bit_set(adj, words, a, b);
                cur_deg[a as u64] = cur_deg[a as u64] + 1;
                cur_deg[b as u64] = cur_deg[b as u64] + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }

    var sp: u32 = 0;
    while sp < m {
        var pick: i32 = -1;
        a = 0;
        while a < m {
            if removed[a as u64] == 0 && cur_deg[a as u64] < 4 {
                if pick < 0 {
                    pick = a as i32;
                } else {
                    let vp: *mut RegVar = ra_var_at(&mut st, elig[pick as u64]);
                    let va2: *mut RegVar = ra_var_at( &mut st, elig[a as u64] );
                    if va2.weight < vp.weight { pick = a as i32; }
                }
            }
            a = a + 1;
        }
        if pick < 0 {
            a = 0;
            while a < m {
                if removed[a as u64] == 0 {
                    if pick < 0 {
                        pick = a as i32;
                    } else {
                        let vp2: *mut RegVar = ra_var_at(&mut st, elig[pick as u64]);
                        let va3: *mut RegVar = ra_var_at(&mut st, elig[a as u64]);
                        if va3.weight < vp2.weight { pick = a as i32; }
                    }
                }
                a = a + 1;
            }
        }
        let u: u32 = pick as u32;
        removed[u as u64] = 1;
        stack[sp as u64] = u;
        sp = sp + 1;
        var nb: u32 = 0;
        while nb < m {
            if removed[nb as u64] == 0 && ra_bit_get(adj, words, u, nb) == 1 {
                if cur_deg[nb as u64] > 0 {
                    cur_deg[nb as u64] = cur_deg[nb as u64] - 1;
                }
            }
            nb = nb + 1;
        }
    }

    while sp > 0 {
        sp = sp - 1;
        let u2: u32 = stack[sp as u64];
        var used_mask: u32 = 0;
        var nb2: u32 = 0;
        while nb2 < m {
            let cnb: u8 = colors[nb2 as u64];
            if cnb >= 12 && ra_bit_get(adj, words, u2, nb2) == 1 {
                used_mask = used_mask | (1 << ((cnb - 12) as u32));
            }
            nb2 = nb2 + 1;
        }
        var c: u32 = 0;
        while c < 4 {
            if (used_mask & (1 << c)) == 0 {
                colors[u2 as u64] = (12 + c) as u8;
                cg.fn_callee_mask = cg.fn_callee_mask | ((1 as u64) << (c as u64));
                let vc: *mut RegVar = ra_var_at(&mut st, elig[u2 as u64]);
                ra_store_cg_reg(cg, vc.name_hash, colors[u2 as u64]);
                break;
            }
            c = c + 1;
        }
    }

    uses_free(adj as *mut u8, adj_bytes);
    uses_free(cur_deg as *mut u8, u32_bytes);
    uses_free(removed, m as u64);
    uses_free(stack as *mut u8, u32_bytes);
    uses_free(colors, m as u64);
    uses_free(elig as *mut u8, elig_bytes);
    uses_free(st.vars as *mut u8, (st.cap as u64) * 40);
}
