struct RegInterferenceGraph {
    var_hashes: [u64; 16],
    first_step: [u32; 16],
    last_step: [u32; 16],
    adj_mask: [u32; 16],
    reg_color: [i32; 16],
    var_count: u32,
}

struct MirInstr {
    opcode: u32,
    dst_ssa: u32,
    src1_ssa: u32,
    src2_ssa: u32,
    imm_val: u64,
}

struct VastLoopDesc {
    ind_var_hash: u64,
    limit_val: u64,
    accum0_hash: u64,
    accum1_hash: u64,
    vector_width: u32,
    unroll_factor: u32,
}


fn opt_bce_prove_index_safe(lv_arr: *mut LocalVar, idx_node: *mut AstNode, stride: u64) -> u32 {
    if lv_arr == (0 as *mut LocalVar) || idx_node == (0 as *mut AstNode) { return 0; }
    if idx_node.kind == 116 && stride > 0 && lv_arr.size > 0 {
        if (idx_node.val * stride) < lv_arr.size {
            return 1;
        }
    }
    return 0;
}

fn opt_regalloc_color_fn(stmts: *mut AstNode, out_graph: *mut RegInterferenceGraph) -> u32 {
    if out_graph == (0 as *mut RegInterferenceGraph) { return 0; }
    out_graph.var_count = 0;
    var step: u32 = 0;
    var cur: *mut AstNode = stmts;
    while cur != (0 as *mut AstNode) {
        step = step + 1;
        if cur.kind == 105 && cur.id == 0 && out_graph.var_count < 16 {
            let idx: u64 = out_graph.var_count as u64;
            out_graph.var_hashes[idx] = cur.hash;
            out_graph.first_step[idx] = step;
            out_graph.last_step[idx] = step;
            out_graph.adj_mask[idx] = 0;
            out_graph.reg_color[idx] = -1;
            out_graph.var_count = out_graph.var_count + 1;
        } else if cur.kind == 106 || cur.kind == 109 {
            var vi: u32 = 0;
            while vi < out_graph.var_count {
                let vh: u64 = out_graph.var_hashes[vi as u64];
                if opt_expr_reads_var(cur.child1, vh) == 1 || opt_expr_reads_var(cur.child2, vh) == 1 {
                    out_graph.last_step[vi as u64] = step;
                }
                vi = vi + 1;
            }
        }
        cur = cur.next;
    }

    var i: u32 = 0;
    while i < out_graph.var_count {
        var j: u32 = i + 1;
        while j < out_graph.var_count {
            let s_i: u32 = out_graph.first_step[i as u64];
            let e_i: u32 = out_graph.last_step[i as u64];
            let s_j: u32 = out_graph.first_step[j as u64];
            let e_j: u32 = out_graph.last_step[j as u64];
            if s_i <= e_j && s_j <= e_i {
                out_graph.adj_mask[i as u64] = out_graph.adj_mask[i as u64] | (1 << j);
                out_graph.adj_mask[j as u64] = out_graph.adj_mask[j as u64] | (1 << i);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    var colored: u32 = 0;
    var ci: u32 = 0;
    while ci < out_graph.var_count {
        var used_colors: u32 = 0;
        let mask: u32 = out_graph.adj_mask[ci as u64];
        var nb: u32 = 0;
        while nb < ci {
            if ((mask >> nb) & 1) != 0 && out_graph.reg_color[nb as u64] >= 0 {
                used_colors = used_colors | (1 << (out_graph.reg_color[nb as u64] as u32));
            }
            nb = nb + 1;
        }
        var c: i32 = 0;
        while c < 8 {
            if ((used_colors >> (c as u32)) & 1) == 0 {
                out_graph.reg_color[ci as u64] = c;
                colored = colored + 1;
                c = 8;
            } else {
                c = c + 1;
            }
        }
        ci = ci + 1;
    }
    return colored;
}

