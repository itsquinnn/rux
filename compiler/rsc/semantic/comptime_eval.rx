fn register_comptime_fn(p: *mut Parser, fnode: *mut AstNode) {
    if p == (0 as *mut Parser) || fnode == (0 as *mut AstNode) { return; }
    if p.fn_asts == (0 as *mut u8) { return; }
    if p.fn_ast_count >= 4096 { return; }
    let slot: *mut u64 = (p.fn_asts + (p.fn_ast_count * 16)) as *mut u64;
    slot[0] = fnode.hash;
    slot[1] = fnode as u64;
    p.fn_ast_count = p.fn_ast_count + 1;
}

fn find_comptime_fn(p: *mut Parser, fn_hash: u64) -> *mut AstNode {
    if p == (0 as *mut Parser) || p.fn_asts == (0 as *mut u8) { return 0 as *mut AstNode; }
    var i: u64 = p.fn_ast_count;
    while i > 0 {
        i = i - 1;
        let slot: *mut u64 = (p.fn_asts + (i * 16)) as *mut u64;
        if slot[0] == fn_hash {
            return slot[1] as *mut AstNode;
        }
    }
    return 0 as *mut AstNode;
}

fn eval_comptime_stmt_list(p: *mut Parser, stmts: *mut AstNode, out_ret: *mut u64) -> u32 {
    var cur: *mut AstNode = stmts;
    while cur != (0 as *mut AstNode) {
        if cur.kind == 105 {
            let val: u64 = eval_const_ast(p, cur.child1);
            parser_add_const(p, cur.hash, val, 1);
        } else if cur.kind == 106 {
            if cur.child1 != (0 as *mut AstNode) && cur.child1.kind == 117 {
                let aval: u64 = eval_const_ast(p, cur.child2);
                parser_add_const(p, cur.child1.hash, aval, 1);
            }
        } else if cur.kind == 107 {
            let cond: u64 = eval_const_ast(p, cur.child1);
            if cond != 0 {
                if eval_comptime_stmt_list(p, cur.child2, out_ret) == 1 { return 1; }
            } else if cur.child3 != (0 as *mut AstNode) {
                if cur.child3.kind == 107 {
                    if eval_comptime_stmt_list(p, cur.child3, out_ret) == 1 { return 1; }
                } else {
                    if eval_comptime_stmt_list(p, cur.child3, out_ret) == 1 { return 1; }
                }
            }
        } else if cur.kind == 108 {
            var w_iter: u32 = 0;
            while eval_const_ast(p, cur.child1) != 0 && w_iter < 10000 {
                if eval_comptime_stmt_list(p, cur.child2, out_ret) == 1 { return 1; }
                w_iter = w_iter + 1;
            }
        } else if cur.kind == 125 {
            let start_v: u64 = eval_const_ast(p, cur.child1);
            let end_v: u64 = eval_const_ast(p, cur.child2);
            let is_incl: u64 = cur.val;
            var iter_v: u64 = start_v;
            var loop_limit: u32 = 0;
            while loop_limit < 10000 {
                if is_incl == 1 {
                    if iter_v > end_v { break; }
                } else {
                    if iter_v >= end_v { break; }
                }
                parser_add_const(p, cur.hash, iter_v, 1);
                if eval_comptime_stmt_list(p, cur.child3, out_ret) == 1 { return 1; }
                iter_v = iter_v + 1;
                loop_limit = loop_limit + 1;
            }
        } else if cur.kind == 109 {
            out_ret[0] = eval_const_ast(p, cur.child1);
            return 1;
        } else if cur.kind == 110 {
            out_ret[0] = eval_const_ast(p, cur.child1);
        }
        cur = cur.next;
    }
    return 0;
}

fn eval_comptime_node(p: *mut Parser, n: *mut AstNode) -> u64 {
    if n == (0 as *mut AstNode) { return 0; }
    if n.kind == 124 {
        let c: u64 = eval_const_ast(p, n.child1);
        if c != 0 { return eval_const_ast(p, n.child2); }
        return eval_const_ast(p, n.child3);
    }
    if n.kind == 129 {
        let tgt: u64 = eval_const_ast(p, n.child1);
        var arm: *mut AstNode = n.child2;
        while arm != (0 as *mut AstNode) {
            if arm.val == 1 {
                return eval_const_ast(p, arm.child2);
            }
            var pat: *mut AstNode = arm.child1;
            while pat != (0 as *mut AstNode) {
                if eval_const_ast(p, pat) == tgt {
                    return eval_const_ast(p, arm.child2);
                }
                pat = pat.next;
            }
            arm = arm.next;
        }
        return 0;
    }
    if n.kind == 113 {
        if n.hash == 7061682049280495870 {
            var la: *mut AstNode = n.child2;
            print("[COMPTIME LOG] ");
            while la != (0 as *mut AstNode) {
                if la.kind == 118 {
                    let s_ptr: *u8 = la.hash as *u8;
                    let s_len: u64 = la.val;
                    if s_len >= 2 {
                        @os.write(1, s_ptr + 1, s_len - 2);
                    }
                } else {
                    print(eval_const_ast(p, la));
                }
                la = la.next;
            }
            println("");
            return 0;
        }
        if n.hash == 18173227160901878698 {
            println("[COMPTIME ERROR] Compile-time assertion failed!");
            sys_exit(1);
        }
        let fn_ast: *mut AstNode = find_comptime_fn(p, n.hash);
        if fn_ast == (0 as *mut AstNode) { return 0; }

        var arg_vals: [u64; 8];
        var param_hashes: [u64; 8];
        var saved_vals: [u64; 8];
        var saved_extras: [u64; 8];
        var had_saved: [u32; 8];
        var p_cnt: u64 = 0;
        let saved_const_count: u64 = p.const_count;

        var pa: *mut AstNode = n.child2;
        var pp: *mut AstNode = fn_ast.child2;
        while pa != (0 as *mut AstNode) && pp != (0 as *mut AstNode) && p_cnt < 8 {
            arg_vals[p_cnt] = eval_const_ast(p, pa);
            param_hashes[p_cnt] = pp.hash;
            let ex: *mut ConstEntry = parser_find_const(p, pp.hash);
            if ex != (0 as *mut ConstEntry) {
                had_saved[p_cnt] = 1;
                saved_vals[p_cnt] = ex.val;
                saved_extras[p_cnt] = ex.extra;
            } else {
                had_saved[p_cnt] = 0;
                saved_vals[p_cnt] = 0;
                saved_extras[p_cnt] = 0;
            }
            p_cnt = p_cnt + 1;
            pa = pa.next;
            pp = pp.next;
        }

        var bi: u64 = 0;
        while bi < p_cnt {
            parser_add_const(p, param_hashes[bi], arg_vals[bi], 1);
            bi = bi + 1;
        }

        var ret_slot: [u64; 1];
        ret_slot[0] = 0;
        eval_comptime_stmt_list(p, fn_ast.child1, &mut ret_slot[0]);

        p.const_count = saved_const_count;
        bi = 0;
        while bi < p_cnt {
            if had_saved[bi] == 1 {
                parser_add_const(p, param_hashes[bi], saved_vals[bi], saved_extras[bi]);
            }
            bi = bi + 1;
        }
        return ret_slot[0];
    }
    return 0;
}

