struct SafetyVar {
    name_hash: u64,
    type_hash: u64,
    drop_fn_hash: u64,
    borrow_target_hash: u64,
    scope_depth: u32,
    is_moved: u32,
    borrow_count: u32,
    is_mut_borrowed: u32,
    is_copy: u32,
    is_ptr: u32,
    borrow_is_mut: u32,
    pad_u32: u32,
}

struct SafetyContext {
    vars: *mut SafetyVar,
    var_count: u32,
    var_cap: u32,
    scope_depth: u32,
    unsafe_depth: u32,
    strict_safety: u32,
    error_count: u32,
    call_depth: u32,
    temp_hashes: *mut u64,
    temp_muts: *mut u32,
    temp_count: u32,
    temp_cap: u32,
    parser: *mut Parser,
}

fn safety_copy_bytes(dst: *mut u8, src: *mut u8, n: u64) {
    var i: u64 = 0;
    while i < n {
        dst[i] = src[i];
        i = i + 1;
    }
}

fn safety_var_at(sc: *mut SafetyContext, idx: u32) -> *mut SafetyVar {
    return ((sc.vars as *mut u8) + ((idx as u64) * 64)) as *mut SafetyVar;
}

fn safety_init(sc: *mut SafetyContext, p: *mut Parser, strict: u32) {
    sc.var_cap = 256;
    sc.vars = uses_alloc((sc.var_cap as u64) * 64) as *mut SafetyVar;
    sc.var_count = 0;
    sc.scope_depth = 0;
    sc.unsafe_depth = 0;
    sc.strict_safety = strict;
    sc.error_count = 0;
    sc.call_depth = 0;
    sc.temp_cap = 64;
    sc.temp_hashes = uses_alloc((sc.temp_cap as u64) * 8) as *mut u64;
    sc.temp_muts = uses_alloc((sc.temp_cap as u64) * 4) as *mut u32;
    sc.temp_count = 0;
    sc.parser = p;
}

fn safety_free(sc: *mut SafetyContext) {
    if sc.vars != (0 as *mut SafetyVar) {
        uses_free(sc.vars as *mut u8, (sc.var_cap as u64) * 64);
        sc.vars = 0 as *mut SafetyVar;
    }
    if sc.temp_hashes != (0 as *mut u64) {
        uses_free(sc.temp_hashes as *mut u8, (sc.temp_cap as u64) * 8);
        sc.temp_hashes = 0 as *mut u64;
    }
    if sc.temp_muts != (0 as *mut u32) {
        uses_free(sc.temp_muts as *mut u8, (sc.temp_cap as u64) * 4);
        sc.temp_muts = 0 as *mut u32;
    }
}

fn safety_find_var(sc: *mut SafetyContext, name_hash: u64) -> *mut SafetyVar {
    if name_hash == 0 { return 0 as *mut SafetyVar; }
    var i: u32 = sc.var_count;
    while i > 0 {
        i = i - 1;
        let v: *mut SafetyVar = safety_var_at(sc, i);
        if v.name_hash == name_hash {
            return v;
        }
    }
    return 0 as *mut SafetyVar;
}

fn safety_register_var_ex(sc: *mut SafetyContext, name_hash: u64, type_hash: u64, is_copy: u32, is_ptr: u32, drop_fn: u64, borrow_target: u64, borrow_is_mut: u32) {
    if sc.var_count >= sc.var_cap {
        let old_bytes: u64 = (sc.var_cap as u64) * 64;
        let new_cap: u32 = sc.var_cap * 2;
        let new_bytes: u64 = (new_cap as u64) * 64;
        let new_buf: *mut u8 = uses_alloc(new_bytes);
        safety_copy_bytes(new_buf, sc.vars as *mut u8, old_bytes);
        uses_free(sc.vars as *mut u8, old_bytes);
        sc.vars = new_buf as *mut SafetyVar;
        sc.var_cap = new_cap;
    }
    let v: *mut SafetyVar = safety_var_at(sc, sc.var_count);
    v.name_hash = name_hash;
    v.type_hash = type_hash;
    v.drop_fn_hash = drop_fn;
    v.borrow_target_hash = borrow_target;
    v.scope_depth = sc.scope_depth;
    v.is_moved = 0;
    v.borrow_count = 0;
    v.is_mut_borrowed = 0;
    v.is_copy = is_copy;
    v.is_ptr = is_ptr;
    v.borrow_is_mut = borrow_is_mut;
    v.pad_u32 = 0;
    sc.var_count = sc.var_count + 1;
}

fn safety_register_var(sc: *mut SafetyContext, name_hash: u64, type_hash: u64, is_copy: u32, drop_fn: u64) {
    safety_register_var_ex(sc, name_hash, type_hash, is_copy, 0, drop_fn, 0, 0);
}

fn safety_release_borrow(sc: *mut SafetyContext, target_hash: u64, is_mut: u32) {
    if target_hash == 0 { return; }
    let t: *mut SafetyVar = safety_find_var(sc, target_hash);
    if t == (0 as *mut SafetyVar) { return; }
    if is_mut == 1 {
        t.is_mut_borrowed = 0;
    } else if t.borrow_count > 0 {
        t.borrow_count = t.borrow_count - 1;
    }
}

fn safety_push_temp_borrow(sc: *mut SafetyContext, target_hash: u64, is_mut: u32) {
    if sc.temp_count >= sc.temp_cap {
        let old_h_bytes: u64 = (sc.temp_cap as u64) * 8;
        let old_m_bytes: u64 = (sc.temp_cap as u64) * 4;
        let new_cap: u32 = sc.temp_cap * 2;
        let new_h: *mut u8 = uses_alloc((new_cap as u64) * 8);
        let new_m: *mut u8 = uses_alloc((new_cap as u64) * 4);
        safety_copy_bytes(new_h, sc.temp_hashes as *mut u8, old_h_bytes);
        safety_copy_bytes(new_m, sc.temp_muts as *mut u8, old_m_bytes);
        uses_free(sc.temp_hashes as *mut u8, old_h_bytes);
        uses_free(sc.temp_muts as *mut u8, old_m_bytes);
        sc.temp_hashes = new_h as *mut u64;
        sc.temp_muts = new_m as *mut u32;
        sc.temp_cap = new_cap;
    }
    let hp: *mut u64 = ((sc.temp_hashes as *mut u8) + ((sc.temp_count as u64) * 8)) as *mut u64;
    let mp: *mut u32 = ((sc.temp_muts as *mut u8) + ((sc.temp_count as u64) * 4)) as *mut u32;
    *hp = target_hash;
    *mp = is_mut;
    sc.temp_count = sc.temp_count + 1;
}

fn safety_unwind_temp_borrows(sc: *mut SafetyContext, saved_cnt: u32) {
    while sc.temp_count > saved_cnt {
        sc.temp_count = sc.temp_count - 1;
        let hp: *mut u64 = ((sc.temp_hashes as *mut u8) + ((sc.temp_count as u64) * 8)) as *mut u64;
        let mp: *mut u32 = ((sc.temp_muts as *mut u8) + ((sc.temp_count as u64) * 4)) as *mut u32;
        safety_release_borrow(sc, *hp, *mp);
    }
}

fn safety_enter_scope(sc: *mut SafetyContext) {
    sc.scope_depth = sc.scope_depth + 1;
}

fn safety_exit_scope(sc: *mut SafetyContext) {
    var i: u32 = sc.var_count;
    while i > 0 {
        i = i - 1;
        let v: *mut SafetyVar = safety_var_at(sc, i);
        if v.scope_depth == sc.scope_depth && v.name_hash != 0 && v.borrow_target_hash != 0 {
            safety_release_borrow(sc, v.borrow_target_hash, v.borrow_is_mut);
            v.borrow_target_hash = 0;
            v.borrow_is_mut = 0;
        }
    }
    i = sc.var_count;
    while i > 0 {
        i = i - 1;
        let v2: *mut SafetyVar = safety_var_at(sc, i);
        if v2.scope_depth == sc.scope_depth {
            v2.name_hash = 0;
        }
    }
    while sc.var_count > 0 {
        let top: *mut SafetyVar = safety_var_at(sc, sc.var_count - 1);
        if top.name_hash == 0 {
            sc.var_count = sc.var_count - 1;
        } else {
            break;
        }
    }
    if sc.scope_depth > 0 {
        sc.scope_depth = sc.scope_depth - 1;
    }
}

fn safety_check_read(sc: *mut SafetyContext, name_hash: u64) {
    let v: *mut SafetyVar = safety_find_var(sc, name_hash);
    if v == (0 as *mut SafetyVar) { return; }

    if v.is_moved == 1 {
        println("[COMPILE ERROR: SAFETY] Use of moved value: variable was moved in previous operation!");
        sc.error_count = sc.error_count + 1;
        return;
    }

    if v.is_mut_borrowed == 1 {
        println("[COMPILE ERROR: SAFETY] Cannot read value while mutably borrowed!");
        sc.error_count = sc.error_count + 1;
    }
}

fn safety_check_move(sc: *mut SafetyContext, name_hash: u64) {
    let v: *mut SafetyVar = safety_find_var(sc, name_hash);
    if v == (0 as *mut SafetyVar) { return; }

    if v.is_copy == 1 { return; }

    if v.is_moved == 1 {
        println("[COMPILE ERROR: SAFETY] Use of moved value: cannot move an already moved value!");
        sc.error_count = sc.error_count + 1;
        return;
    }

    if v.borrow_count > 0 || v.is_mut_borrowed == 1 {
        println("[COMPILE ERROR: SAFETY] Cannot move out of value because it is currently borrowed!");
        sc.error_count = sc.error_count + 1;
        return;
    }

    v.is_moved = 1;
}

fn safety_check_borrow(sc: *mut SafetyContext, name_hash: u64, is_mut: u32) -> u32 {
    let v: *mut SafetyVar = safety_find_var(sc, name_hash);
    if v == (0 as *mut SafetyVar) { return 0; }

    if v.is_moved == 1 {
        println("[COMPILE ERROR: SAFETY] Cannot borrow value: variable was already moved!");
        sc.error_count = sc.error_count + 1;
        return 0;
    }

    if is_mut == 1 {
        if v.is_mut_borrowed == 1 {
            println("[COMPILE ERROR: SAFETY] Cannot borrow as mutable more than once at a time!");
            sc.error_count = sc.error_count + 1;
            return 0;
        }
        if v.borrow_count > 0 {
            println("[COMPILE ERROR: SAFETY] Cannot borrow as mutable while immutably borrowed!");
            sc.error_count = sc.error_count + 1;
            return 0;
        }
        v.is_mut_borrowed = 1;
    } else {
        if v.is_mut_borrowed == 1 {
            println("[COMPILE ERROR: SAFETY] Cannot borrow as immutable while mutably borrowed!");
            sc.error_count = sc.error_count + 1;
            return 0;
        }
        v.borrow_count = v.borrow_count + 1;
    }

    if sc.call_depth > 0 {
        safety_push_temp_borrow(sc, name_hash, is_mut);
    }
    return 1;
}

fn safety_check_raw_deref(sc: *mut SafetyContext) {
    if sc.strict_safety == 1 && sc.unsafe_depth == 0 {
        println("[COMPILE ERROR: SAFETY] Dereference of raw pointer requires unsafe function or block!");
        sc.error_count = sc.error_count + 1;
    }
}

fn safety_root_lvalue_hash(node: *mut AstNode) -> u64 {
    var cur: *mut AstNode = node;
    while cur != (0 as *mut AstNode) {
        if cur.kind == 117 { return cur.hash; }
        if cur.kind == 114 || cur.kind == 115 {
            cur = cur.child1;
        } else {
            return 0;
        }
    }
    return 0;
}

fn safety_extract_borrow(node: *mut AstNode, out_target: *mut u64, out_mut: *mut u32) -> u32 {
    var cur: *mut AstNode = node;
    while cur != (0 as *mut AstNode) && cur.kind == 131 {
        cur = cur.child1;
    }
    if cur != (0 as *mut AstNode) && cur.kind == 112 && cur.val == 50 {
        let th: u64 = safety_root_lvalue_hash(cur.child1);
        if th != 0 {
            *out_target = th;
            *out_mut = cur.is_mut as u32;
            return 1;
        }
    }
    *out_target = 0;
    *out_mut = 0;
    return 0;
}

fn safety_walk_borrow_lvalue_indices(sc: *mut SafetyContext, node: *mut AstNode) {
    var cur: *mut AstNode = node;
    while cur != (0 as *mut AstNode) {
        if cur.kind == 117 { return; }
        if cur.kind == 115 {
            if cur.child1 != (0 as *mut AstNode) && cur.child1.kind == 117 {
                let v_b: *mut SafetyVar = safety_find_var(sc, cur.child1.hash);
                if v_b != (0 as *mut SafetyVar) && v_b.is_ptr == 1 {
                    safety_check_raw_deref(sc);
                }
            }
            safety_walk_expr(sc, cur.child2);
            cur = cur.child1;
        } else if cur.kind == 114 {
            cur = cur.child1;
        } else {
            safety_walk_expr(sc, cur);
            return;
        }
    }
}

fn safety_walk_expr(sc: *mut SafetyContext, expr: *mut AstNode) {
    if expr == (0 as *mut AstNode) { return; }

    if expr.kind == 117 {
        safety_check_read(sc, expr.hash);
    } else if expr.kind == 113 {
        let fn_h: u64 = expr.hash;
        if fn_h == 4839389974674415512 || fn_h == 591460338526206001 || fn_h == 12031162154312822496 {
            var carg: *mut AstNode = expr.child2;
            while carg != (0 as *mut AstNode) {
                if carg.kind == 117 {
                    let sv: *mut SafetyVar = safety_find_var(sc, carg.hash);
                    if sv != (0 as *mut SafetyVar) {
                        if traits_is_primitive_scalar(sv.type_hash) == 0 && sv.type_hash != 0 {
                            println("[COMPILE ERROR: DATA RACE PREVENTION] Cannot transfer non-Send type across thread boundary!");
                            sc.error_count = sc.error_count + 1;
                        }
                    }
                }
                carg = carg.next;
            }
        }
        let saved_temp: u32 = sc.temp_count;
        sc.call_depth = sc.call_depth + 1;
        safety_walk_expr(sc, expr.child1);
        safety_walk_expr(sc, expr.child2);
        sc.call_depth = sc.call_depth - 1;
        safety_unwind_temp_borrows(sc, saved_temp);
        safety_walk_expr(sc, expr.child3);
        safety_walk_expr(sc, expr.next);
        return;
    } else if expr.kind == 112 {
        if expr.val == 50 {
            let target_h: u64 = safety_root_lvalue_hash(expr.child1);
            if target_h != 0 {
                safety_check_borrow(sc, target_h, expr.is_mut as u32);
                safety_walk_borrow_lvalue_indices(sc, expr.child1);
                safety_walk_expr(sc, expr.child2);
                safety_walk_expr(sc, expr.child3);
                safety_walk_expr(sc, expr.next);
                return;
            }
        } else if expr.val == 32 {
            safety_check_raw_deref(sc);
        }
    } else if expr.kind == 114 {
        if expr.child1 != (0 as *mut AstNode) && expr.child1.kind == 117 {
            safety_check_read(sc, expr.child1.hash);
            safety_walk_expr(sc, expr.child2);
            safety_walk_expr(sc, expr.child3);
            safety_walk_expr(sc, expr.next);
            return;
        }
    } else if expr.kind == 115 {
        if expr.child1 != (0 as *mut AstNode) && expr.child1.kind == 117 {
            let v_idx: *mut SafetyVar = safety_find_var(sc, expr.child1.hash);
            if v_idx != (0 as *mut SafetyVar) {
                if v_idx.is_ptr == 1 {
                    safety_check_raw_deref(sc);
                }
            }
            safety_check_read(sc, expr.child1.hash);
            safety_walk_expr(sc, expr.child2);
            safety_walk_expr(sc, expr.child3);
            safety_walk_expr(sc, expr.next);
            return;
        }
    }

    safety_walk_expr(sc, expr.child1);
    safety_walk_expr(sc, expr.child2);
    safety_walk_expr(sc, expr.child3);
    safety_walk_expr(sc, expr.next);
}

fn safety_walk_stmt(sc: *mut SafetyContext, stmt: *mut AstNode) {
    if stmt == (0 as *mut AstNode) { return; }

    if stmt.kind == 105 {
        let var_h: u64 = stmt.hash;
        var is_cp: u32 = 1;
        var vtype: u64 = stmt.val;
        var is_ptr_var: u32 = 0;
        if stmt.id == 1 || stmt.id == 2 || stmt.id == 13 || stmt.id == 14 {
            is_ptr_var = 1;
        }
        if stmt.id == 3 {
            is_cp = 0;
            let copy_h: u64 = 3929114272712712900;
            if traits_type_implements(sc.parser, stmt.val, copy_h) == 1 {
                is_cp = 1;
            }
        }

        var b_target: u64 = 0;
        var b_mut: u32 = 0;
        if stmt.child1 != (0 as *mut AstNode) {
            if stmt.child1.kind == 117 {
                let src_v: *mut SafetyVar = safety_find_var(sc, stmt.child1.hash);
                if src_v != (0 as *mut SafetyVar) {
                    if src_v.is_copy == 0 {
                        is_cp = 0;
                        vtype = src_v.type_hash;
                    }
                    if src_v.is_ptr == 1 {
                        is_ptr_var = 1;
                    }
                }
                safety_check_move(sc, stmt.child1.hash);
            } else {
                var un_rhs: *mut AstNode = stmt.child1;
                while un_rhs != (0 as *mut AstNode) && un_rhs.kind == 131 {
                    un_rhs = un_rhs.child1;
                }
                if un_rhs != (0 as *mut AstNode) && un_rhs.kind == 112 && un_rhs.val == 50 {
                    is_ptr_var = 1;
                }
                safety_walk_expr(sc, stmt.child1);
                safety_extract_borrow(stmt.child1, &mut b_target, &mut b_mut);
            }
        }
        safety_register_var_ex(sc, var_h, vtype, is_cp, is_ptr_var, 0, b_target, b_mut);
    } else if stmt.kind == 106 {
        let lhs: *mut AstNode = stmt.child1;
        let rhs: *mut AstNode = stmt.child2;
        if rhs != (0 as *mut AstNode) && rhs.kind == 117 {
            safety_check_move(sc, rhs.hash);
        } else {
            safety_walk_expr(sc, rhs);
        }
        if lhs != (0 as *mut AstNode) && lhs.kind == 117 {
            let lv: *mut SafetyVar = safety_find_var(sc, lhs.hash);
            if lv != (0 as *mut SafetyVar) {
                if lv.is_mut_borrowed == 1 || lv.borrow_count > 0 {
                    println("[COMPILE ERROR: SAFETY] Cannot assign to variable while borrowed!");
                    sc.error_count = sc.error_count + 1;
                }
                lv.is_moved = 0;
                if lv.borrow_target_hash != 0 {
                    safety_release_borrow(sc, lv.borrow_target_hash, lv.borrow_is_mut);
                    lv.borrow_target_hash = 0;
                    lv.borrow_is_mut = 0;
                }
                var rhs_bt: u64 = 0;
                var rhs_bm: u32 = 0;
                if safety_extract_borrow(rhs, &mut rhs_bt, &mut rhs_bm) == 1 {
                    lv.borrow_target_hash = rhs_bt;
                    lv.borrow_is_mut = rhs_bm;
                }
            }
        } else if lhs != (0 as *mut AstNode) {
            safety_walk_expr(sc, lhs);
        }
    } else if stmt.kind == 132 {
        sc.unsafe_depth = sc.unsafe_depth + 1;
        safety_enter_scope(sc);
        var us: *mut AstNode = stmt.child1;
        while us != (0 as *mut AstNode) {
            safety_walk_stmt(sc, us);
            us = us.next;
        }
        safety_exit_scope(sc);
        if sc.unsafe_depth > 0 {
            sc.unsafe_depth = sc.unsafe_depth - 1;
        }
    } else if stmt.kind == 128 {
        safety_enter_scope(sc);
        var ds: *mut AstNode = stmt.child1;
        while ds != (0 as *mut AstNode) {
            safety_walk_stmt(sc, ds);
            ds = ds.next;
        }
        safety_exit_scope(sc);
    } else if stmt.kind == 107 {
        safety_walk_expr(sc, stmt.child1);
        safety_enter_scope(sc);
        var bs: *mut AstNode = stmt.child2;
        while bs != (0 as *mut AstNode) {
            safety_walk_stmt(sc, bs);
            bs = bs.next;
        }
        safety_exit_scope(sc);

        if stmt.child3 != (0 as *mut AstNode) {
            safety_enter_scope(sc);
            var ebs: *mut AstNode = stmt.child3;
            while ebs != (0 as *mut AstNode) {
                safety_walk_stmt(sc, ebs);
                ebs = ebs.next;
            }
            safety_exit_scope(sc);
        }
    } else if stmt.kind == 108 {
        safety_walk_expr(sc, stmt.child1);
        safety_enter_scope(sc);
        var wbs: *mut AstNode = stmt.child2;
        while wbs != (0 as *mut AstNode) {
            safety_walk_stmt(sc, wbs);
            wbs = wbs.next;
        }
        safety_exit_scope(sc);
    } else if stmt.kind == 125 {
        safety_walk_expr(sc, stmt.child1);
        safety_walk_expr(sc, stmt.child2);
        safety_enter_scope(sc);
        safety_register_var_ex(sc, stmt.hash, 20, 1, 0, 0, 0, 0);
        var fs: *mut AstNode = stmt.child3;
        while fs != (0 as *mut AstNode) {
            safety_walk_stmt(sc, fs);
            fs = fs.next;
        }
        safety_exit_scope(sc);
    } else if stmt.kind == 129 {
        safety_walk_expr(sc, stmt.child1);
        var marm: *mut AstNode = stmt.child2;
        while marm != (0 as *mut AstNode) {
            safety_enter_scope(sc);
            safety_walk_expr(sc, marm.child1);
            var mbs: *mut AstNode = marm.child2;
            while mbs != (0 as *mut AstNode) {
                safety_walk_stmt(sc, mbs);
                mbs = mbs.next;
            }
            safety_exit_scope(sc);
            marm = marm.next;
        }
    } else if stmt.kind == 109 {
        if stmt.child1 != (0 as *mut AstNode) {
            if stmt.child1.kind == 117 {
                safety_check_move(sc, stmt.child1.hash);
            } else {
                safety_walk_expr(sc, stmt.child1);
            }
        }
    } else {
        safety_walk_expr(sc, stmt.child1);
        safety_walk_expr(sc, stmt.child2);
    }
}

fn safety_verify_fn(p: *mut Parser, fnode: *mut AstNode, strict_mode: u32) -> u32 {
    if fnode == (0 as *mut AstNode) { return 0; }
    var sc: SafetyContext;
    safety_init(&mut sc, p, strict_mode);

    var p_cur: *mut AstNode = fnode.child2;
    while p_cur != (0 as *mut AstNode) {
        var p_copy: u32 = 1;
        var p_ptr: u32 = 0;
        if p_cur.is_mut > 0 && p_cur.is_mut != 99 {
            p_ptr = 1;
        } else if p_cur.is_mut == 0 && p_cur.val != 0 && p_cur.val != 20 && p_cur.val != 23 {
            p_copy = 0;
            let copy_h: u64 = 3929114272712712900;
            if traits_is_primitive_scalar(p_cur.val) == 1 || traits_type_implements(p, p_cur.val, copy_h) == 1 {
                p_copy = 1;
            }
        }
        safety_register_var_ex(&mut sc, p_cur.hash, p_cur.val, p_copy, p_ptr, 0, 0, 0);
        p_cur = p_cur.next;
    }

    var st: *mut AstNode = fnode.child1;
    while st != (0 as *mut AstNode) {
        safety_walk_stmt(&mut sc, st);
        st = st.next;
    }

    safety_exit_scope(&mut sc);
    let err_cnt: u32 = sc.error_count;
    safety_free(&mut sc);
    return err_cnt;
}
