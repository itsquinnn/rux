struct SafetyVar {
    name_hash: u64,
    type_hash: u64,
    scope_depth: u32,
    is_moved: u32,
    borrow_count: u32,
    is_mut_borrowed: u32,
    is_copy: u32,
    drop_fn_hash: u64,
}

struct SafetyContext {
    vars: [SafetyVar; 128],
    var_count: u32,
    scope_depth: u32,
    unsafe_depth: u32,
    strict_safety: u32,
    error_count: u32,
    parser: *mut Parser,
}

fn safety_init(sc: *mut SafetyContext, p: *mut Parser, strict: u32) {
    sc.var_count = 0;
    sc.scope_depth = 0;
    sc.unsafe_depth = 0;
    sc.strict_safety = strict;
    sc.error_count = 0;
    sc.parser = p;
}

fn safety_find_var(sc: *mut SafetyContext, name_hash: u64) -> *mut SafetyVar {
    var i: u32 = sc.var_count;
    while i > 0 {
        i = i - 1;
        let v: *mut SafetyVar = (&mut sc.vars[i as u64]) as *mut SafetyVar;
        if v.name_hash == name_hash {
            return v;
        }
    }
    return 0 as *mut SafetyVar;
}

fn safety_register_var(sc: *mut SafetyContext, name_hash: u64, type_hash: u64, is_copy: u32, drop_fn: u64) {
    if sc.var_count >= 128 { return; }
    let v: *mut SafetyVar = (&mut sc.vars[sc.var_count as u64]) as *mut SafetyVar;
    v.name_hash = name_hash;
    v.type_hash = type_hash;
    v.scope_depth = sc.scope_depth;
    v.is_moved = 0;
    v.borrow_count = 0;
    v.is_mut_borrowed = 0;
    v.is_copy = is_copy;
    v.drop_fn_hash = drop_fn;
    sc.var_count = sc.var_count + 1;
}

fn safety_enter_scope(sc: *mut SafetyContext) {
    sc.scope_depth = sc.scope_depth + 1;
}

fn safety_exit_scope(sc: *mut SafetyContext) {
    var i: u32 = sc.var_count;
    while i > 0 {
        i = i - 1;
        let v: *mut SafetyVar = (&mut sc.vars[i as u64]) as *mut SafetyVar;
        if v.scope_depth == sc.scope_depth {
            v.name_hash = 0;
        }
    }
    if sc.scope_depth > 0 {
        sc.scope_depth = sc.scope_depth - 1;
    }
}

fn safety_check_read(sc: *mut SafetyContext, name_hash: u64) {
    let v: *mut SafetyVar = safety_find_var(sc, name_hash);
    if v == (0 as *mut SafetyVar) { return; }

    if v.is_moved == 1 {
        println("[COMPILE ERROR: SAFETY] Use of moved value: variable was moved in previous operation!");
        sc.error_count = sc.error_count + 1;
        return;
    }

    if v.is_mut_borrowed == 1 {
        println("[COMPILE ERROR: SAFETY] Cannot read value while mutably borrowed!");
        sc.error_count = sc.error_count + 1;
    }
}

fn safety_check_move(sc: *mut SafetyContext, name_hash: u64) {
    let v: *mut SafetyVar = safety_find_var(sc, name_hash);
    if v == (0 as *mut SafetyVar) { return; }

    if v.is_copy == 1 { return; }

    if v.is_moved == 1 {
        println("[COMPILE ERROR: SAFETY] Use of moved value: cannot move an already moved value!");
        sc.error_count = sc.error_count + 1;
        return;
    }

    if v.borrow_count > 0 || v.is_mut_borrowed == 1 {
        println("[COMPILE ERROR: SAFETY] Cannot move out of value because it is currently borrowed!");
        sc.error_count = sc.error_count + 1;
        return;
    }

    v.is_moved = 1;
}

fn safety_check_borrow(sc: *mut SafetyContext, name_hash: u64, is_mut: u32) {
    let v: *mut SafetyVar = safety_find_var(sc, name_hash);
    if v == (0 as *mut SafetyVar) { return; }

    if v.is_moved == 1 {
        println("[COMPILE ERROR: SAFETY] Cannot borrow value: variable was already moved!");
        sc.error_count = sc.error_count + 1;
        return;
    }

    if is_mut == 1 {
        if v.is_mut_borrowed == 1 {
            println("[COMPILE ERROR: SAFETY] Cannot borrow as mutable more than once at a time!");
            sc.error_count = sc.error_count + 1;
            return;
        }
        if v.borrow_count > 0 {
            println("[COMPILE ERROR: SAFETY] Cannot borrow as mutable while immutably borrowed!");
            sc.error_count = sc.error_count + 1;
            return;
        }
        v.is_mut_borrowed = 1;
    } else {
        if v.is_mut_borrowed == 1 {
            println("[COMPILE ERROR: SAFETY] Cannot borrow as immutable while mutably borrowed!");
            sc.error_count = sc.error_count + 1;
            return;
        }
        v.borrow_count = v.borrow_count + 1;
    }
}

fn safety_check_raw_deref(sc: *mut SafetyContext) {
    if sc.strict_safety == 1 && sc.unsafe_depth == 0 {
        println("[COMPILE ERROR: SAFETY] Dereference of raw pointer requires unsafe function or block!");
        sc.error_count = sc.error_count + 1;
    }
}

fn safety_walk_expr(sc: *mut SafetyContext, expr: *mut AstNode) {
    if expr == (0 as *mut AstNode) { return; }

    if expr.kind == 117 {
        safety_check_read(sc, expr.hash);
    } else if expr.kind == 113 {
        let fn_h: u64 = expr.hash;
        if fn_h == 4839389974674415512 || fn_h == 591460338526206001 || fn_h == 12031162154312822496 {
            var carg: *mut AstNode = expr.child2;
            while carg != (0 as *mut AstNode) {
                if carg.kind == 117 {
                    let sv: *mut SafetyVar = safety_find_var(sc, carg.hash);
                    if sv != (0 as *mut SafetyVar) {
                        if traits_is_primitive_scalar(sv.type_hash) == 0 && sv.type_hash != 0 {
                            println("[COMPILE ERROR: DATA RACE PREVENTION] Cannot transfer non-Send type across thread boundary!");
                            sc.error_count = sc.error_count + 1;
                        }
                    }
                }
                carg = carg.next;
            }
        }
    } else if expr.kind == 111 {
        if expr.val == 50 {
            if expr.child1 != (0 as *mut AstNode) && expr.child1.kind == 117 {
                safety_check_borrow(sc, expr.child1.hash, expr.is_mut as u32);
            }
        } else if expr.val == 32 {
            safety_check_raw_deref(sc);
        }
    } else if expr.kind == 114 {
        if expr.child1 != (0 as *mut AstNode) && expr.child1.kind == 117 {
            safety_check_read(sc, expr.child1.hash);
        }
    } else if expr.kind == 115 {
        if expr.child1 != (0 as *mut AstNode) && expr.child1.kind == 117 {
            let v_idx: *mut SafetyVar = safety_find_var(sc, expr.child1.hash);
            if v_idx != (0 as *mut SafetyVar) {
                if v_idx.is_copy == 1 && v_idx.type_hash != 0 {
                    safety_check_raw_deref(sc);
                }
            }
            safety_check_read(sc, expr.child1.hash);
        }
    }

    safety_walk_expr(sc, expr.child1);
    safety_walk_expr(sc, expr.child2);
    safety_walk_expr(sc, expr.child3);
    safety_walk_expr(sc, expr.next);
}

fn safety_walk_stmt(sc: *mut SafetyContext, stmt: *mut AstNode) {
    if stmt == (0 as *mut AstNode) { return; }

    if stmt.kind == 105 {
        let var_h: u64 = stmt.hash;
        var is_cp: u32 = 1;
        if stmt.id == 3 {
            is_cp = 0;
            let copy_h: u64 = 3929114272712712900;
            if traits_type_implements(sc.parser, stmt.val, copy_h) == 1 {
                is_cp = 1;
            }
        }

        if stmt.child1 != (0 as *mut AstNode) {
            if stmt.child1.kind == 117 {
                safety_check_move(sc, stmt.child1.hash);
            } else {
                safety_walk_expr(sc, stmt.child1);
            }
        }
        safety_register_var(sc, var_h, stmt.val, is_cp, 0);
    } else if stmt.kind == 106 {
        let lhs: *mut AstNode = stmt.child1;
        let rhs: *mut AstNode = stmt.child2;
        if lhs != (0 as *mut AstNode) && lhs.kind == 117 {
            let lv: *mut SafetyVar = safety_find_var(sc, lhs.hash);
            if lv != (0 as *mut SafetyVar) {
                lv.is_moved = 0;
            }
        }
        if rhs != (0 as *mut AstNode) && rhs.kind == 117 {
            safety_check_move(sc, rhs.hash);
        } else {
            safety_walk_expr(sc, rhs);
        }
    } else if stmt.kind == 132 {
        sc.unsafe_depth = sc.unsafe_depth + 1;
        var us: *mut AstNode = stmt.child1;
        while us != (0 as *mut AstNode) {
            safety_walk_stmt(sc, us);
            us = us.next;
        }
        if sc.unsafe_depth > 0 {
            sc.unsafe_depth = sc.unsafe_depth - 1;
        }
    } else if stmt.kind == 107 {
        safety_walk_expr(sc, stmt.child1);
        safety_enter_scope(sc);
        var bs: *mut AstNode = stmt.child2;
        while bs != (0 as *mut AstNode) {
            safety_walk_stmt(sc, bs);
            bs = bs.next;
        }
        safety_exit_scope(sc);

        if stmt.child3 != (0 as *mut AstNode) {
            safety_enter_scope(sc);
            var ebs: *mut AstNode = stmt.child3;
            while ebs != (0 as *mut AstNode) {
                safety_walk_stmt(sc, ebs);
                ebs = ebs.next;
            }
            safety_exit_scope(sc);
        }
    } else if stmt.kind == 108 {
        safety_walk_expr(sc, stmt.child1);
        safety_enter_scope(sc);
        var wbs: *mut AstNode = stmt.child2;
        while wbs != (0 as *mut AstNode) {
            safety_walk_stmt(sc, wbs);
            wbs = wbs.next;
        }
        safety_exit_scope(sc);
    } else if stmt.kind == 129 {
        safety_walk_expr(sc, stmt.child1);
        var marm: *mut AstNode = stmt.child2;
        while marm != (0 as *mut AstNode) {
            safety_enter_scope(sc);
            safety_walk_expr(sc, marm.child1);
            var mbs: *mut AstNode = marm.child2;
            while mbs != (0 as *mut AstNode) {
                safety_walk_stmt(sc, mbs);
                mbs = mbs.next;
            }
            safety_exit_scope(sc);
            marm = marm.next;
        }
    } else if stmt.kind == 109 {
        if stmt.child1 != (0 as *mut AstNode) {
            if stmt.child1.kind == 117 {
                safety_check_move(sc, stmt.child1.hash);
            } else {
                safety_walk_expr(sc, stmt.child1);
            }
        }
    } else {
        safety_walk_expr(sc, stmt.child1);
        safety_walk_expr(sc, stmt.child2);
    }
}

fn safety_verify_fn(p: *mut Parser, fnode: *mut AstNode, strict_mode: u32) -> u32 {
    if fnode == (0 as *mut AstNode) { return 0; }
    var sc: SafetyContext;
    safety_init(&mut sc, p, strict_mode);

    var p_cur: *mut AstNode = fnode.child2;
    while p_cur != (0 as *mut AstNode) {
        var p_copy: u32 = 1;
        if p_cur.is_mut == 0 && p_cur.val != 0 {
            p_copy = 0;
            let copy_h: u64 = 3929114272712712900;
            if traits_type_implements(p, p_cur.val, copy_h) == 1 {
                p_copy = 1;
            }
        }
        safety_register_var(&mut sc, p_cur.hash, p_cur.val, p_copy, 0);
        p_cur = p_cur.next;
    }

    var st: *mut AstNode = fnode.child1;
    while st != (0 as *mut AstNode) {
        safety_walk_stmt(&mut sc, st);
        st = st.next;
    }

    return sc.error_count;
}
