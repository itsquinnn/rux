fn hex_char_val(c: u8) -> i32 {
    if c >= 48 && c <= 57 { return (c - 48) as i32; }
    if c >= 97 && c <= 102 { return ((c - 97) + 10) as i32; }
    if c >= 65 && c <= 70 { return ((c - 65) + 10) as i32; }
    return -1;
}

fn append_asm_byte(p: *mut Parser, head: *mut *mut AstNode, tail: *mut *mut AstNode, b: u8) {
    let bn: *mut AstNode = alloc_node(p, 116);
    bn.val = (b as u64) & 255;
    if head[0] == (0 as *mut AstNode) {
        head[0] = bn;
    } else {
        tail[0].next = bn;
    }
    tail[0] = bn;
}

fn parse_inline_asm(p: *mut Parser) -> *mut AstNode {
    var close_k: u32 = 61;
    if p.cur_tok.kind == 62 {
        parser_expect(p, 62);
        close_k = 63;
    } else {
        parser_expect(p, 60);
    }
    let n: *mut AstNode = alloc_node(p, 135);
    var head: [(*mut AstNode); 1];
    var tail: [(*mut AstNode); 1];
    head[0] = 0 as *mut AstNode;
    tail[0] = 0 as *mut AstNode;

    while p.cur_tok.kind != (close_k as u64) && p.cur_tok.kind != 0 {
        if p.cur_tok.kind == 3 {
            let s_ptr: *u8 = p.cur_tok.start + 1;
            var s_len: u32 = 0;
            if p.cur_tok.len >= 2 { s_len = (p.cur_tok.len as u32) - 2; }
            let sh: u64 = hash_identifier(s_ptr, s_len);
            if sh == 2403464356601698430 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 144);
            } else if sh == 5315332399326980173 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 243);
                append_asm_byte(p, &mut head[0], &mut tail[0], 144);
            } else if sh == 10666874983195838204 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 15);
                append_asm_byte(p, &mut head[0], &mut tail[0], 174);
                append_asm_byte(p, &mut head[0], &mut tail[0], 232);
            } else if sh == 13880249909581317937 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 15);
                append_asm_byte(p, &mut head[0], &mut tail[0], 174);
                append_asm_byte(p, &mut head[0], &mut tail[0], 240);
            } else if sh == 7575545383668502787 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 15);
                append_asm_byte(p, &mut head[0], &mut tail[0], 174);
                append_asm_byte(p, &mut head[0], &mut tail[0], 248);
            } else if sh == 5515754065222239626 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 15);
                append_asm_byte(p, &mut head[0], &mut tail[0], 11);
            } else if sh == 17728435433899281225 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 250);
            } else if sh == 9398588119769241713 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 251);
            } else if sh == 3704516465924115855 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 244);
            } else if sh == 9937665476793771756 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 195);
            } else if sh == 6010901373725121622 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 72);
                append_asm_byte(p, &mut head[0], &mut tail[0], 207);
            } else if sh == 8081564428864088264 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 15);
                append_asm_byte(p, &mut head[0], &mut tail[0], 1);
                append_asm_byte(p, &mut head[0], &mut tail[0], 248);
            } else if sh == 8519013864044491299 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 15);
                append_asm_byte(p, &mut head[0], &mut tail[0], 49);
            } else if sh == 13411088209811050828 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 15);
                append_asm_byte(p, &mut head[0], &mut tail[0], 162);
            } else if sh == 6167441120493826625 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 15);
                append_asm_byte(p, &mut head[0], &mut tail[0], 9);
            } else if sh == 6740575782527371194 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 15);
                append_asm_byte(p, &mut head[0], &mut tail[0], 5);
            } else if sh == 9588733596348390644 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 72);
                append_asm_byte(p, &mut head[0], &mut tail[0], 15);
                append_asm_byte(p, &mut head[0], &mut tail[0], 7);
            } else if sh == 6815905674521341467 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 127);
                append_asm_byte(p, &mut head[0], &mut tail[0], 32);
                append_asm_byte(p, &mut head[0], &mut tail[0], 3);
                append_asm_byte(p, &mut head[0], &mut tail[0], 213);
            } else if sh == 3155900845526747637 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 223);
                append_asm_byte(p, &mut head[0], &mut tail[0], 63);
                append_asm_byte(p, &mut head[0], &mut tail[0], 3);
                append_asm_byte(p, &mut head[0], &mut tail[0], 213);
            } else if sh == 3460795070590032287 {
                append_asm_byte(p, &mut head[0], &mut tail[0], 115);
                append_asm_byte(p, &mut head[0], &mut tail[0], 0);
                append_asm_byte(p, &mut head[0], &mut tail[0], 16);
                append_asm_byte(p, &mut head[0], &mut tail[0], 0);
            } else {
                var i: u32 = 0;
                while (i + 1) < s_len {
                    let h1: i32 = hex_char_val(s_ptr[i as u64]);
                    let h2: i32 = hex_char_val(s_ptr[(i + 1) as u64]);
                    if h1 >= 0 && h2 >= 0 {
                        let bval: u8 = ((h1 * 16) + h2) as u8;
                        append_asm_byte(p, &mut head[0], &mut tail[0], bval);
                        i = i + 2;
                    } else {
                        i = i + 1;
                    }
                }
            }
            lex_next_token(p.lex, &mut p.cur_tok);
        } else {
            let bexpr: *mut AstNode = parse_expr(p);
            let bval2: u64 = eval_const_ast(p, bexpr);
            append_asm_byte(p, &mut head[0], &mut tail[0], (bval2 & 255) as u8);
        }
        if p.cur_tok.kind == 72 { parser_expect(p, 72); }
    }
    parser_expect(p, close_k);
    n.child1 = head[0];
    return n;
}

