struct GenericField {
    name_hash: u64,
    type_kind: u64,
    concrete_hash: u64,
    is_ptr: u64,
    arr_len: u64,
}

struct GenericStruct {
    name_hash: u64,
    param_count: u64,
    param0_hash: u64,
    param1_hash: u64,
    param2_hash: u64,
    param3_hash: u64,
    field_count: u64,
    fields: [GenericField; 16],
}

struct GenericFn {
    name_hash: u64,
    param_count: u64,
    param0_hash: u64,
    param1_hash: u64,
    calling_conv: u64,
    ast_root: *mut AstNode,
    bound0_hash: u64,
    bound1_hash: u64,
}

fn register_generic_struct(p: *mut Parser, gs: *mut GenericStruct) {
    if p.generic_structs == (0 as *mut u8) { return; }
    if p.generic_struct_count >= 64 { return; }
    let dst: *mut u8 = p.generic_structs + (p.generic_struct_count * 704);
    let src: *mut u8 = gs as *mut u8;
    var i: u64 = 0;
    while i < 704 {
        dst[i] = src[i];
        i = i + 1;
    }
    p.generic_struct_count = p.generic_struct_count + 1;
}

fn find_generic_struct(p: *mut Parser, name_hash: u64) -> *mut GenericStruct {
    if p.generic_structs == (0 as *mut u8) { return 0 as *mut GenericStruct; }
    var i: u64 = 0;
    while i < p.generic_struct_count {
        let gs: *mut GenericStruct = (p.generic_structs + (i * 704)) as *mut GenericStruct;
        if gs.name_hash == name_hash {
            return gs;
        }
        i = i + 1;
    }
    return 0 as *mut GenericStruct;
}

fn is_generic_struct(p: *mut Parser, name_hash: u64) -> u32 {
    if find_generic_struct(p, name_hash) != (0 as *mut GenericStruct) {
        return 1;
    }
    return 0;
}

fn register_generic_fn(p: *mut Parser, gf: *mut GenericFn) {
    if p.generic_fns == (0 as *mut u8) { return; }
    if p.generic_fn_count >= 64 { return; }
    let dst: *mut u8 = p.generic_fns + (p.generic_fn_count * 64);
    let src: *mut u8 = gf as *mut u8;
    var i: u64 = 0;
    while i < 64 {
        dst[i] = src[i];
        i = i + 1;
    }
    p.generic_fn_count = p.generic_fn_count + 1;
}

fn find_generic_fn(p: *mut Parser, name_hash: u64) -> *mut GenericFn {
    if p.generic_fns == (0 as *mut u8) { return 0 as *mut GenericFn; }
    var i: u64 = 0;
    while i < p.generic_fn_count {
        let gf: *mut GenericFn = (p.generic_fns + (i * 64)) as *mut GenericFn;
        if gf.name_hash == name_hash {
            return gf;
        }
        i = i + 1;
    }
    return 0 as *mut GenericFn;
}

fn is_generic_fn(p: *mut Parser, name_hash: u64) -> u32 {
    if find_generic_fn(p, name_hash) != (0 as *mut GenericFn) {
        return 1;
    }
    return 0;
}

fn parse_type_arg_hash(p: *mut Parser) -> u64 {
    var ptr_depth: u64 = 0;
    while p.cur_tok.kind == 32 || p.cur_tok.kind == 50 || p.cur_tok.kind == 13 || p.cur_tok.kind == 12 {
        if p.cur_tok.kind == 32 || p.cur_tok.kind == 50 { ptr_depth = ptr_depth + 1; }
        lex_next_token(p.lex, &mut p.cur_tok);
    }
    var base_h: u64 = p.cur_tok.hash;
    if base_h == 0 { base_h = p.cur_tok.kind as u64; }
    lex_next_token(p.lex, &mut p.cur_tok);

    if p.cur_tok.kind == 43 {
        parser_expect(p, 43);
        let n_arg0: u64 = parse_type_arg_hash(p);
        var n_arg1: u64 = 0;
        if p.cur_tok.kind == 72 {
            parser_expect(p, 72);
            n_arg1 = parse_type_arg_hash(p);
        }
        parser_expect(p, 44);
        if p.cg != (0 as *mut u8) {
            base_h = instantiate_generic_struct(p, p.cg as *mut CodeGen, base_h, n_arg0, n_arg1);
        }
    }

    if ptr_depth > 0 {
        return combine_ns_hash(base_h, 424242 + ptr_depth);
    }
    return base_h;
}

fn instantiate_generic_struct(p: *mut Parser, cg: *mut CodeGen, template_hash: u64, arg0: u64, arg1: u64) -> u64 {
    var mangled_hash: u64 = combine_ns_hash(template_hash, arg0);
    if arg1 != 0 {
        mangled_hash = combine_ns_hash(mangled_hash, arg1);
    }

    if p.instantiations != (0 as *mut ConstEntry) {
        var i: u64 = 0;
        while i < p.instantiation_count {
            let ce: *mut ConstEntry = ((p.instantiations as *mut u8) + (i * 24)) as *mut ConstEntry;
            if ce.name_hash == mangled_hash {
                return mangled_hash;
            }
            i = i + 1;
        }
        if p.instantiation_count < 1024 {
            let nce: *mut ConstEntry = ((p.instantiations as *mut u8) + (p.instantiation_count * 24)) as *mut ConstEntry;
            nce.name_hash = mangled_hash;
            nce.val = 1;
            nce.extra = 0;
            p.instantiation_count = p.instantiation_count + 1;
        }
    }

    let gs: *mut GenericStruct = find_generic_struct(p, template_hash);
    if gs == (0 as *mut GenericStruct) || cg == (0 as *mut CodeGen) {
        return template_hash;
    }

    let sinfo: *mut StructInfo = ((cg.structs as *mut u8) + ((cg.struct_count as u64) * 32)) as *mut StructInfo;
    sinfo.name_hash = mangled_hash;
    sinfo.type_sig_hash = mangled_hash;
    sinfo.field_count = 0;
    sinfo.total_size = 0;

    var cur_offset: u32 = 0;
    var max_s_align: u32 = 1;

    var fi: u64 = 0;
    while fi < gs.field_count {
        let gf: *mut GenericField = ((gs as *mut u8) + 56 + (fi * 40)) as *mut GenericField;
        var f_type_hash: u64 = gf.concrete_hash;
        if gf.type_kind == 1 { f_type_hash = arg0; }
        else if gf.type_kind == 2 { f_type_hash = arg1; }

        var f_size: u64 = 8;
        var f_align: u64 = 8;
        var fm_flags: u64 = 8;

        if gf.is_ptr > 0 {
            f_size = 8;
            f_align = 8;
            fm_flags = 8 | (2 << 16);
        } else {
            let s_sub: *mut StructInfo = cg_find_struct(cg, f_type_hash);
            if s_sub != (0 as *mut StructInfo) {
                f_size = s_sub.total_size;
                f_align = 8;
                fm_flags = 8 | 512 | (f_size << 32);
            } else {
                f_size = type_prim_size_from_tok(0, f_type_hash);
                f_align = f_size;
                fm_flags = f_size;
                if is_signed_type_hash(0, f_type_hash) == 1 {
                    fm_flags = fm_flags | 256;
                }
            }
        }

        if gf.arr_len > 0 {
            f_size = f_size * gf.arr_len;
        }

        if (f_align as u32) > max_s_align {
            max_s_align = f_align as u32;
        }
        if (cur_offset % (f_align as u32)) != 0 {
            cur_offset = cur_offset + ((f_align as u32) - (cur_offset % (f_align as u32)));
        }

        let byte_offset: u32 = cur_offset;
        cur_offset = cur_offset + (f_size as u32);

        cg_add_type_graph_entry(cg, mangled_hash, gf.name_hash, byte_offset, f_size as u32);
        cg_add_field_meta(cg, mangled_hash, gf.name_hash, f_type_hash, fm_flags);
        sinfo.field_count = sinfo.field_count + 1;
        fi = fi + 1;
    }

    if (cur_offset % max_s_align) != 0 {
        cur_offset = cur_offset + (max_s_align - (cur_offset % max_s_align));
    }
    if cur_offset == 0 { cur_offset = 8; }
    sinfo.total_size = cur_offset as u64;

    parser_register_struct(p, mangled_hash, sinfo.total_size);
    cg.struct_count = cg.struct_count + 1;
    return mangled_hash;
}

fn clone_ast_subst(p: *mut Parser, node: *mut AstNode, p0: u64, a0: u64, p1: u64, a1: u64) -> *mut AstNode {
    if node == (0 as *mut AstNode) { return 0 as *mut AstNode; }
    let n: *mut AstNode = alloc_node(p, node.kind as u32);
    n.id = node.id;
    n.is_mut = node.is_mut;
    n.val = node.val;
    n.hash = node.hash;

    if n.hash == p0 && p0 != 0 { n.hash = a0; }
    else if n.hash == p1 && p1 != 0 { n.hash = a1; }

    if n.val == p0 && p0 != 0 { n.val = a0; }
    else if n.val == p1 && p1 != 0 { n.val = a1; }

    if p.generic_structs != (0 as *mut u8) {
        var gsi: u64 = 0;
        while gsi < p.generic_struct_count {
            let gs: *mut GenericStruct = (p.generic_structs + (gsi * 704)) as *mut GenericStruct;
            var old_h: u64 = combine_ns_hash(gs.name_hash, p0);
            var new_h: u64 = combine_ns_hash(gs.name_hash, a0);
            if gs.param_count > 1 {
                old_h = combine_ns_hash(old_h, p1);
                new_h = combine_ns_hash(new_h, a1);
            }
            if n.val == old_h {
                n.val = new_h;
                if p.cg != (0 as *mut u8) {
                    instantiate_generic_struct(p, p.cg as *mut CodeGen, gs.name_hash, a0, a1);
                }
            }
            if n.hash == old_h {
                n.hash = new_h;
                if p.cg != (0 as *mut u8) {
                    instantiate_generic_struct(p, p.cg as *mut CodeGen, gs.name_hash, a0, a1);
                }
            }
            gsi = gsi + 1;
        }
    }

    if n.kind == 122 {
        if is_generic_struct(p, n.hash) == 1 {
            n.hash = instantiate_generic_struct(p, p.cg as *mut CodeGen, n.hash, a0, a1);
        }
    }

    n.child1 = clone_ast_subst(p, node.child1, p0, a0, p1, a1);
    if node.kind != 105 {
        n.child2 = clone_ast_subst(p, node.child2, p0, a0, p1, a1);
    } else {
        n.child2 = node.child2;
    }
    if node.kind != 102 && node.kind != 105 {
        n.child3 = clone_ast_subst(p, node.child3, p0, a0, p1, a1);
    } else {
        n.child3 = node.child3;
    }
    n.next = clone_ast_subst(p, node.next, p0, a0, p1, a1);
    return n;
}

fn instantiate_generic_fn(p: *mut Parser, cg: *mut CodeGen, template_hash: u64, arg0: u64, arg1: u64) -> u64 {
    var mangled_hash: u64 = combine_ns_hash(template_hash, arg0);
    if arg1 != 0 {
        mangled_hash = combine_ns_hash(mangled_hash, arg1);
    }

    let gf: *mut GenericFn = find_generic_fn(p, template_hash);
    if gf == (0 as *mut GenericFn) || cg == (0 as *mut CodeGen) {
        return template_hash;
    }

    if gf.bound0_hash != 0 {
        traits_assert_implements(p, arg0, gf.bound0_hash);
    }
    if gf.bound1_hash != 0 {
        traits_assert_implements(p, arg1, gf.bound1_hash);
    }

    var fei: u32 = 0;
    while fei < (cg.fn_entry_count as u32) {
        let fe: *mut FnEntry = ((cg.fn_entries as *mut u8) + ((fei as u64) * 16)) as *mut FnEntry;
        if fe.fn_hash == mangled_hash {
            return mangled_hash;
        }
        fei = fei + 1;
    }

    let cloned_ast: *mut AstNode = clone_ast_subst(p, gf.ast_root, gf.param0_hash, arg0, gf.param1_hash, arg1);
    cloned_ast.hash = mangled_hash;
    compile_fn(cg, cloned_ast);
    return mangled_hash;
}

fn parse_sizeof_type(p: *mut Parser) -> u64 {
    var ptr_cnt: u32 = 0;
    while p.cur_tok.kind == 32 || p.cur_tok.kind == 50 || p.cur_tok.kind == 13 || p.cur_tok.kind == 12 {
        if p.cur_tok.kind == 32 || p.cur_tok.kind == 50 { ptr_cnt = ptr_cnt + 1; }
        lex_next_token(p.lex, &mut p.cur_tok);
    }
    if p.cur_tok.kind == 64 {
        parser_expect(p, 64);
        let elem_sz: u64 = parse_sizeof_type(p);
        parser_expect(p, 71);
        var cnt: u64 = 0;
        if p.cur_tok.kind == 2 {
            cnt = p.cur_tok.int_val;
            lex_next_token(p.lex, &mut p.cur_tok);
        } else {
            let ce: *mut ConstEntry = parser_find_const(p, p.cur_tok.hash);
            if ce != (0 as *mut ConstEntry) { cnt = ce.val; }
            lex_next_token(p.lex, &mut p.cur_tok);
        }
        parser_expect(p, 65);
        if ptr_cnt > 0 { return 8; }
        return elem_sz * cnt;
    }
    var t_kind: u32 = p.cur_tok.kind as u32;
    var t_hash: u64 = p.cur_tok.hash;
    lex_next_token(p.lex, &mut p.cur_tok);
    if p.cur_tok.kind == 43 {
        parser_expect(p, 43);
        let g_arg0: u64 = parse_type_arg_hash(p);
        var g_arg1: u64 = 0;
        if p.cur_tok.kind == 72 {
            parser_expect(p, 72);
            g_arg1 = parse_type_arg_hash(p);
        }
        parser_expect(p, 44);
        if p.cg != (0 as *mut u8) {
            t_hash = instantiate_generic_struct(p, p.cg as *mut CodeGen, t_hash, g_arg0, g_arg1);
        }
    }
    if ptr_cnt > 0 { return 8; }
    if t_kind == 1 {
        let al: *mut ConstEntry = parser_find_alias(p, t_hash);
        if al != (0 as *mut ConstEntry) {
            if al.extra >= 1000 { return 8; }
            t_hash = al.val;
            t_kind = al.extra as u32;
        }
        let ks: *mut ConstEntry = parser_find_known_struct(p, t_hash);
        if ks != (0 as *mut ConstEntry) { return ks.val; }
    }
    return type_prim_size_from_tok(t_kind, t_hash);
}
