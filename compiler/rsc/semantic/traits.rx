struct TraitMethod {
    name_hash: u64,
    param_count: u64,
    ret_type_hash: u64,
}

struct TraitDef {
    trait_hash: u64,
    method_count: u64,
    methods: [TraitMethod; 16],
}

struct TraitImpl {
    trait_hash: u64,
    type_hash: u64,
    method_count: u64,
    methods: [u64; 16],
}

struct TraitObject {
    data: *mut u8,
    vtable: *mut u64,
}

fn make_trait_object(data_ptr: *mut u8, vtable_ptr: *mut u64) -> TraitObject {
    var obj: TraitObject;
    obj.data = data_ptr;
    obj.vtable = vtable_ptr;
    return obj;
}

fn traits_init(p: *mut Parser) {
    p.trait_count = 0;
    p.trait_impl_count = 0;
    traits_register_def(p, 6317974291308382735);
    traits_register_def(p, 362325525084265754);
    traits_register_def(p, 3929114272712712900);
    traits_register_def(p, 6784203327934035010);
}

fn traits_find_def(p: *mut Parser, trait_hash: u64) -> *mut TraitDef {
    if p.traits == (0 as *mut u8) { return 0 as *mut TraitDef; }
    var i: u64 = 0;
    while i < p.trait_count {
        let td: *mut TraitDef = (p.traits + (i * 400)) as *mut TraitDef;
        if td.trait_hash == trait_hash {
            return td;
        }
        i = i + 1;
    }
    return 0 as *mut TraitDef;
}

fn traits_register_def(p: *mut Parser, trait_hash: u64) -> *mut TraitDef {
    let existing: *mut TraitDef = traits_find_def(p, trait_hash);
    if existing != (0 as *mut TraitDef) {
        return existing;
    }
    if p.traits == (0 as *mut u8) || p.trait_count >= 128 {
        return 0 as *mut TraitDef;
    }
    let td: *mut TraitDef = (p.traits + (p.trait_count * 400)) as *mut TraitDef;
    td.trait_hash = trait_hash;
    td.method_count = 0;
    p.trait_count = p.trait_count + 1;
    return td;
}

fn traits_add_method(td: *mut TraitDef, m_hash: u64, param_cnt: u64, ret_h: u64) {
    if td == (0 as *mut TraitDef) { return; }
    if td.method_count >= 16 { return; }
    let m: *mut TraitMethod = &mut td.methods[td.method_count];
    m.name_hash = m_hash;
    m.param_count = param_cnt;
    m.ret_type_hash = ret_h;
    td.method_count = td.method_count + 1;
}

fn traits_register_impl(p: *mut Parser, trait_hash: u64, type_hash: u64) -> *mut TraitImpl {
    if p.trait_impls == (0 as *mut u8) { return 0 as *mut TraitImpl; }
    var i: u64 = 0;
    while i < p.trait_impl_count {
        let ti: *mut TraitImpl = (p.trait_impls + (i * 152)) as *mut TraitImpl;
        if ti.trait_hash == trait_hash && ti.type_hash == type_hash {
            return ti;
        }
        i = i + 1;
    }
    if p.trait_impl_count >= 256 {
        return 0 as *mut TraitImpl;
    }
    let ti: *mut TraitImpl = (p.trait_impls + (p.trait_impl_count * 152)) as *mut TraitImpl;
    ti.trait_hash = trait_hash;
    ti.type_hash = type_hash;
    ti.method_count = 0;
    p.trait_impl_count = p.trait_impl_count + 1;
    return ti;
}

fn traits_add_impl_method(ti: *mut TraitImpl, m_hash: u64) {
    if ti == (0 as *mut TraitImpl) { return; }
    if ti.method_count >= 16 { return; }
    ti.methods[ti.method_count] = m_hash;
    ti.method_count = ti.method_count + 1;
}

fn traits_is_primitive_scalar(type_hash: u64) -> u32 {
    if type_hash == 5563585020063213298 || type_hash == 15670484296631260865 || type_hash == 4128981603702996129 { return 1; }
    if type_hash == 3089943341986682694 || type_hash == 15594117208746958941 || type_hash == 3143511548502526014 { return 1; }
    if type_hash == 5560783464435099345 || type_hash == 3094732814638223685 { return 1; }
    if type_hash == 5558799945458185151 || type_hash == 3092775683940386555 { return 1; }
    if type_hash == 631772817358541784  || type_hash == 627981701265227156  || type_hash == 14785269867199075517 || type_hash == 7505435266999523071 { return 1; }
    if type_hash == 15957463049929925035 || type_hash == 15952682373371409732 || type_hash == 11532138274943533413 { return 1; }
    return 0;
}

fn traits_type_implements(p: *mut Parser, type_hash: u64, trait_hash: u64) -> u32 {
    if trait_hash == 0 { return 1; }

    let send_hash: u64 = 6317974291308382735;
    let sync_hash: u64 = 362325525084265754;
    let copy_hash: u64 = 3929114272712712900;
    let clone_hash: u64 = 6784203327934035010;
    if (trait_hash == send_hash || trait_hash == sync_hash || trait_hash == copy_hash || trait_hash == clone_hash) && traits_is_primitive_scalar(type_hash) == 1 {
        return 1;
    }

    if p == (0 as *mut Parser) || p.trait_impls == (0 as *mut u8) { return 0; }
    var i: u64 = 0;
    while i < p.trait_impl_count {
        let ti: *mut TraitImpl = (p.trait_impls + (i * 152)) as *mut TraitImpl;
        if ti.trait_hash == trait_hash && ti.type_hash == type_hash {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn traits_assert_implements(p: *mut Parser, type_hash: u64, trait_hash: u64) {
    if traits_type_implements(p, type_hash, trait_hash) == 0 {
        println("[COMPILE ERROR: TRAIT BOUND VIOLATION] Type does not satisfy required trait constraint!");
        sys_exit(1);
    }
}

fn traits_resolve_method(type_hash: u64, method_hash: u64) -> u64 {
    return combine_ns_hash(type_hash, method_hash);
}

fn traits_find_method_index(p: *mut Parser, trait_hash: u64, m_hash: u64) -> i32 {
    let td: *mut TraitDef = traits_find_def(p, trait_hash);
    if td == (0 as *mut TraitDef) { return -1; }
    var i: u64 = 0;
    while i < td.method_count {
        let m: *mut TraitMethod = &mut td.methods[i];
        if m.name_hash == m_hash {
            return i as i32;
        }
        i = i + 1;
    }
    return -1;
}

fn parse_trait(p: *mut Parser) {
    parser_expect(p, 100);
    let trait_hash: u64 = p.cur_tok.hash;
    parser_expect_ident(p);
    let td: *mut TraitDef = traits_register_def(p, trait_hash);

    parser_register_struct(p, trait_hash, 16);
    if p.cg != (0 as *mut u8) {
        let cg: *mut CodeGen = p.cg as *mut CodeGen;
        let sinfo: *mut StructInfo = ((cg.structs as *mut u8) + ((cg.struct_count as u64) * 32)) as *mut StructInfo;
        sinfo.name_hash = trait_hash;
        sinfo.type_sig_hash = trait_hash;
        sinfo.field_count = 2;
        sinfo.total_size = 16;
        cg_add_type_graph_entry(cg, trait_hash, 9609368131611085317, 0, 8);
        cg_add_field_meta(cg, trait_hash, 9609368131611085317, 631772817358541784, 8 | (2 << 16));
        cg_add_type_graph_entry(cg, trait_hash, 11452105443513253379, 8, 8);
        cg_add_field_meta(cg, trait_hash, 11452105443513253379, 5563585020063213298, 8 | (2 << 16));
        cg.struct_count = cg.struct_count + 1;
    }

    parser_expect(p, 62);
    while p.cur_tok.kind != 63 && p.cur_tok.kind != 0 {
        if p.cur_tok.kind == 11 {
            parser_expect(p, 11);
            let m_hash: u64 = p.cur_tok.hash;
            parser_expect_ident(p);

            var param_cnt: u64 = 0;
            if p.cur_tok.kind == 60 {
                parser_expect(p, 60);
                var paren_depth: u32 = 1;
                while paren_depth > 0 && p.cur_tok.kind != 0 {
                    if p.cur_tok.kind == 72 { param_cnt = param_cnt + 1; }
                    else if p.cur_tok.kind == 60 { paren_depth = paren_depth + 1; }
                    else if p.cur_tok.kind == 61 {
                        paren_depth = paren_depth - 1;
                        if paren_depth == 0 { break; }
                    }
                    lex_next_token(p.lex, &mut p.cur_tok);
                }
                parser_expect(p, 61);
            }

            var ret_h: u64 = 0;
            if p.cur_tok.kind == 74 {
                parser_expect(p, 74);
                while p.cur_tok.kind == 32 || p.cur_tok.kind == 50 || p.cur_tok.kind == 13 || p.cur_tok.kind == 12 {
                    lex_next_token(p.lex, &mut p.cur_tok);
                }
                ret_h = p.cur_tok.hash;
                lex_next_token(p.lex, &mut p.cur_tok);
            }
            traits_add_method(td, m_hash, param_cnt, ret_h);
            consume_optional_semi(p);
        } else {
            lex_next_token(p.lex, &mut p.cur_tok);
        }
    }
    parser_expect(p, 63);
    consume_optional_semi(p);
}

fn parse_impl(p: *mut Parser, cg: *mut CodeGen) {
    parser_expect(p, 101);
    let first_hash: u64 = p.cur_tok.hash;
    parser_expect_ident(p);

    var trait_hash: u64 = 0;
    var type_hash: u64 = first_hash;

    if p.cur_tok.kind == 82 {
        parser_expect(p, 82);
        trait_hash = first_hash;
        type_hash = p.cur_tok.hash;
        parser_expect_ident(p);
    }

    var ti: *mut TraitImpl = 0 as *mut TraitImpl;
    if trait_hash != 0 {
        ti = traits_register_impl(p, trait_hash, type_hash);
    }

    let self_hash: u64 = 13444641618751515286;
    parser_add_alias(p, self_hash, type_hash, 1);

    parser_expect(p, 62);
    while p.cur_tok.kind != 63 && p.cur_tok.kind != 0 {
        if p.cur_tok.kind == 11 {
            let fnode: *mut AstNode = parse_fn(p, 0);
            if fnode != (0 as *mut AstNode) {
                let orig_mhash: u64 = fnode.hash;
                fnode.hash = combine_ns_hash(type_hash, orig_mhash);
                if ti != (0 as *mut TraitImpl) {
                    traits_add_impl_method(ti, orig_mhash);
                }
                if cg.strict_safety == 1 {
                    let s_err: u32 = safety_verify_fn(p, fnode, 1);
                    if s_err > 0 { sys_exit(1); }
                }
                compile_fn(cg, fnode);
                while p.anon_fns != (0 as *mut AstNode) {
                    let af: *mut AstNode = p.anon_fns;
                    p.anon_fns = af.next;
                    if p.anon_fns == (0 as *mut AstNode) { p.anon_fn_last = 0 as *mut AstNode; }
                    af.next = 0 as *mut AstNode;
                    compile_fn(cg, af);
                }
            }
        } else {
            lex_next_token(p.lex, &mut p.cur_tok);
        }
    }
    parser_expect(p, 63);
    consume_optional_semi(p);
}

fn register_parsed_struct_cg(parser: *mut Parser, cg: *mut CodeGen, snode: *mut AstNode) {
    if snode == (0 as *mut AstNode) { return; }
    let sinfo: *mut StructInfo = ((cg.structs as *mut u8) + ((cg.struct_count as u64) * 32)) as *mut StructInfo;
    sinfo.name_hash = snode.hash;
    sinfo.type_sig_hash = snode.hash;
    sinfo.field_count = 0;
    sinfo.total_size = 0;

    let is_union: u32 = (snode.val == 1) as u32;
    let is_packed: u32 = (snode.val == 2) as u32;

    var cur_offset: u32 = 0;
    var max_s_align: u32 = 1;
    var f: *mut AstNode = snode.child1;

    var fcount: u32 = 0;
    var f_temp: *mut AstNode = snode.child1;
    while f_temp != (0 as *mut AstNode) {
        fcount = fcount + 1;
        f_temp = f_temp.next;
    }

    var is_wire_struct: u32 = is_union | is_packed;
    if sinfo.name_hash == 6275339306359764668 { is_wire_struct = 1; }
    if sinfo.name_hash == 6723681229567792751 { is_wire_struct = 1; }
    if sinfo.name_hash == 17134799602928510233 { is_wire_struct = 1; }
    if sinfo.name_hash == 1914818511609369086 { is_wire_struct = 1; }

    if cg.permute_seed != 0 && fcount >= 2 && is_wire_struct == 0 {
        let f1: *mut AstNode = snode.child1;
        let f2: *mut AstNode = f1.next;
        if f1 != (0 as *mut AstNode) && f2 != (0 as *mut AstNode) {
            let f2_next: *mut AstNode = f2.next;
            snode.child1 = f2;
            f1.next = f2_next;
            f2.next = f1;
            f = f2;
        }
    }

    while f != (0 as *mut AstNode) {
        var f_size: u64 = 8;
        var f_align: u64 = 8;
        var fm_type_hash: u64 = f.id;
        var fm_flags: u64 = 8;

        if f.is_mut >= 100 {
            var raw_al: u64 = f.is_mut - 100;
            var arr_sgn_flag: u64 = 0;
            if raw_al >= 50 {
                raw_al = raw_al - 50;
                arr_sgn_flag = 256;
            }
            f_align = raw_al;
            if f_align == 0 { f_align = 1; }
            f_size = f.val;
            let elem_stride: u64 = f.id;
            let elem_struct_h: u64 = f.child1 as u64;
            fm_type_hash = elem_struct_h;
            fm_flags = 8 | 512 | 1024 | arr_sgn_flag | (elem_stride << 32);
            if elem_struct_h != 0 {
                fm_flags = fm_flags | 2048;
            }
        } else if f.is_mut > 0 {
            f_size = 8;
            f_align = 8;
            var pk_meta: u64 = 2;
            if f.is_mut == 11 {
                pk_meta = 11;
            } else if cg_find_struct(cg, f.id) != (0 as *mut StructInfo) {
                pk_meta = 1;
            }
            fm_flags = 8 | (pk_meta << 16);
        } else {
            if f.val == 1 {
                let s_sub: *mut StructInfo = cg_find_struct(cg, f.id);
                if s_sub != (0 as *mut StructInfo) {
                    f_size = s_sub.total_size;
                    f_align = 8;
                    fm_flags = 8 | 512 | (f_size << 32);
                } else {
                    f_size = 8;
                    f_align = 8;
                    fm_flags = 8;
                }
            } else {
                f_size = type_prim_size_from_tok(f.val as u32, f.id);
                f_align = f_size;
                fm_flags = f_size;
                if is_signed_type_hash(f.val as u32, f.id) == 1 {
                    fm_flags = fm_flags | 256;
                }
            }
        }

        if is_packed == 1 {
            f_align = 1;
        }
        if (f_align as u32) > max_s_align {
            max_s_align = f_align as u32;
        }

        var byte_offset: u32 = 0;
        if is_union == 1 {
            byte_offset = 0;
            if (f_size as u32) > cur_offset {
                cur_offset = f_size as u32;
            }
        } else {
            if (cur_offset % (f_align as u32)) != 0 {
                cur_offset = cur_offset + ((f_align as u32) - (cur_offset % (f_align as u32)));
            }
            byte_offset = cur_offset;
            cur_offset = cur_offset + (f_size as u32);
        }

        cg_add_type_graph_entry(cg, sinfo.type_sig_hash, f.hash, byte_offset, f_size as u32);
        cg_add_field_meta(cg, sinfo.type_sig_hash, f.hash, fm_type_hash, fm_flags);
        sinfo.field_count = sinfo.field_count + 1;
        f = f.next;
    }

    if is_packed == 0 && (cur_offset % max_s_align) != 0 {
        cur_offset = cur_offset + (max_s_align - (cur_offset % max_s_align));
    }
    if cur_offset == 0 { cur_offset = 8; }
    sinfo.total_size = cur_offset as u64;
    parser_register_struct(parser, sinfo.name_hash, sinfo.total_size);
    cg.struct_count = cg.struct_count + 1;
}
