include "lib/core/types.rx";
include "lib/io/print.rx";
include "lib/time/clock.rx";
include "lib/rxd/rxd.rx";
include "compiler/subsystems/eia/patcher.rx";

fn verify_gate1_syscalls() -> bool {
    println("[Gate 1/5] Direct Silicon Syscall Bridge & OS Environment...");
    let pid: int = @os.getpid();
    if pid <= 0 {
        println("  [FAIL] @os.getpid failed");
        return false;
    }
    var ts: [uint; 2];
    let res: int = @os.clock_gettime(1, &ts[0]);
    if res < 0 {
        println("  [FAIL] @os.clock_gettime failed");
        return false;
    }
    println("  [PASS] USES @os.* hardware port verified (zero libc dependency)");
    return true;
}

fn verify_gate2_memory_cacheline() -> bool {
    println("[Gate 2/5] Memory Arena & 64-Byte Cacheline Invariant...");
    var storage: [byte; 256];
    let raw_addr: uint = (&storage[0]) as uint;
    let aligned_addr: uint = ((raw_addr + 63) / 64) * 64;
    if (aligned_addr % 64) != 0 {
        println("  [FAIL] Cacheline alignment calculation failed");
        return false;
    }
    let p: *mut u64 = aligned_addr as *mut u64;
    p[0] = 0xDEADBEEFCAFE;
    if p[0] != 0xDEADBEEFCAFE {
        println("  [FAIL] Cacheline memory write failed");
        return false;
    }
    println("  [PASS] 64-byte L3 cacheline alignment and atomic writes verified");
    return true;
}

fn verify_gate3_hologram_blake3() -> bool {
    println("[Gate 3/5] Universal Hologram, Contracts, Relocs & BLAKE3...");
    var blob: [u8; 512];
    var z: uint = 0;
    while z < 512 {
        blob[z] = 0;
        z = z + 1;
    }
    blob[0] = 127;
    blob[1] = 69;
    blob[2] = 76;
    blob[3] = 70;
    blob[4] = 2;

    var sc: SymbolContract;
    let sym_h: uint = blake3_hash64("gate3_fn" as *const u8, 8);
    let sig_h: uint = blake3_hash64("(i64)->i64" as *const u8, 10);
    eia_contract_init_ex(&mut sc, sym_h, sig_h, 4259840, 32, EIA_SYM_DEFINED, 0, 0);

    var tg: EiaTypeGraphEntry;
    let t_h: uint = blake3_hash64("Gate3Struct" as *const u8, 11);
    let f_h: uint = blake3_hash64("field_b" as *const u8, 7);
    eia_type_graph_entry_init(&mut tg, t_h, f_h, 24, 8);

    var hole: EiaRelocHole;
    eia_reloc_init(&mut hole, 3, RelocPatchKind.DISP32, t_h, f_h);

    blob[320] = 0x48;
    blob[321] = 0x8B;
    blob[322] = 0x83;

    let sealed: bool = eia_populate_and_seal_hologram(
        &mut blob[0],
        512,
        128,
        224,
        (&sc) as *const SymbolContract,
        1,
        272,
        (&hole) as *const EiaRelocHole,
        1,
        296,
        (&tg) as *const EiaTypeGraphEntry,
        1,
        1,
        EIA_FLAG_HAS_CODE_HASH,
        4194624,
        4194304
    );
    if !sealed {
        println("  [FAIL] eia_populate_and_seal_hologram returned false");
        return false;
    }

    if eia_verify_artifact_bytes((&blob[0]) as *const u8, 512) != 0 {
        println("  [FAIL] eia_verify_artifact_bytes rejected freshly sealed hologram");
        return false;
    }

    let patched: uint = eia_patch_reloc_holes_arch(
        &mut blob[320],
        0,
        (&blob[272]) as *const EiaRelocHole,
        1,
        (&blob[296]) as *const EiaTypeGraphEntry,
        1
    );
    if patched != 1 || eia_patch_read_u32((&blob[323]) as *const u8) != 24 {
        println("  [FAIL] Canonical relocation patcher failed DISP32 resolution");
        return false;
    }

    var client_sc: SymbolContract;
    eia_contract_init_ex(&mut client_sc, sym_h, sig_h, 0, 0, EIA_SYM_IMPORT, 0, 0);
    let prov_sc: *const SymbolContract = (&blob[224]) as *const SymbolContract;
    if !eia_contract_verify_match((&client_sc) as *const SymbolContract, prov_sc) {
        println("  [FAIL] eia_contract_verify_match rejected matching contract");
        return false;
    }

    var bad_client: SymbolContract;
    eia_contract_init_ex(&mut bad_client, sym_h, sig_h ^ 1, 0, 0, EIA_SYM_IMPORT, 0, 0);
    if eia_contract_verify_match((&bad_client) as *const SymbolContract, prov_sc) {
        println("  [FAIL] eia_contract_verify_match accepted mismatched signature hash");
        return false;
    }

    blob[224] = blob[224] ^ 1;
    if eia_verify_artifact_bytes((&blob[0]) as *const u8, 512) == 0 {
        println("  [FAIL] Tampered contract bytes passed BLAKE3 verification");
        return false;
    }

    println("  [PASS] Hologram sealing, BLAKE3 integrity, contract match & reloc patcher verified");
    return true;
}

fn verify_gate4_rxd_vitrification() -> bool {
    println("[Gate 4/5] Dual-Continuum Data (RXD) Vitrification & Units...");
    let sample_rxd: *const byte = "package { name: \"verify\" memory_limit: 16MB timeout: 5s }" as *const byte;
    var plate_buf: [u8; 4096];
    let plate_size: u64 = rxd_vitrify(sample_rxd, 57, &plate_buf[0], 4096);
    if plate_size < 64 {
        println("  [FAIL] RXD text vitrification failed");
        return false;
    }
    let hdr: *const RxdHeader = (&plate_buf[0]) as *const RxdHeader;
    if hdr.magic != 0x00445852 {
        println("  [FAIL] Corrupted RXD header magic");
        return false;
    }
    println("  [PASS] 64-byte cacheline 0 header and unit quantities verified");
    return true;
}

fn verify_gate5_fixpoint() -> bool {
    println("[Gate 5/5] Self-Hosting Binary Format & Embedded EIA Hologram...");
    var fd_bin: int = @os.open("bin/rux" as *byte, 0, 0);
    if fd_bin < 0 {
        fd_bin = @os.open("bin/rux.exe" as *byte, 0, 0);
    }
    if fd_bin < 0 {
        println("  [FAIL] bin/rux not found in local working directory");
        return false;
    }
    let cap: uint = 8388608;
    let bin_buf: *mut u8 = @os.mmap(0 as *mut byte, cap, 3, 34, 0 - 1, 0) as *mut u8;
    if (bin_buf as int) <= 0 {
        @os.close(fd_bin);
        println("  [FAIL] mmap allocation failed for binary verification");
        return false;
    }
    var total_read: uint = 0;
    while total_read < cap {
        let nr: int = @os.read(fd_bin, (bin_buf + total_read) as *byte, cap - total_read);
        if nr <= 0 {
            break;
        }
        total_read = total_read + (nr as uint);
    }
    @os.close(fd_bin);

    let is_elf: bool = (total_read >= 16 && bin_buf[0] == 0x7F && bin_buf[1] == 69 && bin_buf[2] == 76 && bin_buf[3] == 70 && bin_buf[4] == 2);
    let is_pe: bool = (total_read >= 16 && bin_buf[0] == 77 && bin_buf[1] == 90);
    if !is_elf && !is_pe {
        @os.munmap(bin_buf as uint, cap);
        println("  [FAIL] bin/rux is not a valid 64-bit ELF or PE32+ binary");
        return false;
    }

    let holo_off: i64 = eia_locate_hologram_offset(bin_buf as *const u8, total_read);
    if holo_off < 0 {
        @os.munmap(bin_buf as uint, cap);
        println("  [FAIL] bin/rux missing embedded EIA Universal Hologram");
        return false;
    }
    let vres: int = eia_verify_artifact_bytes(bin_buf as *const u8, total_read);
    @os.munmap(bin_buf as uint, cap);
    if vres != 0 {
        println("  [FAIL] bin/rux failed embedded EIA BLAKE3/contract/reloc verification");
        return false;
    }
    println("  [PASS] Self-hosting compiler binary & embedded EIA hologram verified");
    return true;
}

fn verify_run_all_5_gates() -> int {
    println("=================================================================");
    println("            EIA 5-GATE HARDWARE VERIFICATION RING                ");
    println("=================================================================");

    if !verify_gate1_syscalls() { return 1; }
    if !verify_gate2_memory_cacheline() { return 2; }
    if !verify_gate3_hologram_blake3() { return 3; }
    if !verify_gate4_rxd_vitrification() { return 4; }
    if !verify_gate5_fixpoint() { return 5; }

    println("=================================================================");
    println(">>> ALL 5 EIA HARDWARE VERIFICATION GATES PASSED (100% OK) <<<");
    println("=================================================================");
    return 0;
}
