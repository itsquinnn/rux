include "lib/core/types.rx";
include "lib/core/option.rx";
include "lib/core/panic.rx";

const TYPE_ID_I64: u64 = 3143511548502526014;
const TYPE_ID_U64: u64 = 5563585020063213298;
const TYPE_ID_STR: u64 = 9398593617327382768;
const TYPE_ID_BOOL: u64 = 14785269867199075517;

struct AnyValue {
    type_id: u64,
    inline_storage: [u8; 16],
    heap_ptr: *mut u8,
    is_heap: bool,
    size: usize,
}

fn any_from_i64(val: i64) -> AnyValue {
    var a: AnyValue;
    a.type_id = TYPE_ID_I64;
    a.heap_ptr = 0 as *mut u8;
    a.is_heap = false;
    a.size = 8;
    let ptr: *mut i64 = (&mut a.inline_storage[0]) as *mut i64;
    ptr[0] = val;
    return a;
}

fn any_from_u64(val: u64) -> AnyValue {
    var a: AnyValue;
    a.type_id = TYPE_ID_U64;
    a.heap_ptr = 0 as *mut u8;
    a.is_heap = false;
    a.size = 8;
    let ptr: *mut u64 = (&mut a.inline_storage[0]) as *mut u64;
    ptr[0] = val;
    return a;
}

fn any_from_bool(val: bool) -> AnyValue {
    var a: AnyValue;
    a.type_id = TYPE_ID_BOOL;
    a.heap_ptr = 0 as *mut u8;
    a.is_heap = false;
    a.size = 1;
    a.inline_storage[0] = val;
    return a;
}

fn any_is(a: *const AnyValue, expected_type_id: u64) -> bool {
    return a.type_id == expected_type_id;
}

fn any_downcast_i64(a: *const AnyValue) -> Option<i64> {
    if a.type_id != TYPE_ID_I64 {
        return None<i64>();
    }
    let ptr: *const i64 = (&a.inline_storage[0]) as *const i64;
    return Some<i64>(ptr[0]);
}

fn any_downcast_u64(a: *const AnyValue) -> Option<u64> {
    if a.type_id != TYPE_ID_U64 {
        return None<u64>();
    }
    let ptr: *const u64 = (&a.inline_storage[0]) as *const u64;
    return Some<u64>(ptr[0]);
}

fn any_downcast_bool(a: *const AnyValue) -> Option<bool> {
    if a.type_id != TYPE_ID_BOOL {
        return None<bool>();
    }
    return Some<bool>(a.inline_storage[0]);
}

fn any_type_id(a: *const AnyValue) -> u64 {
    return a.type_id;
}

