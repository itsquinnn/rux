include "lib/core/types.rx";
include "lib/core/option.rx";
include "lib/core/utf8.rx";
include "lib/os/uses_substrate.rx";

struct String {
    data: *mut byte,
    len: uint,
    cap: uint,
}

fn string_new() -> String {
    var s: String;
    s.data = 0 as *mut byte;
    s.len = 0;
    s.cap = 0;
    return s;
}

fn string_with_capacity(initial_cap: uint) -> String {
    var s: String;
    var cap: uint = initial_cap;
    if cap < 16 { cap = 16; }
    s.data = uses_substrate_alloc(cap) as *mut byte;
    s.data[0] = 0 as byte;
    s.len = 0;
    s.cap = cap;
    return s;
}

fn string_from(src: str) -> String {
    let ptr: *const byte = src as *const byte;
    var l: uint = 0;
    while ptr[l] != 0 as byte { l = l + 1; }
    var s: String = string_with_capacity(l + 1);
    var i: uint = 0;
    while i < l {
        s.data[i] = ptr[i];
        i = i + 1;
    }
    s.data[l] = 0 as byte;
    s.len = l;
    return s;
}

fn string_grow(s: *mut String, min_cap: uint) {
    var new_cap: uint = s.cap * 2;
    if new_cap < min_cap { new_cap = min_cap; }
    if new_cap < 16 { new_cap = 16; }
    let new_data: *mut byte = uses_substrate_alloc(new_cap) as *mut byte;
    var i: uint = 0;
    while i < s.len {
        new_data[i] = s.data[i];
        i = i + 1;
    }
    new_data[s.len] = 0 as byte;
    if (s.data as uint) != 0 && s.cap > 0 {
        uses_substrate_free(s.data, s.cap);
    }
    s.data = new_data;
    s.cap = new_cap;
}

fn string_push_str(s: *mut String, other: str) {
    let optr: *const byte = other as *const byte;
    var olen: uint = 0;
    while optr[olen] != 0 as byte { olen = olen + 1; }
    if (s.len + olen + 1) > s.cap {
        string_grow(s, s.len + olen + 1);
    }
    var i: uint = 0;
    while i < olen {
        s.data[s.len + i] = optr[i];
        i = i + 1;
    }
    s.len = s.len + olen;
    s.data[s.len] = 0 as byte;
}

fn string_push_char(s: *mut String, c: uint) {
    if (s.len + 5) > s.cap {
        string_grow(s, s.len + 5);
    }
    if c < 128 {
        s.data[s.len] = c as byte;
        s.len = s.len + 1;
    } else if c < 2048 {
        s.data[s.len] = (192 | ((c >> 6) & 31)) as byte;
        s.data[s.len + 1] = (128 | (c & 63)) as byte;
        s.len = s.len + 2;
    } else if c < 65536 {
        s.data[s.len] = (224 | ((c >> 12) & 15)) as byte;
        s.data[s.len + 1] = (128 | ((c >> 6) & 63)) as byte;
        s.data[s.len + 2] = (128 | (c & 63)) as byte;
        s.len = s.len + 3;
    } else {
        s.data[s.len] = (240 | ((c >> 18) & 7)) as byte;
        s.data[s.len + 1] = (128 | ((c >> 12) & 63)) as byte;
        s.data[s.len + 2] = (128 | ((c >> 6) & 63)) as byte;
        s.data[s.len + 3] = (128 | (c & 63)) as byte;
        s.len = s.len + 4;
    }
    s.data[s.len] = 0 as byte;
}

fn string_as_str(s: *const String) -> str {
    if s.len == 0 || (s.data as uint) == 0 {
        return "";
    }
    return s.data as str;
}

fn string_len(s: *const String) -> uint {
    return s.len;
}

fn string_is_empty(s: *const String) -> bool {
    return s.len == 0;
}

fn string_get_range(s: *const String, start: uint, end_idx: uint) -> Option {
    if start > end_idx || end_idx > s.len {
        return option_none();
    }
    let sub_len: uint = end_idx - start;
    let sub_buf: *mut byte = uses_substrate_alloc(sub_len + 1) as *mut byte;
    var i: uint = 0;
    while i < sub_len {
        sub_buf[i] = s.data[start + i];
        i = i + 1;
    }
    sub_buf[sub_len] = 0 as byte;
    return option_some(sub_buf as uint);
}

fn string_negative_index(s: *const String, neg_idx: int) -> Option {
    var pos_idx: int = neg_idx;
    if neg_idx < 0 {
        pos_idx = (s.len as int) + neg_idx;
    }
    if pos_idx < 0 || (pos_idx as uint) >= s.len {
        return option_none();
    }
    return option_some((s.data[pos_idx as uint] as uint) & 255);
}

struct CharIterator {
    ptr: *const byte,
    len: uint,
    offset: uint,
}

fn string_chars(s: *const String) -> CharIterator {
    var it: CharIterator;
    it.ptr = s.data;
    it.len = s.len;
    it.offset = 0;
    return it;
}

fn char_iter_next(it: *mut CharIterator, out_c: *mut uint) -> bool {
    if it.offset >= it.len {
        return false;
    }
    var rune: [uint; 1];
    let consumed: uint = utf8_decode_rune(it.ptr, it.len, it.offset, &mut rune[0]);
    if consumed == 0 {
        return false;
    }
    out_c[0] = rune[0];
    it.offset = it.offset + consumed;
    return true;
}

struct ByteIterator {
    ptr: *const byte,
    len: uint,
    offset: uint,
}

fn string_bytes(s: *const String) -> ByteIterator {
    var it: ByteIterator;
    it.ptr = s.data;
    it.len = s.len;
    it.offset = 0;
    return it;
}

fn byte_iter_next(it: *mut ByteIterator, out_b: *mut byte) -> bool {
    if it.offset >= it.len {
        return false;
    }
    out_b[0] = it.ptr[it.offset];
    it.offset = it.offset + 1;
    return true;
}

struct GraphemeIterator {
    char_it: CharIterator,
}

fn string_graphemes(s: *const String) -> GraphemeIterator {
    var g: GraphemeIterator;
    g.char_it = string_chars(s);
    return g;
}

fn grapheme_iter_next(g: *mut GraphemeIterator, out_g: *mut uint) -> bool {
    return char_iter_next(&mut g.char_it, out_g);
}

fn string_free(s: *mut String) {
    if (s.data as uint) != 0 && s.cap > 0 {
        uses_substrate_free(s.data, s.cap);
        s.data = 0 as *mut byte;
        s.len = 0;
        s.cap = 0;
    }
}

