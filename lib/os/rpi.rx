include "lib/core/types.rx";
include "lib/os/raiq.rx";

const RPI_OP_READ: uint             = 1;
const RPI_OP_WRITE: uint            = 2;
const RPI_OP_DMA_COPY: uint         = 3;
const RPI_OP_MAP: uint              = 4;
const RPI_OP_OPEN: uint             = 5;
const RPI_OP_CLOSE: uint            = 6;
const RPI_OP_EXIT: uint             = 7;
const RPI_OP_UNMAP: uint            = 8;
const RPI_OP_EPOLL: uint            = 9;
const RPI_OP_DELETE: uint           = 10;
const RPI_OP_SOCKET: uint           = 11;
const RPI_OP_CONNECT: uint          = 12;
const RPI_OP_BIND: uint             = 13;
const RPI_OP_LISTEN: uint           = 14;
const RPI_OP_ACCEPT: uint           = 15;
const RPI_OP_SEEK: uint             = 16;
const RPI_OP_STAT: uint             = 17;
const RPI_OP_RENAME: uint           = 18;
const RPI_OP_DIRECTORY_CREATE: uint = 19;
const RPI_OP_DIRECTORY_READ: uint   = 20;
const RPI_OP_CLOCK_GET: uint        = 21;
const RPI_OP_SLEEP: uint            = 22;
const RPI_OP_RANDOM_GET: uint       = 23;
const RPI_OP_PROCESS_SPAWN: uint    = 24;
const RPI_OP_MEMORY_ALLOCATE: uint  = 25;
const RPI_OP_MEMORY_RELEASE: uint   = 26;
const RPI_OP_MEMORY_PROTECT: uint   = 27;

const RPI_CAP_TAG_SOVEREIGN: uint   = 14786561;
const RPI_CAP_PROOF_ROOT: uint      = 2416041645;

const RPI_SUCCESS: int              = 0;
const RPI_ERR_GENERIC: int          = -1;
const RPI_ERR_NOT_FOUND: int        = -2;
const RPI_ERR_ACCESS_DENIED: int    = -3;
const RPI_ERR_INVALID_HANDLE: int   = -4;
const RPI_ERR_OUT_OF_MEMORY: int    = -5;

fn rpi_host_dispatch(sqe: *const RaiqSubmissionEntry64) -> int {
    @silicon.sfence();
    let op: uint = sqe.opcode;
    let src: uint = sqe.source_addr;
    let dst: uint = sqe.dest_addr;
    let len: uint = sqe.length;

    if op == RPI_OP_WRITE {
        let fd: uint = dst;
        let buf_ptr: uint = src;
        return @os.write(fd, buf_ptr, len);
    } else if op == RPI_OP_READ {
        let fd: uint = src;
        let buf_ptr: uint = dst;
        return @os.read(fd, buf_ptr, len);
    } else if op == RPI_OP_OPEN {
        let path_ptr: uint = src;
        let flags: uint = dst;
        let mode: uint = len;
        return @os.open(path_ptr, flags, mode);
    } else if op == RPI_OP_CLOSE {
        let fd: uint = src;
        return @os.close(fd);
    } else if op == RPI_OP_MAP || op == RPI_OP_MEMORY_ALLOCATE {
        let fd: uint = src;
        let map_len: uint = len;
        if fd == (0 - 1) || dst == 1 {
            return @os.mmap(0, map_len, 7, 34, 0 - 1, 0);
        } else {
            return @os.mmap(0, map_len, 7, 1, fd, 0);
        }
    } else if op == RPI_OP_EXIT {
        let code: uint = src;
        @os.exit(code);
        return 0;
    } else if op == RPI_OP_UNMAP || op == RPI_OP_MEMORY_RELEASE {
        return @os.munmap(src, len);
    } else if op == RPI_OP_EPOLL {
        return @os.epoll_create1(src);
    } else if op == RPI_OP_DELETE {
        return @os.unlink(src);
    } else if op == RPI_OP_SOCKET {
        return @os.socket(src, dst, len);
    } else if op == RPI_OP_CONNECT {
        return @os.connect(src, dst, len);
    } else if op == RPI_OP_BIND {
        return @os.bind(src, dst, len);
    } else if op == RPI_OP_LISTEN {
        return @os.listen(src, dst);
    } else if op == RPI_OP_ACCEPT {
        return @os.accept(src, dst, len);
    } else if op == RPI_OP_DIRECTORY_CREATE {
        return @os.mkdir(src as *byte, dst);
    } else if op == RPI_OP_CLOCK_GET {
        return @os.clock_gettime(src, dst as *mut uint);
    } else if op == RPI_OP_SLEEP {
        return @os.nanosleep(src as *const uint, dst as *mut uint);
    }
    return 0;
}

fn rpi_alloc(bytes: uint) -> *mut u8 {
    let aligned: uint = ((bytes + 4095) / 4096) * 4096;
    var sqe: RaiqSubmissionEntry64;
    raiq_prepare_sqe(&mut sqe, RPI_OP_MAP, 0 - 1, 1, aligned, 10);
    let ptr: int = rpi_host_dispatch(&sqe);
    let uptr: uint = ptr as uint;
    if uptr == 0 || uptr > 18446744000000000000 {
        return 0 as *mut u8;
    }
    return ptr as *mut u8;
}

fn rpi_free(ptr: *mut u8, bytes: uint) {
    if (ptr as int) > 0 {
        let aligned: uint = ((bytes + 4095) / 4096) * 4096;
        var sqe: RaiqSubmissionEntry64;
        raiq_prepare_sqe(&mut sqe, RPI_OP_UNMAP, ptr as uint, 0, aligned, 11);
        rpi_host_dispatch(&sqe);
    }
}

fn rpi_epoll_create(flags: uint) -> int {
    var sqe: RaiqSubmissionEntry64;
    raiq_prepare_sqe(&mut sqe, RPI_OP_EPOLL, flags, 0, 0, 12);
    return rpi_host_dispatch(&sqe);
}

fn rpi_unlink(path: *const byte) -> int {
    var sqe: RaiqSubmissionEntry64;
    raiq_prepare_sqe(&mut sqe, RPI_OP_DELETE, path as uint, 0, 0, 13);
    return rpi_host_dispatch(&sqe);
}

fn rpi_write(channel: uint, buf: *const byte, len: uint) -> int {
    var sqe: RaiqSubmissionEntry64;
    raiq_prepare_sqe(&mut sqe, RPI_OP_WRITE, buf as uint, channel, len, 1);
    return rpi_host_dispatch(&sqe);
}

fn rpi_read(channel: uint, buf: *mut byte, max_len: uint) -> int {
    var sqe: RaiqSubmissionEntry64;
    raiq_prepare_sqe(&mut sqe, RPI_OP_READ, channel, buf as uint, max_len, 2);
    return rpi_host_dispatch(&sqe);
}

fn rpi_open(path: *const byte, flags: uint, mode: uint) -> int {
    var sqe: RaiqSubmissionEntry64;
    raiq_prepare_sqe(&mut sqe, RPI_OP_OPEN, path as uint, flags, mode, 3);
    return rpi_host_dispatch(&sqe);
}

fn rpi_close(channel: uint) -> int {
    var sqe: RaiqSubmissionEntry64;
    raiq_prepare_sqe(&mut sqe, RPI_OP_CLOSE, channel, 0, 0, 4);
    return rpi_host_dispatch(&sqe);
}

fn rpi_write_file(filepath: *const byte, buf: *const u8, len: uint) -> int {
    let flags: uint = 577;
    let mode: uint = 493;
    let fd: int = rpi_open(filepath, flags, mode);
    if fd < 0 {
        return -1;
    }

    var written: uint = 0;
    while written < len {
        let chunk: uint = len - written;
        let buf_ptr: *const byte = (buf + written) as *const byte;
        let n: int = rpi_write(fd as uint, buf_ptr, chunk);
        if n <= 0 {
            rpi_close(fd as uint);
            return -2;
        }
        written = written + (n as uint);
    }

    rpi_close(fd as uint);
    return written as int;
}

fn rpi_read_file(filepath: *const byte, dst: *mut u8, max_len: uint) -> int {
    let fd: int = rpi_open(filepath, 0, 0);
    if fd < 0 {
        return -1;
    }
    let nread: int = rpi_read(fd as uint, dst as *mut byte, max_len);
    rpi_close(fd as uint);
    return nread;
}

fn rpi_map_plate(filepath: *const byte, max_size: uint) -> *mut u8 {
    let fd: int = rpi_open(filepath, 0, 0);
    if fd < 0 {
        return 0 as *mut u8;
    }
    var sqe: RaiqSubmissionEntry64;
    raiq_prepare_sqe(&mut sqe, RPI_OP_MAP, fd as uint, 0, max_size, 5);
    let ptr: int = rpi_host_dispatch(&sqe);
    rpi_close(fd as uint);
    if ptr <= 0 {
        return 0 as *mut u8;
    }
    return ptr as *mut u8;
}

fn rpi_exit(code: uint) {
    var sqe: RaiqSubmissionEntry64;
    raiq_prepare_sqe(&mut sqe, RPI_OP_EXIT, code, 0, 0, 99);
    rpi_host_dispatch(&sqe);
}
