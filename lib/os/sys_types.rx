include "lib/core/types.rx";

struct KernelTimespec {
    tv_sec: int,
    tv_nsec: int,
}

struct KernelIovec {
    iov_base: *mut byte,
    iov_len: uint,
}

struct KernelStat {
    st_dev: uint,
    st_ino: uint,
    st_nlink: uint,
    st_mode: u32,
    st_uid: u32,
    st_gid: u32,
    pad0: u32,
    st_rdev: uint,
    st_size: int,
    st_blksize: int,
    st_blocks: int,
    st_atime: int,
    st_atime_nsec: uint,
    st_mtime: int,
    st_mtime_nsec: uint,
    st_ctime: int,
    st_ctime_nsec: uint,
}
