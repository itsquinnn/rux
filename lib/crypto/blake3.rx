include "lib/core/types.rx";
include "lib/crypto/blake3_core.rx";

fn blake3_64(buf: *const byte, len: uint) -> uint {
    return blake3_hash64(buf as *const u8, len as u64) as uint;
}

fn blake3_str(s: *const byte) -> uint {
    var len: uint = 0;
    while s[len] != 0 {
        len = len + 1;
    }
    return blake3_64(s, len);
}
