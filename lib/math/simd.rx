include "lib/core/types.rx";

struct Vec4i64 {
    v0: int,
    v1: int,
    v2: int,
    v3: int,
}

fn vec4i64_add(a: Vec4i64, b: Vec4i64) -> Vec4i64 {
    return Vec4i64 {
        v0: a.v0 + b.v0,
        v1: a.v1 + b.v1,
        v2: a.v2 + b.v2,
        v3: a.v3 + b.v3,
    };
}

fn vec4i64_mul(a: Vec4i64, b: Vec4i64) -> Vec4i64 {
    return Vec4i64 {
        v0: a.v0 * b.v0,
        v1: a.v1 * b.v1,
        v2: a.v2 * b.v2,
        v3: a.v3 * b.v3,
    };
}
