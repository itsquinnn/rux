include "lib/core/types.rx";
include "lib/math/scalar.rx";

struct Rational {
    num: int,
    den: int,
}

fn gcd_i64(a: int, b: int) -> int {
    var x: int = abs_int(a);
    var y: int = abs_int(b);
    while y != 0 {
        let rem: int = x % y;
        x = y;
        y = rem;
    }
    return x;
}

fn rational_reduce(num: int, den: int) -> Rational {
    if den == 0 {
        return Rational { num: 0, den: 0 };
    }
    let g: int = gcd_i64(num, den);
    var sign: int = 1;
    if (num < 0 && den > 0) || (num > 0 && den < 0) {
        sign = -1;
    }
    let r_num: int = (abs_int(num) / g) * sign;
    let r_den: int = abs_int(den) / g;
    return Rational { num: r_num, den: r_den };
}

fn rational_new(num: int, den: int) -> Rational {
    return rational_reduce(num, den);
}

fn rational_add(a: Rational, b: Rational) -> Rational {
    let common_den: int = a.den * b.den;
    let new_num: int = (a.num * b.den) + (b.num * a.den);
    return rational_reduce(new_num, common_den);
}

fn rational_sub(a: Rational, b: Rational) -> Rational {
    let common_den: int = a.den * b.den;
    let new_num: int = (a.num * b.den) - (b.num * a.den);
    return rational_reduce(new_num, common_den);
}

fn rational_mul(a: Rational, b: Rational) -> Rational {
    return rational_reduce(a.num * b.num, a.den * b.den);
}

fn rational_div(a: Rational, b: Rational) -> Rational {
    return rational_reduce(a.num * b.den, a.den * b.num);
}

fn rational_to_float(r: Rational) -> float {
    if r.den == 0 { return 0.0; }
    return (r.num as float) / (r.den as float);
}

