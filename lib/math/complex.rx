include "lib/core/types.rx";

struct Complex {
    re: int,
    im: int,
}

fn complex_new(re: int, im: int) -> Complex {
    return Complex { re: re, im: im };
}

fn complex_add(a: Complex, b: Complex) -> Complex {
    return Complex {
        re: a.re + b.re,
        im: a.im + b.im,
    };
}

fn complex_sub(a: Complex, b: Complex) -> Complex {
    return Complex {
        re: a.re - b.re,
        im: a.im - b.im,
    };
}

fn complex_mul(a: Complex, b: Complex) -> Complex {
    return Complex {
        re: (a.re * b.re) - (a.im * b.im),
        im: (a.re * b.im) + (a.im * b.re),
    };
}

fn complex_conj(a: Complex) -> Complex {
    return Complex {
        re: a.re,
        im: 0 - a.im,
    };
}

fn complex_norm_sq(a: Complex) -> int {
    return (a.re * a.re) + (a.im * a.im);
}

fn complex_scale(a: Complex, factor: int) -> Complex {
    return Complex {
        re: a.re * factor,
        im: a.im * factor,
    };
}
