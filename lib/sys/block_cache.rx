include "lib/core/types.rx";

struct BlockCacheLine {
    dev_id: u32,
    lba: u64,
    last_used_tick: u64,
    valid: bool,
    dirty: bool,
    data: [byte; 512],
}

struct BlockCache {
    lines: [BlockCacheLine; 16],
    tick: u64,
    hits: u64,
    misses: u64,
    writebacks: u64,
}

fn block_cache_init(bc: *mut BlockCache) {
    bc.tick = 1;
    bc.hits = 0;
    bc.misses = 0;
    bc.writebacks = 0;
    var i: uint = 0;
    while i < 16 {
        bc.lines[i].valid = false;
        bc.lines[i].dirty = false;
        bc.lines[i].last_used_tick = 0;
        i = i + 1;
    }
}

fn block_cache_find(bc: *mut BlockCache, dev_id: u32, lba: u64) -> int {
    var i: uint = 0;
    while i < 16 {
        if bc.lines[i].valid && bc.lines[i].dev_id == dev_id && bc.lines[i].lba == lba {
            bc.tick = bc.tick + 1;
            bc.lines[i].last_used_tick = bc.tick;
            bc.hits = bc.hits + 1;
            return i as int;
        }
        i = i + 1;
    }
    bc.misses = bc.misses + 1;
    return -1;
}

fn block_cache_select_victim(bc: *mut BlockCache) -> uint {
    var i: uint = 0;
    while i < 16 {
        if !bc.lines[i].valid {
            return i;
        }
        i = i + 1;
    }
    var lru_idx: uint = 0;
    var lru_tick: u64 = bc.lines[0].last_used_tick;
    var j: uint = 1;
    while j < 16 {
        if bc.lines[j].last_used_tick < lru_tick {
            lru_tick = bc.lines[j].last_used_tick;
            lru_idx = j;
        }
        j = j + 1;
    }
    if bc.lines[lru_idx].dirty {
        bc.writebacks = bc.writebacks + 1;
        bc.lines[lru_idx].dirty = false;
    }
    return lru_idx;
}

fn block_cache_write_sector(bc: *mut BlockCache, dev_id: u32, lba: u64, src: *const byte) -> uint {
    var slot_i: int = block_cache_find(bc, dev_id, lba);
    var slot: uint = 0;
    if slot_i < 0 {
        slot = block_cache_select_victim(bc);
        bc.lines[slot].dev_id = dev_id;
        bc.lines[slot].lba = lba;
        bc.lines[slot].valid = true;
    } else {
        slot = slot_i as uint;
    }
    bc.tick = bc.tick + 1;
    bc.lines[slot].last_used_tick = bc.tick;
    bc.lines[slot].dirty = true;
    var k: uint = 0;
    while k < 512 {
        bc.lines[slot].data[k] = src[k];
        k = k + 1;
    }
    return slot;
}

