include "lib/core/types.rx";

const AHCI_FIS_TYPE_REG_H2D: u8 = 0x27;
const ATA_CMD_READ_DMA_EXT: u8  = 0x25;
const ATA_CMD_WRITE_DMA_EXT: u8 = 0x35;
const ATA_CMD_IDENTIFY: u8      = 0xEC;

struct AhciFisRegH2D {
    fis_type: u8,
    pmport_c: u8,
    command: u8,
    feature_low: u8,
    lba0: u8,
    lba1: u8,
    lba2: u8,
    device: u8,
    lba3: u8,
    lba4: u8,
    lba5: u8,
    feature_high: u8,
    count_low: u8,
    count_high: u8,
    icc: u8,
    control: u8,
    rsvd: u32,
}

struct AhciPrdtEntry {
    dba: u32,
    dbau: u32,
    rsvd: u32,
    dbc_i: u32,
}

struct AhciCommandHeader {
    flags: u16,
    prdtl: u16,
    prdbc: u32,
    ctba: u32,
    ctbau: u32,
}

fn ahci_build_h2d_lba48(fis: *mut AhciFisRegH2D, is_write: bool, lba: u64, sector_count: u16) {
    fis.fis_type = AHCI_FIS_TYPE_REG_H2D;
    fis.pmport_c = 128;
    if is_write {
        fis.command = ATA_CMD_WRITE_DMA_EXT;
    } else {
        fis.command = ATA_CMD_READ_DMA_EXT;
    }
    fis.feature_low = 0;
    fis.lba0 = (lba & 255) as u8;
    fis.lba1 = ((lba >> 8) & 255) as u8;
    fis.lba2 = ((lba >> 16) & 255) as u8;
    fis.device = 64;
    fis.lba3 = ((lba >> 24) & 255) as u8;
    fis.lba4 = ((lba >> 32) & 255) as u8;
    fis.lba5 = ((lba >> 40) & 255) as u8;
    fis.feature_high = 0;
    fis.count_low = (sector_count & 255) as u8;
    fis.count_high = ((sector_count >> 8) & 255) as u8;
    fis.icc = 0;
    fis.control = 0;
    fis.rsvd = 0;
}

fn ahci_build_prdt(entry: *mut AhciPrdtEntry, phys_addr: u64, byte_len: u32, interrupt_on_complete: bool) {
    entry.dba = (phys_addr & 4294967295) as u32;
    entry.dbau = ((phys_addr >> 32) & 4294967295) as u32;
    entry.rsvd = 0;
    var dbc: u32 = 0;
    if byte_len > 0 {
        dbc = (byte_len - 1) & 4194303;
    }
    if interrupt_on_complete {
        dbc = dbc | (1 << 31);
    }
    entry.dbc_i = dbc;
}

fn ahci_build_cmd_header(hdr: *mut AhciCommandHeader, cmd_table_phys: u64, prdt_count: u16, is_write: bool) {
    var fl: u16 = 5;
    if is_write {
        fl = fl | 64;
    }
    hdr.flags = fl;
    hdr.prdtl = prdt_count;
    hdr.prdbc = 0;
    hdr.ctba = (cmd_table_phys & 4294967295) as u32;
    hdr.ctbau = ((cmd_table_phys >> 32) & 4294967295) as u32;
}

