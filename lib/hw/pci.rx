include "lib/core/types.rx";

const PCI_CONFIG_ADDR_PORT: u16 = 0x0CF8;
const PCI_CONFIG_DATA_PORT: u16 = 0x0CFC;

const PCI_CLASS_STORAGE: u8    = 0x01;
const PCI_CLASS_NETWORK: u8    = 0x02;
const PCI_CLASS_DISPLAY: u8    = 0x03;
const PCI_CLASS_MULTIMEDIA: u8 = 0x04;
const PCI_CLASS_BRIDGE: u8     = 0x06;
const PCI_CLASS_SERIAL_BUS: u8 = 0x0C;

const PCI_CAP_ID_MSI: u8  = 0x05;
const PCI_CAP_ID_PCIE: u8 = 0x10;
const PCI_CAP_ID_MSIX: u8 = 0x11;

struct PciAddress {
    segment: u16,
    bus: u8,
    device: u8,
    function: u8,
}

struct PciDeviceHeader {
    addr: PciAddress,
    vendor_id: u16,
    device_id: u16,
    command: u16,
    status: u16,
    revision_id: u8,
    prog_if: u8,
    subclass: u8,
    class_code: u8,
    header_type: u8,
    irq_line: u8,
    bars: [u32; 6],
}

struct PciBarRegion {
    base_addr: u64,
    size_bytes: u64,
    is_io: bool,
    is_64bit: bool,
    is_prefetchable: bool,
}

struct PciMsiConfig {
    msg_addr: u64,
    msg_data: u32,
    vector: u8,
    enabled: bool,
}

fn pci_legacy_cfg_addr(bus: u8, dev: u8, func: u8, offset: u8) -> u32 {
    let b: u32 = (bus as u32) & 255;
    let d: u32 = (dev as u32) & 31;
    let f: u32 = (func as u32) & 7;
    let o: u32 = (offset as u32) & 252;
    return (1 << 31) | (b << 16) | (d << 11) | (f << 8) | o;
}

fn pcie_ecam_addr(ecam_base: u64, bus: u8, dev: u8, func: u8, reg_offset: u16) -> u64 {
    let b: u64 = (bus as u64) & 255;
    let d: u64 = (dev as u64) & 31;
    let f: u64 = (func as u64) & 7;
    let r: u64 = (reg_offset as u64) & 4095;
    return ecam_base + (b << 20) + (d << 15) + (f << 12) + r;
}

fn pci_decode_bar(bar_low: u32, bar_high: u32, size_mask_low: u32) -> PciBarRegion {
    var reg: PciBarRegion;
    if (bar_low & 1) != 0 {
        reg.is_io = true;
        reg.is_64bit = false;
        reg.is_prefetchable = false;
        reg.base_addr = (bar_low & 4294967292) as u64;
        let masked: u32 = size_mask_low & 4294967292;
        if masked == 0 {
            reg.size_bytes = 0;
        } else {
            reg.size_bytes = ((4294967295 ^ masked) + 1) as u64;
        }
        return reg;
    }

    reg.is_io = false;
    let bar_type: u32 = (bar_low >> 1) & 3;
    reg.is_64bit = bar_type == 2;
    reg.is_prefetchable = ((bar_low >> 3) & 1) != 0;
    let low_base: u64 = (bar_low & 4294967280) as u64;
    if reg.is_64bit {
        reg.base_addr = low_base | ((bar_high as u64) << 32);
    } else {
        reg.base_addr = low_base;
    }
    let mem_mask: u32 = size_mask_low & 4294967280;
    if mem_mask == 0 {
        reg.size_bytes = 0;
    } else {
        reg.size_bytes = ((4294967295 ^ mem_mask) + 1) as u64;
    }
    return reg;
}

fn pci_parse_header(cfg_words: *const u32, bus: u8, dev: u8, func: u8, out: *mut PciDeviceHeader) -> bool {
    let w0: u32 = cfg_words[0];
    let vendor: u16 = (w0 & 65535) as u16;
    if vendor == 65535 || vendor == 0 {
        return false;
    }
    out.addr.segment = 0;
    out.addr.bus = bus;
    out.addr.device = dev;
    out.addr.function = func;
    out.vendor_id = vendor;
    out.device_id = ((w0 >> 16) & 65535) as u16;

    let w1: u32 = cfg_words[1];
    out.command = (w1 & 65535) as u16;
    out.status = ((w1 >> 16) & 65535) as u16;

    let w2: u32 = cfg_words[2];
    out.revision_id = (w2 & 255) as u8;
    out.prog_if = ((w2 >> 8) & 255) as u8;
    out.subclass = ((w2 >> 16) & 255) as u8;
    out.class_code = ((w2 >> 24) & 255) as u8;

    let w3: u32 = cfg_words[3];
    out.header_type = ((w3 >> 16) & 255) as u8;

    var i: uint = 0;
    while i < 6 {
        out.bars[i] = cfg_words[4 + i];
        i = i + 1;
    }
    out.irq_line = (cfg_words[15] & 255) as u8;
    return true;
}

fn pci_build_msi_x86(apic_id: u8, vector: u8) -> PciMsiConfig {
    var msi: PciMsiConfig;
    msi.msg_addr = 0xFEE00000 | (((apic_id as u64) & 255) << 12);
    msi.msg_data = (vector as u32) & 255;
    msi.vector = vector;
    msi.enabled = true;
    return msi;
}

