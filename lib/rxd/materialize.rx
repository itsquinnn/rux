include "lib/core/types.rx";
include "lib/os/os.rx";
include "lib/crypto/blake3.rx";


fn rxd_materialize(plate: *const RxdPlate, out_buf: *mut u8, max_out: u64) -> u64 {
    var out_pos: u64 = 0;
    let arena_base: *const u8 = plate.raw_ptr + plate.arena_offset;
    let slots_base: *const u8 = plate.raw_ptr + 64;

    var i: u64 = 0;
    while i < plate.slot_count && out_pos + 128 < max_out {
        let slot: *const RxdSlotDescriptor = (slots_base + (i * 16)) as *const RxdSlotDescriptor;
        let k_ptr: *const u8 = arena_base + (slot.name_offset as u64);
        let k_len: u64 = slot.name_len as u64;

        var ki: u64 = 0;
        while ki < k_len && out_pos < max_out {
            out_buf[out_pos] = k_ptr[ki];
            out_pos = out_pos + 1;
            ki = ki + 1;
        }

        out_buf[out_pos] = 58; out_pos = out_pos + 1;
        out_buf[out_pos] = 32; out_pos = out_pos + 1;

        if slot.kind == 5 {
            out_buf[out_pos] = 34; out_pos = out_pos + 1;
            let s_ptr: *const u8 = arena_base + (slot.arena_offset as u64);
            let s_len: u64 = slot.val_or_len;
            var si: u64 = 0;
            while si < s_len && out_pos < max_out {
                out_buf[out_pos] = s_ptr[si];
                out_pos = out_pos + 1;
                si = si + 1;
            }
            out_buf[out_pos] = 34; out_pos = out_pos + 1;
        } else if slot.kind == 4 {
            if slot.val_or_len != 0 {
                out_buf[out_pos] = 116; out_pos = out_pos + 1;
                out_buf[out_pos] = 114; out_pos = out_pos + 1;
                out_buf[out_pos] = 117; out_pos = out_pos + 1;
                out_buf[out_pos] = 101; out_pos = out_pos + 1;
            } else {
                out_buf[out_pos] = 102; out_pos = out_pos + 1;
                out_buf[out_pos] = 97;  out_pos = out_pos + 1;
                out_buf[out_pos] = 108; out_pos = out_pos + 1;
                out_buf[out_pos] = 115; out_pos = out_pos + 1;
                out_buf[out_pos] = 101; out_pos = out_pos + 1;
            }
        } else if slot.kind == 7 {
            out_buf[out_pos] = 123; out_pos = out_pos + 1;
            out_buf[out_pos] = 125; out_pos = out_pos + 1;
        } else if slot.kind == 8 {
            out_buf[out_pos] = 91; out_pos = out_pos + 1;
            let a_ptr: *const u8 = arena_base + (slot.arena_offset as u64);
            let a_len: u64 = slot.val_or_len;
            var ai: u64 = 0;
            while ai < a_len && out_pos < max_out {
                out_buf[out_pos] = a_ptr[ai];
                out_pos = out_pos + 1;
                ai = ai + 1;
            }
            out_buf[out_pos] = 93; out_pos = out_pos + 1;
        } else {
            var val: u64 = slot.val_or_len;
            if val == 0 {
                out_buf[out_pos] = 48; out_pos = out_pos + 1;
            } else {
                var digits: [u8; 32];
                var d_count: u64 = 0;
                while val > 0 {
                    digits[d_count] = ((val % 10) + 48) as u8;
                    val = val / 10;
                    d_count = d_count + 1;
                }
                var di: u64 = 0;
                while di < d_count {
                    let d_idx: u64 = d_count - 1 - di;
                    out_buf[out_pos] = digits[d_idx];
                    out_pos = out_pos + 1;
                    di = di + 1;
                }
            }
        }

        out_buf[out_pos] = 10; out_pos = out_pos + 1;
        i = i + 1;
    }

    out_buf[out_pos] = 0;
    return out_pos;
}

fn rxd_materialize_file(in_path: *const byte, out_path: *const byte) -> int {
    let plate_buf: *mut u8 = uses_substrate_alloc(65536);
    if (plate_buf as u64) == 0 {
        return -1;
    }
    let nread: int = os_read_file(in_path, plate_buf, 65536);
    if nread <= 0 {
        uses_substrate_free(plate_buf, 65536);
        return -1;
    }

    let plate: RxdPlate = rxd_plate_from_bytes(plate_buf, nread as u64);
    if plate.byte_length == 0 {
        uses_substrate_free(plate_buf, 65536);
        return -2;
    }

    let text_out: *mut u8 = uses_substrate_alloc(65536);
    if (text_out as u64) == 0 {
        uses_substrate_free(plate_buf, 65536);
        return -3;
    }
    let text_len: u64 = rxd_materialize(&plate, text_out, 65536);
    if text_len == 0 {
        uses_substrate_free(plate_buf, 65536);
        uses_substrate_free(text_out, 65536);
        return -3;
    }

    let nwritten: int = os_write_file(out_path, text_out as *const u8, text_len as uint);
    uses_substrate_free(plate_buf, 65536);
    uses_substrate_free(text_out, 65536);
    if nwritten <= 0 {
        return -4;
    }
    return text_len as int;
}
