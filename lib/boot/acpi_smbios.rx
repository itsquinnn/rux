include "lib/core/types.rx";

const ACPI_MADT_TYPE_LAPIC: u8  = 0;
const ACPI_MADT_TYPE_IOAPIC: u8 = 1;

const ACPI_POWER_S0_WORKING: u8  = 0;
const ACPI_POWER_S3_SLEEP: u8    = 3;
const ACPI_POWER_S5_SOFT_OFF: u8 = 5;

struct AcpiRsdpDescriptor {
    signature: [u8; 8],
    checksum: u8,
    oem_id: [u8; 6],
    revision: u8,
    rsdt_address: u32,
    length: u32,
    xsdt_address: u64,
}

struct AcpiTopology {
    lapic_base: u64,
    ioapic_base: u64,
    pcie_ecam_base: u64,
    cpu_apic_ids: [u8; 64],
    cpu_count: uint,
    pm1a_control_port: u16,
}

struct SmbiosSystemInfo {
    major_ver: u8,
    minor_ver: u8,
    vendor: *const byte,
    product_name: *const byte,
    bios_version: *const byte,
}

fn acpi_checksum_valid(bytes: *const u8, len: uint) -> bool {
    var sum: u8 = 0;
    var i: uint = 0;
    while i < len {
        sum = (sum + bytes[i]) & 255;
        i = i + 1;
    }
    return sum == 0;
}

fn acpi_verify_rsdp_sig(sig: *const u8) -> bool {
    return sig[0] == 82 && sig[1] == 83 && sig[2] == 68 && sig[3] == 32 &&
           sig[4] == 80 && sig[5] == 84 && sig[6] == 82 && sig[7] == 32;
}

fn acpi_topology_init(topo: *mut AcpiTopology, lapic_addr: u64, ioapic_addr: u64, ecam_addr: u64) {
    topo.lapic_base = lapic_addr;
    topo.ioapic_base = ioapic_addr;
    topo.pcie_ecam_base = ecam_addr;
    topo.cpu_count = 0;
    topo.pm1a_control_port = 1540;
}

fn acpi_register_lapic(topo: *mut AcpiTopology, apic_id: u8) {
    if topo.cpu_count < 64 {
        topo.cpu_apic_ids[topo.cpu_count] = apic_id;
        topo.cpu_count = topo.cpu_count + 1;
    }
}

fn smbios_verify_anchor3(buf: *const u8) -> bool {
    return buf[0] == 95 && buf[1] == 83 && buf[2] == 77 && buf[3] == 51 && buf[4] == 95;
}
