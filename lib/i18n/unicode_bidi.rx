include "lib/core/types.rx";
include "lib/core/utf8.rx";

const BIDI_DIR_LTR: u8     = 0;
const BIDI_DIR_RTL: u8     = 1;
const BIDI_DIR_NEUTRAL: u8 = 2;

fn uni_is_combining_mark(cp: uint) -> bool {
    if cp >= 0x0300 && cp <= 0x036F { return true; }
    if cp >= 0x0591 && cp <= 0x05BD { return true; }
    if cp >= 0x064B && cp <= 0x065F { return true; }
    if cp >= 0x0901 && cp <= 0x0903 { return true; }
    if cp >= 0x093E && cp <= 0x094D { return true; }
    return false;
}

fn uni_grapheme_count(utf8_bytes: *const byte, byte_len: uint) -> uint {
    var offset: uint = 0;
    var clusters: uint = 0;
    var cp: [uint; 1];
    while offset < byte_len {
        let step: uint = utf8_decode_rune(utf8_bytes, byte_len, offset, &mut cp[0]);
        if step == 0 {
            offset = offset + 1;
            clusters = clusters + 1;
        } else {
            if clusters == 0 || !uni_is_combining_mark(cp[0]) {
                clusters = clusters + 1;
            }
            offset = offset + step;
        }
    }
    return clusters;
}

fn uni_fold_case(cp: uint) -> uint {
    if cp >= 65 && cp <= 90 {
        return cp + 32;
    }
    if cp >= 0x00C0 && cp <= 0x00D6 {
        return cp + 32;
    }
    if cp >= 0x0410 && cp <= 0x042F {
        return cp + 32;
    }
    return cp;
}

fn uni_collate_utf8(a: *const byte, a_len: uint, b: *const byte, b_len: uint) -> int {
    var oa: uint = 0;
    var ob: uint = 0;
    var cpa: [uint; 1];
    var cpb: [uint; 1];

    while oa < a_len && ob < b_len {
        let sa: uint = utf8_decode_rune(a, a_len, oa, &mut cpa[0]);
        let sb: uint = utf8_decode_rune(b, b_len, ob, &mut cpb[0]);
        if sa == 0 || sb == 0 {
            return (a[oa] as int) - (b[ob] as int);
        }
        let fa: uint = uni_fold_case(cpa[0]);
        let fb: uint = uni_fold_case(cpb[0]);
        if fa < fb { return -1; }
        if fa > fb { return 1; }
        oa = oa + sa;
        ob = ob + sb;
    }
    if oa < a_len { return 1; }
    if ob < b_len { return -1; }
    return 0;
}

fn uni_bidi_char_class(cp: uint) -> u8 {
    if cp >= 0x0590 && cp <= 0x08FF {
        return BIDI_DIR_RTL;
    }
    if cp >= 0xFB1D && cp <= 0xFDFF {
        return BIDI_DIR_RTL;
    }
    if cp >= 0xFE70 && cp <= 0xFEFF {
        return BIDI_DIR_RTL;
    }
    if cp == 32 || cp == 9 || (cp >= 33 && cp <= 47) {
        return BIDI_DIR_NEUTRAL;
    }
    return BIDI_DIR_LTR;
}

fn uni_bidi_visual_reorder_run(codepoints: *const uint, count: uint, base_dir: u8, out_visual: *mut uint) -> u8 {
    var detected_dir: u8 = base_dir;
    var i: uint = 0;
    var found_strong: bool = false;
    while i < count {
        let cls: u8 = uni_bidi_char_class(codepoints[i]);
        if cls != BIDI_DIR_NEUTRAL && !found_strong {
            detected_dir = cls;
            found_strong = true;
        }
        i = i + 1;
    }
    if detected_dir == BIDI_DIR_RTL {
        var k: uint = 0;
        while k < count {
            out_visual[k] = codepoints[count - 1 - k];
            k = k + 1;
        }
    } else {
        var m: uint = 0;
        while m < count {
            out_visual[m] = codepoints[m];
            m = m + 1;
        }
    }
    return detected_dir;
}

