include "lib/core/types.rx";
include "lib/fs/file.rx";

struct DirEntry {
    inode: uint,
    offset_to_next: uint,
    record_len: u16,
    entry_type: byte,
    name_buffer: [byte; 64],
}

struct DirIterator {
    dir_fd: int,
    raw_buffer: *mut byte,
    buffer_len: uint,
    cursor: uint,
    is_valid: bool,
}

fn dir_open(path: str, buffer_mem: *mut byte, buf_cap: uint) -> DirIterator {
    let f: File = file_open(path, OpenMode.READ_ONLY);
    if !f.is_open {
        return DirIterator { dir_fd: -1, raw_buffer: 0 as *mut byte, buffer_len: 0, cursor: 0, is_valid: false };
    }
    return DirIterator { dir_fd: f.fd, raw_buffer: buffer_mem, buffer_len: buf_cap, cursor: 0, is_valid: true };
}

fn dir_close(it: *mut DirIterator) {
    if it.is_valid && it.dir_fd >= 0 {
        @os.close(it.dir_fd);
        it.is_valid = false;
        it.dir_fd = -1;
    }
}
